      "does": "Build the candidate and the signed laptop payload from the pinned inputs",
      "decision": "run"
    },
    {
      "target": "laptop-update",
      "id": "control",
      "does": "Rebuild the installed release's images from its candidate with the same steps; they must match byte for byte",
      "decision": "run"
    },
    {
      "target": "laptop-update",
      "id": "update-rehearsal",
      "does": "VM: update the installed release into the other slot with existing data, boot it and compare the slot bytes",
      "decision": "run"
    },
    {
      "target": "laptop-update",
      "id": "fallback",
      "does": "VM: break the new slot; the old slot must boot by itself",
      "decision": "run"
    },
    {
      "target": "laptop-update",
      "id": "after-update",
      "does": "VM: check every changed feature after the update, with existing data",
      "decision": "run"
    },
    {
      "target": "stick",
      "id": "stick-image",
      "does": "Build the stick image and its installer pin from the candidate",
      "decision": "run"
    },
    {
      "target": "stick",
      "id": "fresh-boot",
      "does": "VM: first boot of the candidate with fresh data",
      "reusable_kind": "fresh-boot-vm",
      "decision": "cite-source"
    },
    {
      "target": "stick",
      "id": "stick-install",
      "does": "VM: install from the stick image, then boot without the stick",
      "decision": "run"
    }
  ],
