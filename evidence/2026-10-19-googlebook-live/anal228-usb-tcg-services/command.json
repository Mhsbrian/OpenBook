[
  "$DATA/installer/work/anal228-tcg/build/qemu-system-x86_64",
  "-machine",
  "q35",
  "-accel",
  "tcg",
  "-cpu",
  "max",
  "-smp",
  "4",
  "-m",
  "8192",
  "-display",
  "none",
  "-nic",
  "none",
  "-serial",
  "file:$DATA/installer/work/anal228-usb-tcg-services/serial.log",
  "-monitor",
  "none",
  "-no-reboot",
  "-qmp",
  "unix:qmp.sock,server=on,wait=off",
  "-drive",
  "file=$DATA/installer/work/anal228-usb-tcg-services/usb-test.img,format=raw,if=none,id=d0,snapshot=on",
  "-device",
  "virtio-vga",
  "-drive",
  "if=pflash,format=raw,readonly=on,file=/usr/share/edk2/x64/OVMF_CODE.4m.fd",
  "-drive",
  "if=pflash,format=raw,file=$DATA/installer/work/anal228-usb-tcg-services/vars.fd",
  "-device",
  "qemu-xhci,id=xhci",
  "-device",
  "usb-storage,drive=d0,bootindex=1",
  "-device",
  "usb-kbd,bus=xhci.0",
  "-device",
  "usb-tablet,bus=xhci.0",
  "-drive",
  "file=$DATA/installer/work/anal228-usb-tcg-services/internal-decoy.img,format=raw,if=none,id=internal",
  "-device",
  "nvme,drive=internal,serial=SYNTHETICINTERNAL",
  "-chardev",
  "socket,id=chrtpm,path=tpm.sock",
  "-tpmdev",
  "emulator,id=tpm0,chardev=chrtpm",
  "-device",
  "tpm-crb,tpmdev=tpm0"
]
