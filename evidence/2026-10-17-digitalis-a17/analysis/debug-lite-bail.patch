diff --git a/kernel_api/arm64/syscall_emulation.cc b/kernel_api/arm64/syscall_emulation.cc
index c6cc7b23..1ed03710 100644
--- a/kernel_api/arm64/syscall_emulation.cc
+++ b/kernel_api/arm64/syscall_emulation.cc
@@ -171,7 +171,29 @@ long RunGuestSyscall___NR_newfstatat(long arg_1, long arg_2, long arg_3, long ar
 
 }  // namespace
 
+static void RunGuestSyscallInner(ThreadState* state);
+
+// DEBUG (OpenBook): with berberis.tracing on, one line per guest syscall: number, guest pc, arguments, result,
+// and the path for the path-taking calls, to diff runs under different translation modes.
 void RunGuestSyscall(ThreadState* state) {
+  if (!Tracing::IsOn()) {
+    RunGuestSyscallInner(state);
+    return;
+  }
+  const long nr = state->cpu.x[8];
+  const uint64_t a0 = state->cpu.x[0], a1 = state->cpu.x[1], a2 = state->cpu.x[2], a3 = state->cpu.x[3];
+  const uint64_t pc = state->cpu.insn_addr;
+  const char* path = nullptr;
+  if ((nr == 56 || nr == 48 || nr == 79 || nr == 291 || nr == 78 || nr == 35 || nr == 34) && a1) {
+    path = ToHostAddr<const char>(a1);  // openat, faccessat, newfstatat, statx, readlinkat, unlinkat, mkdirat
+  }
+  RunGuestSyscallInner(state);
+  Tracing::TraceF("SYS %ld pc=%lx (%lx,%lx,%lx,%lx) = %lx%s%s", nr, (unsigned long)pc, (unsigned long)a0,
+                  (unsigned long)a1, (unsigned long)a2, (unsigned long)a3, (unsigned long)state->cpu.x[0],
+                  path ? " " : "", path ? path : "");
+}
+
+static void RunGuestSyscallInner(ThreadState* state) {
   // ATTENTION: run guest signal handlers instantly!
   // If signal arrives while in a syscall, syscall should immediately return with EINTR.
   // In this case pending signals are OK, as guest handlers will run on return from syscall.
