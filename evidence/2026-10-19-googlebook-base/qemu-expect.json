  {
    "send": "while [ \"$(getprop sys.boot_completed)\" != 1 ]; do sleep 2; done; echo BOOTDONE=1 uptime=$(cut -d' ' -f1 /proc/uptime)\n"
  },
  {
    "wait": "\\nBOOTDONE=1 uptime=",
    "timeout": 600
  },
  {
    "wait": "console:/ # ",
    "timeout": 30
  },
  {
    "send": "while read -r k n v; do [ \"$k\" = export ] && export \"$n=$v\"; done < /data/system/environ/classpath; svc power stayon true; settings put system screen_off_timeout 3600000; input keyevent 224; wm dismiss-keyguard\n"
  },
  {
    "wait": "console:/ # ",
    "timeout": 30
  },
  {
    "send": "wm density 240; mkdir -p /mnt/obesp; mount -t vfat /dev/block/sda1 /mnt/obesp; cp /mnt/obesp/openbook/base-test.apk /data/local/tmp/base-test.apk; umount /mnt/obesp; am force-stop org.openbook.installer; pm install -r /data/local/tmp/base-test.apk\n"
  },
  {
    "wait": "console:/ # ",
    "timeout": 120
