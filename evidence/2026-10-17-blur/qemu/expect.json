 {
  "send": "echo ===BLURFACTS-BEGIN===; for p in ro.surface_flinger.supports_background_blur vendor.anybook.gpu.hal ro.hardware.egl ro.hardware.vulkan ro.hwui.use_vulkan debug.renderengine.backend; do echo $p=$(getprop $p); done; su 0 dumpsys activity service com.android.systemui/.SystemUIService BlurUtils | grep -E 'Radius|supports|CROSS|HighEnd'; su 0 dumpsys SurfaceFlinger | grep -E '^GLES: |RenderEngine'; echo ===BLURFACTS-END===\n"
