#version 450
// SPDX-License-Identifier: Apache-2.0
// vk-compute-bench: one vec4 read and one vec4 write per thread.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer S { vec4 s[]; };
layout(std430, binding = 1) writeonly buffer D { vec4 d[]; };
layout(push_constant) uniform P { uint iters; uint width; } pc;
void main() {
    uint i = gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 256u + gl_GlobalInvocationID.x;
    d[i] = s[i];
}
