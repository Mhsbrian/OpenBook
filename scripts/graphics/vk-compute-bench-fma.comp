#version 450
// SPDX-License-Identifier: Apache-2.0
// vk-compute-bench: 8 independent vec4 FMA chains, 64 FP32 FLOP per thread per iteration.
layout(local_size_x = 256) in;
layout(std430, binding = 0) writeonly buffer Out { float data[]; };
layout(push_constant) uniform P { uint iters; uint width; } pc;
void main() {
    uint id = gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 256u + gl_GlobalInvocationID.x;
    float s = float(id & 1023u) * 1.0e-6;
    vec4 m = vec4(0.9999, 0.99991, 0.99992, 0.99993), c = vec4(1.0e-4);
    vec4 a0 = vec4(s), a1 = a0 + 0.1, a2 = a0 + 0.2, a3 = a0 + 0.3;
    vec4 a4 = a0 + 0.4, a5 = a0 + 0.5, a6 = a0 + 0.6, a7 = a0 + 0.7;
    for (uint k = 0u; k < pc.iters; k++) {
        a0 = fma(a0, m, c); a1 = fma(a1, m, c); a2 = fma(a2, m, c); a3 = fma(a3, m, c);
        a4 = fma(a4, m, c); a5 = fma(a5, m, c); a6 = fma(a6, m, c); a7 = fma(a7, m, c);
    }
    data[id] = dot(a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7, vec4(1.0));
}
