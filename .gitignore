# Never commit proprietary or large images
*.img
*.bin
*.zip
# ...except OpenBook's own boot animation (CC-BY-4.0, generated by scripts/brand/bootanimation.py)
!assets/bootanimation/bootanimation.zip
# ...and the product's link to it (device/anybook/common/branding/branding.mk copies it to /product/media)
!device/anybook/common/branding/media/bootanimation.zip
*.iso
*.tar.gz
*.tgz
/dl/
/work/

# Python bytecode
__pycache__/
*.pyc
docs/installer-design/fonts
assets/src/fonts
docs/quire-design/fonts

# Never commit private keys (the OTA signing key lives outside every repository)
*.key
*.pk8
