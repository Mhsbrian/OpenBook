+    /**
+     * The installed image's build_id, its first line, or null when none is installed or it has none. Read on every
+     * call: Recovery can replace the image while this process lives.
+     */
+    private fun installedImage(): String? {
+        val image = InstalledImage.getDefault(context!!)
+        if (!image.isInstalled()) return null
+        return try {
+            image.installDir.resolve("build_id").toFile().bufferedReader().use { it.readLine() }
+                ?.trim()
+                ?.take(IMAGE_MAX)
+                ?.ifEmpty { null }
+        } catch (e: IOException) {
+            null
+        }
+    }
+
