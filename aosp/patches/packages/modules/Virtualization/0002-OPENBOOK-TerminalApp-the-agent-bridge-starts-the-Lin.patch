     }
 
     override fun onCreate(): Boolean = true
@@ -72,6 +81,7 @@ class AgentBridgeProvider : ContentProvider() {
 
     private fun state(): Pair<String, String?> {
         if (!Flags.terminalNewuiJetpack()) return "error" to "the agent bridge needs the new Terminal UI"
+        if (Installer.isInstalling) return "installing" to null
         if (!InstalledImage.getDefault(context!!).isInstalled()) return "not_installed" to null
         return when (val s = VmController.vmState.value) {
             // VmController calls the VM running as soon as crosvm is started, and AVF keeps listing it while its
@@ -108,14 +118,70 @@ class AgentBridgeProvider : ContentProvider() {
 
     override fun call(method: String, arg: String?, extras: Bundle?): Bundle? {
         enforce()
-        if (method != "status") throw IllegalArgumentException("unknown method $method")
-        val (state, message) = state()
+        val (state, message) =
+            when (method) {
+                "status" -> state()
+                "start" -> start()
+                else -> throw IllegalArgumentException("unknown method $method")
+            }
         return Bundle().apply {
             putString("state", state)
             message?.let { putString("message", it) }
         }
     }
 
+    /** Installs if needed, then starts the VM; returns the state right after asking. See the class. */
+    private fun start(): Pair<String, String?> {
+        val (state, message) = state()
+        return try {
+            when (state) {
+                "running", "starting", "installing" -> state to message
+                "not_installed" -> {
+                    Log.i(TAG, "start: installing the Linux environment for ${callingPackage ?: "?"}")
+                    Installer.install()
+                    thread(name = "AgentBridge-start") { startWhenInstalled() }
+                    "installing" to null
+                }
+                else -> {
+                    startVm()
+                    "starting" to null
+                }
+            }
+        } catch (e: Exception) {
+            // Most likely the background limit on foreground services: the caller didn't exempt this app.
+            Log.w(TAG, "start failed", e)
+            "error" to "could not start the Linux environment: ${e.message ?: e.javaClass.simpleName}"
+        }
+    }
+
+    private fun startWhenInstalled() {
+        val deadline = SystemClock.elapsedRealtime() + INSTALL_TIMEOUT_MS
+        while (SystemClock.elapsedRealtime() < deadline) {
+            when (val s = Installer.installState.value) {
+                is InstallState.Installed -> {
+                    try {
+                        startVm()
+                    } catch (e: Exception) {
+                        Log.w(TAG, "start after install failed", e)
+                    }
+                    return
+                }
+                is InstallState.Error -> {
+                    Log.w(TAG, "install failed: ${s.errorCause}")
+                    return
+                }
+                else -> Thread.sleep(1000)
+            }
+        }
+        Log.w(TAG, "install did not finish in ${INSTALL_TIMEOUT_MS / 60_000} min")
+    }
+
+    private fun startVm() {
+        Log.i(TAG, "start: starting the Linux environment for ${callingPackage ?: "?"}")
+        VmController.reset()
+        VmController.start()
+    }
+
