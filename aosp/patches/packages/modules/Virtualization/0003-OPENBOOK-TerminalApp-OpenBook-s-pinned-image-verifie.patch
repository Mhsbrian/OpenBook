+ * limitations under the License.
+ */
+package com.android.virtualization.terminal.openbook
+
+import java.io.BufferedInputStream
+import java.io.FileInputStream
+import java.io.IOException
+import java.nio.file.FileVisitResult
+import java.nio.file.Files
+import java.nio.file.LinkOption
+import java.nio.file.Path
+import java.nio.file.SimpleFileVisitor
+import java.nio.file.StandardCopyOption
+import java.nio.file.StandardOpenOption
+import java.nio.file.attribute.BasicFileAttributes
+import java.util.concurrent.CancellationException
+import org.apache.commons.compress.archivers.tar.TarArchiveEntry
+import org.apache.commons.compress.archivers.tar.TarArchiveInputStream
+import org.apache.commons.compress.compressors.gzip.GzipCompressorInputStream
+
+/**
+ * Extracts a verified image archive into a fresh folder, refusing anything AOSP's installer doesn't expect: a path
+ * that is absolute, has `..` or leaves the folder; anything that isn't a regular file (links, devices, FIFOs,
+ * folders other than the archive's root); a name outside [ALLOWED]; a name twice; more bytes than [limit].
+ */
+object SafeExtractor {
+    val ALLOWED =
+        setOf(
+            "build_id",
+            "root_part",
+            "vm_config.json",
+            "vmlinuz",
+            "initrd.img",
+            "efi_part",
+            "cidata.iso",
+            "cidata.build_id",
+        )
+
+    /** Returns the names extracted. On any refusal [dest] is deleted and [ImageRefusedException] thrown. */
+    fun extract(
+        archive: Path,
+        dest: Path,
+        limit: Long?,
+        onBytes: (Long) -> Unit = {},
+        cancelled: () -> Boolean = { false },
+    ): Set<String> {
+        deleteTree(dest)
+        Files.createDirectories(dest)
+        val root = dest.toAbsolutePath().normalize()
+        val names = LinkedHashSet<String>()
+        var total = 0L
+        try {
+            TarArchiveInputStream(GzipCompressorInputStream(BufferedInputStream(FileInputStream(archive.toFile())))).use { tar ->
+                val buf = ByteArray(256 * 1024)
+                while (true) {
+                    val e = tar.nextEntry as TarArchiveEntry? ?: break
+                    val raw = e.name
+                    val name = raw.removePrefix("./").removeSuffix("/")
+                    if (name.isEmpty() || name == ".") {
+                        if (e.isDirectory) continue
+                        refuse(raw, "an entry with no name")
+                    }
+                    if (raw.startsWith("/")) refuse(raw, "an absolute path")
+                    if (raw.contains('\u0000') || raw.contains('\\')) refuse(raw, "a name with a NUL or a backslash")
+                    if (name.split('/').any { it == ".." }) refuse(raw, "a path with ..")
+                    val to = root.resolve(name).normalize()
+                    if (!to.startsWith(root)) refuse(raw, "a path outside the image folder")
+                    if (to.parent != root) refuse(raw, "a path in a subfolder")
+                    when {
+                        e.isSymbolicLink -> refuse(raw, "a symbolic link")
+                        e.isLink -> refuse(raw, "a hard link")
+                        e.isCharacterDevice || e.isBlockDevice -> refuse(raw, "a device")
+                        e.isFIFO -> refuse(raw, "a FIFO")
+                        e.isDirectory -> refuse(raw, "a folder")
+                        e.isGNUSparse -> refuse(raw, "a sparse file")
+                    }
+                    if (name !in ALLOWED) refuse(raw, "a file the installer doesn't know")
+                    if (!names.add(name)) refuse(raw, "a file twice")
+                    if (limit != null && total + e.size > limit) refuse(raw, "more than the image's installed size")
+                    Files.newOutputStream(to, StandardOpenOption.CREATE_NEW, StandardOpenOption.WRITE).use { out ->
+                        while (true) {
+                            if (cancelled()) throw CancellationException("the install was cancelled")
+                            val n = tar.read(buf)
+                            if (n < 0) break
+                            total += n
+                            if (limit != null && total > limit) refuse(raw, "more than the image's installed size")
+                            out.write(buf, 0, n)
+                            onBytes(total)
+                        }
+                    }
+                }
+            }
+        } catch (e: Exception) {
+            deleteTree(dest)
+            throw e
+        }
+        if (names.isEmpty()) {
+            deleteTree(dest)
+            throw ImageRefusedException("the image archive is empty")
+        }
+        return names
+    }
+
+    private fun refuse(entry: String, what: String): Nothing =
+        throw ImageRefusedException("refused the image: '$entry' is $what")
+
+    fun deleteTree(p: Path) {
+        if (!Files.exists(p, LinkOption.NOFOLLOW_LINKS)) return
+        Files.walkFileTree(
+            p,
+            object : SimpleFileVisitor<Path>() {
+                override fun visitFile(file: Path, attrs: BasicFileAttributes): FileVisitResult {
+                    Files.delete(file)
+                    return FileVisitResult.CONTINUE
+                }
+
+                override fun postVisitDirectory(dir: Path, exc: IOException?): FileVisitResult {
+                    Files.delete(dir)
+                    return FileVisitResult.CONTINUE
+                }
+            },
+        )
+    }
+}
+
+/**
+ * Puts a complete, extracted image in place of the install folder, keeping what the person has there that isn't part
+ * of an image (such as `root_part_backup`, the old guest's disk kept by an upgrade). Each step leaves something
+ * [recover] can finish or undo, so an interrupted swap never loses the old folder.
+ */
+object InstallCommit {
+    private fun old(install: Path) = install.resolveSibling(install.fileName.toString() + ".old")
+
+    fun staging(install: Path): Path = install.resolveSibling(install.fileName.toString() + ".new")
+
+    /** [newDir] already holds the image; writes [marker] in it, then swaps it in for [install]. */
+    fun commit(newDir: Path, install: Path, marker: String) {
+        Files.createFile(newDir.resolve(marker))
+        val old = old(install)
+        SafeExtractor.deleteTree(old)
+        if (Files.exists(install, LinkOption.NOFOLLOW_LINKS)) Files.move(install, old, StandardCopyOption.ATOMIC_MOVE)
+        try {
+            Files.move(newDir, install, StandardCopyOption.ATOMIC_MOVE)
+        } catch (e: IOException) {
+            if (Files.exists(old)) Files.move(old, install, StandardCopyOption.ATOMIC_MOVE)
+            throw e
+        }
+        carryOver(old, install, marker)
+        SafeExtractor.deleteTree(old)
+    }
+
+    /** Finishes or undoes a swap that a crash interrupted, and drops a leftover extraction. */
+    fun recover(install: Path, marker: String) {
+        val old = old(install)
+        val new = staging(install)
+        val hasInstall = Files.exists(install, LinkOption.NOFOLLOW_LINKS)
+        if (Files.exists(old, LinkOption.NOFOLLOW_LINKS)) {
+            if (!hasInstall) {
+                if (Files.exists(new.resolve(marker))) {
+                    Files.move(new, install, StandardCopyOption.ATOMIC_MOVE)
+                    carryOver(old, install, marker)
+                    SafeExtractor.deleteTree(old)
+                } else {
+                    Files.move(old, install, StandardCopyOption.ATOMIC_MOVE)
+                }
+            } else {
+                carryOver(old, install, marker)
+                SafeExtractor.deleteTree(old)
+            }
+        }
+        SafeExtractor.deleteTree(new)
+    }
+
+    private fun carryOver(old: Path, install: Path, marker: String) {
+        if (!Files.isDirectory(old, LinkOption.NOFOLLOW_LINKS)) return
+        Files.list(old).use { s ->
+            for (f in s.toList()) {
+                val n = f.fileName.toString()
+                if (n in SafeExtractor.ALLOWED || n == marker) continue
+                val to = install.resolve(n)
+                if (!Files.exists(to, LinkOption.NOFOLLOW_LINKS)) Files.move(f, to, StandardCopyOption.ATOMIC_MOVE)
+            }
+        }
+    }
+}
