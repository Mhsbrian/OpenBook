+/** `/product/etc/openbook/linux-env.json`, with a URL: the image this build installs. */
+data class ImageManifest(
+    val version: String?,
+    val url: String,
+    val sha256: String,
+    val size: Long,
+    val installedSize: Long?,
+) {
+    sealed interface Read {
+        data class Ready(val manifest: ImageManifest) : Read
+
+        /** The state before an image is published: the manifest names no URL. */
+        data class NoUrl(val version: String?) : Read
+
+        data class Invalid(val reason: String) : Read
+    }
+
+    companion object {
+        const val PATH = "/product/etc/openbook/linux-env.json"
+        private val HEX64 = Regex("^[0-9a-fA-F]{64}$")
+
+        fun read(text: String): Read {
+            val o =
+                try {
+                    MiniJson.parse(text) as? Map<*, *> ?: return Read.Invalid("not a JSON object")
+                } catch (e: IllegalArgumentException) {
+                    return Read.Invalid(e.message ?: "not JSON")
+                }
+            val version = o["version"] as? String
+            val url = o["url"]
+            if (url == null || (url is String && url.isBlank())) return Read.NoUrl(version)
+            if (url !is String) return Read.Invalid("url is not a string")
+            if (!url.startsWith("https://") && !url.startsWith("http://")) {
+                return Read.Invalid("url must be http or https")
+            }
+            val sha = o["sha256"] as? String ?: return Read.Invalid("no sha256")
+            if (!HEX64.matches(sha)) return Read.Invalid("sha256 is not 64 hex digits")
+            val size = (o["size"] as? Long)?.takeIf { it > 0 } ?: return Read.Invalid("size must be a positive integer")
+            val installed =
+                when (val v = o["installed_size"]) {
+                    null -> null
+                    is Long -> v.takeIf { it > 0 } ?: return Read.Invalid("installed_size must be positive")
+                    else -> return Read.Invalid("installed_size must be an integer")
+                }
+            return Read.Ready(ImageManifest(version, url, sha.lowercase(), size, installed))
+        }
+    }
+}
+
+/** Where this build's image comes from, decided in the order of docs/quire-setup.md §4.1. */
+sealed interface ImageSource {
+    /** A debuggable build's `/sdcard/linux/images.tar.gz`, for the checks. */
+    data class SdCard(val archive: Path) : ImageSource
+
+    data class OpenBook(val manifest: ImageManifest) : ImageSource
+
+    /** An OpenBook build with no usable image. Never Google's instead. */
+    data class NoImage(val reason: String) : ImageSource
+
+    /** Not an OpenBook build: AOSP's own download. */
+    data object Upstream : ImageSource
+
+    companion object {
+        /**
+         * Quire core, the system app every OpenBook product installs (device/anybook/common/quire). A build with it
+         * is OpenBook's whether or not its image manifest is there, so a missing manifest is [NoImage], never Google's
+         * image (ANAL-393, the Checker's follow-up).
+         */
+        const val OPENBOOK_MARKER = "/system_ext/priv-app/OpenBookQuire"
+
+        /**
+         * [manifest] is [ImageManifest.PATH]. An OpenBook build ([openBookMarker] present, or the manifest's folder)
+         * with no usable manifest gets [NoImage]. Only a build that isn't OpenBook's keeps AOSP's download.
+         */
+        fun select(debuggable: Boolean, sdcardArchive: Path, manifest: Path,
+            openBookMarker: Path = Paths.get(OPENBOOK_MARKER)): ImageSource {
+            if (debuggable && Files.isRegularFile(sdcardArchive)) return SdCard(sdcardArchive)
+            if (Files.exists(manifest)) {
+                val text =
+                    try {
+                        String(Files.readAllBytes(manifest), Charsets.UTF_8)
+                    } catch (e: IOException) {
+                        return NoImage("the image manifest can't be read: ${e.message}")
+                    }
+                return when (val r = ImageManifest.read(text)) {
+                    is ImageManifest.Read.Ready -> OpenBook(r.manifest)
+                    is ImageManifest.Read.NoUrl -> NoImage("this build doesn't include a Linux environment image yet")
+                    is ImageManifest.Read.Invalid -> NoImage("the image manifest is invalid: ${r.reason}")
+                }
+            }
+            val dir = manifest.parent
+            if (Files.exists(openBookMarker) || (dir != null && Files.isDirectory(dir))) {
+                return NoImage("the image manifest is missing")
+            }
+            return Upstream
+        }
+    }
+}
+
+/** What the install is doing, for the agent bridge: `phase` is download, verify or unpack; null when idle. */
+object InstallProgress {
+    @Volatile var phase: String? = null
+        private set
+
+    @Volatile var bytes: Long = 0
+        private set
+
+    @Volatile var total: Long = 0
+        private set
+
+    fun set(phase: String, bytes: Long, total: Long) {
+        this.bytes = bytes
+        this.total = total
+        this.phase = phase
+    }
+
+    fun clear() {
+        phase = null
+        bytes = 0
+        total = 0
+    }
+}
+
+/** Just enough JSON for the manifest and the staging record: objects, arrays, strings, integers, true, false, null. */
+object MiniJson {
+    fun parse(text: String): Any? {
+        val p = Parser(text)
+        p.ws()
+        val v = p.value()
+        p.ws()
+        require(p.i == text.length) { "trailing characters at ${p.i}" }
+        return v
+    }
+
+    fun write(o: Map<String, Any?>): String =
+        o.entries.joinToString(",", "{", "}") { (k, v) ->
+            quote(k) + ":" + when (v) {
+                null -> "null"
+                is String -> quote(v)
+                is Number, is Boolean -> v.toString()
+                else -> throw IllegalArgumentException("unsupported value for $k")
+            }
+        }
+
+    private fun quote(s: String): String {
+        val b = StringBuilder("\"")
+        for (c in s) {
+            when {
+                c == '"' -> b.append("\\\"")
+                c == '\\' -> b.append("\\\\")
+                c < ' ' -> b.append(String.format("\\u%04x", c.code))
+                else -> b.append(c)
+            }
+        }
+        return b.append('"').toString()
+    }
+
+    private class Parser(val s: String) {
+        var i = 0
+
+        fun ws() {
+            while (i < s.length && s[i].isWhitespace()) i++
+        }
+
+        fun value(): Any? {
+            require(i < s.length) { "unexpected end" }
+            return when (s[i]) {
+                '{' -> obj()
+                '[' -> arr()
+                '"' -> str()
+                't' -> lit("true", true)
+                'f' -> lit("false", false)
+                'n' -> lit("null", null)
+                else -> num()
+            }
+        }
+
+        private fun lit(word: String, v: Any?): Any? {
+            require(s.startsWith(word, i)) { "bad literal at $i" }
+            i += word.length
+            return v
+        }
+
+        private fun obj(): Map<String, Any?> {
+            val m = LinkedHashMap<String, Any?>()
+            i++
+            ws()
+            if (i < s.length && s[i] == '}') {
+                i++
+                return m
+            }
+            while (true) {
+                ws()
+                require(i < s.length && s[i] == '"') { "expected a key at $i" }
+                val k = str()
+                ws()
+                require(i < s.length && s[i] == ':') { "expected ':' at $i" }
+                i++
+                ws()
+                m[k] = value()
+                ws()
+                require(i < s.length) { "unexpected end" }
+                when (s[i++]) {
+                    ',' -> continue
+                    '}' -> return m
+                    else -> throw IllegalArgumentException("expected ',' or '}' at ${i - 1}")
+                }
+            }
+        }
+
+        private fun arr(): List<Any?> {
+            val l = ArrayList<Any?>()
+            i++
+            ws()
+            if (i < s.length && s[i] == ']') {
+                i++
+                return l
+            }
+            while (true) {
+                ws()
+                l += value()
+                ws()
+                require(i < s.length) { "unexpected end" }
+                when (s[i++]) {
+                    ',' -> continue
+                    ']' -> return l
+                    else -> throw IllegalArgumentException("expected ',' or ']' at ${i - 1}")
+                }
+            }
+        }
+
+        private fun str(): String {
+            val b = StringBuilder()
+            i++
+            while (true) {
+                require(i < s.length) { "unterminated string" }
+                val c = s[i++]
+                when (c) {
+                    '"' -> return b.toString()
+                    '\\' -> {
+                        require(i < s.length) { "unterminated escape" }
+                        when (val e = s[i++]) {
+                            '"', '\\', '/' -> b.append(e)
+                            'b' -> b.append('\b')
+                            'f' -> b.append('\u000c')
+                            'n' -> b.append('\n')
+                            'r' -> b.append('\r')
+                            't' -> b.append('\t')
+                            'u' -> {
+                                require(i + 4 <= s.length) { "bad \\u escape" }
+                                b.append(s.substring(i, i + 4).toInt(16).toChar())
+                                i += 4
+                            }
+                            else -> throw IllegalArgumentException("bad escape \\$e")
+                        }
+                    }
+                    else -> b.append(c)
+                }
+            }
+        }
+
+        private fun num(): Long {
+            val start = i
+            if (i < s.length && s[i] == '-') i++
+            while (i < s.length && s[i].isDigit()) i++
+            require(i > start && (i < s.length && s[i] in ".eE").not()) { "only integers are supported, at $start" }
+            return s.substring(start, i).toLongOrNull() ?: throw IllegalArgumentException("bad number at $start")
+        }
+    }
+}
