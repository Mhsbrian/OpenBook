+package com.android.virtualization.terminal.openbook
+
+import java.nio.file.Files
+import java.nio.file.Path
+
+/**
+ * Installs OpenBook's image in four steps (docs/quire-setup.md §4.1): stage the download in [staging], verify all of
+ * it, extract checked names into `<install>.new`, then swap that in for [install]. A failure at any step leaves
+ * [install] as it was. A refused image ([ImageRefusedException]) is dropped from [staging], so it is never extracted
+ * or continued later; any other failure keeps the staged bytes for the next try.
+ *
+ * [cidata] adds the guest agent's files to the extracted folder (AOSP's handling, which needs Android), given the
+ * names the archive held.
+ */
+class OpenBookInstall(
+    private val manifest: ImageManifest,
+    private val staging: Path,
+    private val install: Path,
+    private val marker: String,
+    private val fetcher: Fetcher = HttpFetcher(),
+    private val usableSpace: (Path) -> Long = { Files.getFileStore(it).usableSpace },
+) {
+    fun run(
+        cidata: (Path, Set<String>) -> Unit,
+        listener: StagedDownload.Listener,
+        cancelled: () -> Boolean,
+    ) {
+        val download = StagedDownload(staging, manifest, fetcher, usableSpace)
+        val newDir = InstallCommit.staging(install)
+        try {
+            InstallCommit.recover(install, marker)
+            val installed = manifest.installedSize ?: (manifest.size * 4)
+            val archive = download.run(installed, listener, cancelled)
+            listener.phase("unpack", 0, installed)
+            try {
+                val names =
+                    SafeExtractor.extract(
+                        archive,
+                        newDir,
+                        manifest.installedSize?.let { it + StagedDownload.SPACE_MARGIN },
+                        { n -> listener.phase("unpack", n, installed) },
+                        cancelled,
+                    )
+                cidata(newDir, names)
+                InstallCommit.commit(newDir, install, marker)
+            } catch (e: Exception) {
+                SafeExtractor.deleteTree(newDir)
+                throw e
+            }
+            download.clear()
+        } catch (e: ImageRefusedException) {
+            download.clear()
+            throw e
+        }
+    }
+}
