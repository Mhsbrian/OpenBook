+ */
+package com.android.virtualization.terminal.openbook
+
+import java.io.ByteArrayInputStream
+import java.io.Closeable
+import java.io.FileInputStream
+import java.io.FileNotFoundException
+import java.io.FileOutputStream
+import java.io.IOException
+import java.io.InputStream
+import java.net.HttpURLConnection
+import java.net.URL
+import java.nio.file.Files
+import java.nio.file.Path
+import java.security.MessageDigest
+import java.util.concurrent.CancellationException
+
+/** One HTTP answer: its status, `Content-Range`, the validator (ETag or Last-Modified), and its body. */
+class FetchResponse(val code: Int, val contentRange: String?, val validator: String?, val body: InputStream) :
+    Closeable {
+    override fun close() = body.close()
+}
+
+fun interface Fetcher {
+    /** GET [url] from [offset] (a `Range` request when it is above 0), with `If-Range: validator` when given. */
+    fun open(url: String, offset: Long, validator: String?): FetchResponse
+}
+
+class HttpFetcher(private val connectMs: Int = 30_000, private val readMs: Int = 60_000) : Fetcher {
+    override fun open(url: String, offset: Long, validator: String?): FetchResponse {
+        val c = URL(url).openConnection() as HttpURLConnection
+        c.connectTimeout = connectMs
+        c.readTimeout = readMs
+        c.instanceFollowRedirects = true
+        c.setRequestProperty("Accept-Encoding", "identity")
+        if (offset > 0) {
+            c.setRequestProperty("Range", "bytes=$offset-")
+            validator?.let { c.setRequestProperty("If-Range", it) }
+        }
+        val code = c.responseCode
+        val body = if (code in 200..299) c.inputStream else (c.errorStream ?: ByteArrayInputStream(ByteArray(0)))
+        return FetchResponse(
+            code,
+            c.getHeaderField("Content-Range"),
+            c.getHeaderField("ETag") ?: c.getHeaderField("Last-Modified"),
+            object : InputStream() {
+                override fun read() = body.read()
+
+                override fun read(b: ByteArray, off: Int, len: Int) = body.read(b, off, len)
+
+                override fun close() {
+                    body.close()
+                    c.disconnect()
+                }
+            },
+        )
+    }
+}
+
+/**
+ * The image's download, staged in [dir] (the Terminal app's no-backup storage), never in the install folder:
+ * `images.tar.gz.part` and `staging.json`, which records the manifest it belongs to. A later start, after this process
+ * ended too, continues where the file ends: by a `Range` request, taken only on a 206 whose `Content-Range` starts
+ * there. A 200, any other range or a changed manifest starts over. [run] returns the archive only once all of it
+ * matches the pinned size and SHA-256; nothing is extracted before that.
+ */
+class StagedDownload(
+    private val dir: Path,
+    private val manifest: ImageManifest,
+    private val fetcher: Fetcher,
+    private val usableSpace: (Path) -> Long = { Files.getFileStore(it).usableSpace },
+) {
+    fun interface Listener {
+        fun phase(phase: String, bytes: Long, total: Long)
+    }
+
+    val part: Path = dir.resolve("images.tar.gz.part")
+    private val record: Path = dir.resolve("staging.json")
+
+    /** Bytes already staged for this manifest; 0 when nothing is, or what is belongs to another manifest. */
+    fun staged(): Long {
+        if (!Files.isRegularFile(part) || recorded() == null) return 0
+        val n = Files.size(part)
+        return if (n <= manifest.size) n else 0
+    }
+
+    /** The staged archive, verified. [installedNeed] is the space the extraction needs on the same storage. */
+    fun run(installedNeed: Long, listener: Listener, cancelled: () -> Boolean): Path {
+        Files.createDirectories(dir)
+        var offset = staged()
+        val validator = if (offset > 0) recorded()?.second else null
+        if (offset == 0L) reset()
+        val need = (manifest.size - offset) + installedNeed + SPACE_MARGIN
+        val have = usableSpace(dir)
+        if (have < need) throw IOException("No space left on device: the Linux environment needs $need bytes, $have free")
+
+        val digest = MessageDigest.getInstance("SHA-256")
+        if (offset > 0) {
+            // Hash what is already here, so the whole file is checked, not only the new bytes.
+            val staged = offset
+            listener.phase("verify", 0, staged)
+            FileInputStream(part.toFile()).use { input ->
+                pump(input, null, digest, staged, cancelled, exact = true) { n -> listener.phase("verify", n, staged) }
+            }
+        }
+        if (offset < manifest.size) {
+            var r = fetcher.open(manifest.url, offset, validator)
+            if (offset > 0 && !(r.code == 206 && rangeMatches(r.contentRange, offset, manifest.size))) {
+                when (r.code) {
+                    // The server sent the whole file (If-Range: it changed), or a range we didn't ask for: start over.
+                    200 -> {}
+                    206, 416 -> r = r.also { it.close() }.let { fetcher.open(manifest.url, 0, null) }
+                    else -> r.use { failed(it.code) }
+                }
+                offset = 0
+                digest.reset()
+                reset()
+            }
+            r.use { resp ->
+                val continuing = offset > 0
+                if (!continuing && !(resp.code == 200 || (resp.code == 206 && rangeMatches(resp.contentRange, 0, manifest.size)))) {
+                    failed(resp.code)
+                }
+                writeRecord(resp.validator)
+                val from = offset
+                FileOutputStream(part.toFile(), true).use { out ->
+                    pump(resp.body, out, digest, manifest.size - from, cancelled, exact = false) { n ->
+                        listener.phase("download", from + n, manifest.size)
+                    }
+                }
+            }
+        }
+        listener.phase("verify", manifest.size, manifest.size)
+        val got = Files.size(part)
+        if (got != manifest.size) throw IOException("the download ended early: $got of ${manifest.size} bytes")
+        val hex = digest.digest().joinToString("") { "%02x".format(it) }
+        if (hex != manifest.sha256) refuse("the image's SHA-256 is $hex, not the pinned ${manifest.sha256}")
+        return part
+    }
+
+    private fun failed(code: Int): Nothing {
+        if (code == 404 || code == 410) throw FileNotFoundException("the image is not at ${manifest.url} (HTTP $code)")
+        throw IOException("downloading the image: HTTP $code")
+    }
+
+    /** Removes the staged download and its record. */
+    fun clear() {
+        Files.deleteIfExists(part)
+        Files.deleteIfExists(record)
+    }
+
+    private fun refuse(why: String): Nothing {
+        clear()
+        throw ImageRefusedException(why)
+    }
+
+    private fun reset() {
+        Files.deleteIfExists(part)
+        writeRecord(null)
+    }
+
+    /** (url, validator) when the record belongs to this manifest. */
+    private fun recorded(): Pair<String, String?>? {
+        if (!Files.isRegularFile(record)) return null
+        val o =
+            try {
+                MiniJson.parse(String(Files.readAllBytes(record), Charsets.UTF_8)) as? Map<*, *>
+            } catch (e: Exception) {
+                null
+            } ?: return null
+        if (o["url"] != manifest.url || o["sha256"] != manifest.sha256 || o["size"] != manifest.size) return null
+        return manifest.url to (o["validator"] as? String)
+    }
+
+    private fun writeRecord(validator: String?) {
+        val tmp = dir.resolve("staging.json.tmp")
+        Files.write(
+            tmp,
+            MiniJson.write(
+                    mapOf(
+                        "url" to manifest.url,
+                        "sha256" to manifest.sha256,
+                        "size" to manifest.size,
+                        "validator" to validator,
+                    )
+                )
+                .toByteArray(Charsets.UTF_8),
+        )
+        Files.move(tmp, record, java.nio.file.StandardCopyOption.REPLACE_EXISTING,
+            java.nio.file.StandardCopyOption.ATOMIC_MOVE)
+    }
+
+    private fun pump(
+        input: InputStream,
+        out: java.io.OutputStream?,
+        digest: MessageDigest,
+        limit: Long,
+        cancelled: () -> Boolean,
+        exact: Boolean = true,
+        progress: (Long) -> Unit,
+    ) {
+        val buf = ByteArray(256 * 1024)
+        var n = 0L
+        var lastReport = 0L
+        while (true) {
+            if (cancelled()) throw CancellationException("the install was cancelled")
+            val want = if (exact) minOf(buf.size.toLong(), limit - n).toInt() else buf.size
+            if (exact && want <= 0) break
+            val r = input.read(buf, 0, want)
+            if (r < 0) break
+            if (!exact && n + r > limit) refuse("the download is larger than the pinned ${manifest.size} bytes")
+            digest.update(buf, 0, r)
+            out?.write(buf, 0, r)
+            n += r
+            if (n - lastReport >= REPORT_EVERY) {
+                lastReport = n
+                progress(n)
+            }
+        }
+        progress(n)
+    }
+
+    companion object {
+        /** Room left over after the download and the extraction. */
+        const val SPACE_MARGIN = 256L shl 20
+        private const val REPORT_EVERY = 1L shl 20
+
+        /** `bytes START-END/TOTAL` with START == [offset], END the last byte, and TOTAL [size] or `*`. */
+        fun rangeMatches(contentRange: String?, offset: Long, size: Long): Boolean {
+            val m = Regex("""^\s*bytes\s+(\d+)-(\d+)/(\d+|\*)\s*$""").find(contentRange ?: return false) ?: return false
+            val (start, end, total) = m.destructured
+            return start.toLongOrNull() == offset && end.toLongOrNull() == size - 1 && (total == "*" || total.toLongOrNull() == size)
+        }
+    }
+}
