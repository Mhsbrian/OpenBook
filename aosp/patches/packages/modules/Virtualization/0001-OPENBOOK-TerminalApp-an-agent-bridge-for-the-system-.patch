+package com.android.virtualization.terminal
+
+import android.content.ContentProvider
+import android.content.ContentValues
+import android.database.Cursor
+import android.net.Uri
+import android.os.Bundle
+import android.os.ParcelFileDescriptor
+import android.system.ErrnoException
+import android.system.Os
+import android.system.OsConstants
+import android.util.Log
+import com.android.system.virtualmachine.flags.Flags
+import com.android.virtualization.terminal.new2.core.VmController
+import com.android.virtualization.terminal.new2.core.VmState
+import java.io.FileDescriptor
+import java.io.FileInputStream
+import java.io.FileNotFoundException
+import java.io.FileOutputStream
+import java.util.concurrent.atomic.AtomicInteger
+import kotlin.concurrent.thread
+
+/**
+ * OpenBook: lets the system's agent host (Quire core) reach one service in the Linux environment
+ * while it runs: the guest's `quired serve` on vsock port 7690.
+ *
+ * Only a VM's owner can have a vsock to it, so this process asks virtmgr for the connection
+ * ([android.system.virtualmachine.VirtualMachine.connectVsock]) and relays it to one end of a
+ * socket pair; the caller gets the other end. Callers need [PERMISSION]
+ * (signature|privileged), and only the ports in [PORTS] are offered: ttyd and the guest agent stay
+ * private to this app.
+ *
+ * - `openFile(content://com.android.virtualization.terminal.agentbridge/vsock/7690, "rw")`
+ * - `call("status")` returns `state` (not_installed, stopped, starting, running, error) and,
+ *   for an error, `message`.
+ */
+class AgentBridgeProvider : ContentProvider() {
+    companion object {
+        private const val TAG = "AgentBridge"
+        const val AUTHORITY = "com.android.virtualization.terminal.agentbridge"
+        const val PERMISSION = "com.android.virtualization.terminal.permission.ACCESS_AGENT_BRIDGE"
+        val PORTS = setOf(7690L)
+        private val nextId = AtomicInteger()
+    }
+
+    override fun onCreate(): Boolean = true
+
+    private fun enforce() {
+        context!!.enforceCallingPermission(PERMISSION, "the Linux environment's agent bridge")
+    }
+
+    private fun state(): Pair<String, String?> {
+        if (!Flags.terminalNewuiJetpack()) return "error" to "the agent bridge needs the new Terminal UI"
+        if (!InstalledImage.getDefault(context!!).isInstalled()) return "not_installed" to null
+        return when (val s = VmController.vmState.value) {
+            is VmState.Running -> "running" to null
+            is VmState.Starting, is VmState.Rebooting -> "starting" to null
+            is VmState.Error -> "error" to (s.cause.message ?: s.cause.javaClass.simpleName)
+            else -> "stopped" to null
+        }
+    }
+
+    override fun call(method: String, arg: String?, extras: Bundle?): Bundle? {
+        enforce()
+        if (method != "status") throw IllegalArgumentException("unknown method $method")
+        val (state, message) = state()
+        return Bundle().apply {
+            putString("state", state)
+            message?.let { putString("message", it) }
+        }
+    }
+
+    override fun openFile(uri: Uri, mode: String): ParcelFileDescriptor {
+        enforce()
+        val seg = uri.pathSegments
+        val port = if (seg.size == 2 && seg[0] == "vsock") seg[1].toLongOrNull() else null
+        if (port == null || port !in PORTS) throw FileNotFoundException("not offered: ${uri.path}")
+        val (state, message) = state()
+        val vm = VmController.virtualMachine
+        if (state != "running" || vm == null) {
+            throw FileNotFoundException("the Linux environment is $state" + (message?.let { ": $it" } ?: ""))
+        }
+        val vsock =
+            try {
+                vm.connectVsock(port)
+            } catch (e: Exception) {
+                throw FileNotFoundException("no answer on vsock port $port: ${e.message}")
+            }
+        val pair = ParcelFileDescriptor.createSocketPair()
+        relay(nextId.incrementAndGet(), pair[0], vsock, callingPackage ?: "?", port)
+        return pair[1]
+    }
+
+    /** Copies both ways until both sides are done, passing on half-closes, then closes both. */
+    private fun relay(id: Int, caller: ParcelFileDescriptor, vm: ParcelFileDescriptor, who: String, port: Long) {
+        Log.i(TAG, "#$id: $who connected to vsock port $port")
+        val open = AtomicInteger(2)
+        val closeBoth = {
+            if (open.decrementAndGet() == 0) {
+                caller.close()
+                vm.close()
+                Log.i(TAG, "#$id: closed")
+            }
+        }
+        fun pipe(name: String, from: ParcelFileDescriptor, to: ParcelFileDescriptor) =
+            thread(name = "AgentBridge-$id-$name") {
+                val input = FileInputStream(from.fileDescriptor)
+                val output = FileOutputStream(to.fileDescriptor)
+                val buf = ByteArray(16 * 1024)
+                try {
+                    while (true) {
+                        val n = input.read(buf)
+                        if (n < 0) break
+                        output.write(buf, 0, n)
+                    }
+                    shutdownWrite(to.fileDescriptor)
+                } catch (e: Exception) {
+                    // One side failed: end the other direction too.
+                    Log.d(TAG, "#$id $name: ${e.message}")
+                    shutdownBoth(from.fileDescriptor)
+                    shutdownBoth(to.fileDescriptor)
+                } finally {
+                    closeBoth()
+                }
+            }
+        pipe("to-vm", caller, vm)
+        pipe("from-vm", vm, caller)
+    }
+
+    private fun shutdownWrite(fd: FileDescriptor) {
+        try {
+            Os.shutdown(fd, OsConstants.SHUT_WR)
+        } catch (_: ErrnoException) {}
+    }
+
+    private fun shutdownBoth(fd: FileDescriptor) {
+        try {
+            Os.shutdown(fd, OsConstants.SHUT_RDWR)
+        } catch (_: ErrnoException) {}
+    }
+
+    override fun query(u: Uri, p: Array<String>?, s: String?, a: Array<String>?, o: String?): Cursor? = null
+
+    override fun getType(uri: Uri): String? = null
+
+    override fun insert(uri: Uri, values: ContentValues?): Uri? = null
+
+    override fun delete(uri: Uri, s: String?, a: Array<String>?): Int = 0
+
+    override fun update(uri: Uri, v: ContentValues?, s: String?, a: Array<String>?): Int = 0
+}
