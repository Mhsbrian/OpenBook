index cdfaa9290..1f7932afa 100644
--- a/android/TerminalApp/java/com/android/virtualization/terminal/new2/core/VmController.kt
+++ b/android/TerminalApp/java/com/android/virtualization/terminal/new2/core/VmController.kt
@@ -493,7 +493,11 @@ object VmController {
     private val IS_EMULATOR: Boolean =
         {
             val deviceName = SystemProperties.get("ro.product.vendor.device", "")
-            val cuttlefish = deviceName.startsWith("vsoc_")
+            // OpenBook: Cuttlefish products not named vsoc_* (anybook_vsoc_x86_64) are found by
+            // the hypervisor version Cuttlefish's launcher sets ("cf-crosvm", "cf-qemu").
+            val cuttlefish =
+                deviceName.startsWith("vsoc_") ||
+                    SystemProperties.get("ro.boot.hypervisor.version", "").startsWith("cf-")
             val goldfish = deviceName.startsWith("emu64")
 
             cuttlefish || goldfish
