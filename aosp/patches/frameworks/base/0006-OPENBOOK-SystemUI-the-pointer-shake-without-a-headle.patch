 import com.google.common.truth.Truth.assertThat
+import org.junit.Assume.assumeFalse
+import org.junit.Assume.assumeTrue
 import org.junit.Before
 import org.junit.Rule
 import org.junit.Test
@@ -114,6 +117,8 @@ class ContextualCursorInteractorTest : SysuiTestCase() {
     @Test
     fun notInvoke_whenUserSignedOut() =
         kosmos.runTest {
+            // Only a headless system user device has users that can sign out (OPENBOOK).
+            assumeTrue(UserManager.isHeadlessSystemUserMode())
             setDeviceEntered()
             fakeUserRepository.setUserManagerLogoutEnabled(false)
 
@@ -121,6 +126,23 @@ class ContextualCursorInteractorTest : SysuiTestCase() {
             verify(launcherProxy, never()).invokeContextualSearch(any(), any())
         }
 
+    @Test
+    fun invoke_whenSystemUserCannotLogOut_withoutHeadlessSystemUser() =
+        kosmos.runTest {
+            // OPENBOOK: without a headless system user, the system user is the person's user and
+            // can never log out; the shake still works once set up and past the lock screen.
+            assumeFalse(UserManager.isHeadlessSystemUserMode())
+            setDeviceEntered()
+            fakeUserRepository.setUserManagerLogoutEnabled(false)
+
+            simulateShake()
+            verify(launcherProxy)
+                .invokeContextualSearch(
+                    eq(ContextualSearchManager.ENTRYPOINT_SYSTEM_ACTION),
+                    eq(null),
+                )
+        }
+
     @Test
     fun invoke_whenAllActivated() =
         kosmos.runTest {
