+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.am;
+
+import android.content.pm.ServiceInfo;
+
+import java.util.Objects;
+
+/** Narrow compatibility rule for Chromium's declared managed renderer services. */
+final class NativeBridgeServiceFallback {
+    private NativeBridgeServiceFallback() {}
+
+    static String targetClass(String sourceClass) {
+        // Do not infer arbitrary fallbacks by removing "Native" from a class name.
+        if (sourceClass == null) return null;
+        switch (sourceClass) {
+            case "org.chromium.content.app.NativeOnlySandboxedProcessService0":
+                return "org.chromium.content.app.SandboxedProcessService0";
+            case "org.chromium.content.app.NativeOnlySandboxedProcessService1":
+                return "org.chromium.content.app.SandboxedProcessService1";
+            default:
+                return null;
+        }
+    }
+
+    static boolean compatible(ServiceInfo source, ServiceInfo target) {
+        if (source == null || target == null) return false;
+        final String expected = targetClass(source.name);
+        if (expected == null) return false;
+        final int nativeIsolated = ServiceInfo.FLAG_NATIVE_SERVICE | ServiceInfo.FLAG_ISOLATED_PROCESS;
+        return (source.flags & nativeIsolated) == nativeIsolated
+                && expected.equals(target.name)
+                && source.applicationInfo != null && target.applicationInfo != null
+                && Objects.equals(source.packageName, target.packageName)
+                && Objects.equals(source.applicationInfo.packageName, target.applicationInfo.packageName)
+                && source.applicationInfo.uid == target.applicationInfo.uid
+                && Objects.equals(source.applicationInfo.primaryCpuAbi, target.applicationInfo.primaryCpuAbi)
+                && Objects.equals(source.processName, target.processName)
+                && Objects.equals(source.permission, target.permission)
+                && source.exported == target.exported
+                && source.directBootAware == target.directBootAware
+                && source.enabled && target.enabled
+                && source.applicationInfo.enabled && target.applicationInfo.enabled
+                && (source.flags & ~ServiceInfo.FLAG_NATIVE_SERVICE) == target.flags;
+    }
+}
