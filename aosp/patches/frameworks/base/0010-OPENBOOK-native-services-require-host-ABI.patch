From: B <Bhoneycutt153@gmail.com>
Date: Mon, 19 Oct 2026 17:00:00 +0000
Subject: [PATCH] OPENBOOK: reject untranslated native services before queuing starts

zygote_next cannot load guest-ISA libraries. Return a failed service lookup
so callers can immediately select a managed NativeBridge-compatible service.
Also reject direct native-zygote requests before starting or connecting.
Do not remove ARM64 from the supported application ABIs.

diff --git a/core/java/android/os/NativeZygoteProcess.java b/core/java/android/os/NativeZygoteProcess.java
--- a/core/java/android/os/NativeZygoteProcess.java
+++ b/core/java/android/os/NativeZygoteProcess.java
@@ -27,6 +27,8 @@
 
 import com.android.internal.os.Zygote;
 
+import dalvik.system.VMRuntime;
+
 import java.io.FileDescriptor;
 import java.io.IOException;
 import java.util.Map;
@@ -54,6 +56,23 @@
 
     public NativeZygoteProcess(LocalSocketAddress socketAddress) {
         mSocketAddress = socketAddress;
+    }
+
+    /**
+     * Whether zygote_next can load this ABI. Unlike the managed zygote it has no
+     * NativeBridge runtime: a guest ABI in SUPPORTED_ABIS is not enough.
+     * @hide
+     */
+    public static boolean isAbiSupported(@Nullable String abi) {
+        final String libraryIsa = VMRuntime.getInstructionSet(
+                abi != null ? abi : Build.SUPPORTED_ABIS[0]);
+        return libraryIsa.equals(VMRuntime.getCurrentInstructionSet());
+    }
+
+    private static void requireSupportedAbi(String abi) {
+        if (!isAbiSupported(abi)) {
+            throw new IllegalArgumentException("Native zygote cannot translate ABI " + abi);
+        }
     }
 
     private static native void nativePrewarmNativeZygote();
@@ -119,6 +138,7 @@
                                                   boolean bindOverrideSysprops,
                                                   long startSeq,
                                                   @Nullable String[] zygoteArgs) {
+        requireSupportedAbi(abi);
         int pid;
         try {
             connectToZygote();
@@ -149,6 +169,7 @@
                                                int uidRangeStart,
                                                int uidRangeEnd,
                                                ApplicationInfo appInfo) {
+        requireSupportedAbi(abi);
         // Create an unguessable address in the global abstract namespace.
         String serverAddress = processClass + "/" + UUID.randomUUID().toString();
         // The address of abstract socket should be prefixed with '@'.  LocalSocket.connect()
diff --git a/services/core/java/com/android/server/am/ActiveServices.java b/services/core/java/com/android/server/am/ActiveServices.java
--- a/services/core/java/com/android/server/am/ActiveServices.java
+++ b/services/core/java/com/android/server/am/ActiveServices.java
@@ -208,6 +208,7 @@
 import android.os.IBinder;
 import android.os.Looper;
 import android.os.Message;
+import android.os.NativeZygoteProcess;
 import android.os.PowerExemptionManager;
 import android.os.PowerExemptionManager.ReasonCode;
 import android.os.Process;
@@ -5240,6 +5241,11 @@
                           ": not found");
                     return null;
                 }
+                // Check before constructing/inserting a ServiceRecord: failed binds must
+                // not accumulate records or prewarm a zygote that cannot load the library.
+                if (!isNativeServiceAbiSupported(sInfo)) {
+                    return null;
+                }
                 if (instanceName != null
                         && (sInfo.flags & ServiceInfo.FLAG_ISOLATED_PROCESS) == 0
                         && !isSdkSandboxService) {
@@ -5475,10 +5481,31 @@
                 }
             }
 
+            // Return an ordinary failed lookup before binding or queueing a process start.
+            // Apps such as Chromium can then bind their managed-service fallback, whose
+            // JNI libraries use NativeBridge. Do not try to instantiate a native-only
+            // service as a Java Service: it need not contain that class.
+            if (!isNativeServiceAbiSupported(r.serviceInfo)) {
+                return null;
+            }
+
             r.appInfo.seInfo += generateAdditionalSeInfoFromService(service, r);
             return new ServiceLookupResult(r, resolution.getAlias());
         }
         return null;
+    }
+
+    private static boolean isNativeServiceAbiSupported(ServiceInfo serviceInfo) {
+        final int nativeIsolated = ServiceInfo.FLAG_NATIVE_SERVICE
+                | ServiceInfo.FLAG_ISOLATED_PROCESS;
+        if (android.os.Flags.nativeFrameworkPrototype()
+                && (serviceInfo.flags & nativeIsolated) == nativeIsolated
+                && !NativeZygoteProcess.isAbiSupported(serviceInfo.applicationInfo.primaryCpuAbi)) {
+            Slog.w(TAG_SERVICE, "Native-only service unavailable for ABI "
+                    + serviceInfo.applicationInfo.primaryCpuAbi + ": " + serviceInfo.name);
+            return false;
+        }
+        return true;
     }
 
     private int getAllowMode(Intent service, @Nullable String callingPackage) {
