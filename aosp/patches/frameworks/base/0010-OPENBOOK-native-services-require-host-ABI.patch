+
+    /** Use the existing component-alias contract, including the original name in callbacks. */
+    private ComponentName resolveNativeBridgeServiceFallback(Intent service, String resolvedType,
+            int userId, int callingUid, int callingPid, boolean allowInstant,
+            boolean matchQuarantined) {
+        final ComponentName original = service.getComponent();
+        if (original == null || !android.os.Flags.nativeFrameworkPrototype()) return null;
+        final String targetClass = NativeBridgeServiceFallback.targetClass(original.getClassName());
+        if (targetClass == null) return null;
+        long flags = ActivityManagerService.STOCK_PM_FLAGS | PackageManager.MATCH_DEBUG_TRIAGED_MISSING;
+        if (allowInstant) flags |= PackageManager.MATCH_INSTANT;
+        if (matchQuarantined) flags |= PackageManager.MATCH_QUARANTINED_COMPONENTS;
+        final ResolveInfo source = mAm.getPackageManagerInternal().resolveService(service,
+                resolvedType, flags, userId, callingUid, callingPid);
+        if (source == null || source.serviceInfo == null
+                || NativeZygoteProcess.isAbiSupported(source.serviceInfo.applicationInfo.primaryCpuAbi)) {
+            return null;
+        }
+        final Intent candidate = new Intent(service).setComponent(
+                new ComponentName(original.getPackageName(), targetClass));
+        final ResolveInfo target = mAm.getPackageManagerInternal().resolveService(candidate,
+                resolvedType, flags, userId, callingUid, callingPid);
+        if (target == null || !NativeBridgeServiceFallback.compatible(source.serviceInfo,
+                target.serviceInfo)) {
+            return null;
+        }
+        // Both declarations have identical access and sandbox requirements. The normal
+        // service lookup below still enforces permissions, visibility, user and app-op policy.
+        service.setOriginalIntent(new Intent(service));
+        service.setComponent(candidate.getComponent());
+        Slog.i(TAG_SERVICE, "Native bridge service fallback: " + original.flattenToShortString()
+                + " -> " + targetClass);
+        return original;
+    }
+
+    private static boolean isNativeServiceAbiSupported(ServiceInfo serviceInfo) {
+        final int nativeIsolated = ServiceInfo.FLAG_NATIVE_SERVICE
+                | ServiceInfo.FLAG_ISOLATED_PROCESS;
+        if (android.os.Flags.nativeFrameworkPrototype()
+                && (serviceInfo.flags & nativeIsolated) == nativeIsolated
+                && !NativeZygoteProcess.isAbiSupported(serviceInfo.applicationInfo.primaryCpuAbi)) {
+            Slog.w(TAG_SERVICE, "Native-only service unavailable for ABI "
+                    + serviceInfo.applicationInfo.primaryCpuAbi + ": " + serviceInfo.name);
+            return false;
+        }
+        return true;
     }
 
     private int getAllowMode(Intent service, @Nullable String callingPackage) {
diff --git a/services/core/java/com/android/server/am/NativeBridgeServiceFallback.java b/services/core/java/com/android/server/am/NativeBridgeServiceFallback.java
new file mode 100644
--- /dev/null
+++ b/services/core/java/com/android/server/am/NativeBridgeServiceFallback.java
@@ -0,0 +1,48 @@
+/*
