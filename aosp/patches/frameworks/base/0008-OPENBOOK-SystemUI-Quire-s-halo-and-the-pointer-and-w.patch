+package com.android.systemui.contextualcursor
+
+import android.app.ActivityTaskManager
+import android.app.WindowConfiguration
+import android.app.contextualsearch.ContextualSearchConfig
+import android.content.Context
+import android.content.pm.PackageManager
+import android.graphics.Rect
+import android.os.Bundle
+import android.os.SystemClock
+import android.util.Log
+import com.android.systemui.contextualcursor.ui.QuireHalo
+import com.android.systemui.cursorposition.data.model.CursorPosition
+
+/**
+ * OPENBOOK: where the pointer is when Quire is called, and the window under it (OpenBook's docs/quire-design.md §2).
+ * SystemUI already follows the pointer for the shake; it hands the contextual search app the pointer's position in the
+ * launch extras and the window's bounds as `sourceBounds`, so Quire's note opens at the pointer and takes in that window.
+ * Meta+Space and the assist key use the same position when the pointer moved in the last 10 s (§2: "the 10 s rule").
+ * With the bounds go the window's package, so Quire names the window it crops to (not the topmost visible app), and the
+ * time they were read, so Quire can refuse bounds that are too old to match the screenshot. Without a recent pointer, or
+ * over the desktop, SystemUI sends no bounds and Quire takes in nothing.
+ */
+object QuirePointer {
+    private const val TAG = "QuirePointer"
+
+    /** The keys Quire reads (dev.openbook.quire's Quire.EXTRA_POINTER_X/Y). */
+    const val EXTRA_POINTER_X = "dev.openbook.quire.extra.POINTER_X"
+    const val EXTRA_POINTER_Y = "dev.openbook.quire.extra.POINTER_Y"
+
+    /** The window's bounds, for the assistant session to pass on as `sourceBounds`. */
+    const val EXTRA_SOURCE_BOUNDS = "dev.openbook.quire.extra.SOURCE_BOUNDS"
+
+    /** The package of the window in the bounds, and when the bounds were read (elapsedRealtime, ms). */
+    const val EXTRA_SOURCE_PACKAGE = "dev.openbook.quire.extra.SOURCE_PACKAGE"
+    const val EXTRA_SOURCE_TIME = "dev.openbook.quire.extra.SOURCE_TIME"
+
+    /** How long a pointer stays "where the person is looking" for the keys. */
+    const val RECENT_MS = 10_000L
+
+    @Volatile private var last: CursorPosition? = null
+    @Volatile private var lastAt = 0L
+
+    /** Set by ContextualCursorInteractor, so the assistant path can show the same halo. */
+    @Volatile var halo: QuireHalo? = null
+
+    /** Called by the shake detector for every pointer position. */
+    fun moved(position: CursorPosition) {
+        last = position
+        lastAt = SystemClock.uptimeMillis()
+    }
+
+    /** The last position, when the pointer moved within [windowMs]. */
+    fun recent(windowMs: Long = RECENT_MS): CursorPosition? {
+        val p = last ?: return null
+        return if (SystemClock.uptimeMillis() - lastAt <= windowMs) p else null
+    }
+
+    fun current(): CursorPosition? = last
+
+    /**
+     * The bounds and package of the topmost visible app task under [p], or null over the desktop: the home task spans
+     * the display beneath every window, so it is never "the window under the pointer".
+     */
+    fun taskAt(p: CursorPosition): Pair<Rect, String?>? =
+        try {
+            ActivityTaskManager.getInstance()
+                .getTasks(MAX_TASKS, false, false, p.displayId)
+                .firstOrNull { t ->
+                    val mode = t.configuration.windowConfiguration.windowingMode
+                    t.isVisible &&
+                        t.configuration.windowConfiguration.activityType ==
+                            WindowConfiguration.ACTIVITY_TYPE_STANDARD &&
+                        t.displayId == p.displayId &&
+                        (mode == WindowConfiguration.WINDOWING_MODE_FREEFORM ||
+                            mode == WindowConfiguration.WINDOWING_MODE_FULLSCREEN ||
+                            mode == WindowConfiguration.WINDOWING_MODE_MULTI_WINDOW) &&
+                        t.configuration.windowConfiguration.bounds.contains(p.x.toInt(), p.y.toInt())
+                }
+                ?.let {
+                    Rect(it.configuration.windowConfiguration.bounds) to
+                        (it.topActivity ?: it.baseActivity)?.packageName
+                }
+                ?.takeIf { it.second != null }
+        } catch (e: RuntimeException) {
+            Log.w(TAG, "no task list", e)
+            null
+        }
+
+    /**
+     * The contextual search config for a call at [p]: its display, the pointer, and the window under it (bounds,
+     * package, when they were read), or no window at all over the desktop.
+     */
+    fun config(p: CursorPosition, target: Pair<Rect, String?>?): ContextualSearchConfig =
+        ContextualSearchConfig.Builder()
+            .setDisplayId(p.displayId)
+            .setSourceBounds(target?.first)
+            .setIntentExtras(
+                Bundle().apply {
+                    putFloat(EXTRA_POINTER_X, p.x)
+                    putFloat(EXTRA_POINTER_Y, p.y)
+                    putSource(this, target)
+                }
+            )
+            .build()
+
+    private fun putSource(b: Bundle, target: Pair<Rect, String?>?) {
+        target ?: return
+        b.putString(EXTRA_SOURCE_PACKAGE, target.second)
+        b.putLong(EXTRA_SOURCE_TIME, SystemClock.elapsedRealtime())
+    }
+
+    /** Puts the pointer and the window's bounds into the assistant's args, when the pointer moved recently. */
+    fun addTo(context: Context, args: Bundle, label: String) {
+        val p = recent() ?: return
+        val target = taskAt(p)
+        args.putFloat(EXTRA_POINTER_X, p.x)
+        args.putFloat(EXTRA_POINTER_Y, p.y)
+        target?.let { args.putParcelable(EXTRA_SOURCE_BOUNDS, it.first) }
+        putSource(args, target)
+        halo?.show(p.displayId, p.x, p.y, target?.first, label, appName(context, target?.second))
+    }
+
+    fun appName(context: Context, pkg: String?): String? {
+        pkg ?: return null
+        return try {
+            val pm = context.packageManager
+            pm.getApplicationLabel(pm.getApplicationInfo(pkg, 0)).toString()
+        } catch (e: PackageManager.NameNotFoundException) {
+            null
+        }
+    }
+
+    private const val MAX_TASKS = 20
+}
