+import kotlin.math.min
+import kotlin.math.sqrt
+
+/**
+ * OPENBOOK: the first 100 ms of calling Quire (OpenBook's docs/quire-design.md §2, §4.4, §5.2): a halo blooms around
+ * the pointer's hotspot, the window under it gets the intake outline, and a label names what was done ("Ask Quire",
+ * or the shortcut). Drawn by SystemUI above every window, so it answers even when the app under the pointer is slow;
+ * it takes no touch and no focus. The note itself is Quire's window; the halo fades out once it has opened.
+ *
+ * Motion: the halo scales 0 → 1 with spring.tick (stiffness 1400, damping 0.7); the outline and the label fade in over
+ * 120 ms; the label fades out at 150 ms; everything fades out over 200 ms from 390 ms. With Remove animations the halo
+ * appears at full size and everything cuts (§5.3).
+ */
+@SysUISingleton
+class QuireHalo
+@Inject
+constructor(@Application private val context: Context, @Main private val handler: Handler) {
+    private var window: HaloView? = null
+    private var windowManager: WindowManager? = null
+
+    /** Shows the halo at ([x], [y]) on [displayId], with the outline around [bounds] when known. Any thread. */
+    fun show(displayId: Int, x: Float, y: Float, bounds: Rect?, label: String, appName: String?) {
+        handler.post { showOnMain(displayId, x, y, bounds, label, appName) }
+    }
+
+    private fun showOnMain(displayId: Int, x: Float, y: Float, bounds: Rect?, label: String, appName: String?) {
+        remove()
+        val display = context.getSystemService(DisplayManager::class.java).getDisplay(displayId) ?: return
+        val windowContext =
+            context.createDisplayContext(display)
+                .createWindowContext(WindowManager.LayoutParams.TYPE_SECURE_SYSTEM_OVERLAY, null)
+        val wm = windowContext.getSystemService(WindowManager::class.java)
+        val view = HaloView(windowContext, x, y, bounds, label)
+        view.contentDescription =
+            if (appName != null) "Quire. Pointing at $appName." else "Quire."
+        view.accessibilityLiveRegion = View.ACCESSIBILITY_LIVE_REGION_POLITE
+        val lp =
+            WindowManager.LayoutParams(
+                    WindowManager.LayoutParams.MATCH_PARENT,
+                    WindowManager.LayoutParams.MATCH_PARENT,
+                    WindowManager.LayoutParams.TYPE_SECURE_SYSTEM_OVERLAY,
+                    WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+                        WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE or
+                        WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
+                        WindowManager.LayoutParams.FLAG_HARDWARE_ACCELERATED,
+                    PixelFormat.TRANSLUCENT,
+                )
+                .apply {
+                    title = "QuireHalo"
+                    setTrustedOverlay()
+                    layoutInDisplayCutoutMode =
+                        WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS
+                    fitInsetsTypes = 0
+                    windowAnimations = 0
+                }
+        try {
+            wm.addView(view, lp)
+        } catch (e: RuntimeException) {
+            Log.w(TAG, "could not show the halo", e)
+            return
+        }
+        window = view
+        windowManager = wm
+        view.start { remove() }
+    }
+
+    private fun remove() {
+        val v = window ?: return
+        window = null
+        try {
+            windowManager?.removeView(v)
+        } catch (e: RuntimeException) {
+            // Already gone.
+        }
+    }
+
+    private class HaloView(
+        context: Context,
+        private val cx: Float,
+        private val cy: Float,
+        private val bounds: Rect?,
+        private val label: String,
+    ) : View(context), Choreographer.FrameCallback {
+        private val density = resources.displayMetrics.density
+        private val dark =
+            resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK ==
+                Configuration.UI_MODE_NIGHT_YES
+        private val primary =
+            context.getColor(
+                if (dark) android.R.color.system_primary_dark
+                else android.R.color.system_primary_light
+            )
+        private val inverseSurface =
+            context.getColor(
+                if (dark) android.R.color.system_inverse_surface_dark
+                else android.R.color.system_inverse_surface_light
+            )
+        private val inverseOnSurface =
+            context.getColor(
+                if (dark) android.R.color.system_inverse_on_surface_dark
+                else android.R.color.system_inverse_on_surface_light
+            )
+        private val animate = ValueAnimator.areAnimatorsEnabled()
+
+        // The halo: a 32 dp ring with a 2 dp conic stroke through the brand colours (§4.4).
+        private val ring =
+            Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                style = Paint.Style.STROKE
+                strokeWidth = 2f * density
+                shader =
+                    SweepGradient(
+                            0f,
+                            0f,
+                            intArrayOf(BRAND_A, HALO_C, FOLD_B, FOLD_A, BRAND_A),
+                            null,
+                        )
+                        .also { it.setLocalMatrix(Matrix().apply { setRotate(210f - 90f) }) }
+            }
+        // The intake outline: 2 dp of primary at 55 %, 2 dp off the window, over a 10 dp glow at 18 % (§2 rules).
+        private val outline =
+            Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                style = Paint.Style.STROKE
+                strokeWidth = 2f * density
+                color = withAlpha(primary, 0.55f)
+            }
+        private val glow =
+            Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                style = Paint.Style.STROKE
+                strokeWidth = 10f * density
+                color = withAlpha(primary, 0.18f)
+            }
+        private val pill = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = inverseSurface }
+        private val text =
+            Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                color = inverseOnSurface
+                textSize = 12.5f * density
+                typeface = Typeface.create(Typeface.create("google-sans-text", Typeface.NORMAL), 500, false)
+            }
+        private val leafBody =
+            PathParser.createPathFromPathData(
+                "M7.5 3H14l6 6v8.5A3.5 3.5 0 0 1 16.5 21h-9A3.5 3.5 0 0 1 4 17.5v-11A3.5 3.5 0 0 1 7.5 3Z"
+            )
+        private val leafFold = PathParser.createPathFromPathData("M14 3v4.5A1.5 1.5 0 0 0 15.5 9H20Z")
+        private val leafBodyPaint =
+            Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                shader = LinearGradient(4f, 3f, 20f, 21f, BRAND_A, BRAND_B, Shader.TileMode.CLAMP)
+            }
+        private val leafFoldPaint =
+            Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                shader = LinearGradient(14f, 3f, 20f, 9f, FOLD_A, FOLD_B, Shader.TileMode.CLAMP)
+            }
+
+        private var scale = if (animate) 0f else 1f
+        private var velocity = 0f
+        private var lastFrame = 0L
+        private var labelAlpha = if (animate) 0f else 1f
+        private var allAlpha = 1f
+        private var start = 0L
+        private var onDone: (() -> Unit)? = null
+
+        fun start(done: () -> Unit) {
+            onDone = done
+            start = System.nanoTime()
+            Choreographer.getInstance().postFrameCallback(this)
+        }
+
+        override fun onDetachedFromWindow() {
+            Choreographer.getInstance().removeFrameCallback(this)
+            super.onDetachedFromWindow()
+        }
+
+        override fun doFrame(frameTimeNanos: Long) {
+            val t = (frameTimeNanos - start) / 1_000_000f
+            if (animate) {
+                // spring.tick, mass 1, integrated in 4 ms substeps like Quire's own springs.
+                val dt = if (lastFrame == 0L) 0f else min(0.064f, (frameTimeNanos - lastFrame) / 1e9f)
+                lastFrame = frameTimeNanos
+                val k = 1400f
+                val c = 2f * 0.7f * sqrt(k)
+                val steps = ceil(dt / 0.004f).toInt().coerceAtLeast(1)
+                val h = dt / steps
+                repeat(steps) {
+                    val a = -k * (scale - 1f) - c * velocity
+                    velocity += a * h
+                    scale += velocity * h
+                }
+                if (abs(scale - 1f) < 0.002f && abs(velocity) < 0.02f) scale = 1f
+                labelAlpha =
+                    when {
+                        t < 120f -> t / 120f
+                        t < 150f -> 1f
+                        else -> (1f - (t - 150f) / 120f).coerceAtLeast(0f)
+                    }
+                allAlpha = if (t < 390f) 1f else (1f - (t - 390f) / 200f).coerceAtLeast(0f)
+            } else {
+                // Remove animations: everything at rest, then gone in one frame (§5.3).
+                labelAlpha = if (t < 270f) 1f else 0f
+                allAlpha = if (t < 590f) 1f else 0f
+            }
+            invalidate()
+            if (t >= 600f) {
+                onDone?.invoke()
+                onDone = null
+                return
+            }
+            Choreographer.getInstance().postFrameCallback(this)
+        }
+
+        override fun onDraw(canvas: Canvas) {
+            val a = allAlpha
+            if (bounds != null && a > 0f) {
+                val r = 20f * density
+                val g = RectF(bounds).apply { inset(-5f * density, -5f * density) }
+                glow.alpha = (Color.alpha(withAlpha(primary, 0.18f)) * a * (if (animate) min(1f, labelFade()) else 1f)).toInt()
+                canvas.drawRoundRect(g, r + 5f * density, r + 5f * density, glow)
+                val o = RectF(bounds).apply { inset(-3f * density, -3f * density) }
+                outline.alpha = (Color.alpha(withAlpha(primary, 0.55f)) * a * (if (animate) min(1f, labelFade()) else 1f)).toInt()
+                canvas.drawRoundRect(o, r + 3f * density, r + 3f * density, outline)
+            }
+            // The ring around the hotspot (the arrow's tip is 4 dp right and 3 dp below the hotspot in the
+            // prototype's drawing; the halo centres there).
+            val hx = cx + 4f * density
+            val hy = cy + 3f * density
+            canvas.save()
+            canvas.translate(hx, hy)
+            canvas.scale(scale, scale)
+            ring.alpha = (255 * a).toInt()
+            canvas.drawCircle(0f, 0f, 15f * density, ring)
+            canvas.restore()
+            val la = labelAlpha * a
+            if (la > 0f) {
+                val left = cx + 28f * density
+                val top = cy - 6f * density
+                val leaf = 14f * density
+                val w = 8f * density + leaf + 6f * density + text.measureText(label) + 12f * density
+                val h = 28f * density
+                pill.alpha = (255 * la).toInt()
+                canvas.drawRoundRect(left, top, left + w, top + h, h / 2, h / 2, pill)
+                canvas.save()
+                canvas.translate(left + 8f * density, top + (h - leaf) / 2)
+                canvas.scale(leaf / 24f, leaf / 24f)
+                leafBodyPaint.alpha = (255 * la).toInt()
+                leafFoldPaint.alpha = (255 * la).toInt()
+                canvas.drawPath(leafBody, leafBodyPaint)
+                canvas.drawPath(leafFold, leafFoldPaint)
+                canvas.restore()
+                text.alpha = (255 * la).toInt()
+                val fm = text.fontMetrics
+                canvas.drawText(
+                    label,
+                    left + 8f * density + leaf + 6f * density,
+                    top + h / 2 - (fm.ascent + fm.descent) / 2,
+                    text,
+                )
+            }
+        }
+
+        /** The outline fades in over the first 120 ms. */
+        private fun labelFade(): Float = ((System.nanoTime() - start) / 1_000_000f / 120f)
+    }
+
+    companion object {
+        private const val TAG = "QuireHalo"
+        private const val BRAND_A = 0xFF7E8CFF.toInt()
+        private const val BRAND_B = 0xFF4355B9.toInt()
+        private const val HALO_C = 0xFFD08BFF.toInt()
+        private const val FOLD_A = 0xFFFFB38A.toInt()
+        private const val FOLD_B = 0xFFFF7A9C.toInt()
+
+        private fun withAlpha(color: Int, alpha: Float) =
+            Color.argb(
+                (alpha * 255).toInt(),
+                Color.red(color),
+                Color.green(color),
+                Color.blue(color),
+            )
+    }
