From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "AnyBook aosp-patches.sh" <noreply@anybook.invalid>
Date: Sat, 17 Oct 2026 22:20:00 -0400
Subject: [PATCH] OPENBOOK: fonts.xml: metric-compatible document fonts for
 WebView

WebView and Chrome render system fonts through Skia's SkFontMgr_Android,
which parses only /system/etc/fonts.xml, with font paths relative to
/system/fonts (Chromium 145 leaves the NDK font API, UseAndroidNDKFontAPI,
off). It never reads /product/etc/fonts_customization.xml, so the
document fonts OpenBook installs in /product/fonts reach the framework
but not web pages.

Declare them here too, as ../../product/fonts/<file>: Arimo, Tinos,
Cousine, Gelasio, Comic Relief, Archivo Black and Archivo Narrow. Point
arial, times new roman, courier new and georgia at them instead of
sans-serif, serif and serif-monospace, and add comic sans ms. Skia knows
a font only by the names this file gives it, so the families whose own
name has a space also get it (comic relief, archivo black, archivo
narrow). Skia keeps the first family a name maps to, so the old
aliases are removed rather than overridden. The framework itself reads
font_fallback.xml, not this file, so its fonts are unchanged; on a
product without the files Skia drops the empty families and these names
fall back to the default font.

Generated by OpenBook scripts/ui/fonts-customization.py --legacy-fonts-xml.
---
 data/fonts/fonts.xml | 114 +++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 110 insertions(+), 4 deletions(-)

diff --git a/data/fonts/fonts.xml b/data/fonts/fonts.xml
index 8cbc300..aed5b76 100644
--- a/data/fonts/fonts.xml
+++ b/data/fonts/fonts.xml
@@ -134,7 +134,6 @@
     <alias name="sans-serif-light" to="sans-serif" weight="300" />
     <alias name="sans-serif-medium" to="sans-serif" weight="500" />
     <alias name="sans-serif-black" to="sans-serif" weight="900" />
-    <alias name="arial" to="sans-serif" />
     <alias name="helvetica" to="sans-serif" />
     <alias name="tahoma" to="sans-serif" />
     <alias name="verdana" to="sans-serif" />
@@ -242,9 +241,7 @@
     </family>
     <alias name="serif-bold" to="serif" weight="700" />
     <alias name="times" to="serif" />
-    <alias name="times new roman" to="serif" />
     <alias name="palatino" to="serif" />
-    <alias name="georgia" to="serif" />
     <alias name="baskerville" to="serif" />
     <alias name="goudy" to="serif" />
     <alias name="fantasy" to="serif" />
@@ -260,7 +257,6 @@
         <font weight="400" style="normal" postScriptName="CutiveMono-Regular">CutiveMono.ttf</font>
     </family>
     <alias name="courier" to="serif-monospace" />
-    <alias name="courier new" to="serif-monospace" />
 
     <family name="casual">
         <font weight="400" style="normal" postScriptName="ComingSoon-Regular">ComingSoon.ttf</font>
@@ -289,6 +285,116 @@
     </family>
     <alias name="source-sans-pro-semi-bold" to="source-sans-pro" weight="600"/>
 
+    <!-- OpenBook: metric-compatible document fonts (scripts/ui/fonts-customization.py). They are in
+         /product/fonts; paths here are relative to /system/fonts. The framework reads the same families
+         and aliases from /product/etc/fonts_customization.xml; this file is for apps that parse it
+         (WebView and Chrome). -->
+    <family name="arimo">
+        <font weight="400" style="normal">../../product/fonts/Arimo-VF.ttf
+          <axis tag="wght" stylevalue="400" />
+        </font>
+        <font weight="500" style="normal">../../product/fonts/Arimo-VF.ttf
+          <axis tag="wght" stylevalue="500" />
+        </font>
+        <font weight="600" style="normal">../../product/fonts/Arimo-VF.ttf
+          <axis tag="wght" stylevalue="600" />
+        </font>
+        <font weight="700" style="normal">../../product/fonts/Arimo-VF.ttf
+          <axis tag="wght" stylevalue="700" />
+        </font>
+        <font weight="400" style="italic">../../product/fonts/Arimo-Italic-VF.ttf
+          <axis tag="wght" stylevalue="400" />
+        </font>
+        <font weight="500" style="italic">../../product/fonts/Arimo-Italic-VF.ttf
+          <axis tag="wght" stylevalue="500" />
+        </font>
+        <font weight="600" style="italic">../../product/fonts/Arimo-Italic-VF.ttf
+          <axis tag="wght" stylevalue="600" />
+        </font>
+        <font weight="700" style="italic">../../product/fonts/Arimo-Italic-VF.ttf
+          <axis tag="wght" stylevalue="700" />
+        </font>
+    </family>
+    <alias name="arial" to="arimo" />
+    <family name="tinos">
+        <font weight="400" style="normal">../../product/fonts/Tinos-Regular.ttf</font>
+        <font weight="700" style="normal">../../product/fonts/Tinos-Bold.ttf</font>
+        <font weight="400" style="italic">../../product/fonts/Tinos-Italic.ttf</font>
+        <font weight="700" style="italic">../../product/fonts/Tinos-BoldItalic.ttf</font>
+    </family>
+    <alias name="times new roman" to="tinos" />
+    <family name="cousine">
+        <font weight="400" style="normal">../../product/fonts/Cousine-Regular.ttf</font>
+        <font weight="700" style="normal">../../product/fonts/Cousine-Bold.ttf</font>
+        <font weight="400" style="italic">../../product/fonts/Cousine-Italic.ttf</font>
+        <font weight="700" style="italic">../../product/fonts/Cousine-BoldItalic.ttf</font>
+    </family>
+    <alias name="courier new" to="cousine" />
+    <family name="gelasio">
+        <font weight="400" style="normal">../../product/fonts/Gelasio-VF.ttf
+          <axis tag="wght" stylevalue="400" />
+        </font>
+        <font weight="500" style="normal">../../product/fonts/Gelasio-VF.ttf
+          <axis tag="wght" stylevalue="500" />
+        </font>
+        <font weight="600" style="normal">../../product/fonts/Gelasio-VF.ttf
+          <axis tag="wght" stylevalue="600" />
+        </font>
+        <font weight="700" style="normal">../../product/fonts/Gelasio-VF.ttf
+          <axis tag="wght" stylevalue="700" />
+        </font>
+        <font weight="400" style="italic">../../product/fonts/Gelasio-Italic-VF.ttf
+          <axis tag="wght" stylevalue="400" />
+        </font>
+        <font weight="500" style="italic">../../product/fonts/Gelasio-Italic-VF.ttf
+          <axis tag="wght" stylevalue="500" />
+        </font>
+        <font weight="600" style="italic">../../product/fonts/Gelasio-Italic-VF.ttf
+          <axis tag="wght" stylevalue="600" />
+        </font>
+        <font weight="700" style="italic">../../product/fonts/Gelasio-Italic-VF.ttf
+          <axis tag="wght" stylevalue="700" />
+        </font>
+    </family>
+    <alias name="georgia" to="gelasio" />
+    <family name="comic-relief">
+        <font weight="400" style="normal">../../product/fonts/ComicRelief-Regular.ttf</font>
+        <font weight="700" style="normal">../../product/fonts/ComicRelief-Bold.ttf</font>
+    </family>
+    <alias name="comic sans ms" to="comic-relief" />
+    <alias name="comic relief" to="comic-relief" />
+    <family name="archivo-black">
+        <font weight="400" style="normal">../../product/fonts/ArchivoBlack-Regular.ttf</font>
+    </family>
+    <alias name="archivo black" to="archivo-black" />
+    <family name="archivo-narrow">
+        <font weight="400" style="normal">../../product/fonts/ArchivoNarrow-VF.ttf
+          <axis tag="wght" stylevalue="400" />
+        </font>
+        <font weight="500" style="normal">../../product/fonts/ArchivoNarrow-VF.ttf
+          <axis tag="wght" stylevalue="500" />
+        </font>
+        <font weight="600" style="normal">../../product/fonts/ArchivoNarrow-VF.ttf
+          <axis tag="wght" stylevalue="600" />
+        </font>
+        <font weight="700" style="normal">../../product/fonts/ArchivoNarrow-VF.ttf
+          <axis tag="wght" stylevalue="700" />
+        </font>
+        <font weight="400" style="italic">../../product/fonts/ArchivoNarrow-Italic-VF.ttf
+          <axis tag="wght" stylevalue="400" />
+        </font>
+        <font weight="500" style="italic">../../product/fonts/ArchivoNarrow-Italic-VF.ttf
+          <axis tag="wght" stylevalue="500" />
+        </font>
+        <font weight="600" style="italic">../../product/fonts/ArchivoNarrow-Italic-VF.ttf
+          <axis tag="wght" stylevalue="600" />
+        </font>
+        <font weight="700" style="italic">../../product/fonts/ArchivoNarrow-Italic-VF.ttf
+          <axis tag="wght" stylevalue="700" />
+        </font>
+    </family>
+    <alias name="archivo narrow" to="archivo-narrow" />
+
     <family name="roboto-flex">
         <font weight="100" style="normal">RobotoFlex-Regular.ttf
           <axis tag="slnt" stylevalue="0" />
