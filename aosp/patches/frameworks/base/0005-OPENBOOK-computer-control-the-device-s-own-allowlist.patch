@@ -855,6 +894,39 @@ final class ComputerControlAllowlistController implements DeviceConfig.OnPropert
             setSignedPackages(storedSignedPackages);
         }
 
+        /**
+         * OPENBOOK: reads the device's own list. Same syntax as the DeviceConfig value, except
+         * that entries may also be separated by newlines, whitespace is ignored and lines
+         * starting with '#' are comments.
+         */
+        @Nullable
+        private SignedPackages readFactoryValue() {
+            if (mFactoryFile == null || !mFactoryFile.isFile()) {
+                return null;
+            }
+            try {
+                final String text = new String(
+                        java.nio.file.Files.readAllBytes(mFactoryFile.toPath()),
+                        StandardCharsets.UTF_8);
+                final List<String> entries = new ArrayList<>();
+                for (String line : text.split("\n")) {
+                    final String trimmed = line.trim();
+                    if (trimmed.isEmpty() || trimmed.startsWith("#")) {
+                        continue;
+                    }
+                    for (String entry : trimmed.split(SIGNED_PACKAGE_SEPARATOR)) {
+                        if (!entry.trim().isEmpty()) {
+                            entries.add(entry.trim());
+                        }
+                    }
+                }
+                return parseList(String.join(SIGNED_PACKAGE_SEPARATOR, entries));
+            } catch (Exception e) {
+                Slog.e(TAG, "Failed to read factory value from " + mFactoryFile, e);
+                return null;
+            }
+        }
+
