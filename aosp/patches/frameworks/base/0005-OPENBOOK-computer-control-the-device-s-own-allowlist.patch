+    @Test
+    public void factoryAllowlists_usedWithoutDeviceConfigOrPersistedValue() throws Exception {
+        final Signature signature = generateSignature((byte) 11);
+        final String certificateDigest = preparePackage(AGENT_PACKAGE, signature);
+        when(mPackageManager.getPackageUidAsUser(eq(AGENT_PACKAGE), anyInt()))
+                .thenReturn(Process.myUid());
+        final String targetPackage = "com.hello.target";
+        preparePackage(targetPackage, generateSignature((byte) 12), /* preinstalled= */ true,
+                /* testOnly= */ false);
+        final File factoryDir = writeFactoryAllowlists(
+                "# the device's agent\n" + AGENT_PACKAGE + ":" + certificateDigest + "\n",
+                " " + targetPackage + ":PREINSTALLED ,\n\n");
+
+        DeviceConfig.removeOnPropertiesChangedListener(mAllowlistController);
+        createAllowlistController(/* buildIsDebuggable= */ false, factoryDir);
+
+        assertTrue(mAllowlistController.isPackageAllowedToCreateSession(
+                AGENT_PACKAGE, mPackageManager, USER_HANDLE,
+                VirtualDeviceManager.COMPUTER_CONTROL_VERSION));
+        assertTrue(mAllowlistController.isPackageAutomatable(
+                targetPackage, AGENT_PACKAGE, mPackageManager));
+        // The factory value is not persisted.
+        assertFalse(mSessionOwnerAllowlistFile.exists());
+    }
+
+    @Test
+    public void deviceConfigValue_winsOverFactoryAllowlist() throws Exception {
+        final Signature signature = generateSignature((byte) 13);
+        final String certificateDigest = preparePackage(AGENT_PACKAGE, signature);
+        when(mPackageManager.getPackageUidAsUser(eq(AGENT_PACKAGE), anyInt()))
+                .thenReturn(Process.myUid());
+        final File factoryDir = writeFactoryAllowlists(
+                AGENT_PACKAGE + ":" + certificateDigest, "");
+
+        DeviceConfig.removeOnPropertiesChangedListener(mAllowlistController);
+        createAllowlistController(/* buildIsDebuggable= */ false, factoryDir);
+        assertTrue(mAllowlistController.isPackageAllowedToCreateSession(
+                AGENT_PACKAGE, mPackageManager, USER_HANDLE,
+                VirtualDeviceManager.COMPUTER_CONTROL_VERSION));
+
+        mDeviceConfigWriter.writeValue(COMPUTER_CONTROL_SESSION_OWNER_ALLOWLIST_KEY, "");
+        SystemClock.sleep(TIMEOUT_MILLIS);
+
+        assertFalse(mAllowlistController.isPackageAllowedToCreateSession(
+                AGENT_PACKAGE, mPackageManager, USER_HANDLE,
+                VirtualDeviceManager.COMPUTER_CONTROL_VERSION));
+    }
+
+    private File writeFactoryAllowlists(@NonNull String sessionOwners,
+            @NonNull String automatableApps) throws Exception {
+        final File dir = new File(mSessionOwnerAllowlistFile.getParentFile(), "factory");
+        dir.mkdirs();
+        Files.writeString(new File(dir, "session_owner_allowlist.txt").toPath(), sessionOwners);
+        Files.writeString(new File(dir, "automatable_app_allowlist.txt").toPath(),
+                automatableApps);
+        return dir;
+    }
