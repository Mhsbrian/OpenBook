+  static constexpr Register kSaved[] = {Assembler::rax, Assembler::rcx, Assembler::rdx, Assembler::rsi,
+                                        Assembler::rdi, Assembler::r8,  Assembler::r9,  Assembler::r10,
+                                        Assembler::r11};
