+      as_.Shrq(t, int8_t{52});
+      if (!is_rsqrt) as_.Andl(t, int32_t{0x7ff});
+      as_.Subq(t, int32_t{1});
+      as_.Cmpq(t, int32_t{is_rsqrt ? 2045 : 2043});
