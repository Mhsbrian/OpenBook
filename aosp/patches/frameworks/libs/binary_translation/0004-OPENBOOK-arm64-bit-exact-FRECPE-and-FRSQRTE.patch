+    if (is_double) {
+      uint64_t x = static_cast<uint64_t>(src >> (64 * i));
+      uint64_t r = is_rsqrt ? arm64::FpRSqrtEstimate<64>(x, fpcr, &fpsr) : arm64::FpRecipEstimate<64>(x, fpcr, &fpsr);
