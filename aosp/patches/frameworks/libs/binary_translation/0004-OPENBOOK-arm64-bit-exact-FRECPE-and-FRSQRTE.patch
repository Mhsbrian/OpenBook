+      as_.Movq(est, x);
+      as_.Shrq(est, int8_t{44});
+      as_.Andl(est, int32_t{is_rsqrt ? 0x1ff : 0xff});
+      as_.Movzxbl(est, {.base = tbl, .index = est, .scale = Assembler::kTimesOne});
+      as_.Shlq(est, int8_t{44});
+      as_.Negl(t);
+      if (!is_rsqrt) {
+        as_.Addl(t, int32_t{2044});  // 2045 - exponent
+        as_.Shlq(t, int8_t{52});
+        as_.Shrq(x, int8_t{63});  // sign
+        as_.Shlq(x, int8_t{63});
+        as_.Orq(x, t);
+      } else {
+        as_.Addl(t, int32_t{3067});  // 3068 - exponent, then DIV 2
+        as_.Shrl(t, int8_t{1});
+        as_.Shlq(t, int8_t{52});
