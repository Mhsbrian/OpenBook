+    } else {
+      uint32_t x = static_cast<uint32_t>(src >> (32 * i));
+      uint64_t r = is_rsqrt ? arm64::FpRSqrtEstimate<32>(x, fpcr, &fpsr) : arm64::FpRecipEstimate<32>(x, fpcr, &fpsr);
+      res |= static_cast<__uint128_t>(r) << (32 * i);
+    }
+  }
+  state->cpu.v[rd] = res;
+  state->cpu.emulated_fpsr |= fpsr;
