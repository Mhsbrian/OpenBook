+void FpEstimateSlowPath(ThreadState* state, uint32_t desc) {
+  const unsigned rd = desc & 31, rn = (desc >> 5) & 31, lanes = (desc >> 12) & 7;
+  const bool is_rsqrt = desc & (1u << 10), is_double = desc & (1u << 11);
+  const uint32_t fpcr = state->cpu.cached_fpcr;
+  uint32_t fpsr = 0;
