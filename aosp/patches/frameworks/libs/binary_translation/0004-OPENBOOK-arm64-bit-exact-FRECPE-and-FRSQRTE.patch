+        as_.Addl(t, int32_t{252});  // 253 - exponent
+        as_.Shll(t, int8_t{23});
+        as_.Andl(x, int32_t{INT32_MIN});  // sign
+        as_.Orl(x, t);
+      } else {
+        as_.Addl(t, int32_t{379});  // 380 - exponent, then DIV 2
+        as_.Shrl(t, int8_t{1});
+        as_.Shll(t, int8_t{23});
+        as_.Movl(x, t);
+      }
