+#ifndef BERBERIS_GUEST_STATE_GUEST_FP_ESTIMATE_ARM64_H_
+#define BERBERIS_GUEST_STATE_GUEST_FP_ESTIMATE_ARM64_H_
+
+#include <array>
+#include <cstdint>
+
+namespace berberis::arm64 {
+
+// FRECPE / FRSQRTE / URECPE / URSQRTE, bit-exact: the Arm ARM pseudocode FPRecipEstimate(), FPRSqrtEstimate(),
+// RecipEstimate() and RecipSqrtEstimate() for half, single and double precision, without FEAT_RPRES (the
+// increased-precision estimates, which only apply with FPCR.AH=1) and without FEAT_AFP. Software uses these
+// estimates as Newton-Raphson seeds and expects the same bits on every Arm CPU; an exact 1/x or 1/sqrt(x) gives
+// different results after the refinement steps.
+
+// FPSR cumulative exception bits and the FPCR bits these functions read.
+inline constexpr uint32_t kFpsrIoc = 1u << 0;
+inline constexpr uint32_t kFpsrDzc = 1u << 1;
+inline constexpr uint32_t kFpsrOfc = 1u << 2;
+inline constexpr uint32_t kFpsrUfc = 1u << 3;
+inline constexpr uint32_t kFpsrIxc = 1u << 4;
+inline constexpr uint32_t kFpsrIdc = 1u << 7;
+inline constexpr uint32_t kFpcrFz16 = 1u << 19;
+inline constexpr uint32_t kFpcrFz = 1u << 24;
+inline constexpr uint32_t kFpcrDn = 1u << 25;
+
+// RecipEstimate(a): a in 256..511 is a fixed-point number in [0.5, 1.0); the result, in 256..511, is in [1.0, 2.0).
+constexpr uint32_t RecipEstimate(uint32_t a) {
+  a = a * 2 + 1;              // round to nearest
+  uint32_t b = (1u << 19) / a;
+  return (b + 1) / 2;         // round to nearest
+}
+
+// RecipSqrtEstimate(a): a in 128..511 is a fixed-point number in [0.25, 1.0); the result is in 256..511.
+constexpr uint32_t RecipSqrtEstimate(uint32_t a) {
+  if (a < 256) {
+    a = a * 2 + 1;            // 0.25 .. 0.5, in units of 1/512 rounded to nearest
+  } else {
+    a = (a >> 1) << 1;        // 0.5 .. 1.0: discard the bottom bit,
+    a = (a + 1) * 2;          // in units of 1/256 rounded to nearest
+  }
+  // b = the largest b >= 512 with a * (b + 1)^2 < 2^28 ... plus one, as the pseudocode's loop leaves it:
+  // the smallest b >= 512 with a * (b + 1)^2 >= 2^28.
+  uint32_t lo = 512, hi = 1u << 14;
+  while (lo < hi) {
+    uint32_t mid = (lo + hi) / 2;
+    if (uint64_t{a} * (mid + 1) * (mid + 1) < (uint64_t{1} << 28)) {
+      lo = mid + 1;
+    } else {
+      hi = mid;
+    }
+  }
+  return (lo + 1) / 2;        // round to nearest
+}
+
+// RecipEstimate / RecipSqrtEstimate of every 9-bit input, for the per-lane lookups the translators emit.
+// Entries outside each function's domain are 0.
+inline constexpr std::array<uint16_t, 512> kRecipEstimateTable = [] {
+  std::array<uint16_t, 512> t{};
+  for (uint32_t a = 256; a < 512; a++) t[a] = static_cast<uint16_t>(RecipEstimate(a));
+  return t;
+}();
+inline constexpr std::array<uint16_t, 512> kRecipSqrtEstimateTable = [] {
+  std::array<uint16_t, 512> t{};
+  for (uint32_t a = 128; a < 512; a++) t[a] = static_cast<uint16_t>(RecipSqrtEstimate(a));
+  return t;
+}();
+
+// Low 8 bits of the estimate, as the translators' inline paths need them for normal inputs with normal results:
+//   kFrecpeFastTable[frac<top 8>]                 FRECPE: RecipEstimate(256 | fraction<51:44>)
+//   kFrsqrteFastTable[exp<0> << 8 | frac<top 8>]  FRSQRTE: RecipSqrtEstimate of '1':fraction<51:44> (even exponent)
+//                                                 or '01':fraction<51:45> (odd exponent)
+inline constexpr std::array<uint8_t, 256> kFrecpeFastTable = [] {
+  std::array<uint8_t, 256> t{};
+  for (uint32_t i = 0; i < 256; i++) t[i] = static_cast<uint8_t>(RecipEstimate(256 | i));
+  return t;
+}();
+inline constexpr std::array<uint8_t, 512> kFrsqrteFastTable = [] {
+  std::array<uint8_t, 512> t{};
+  for (uint32_t i = 0; i < 512; i++) {
+    t[i] = static_cast<uint8_t>(RecipSqrtEstimate((i & 256) ? (128 | ((i & 255) >> 1)) : (256 | i)));
+  }
+  return t;
+}();
+
+template <int kBits>
+struct FpEstimateFormat;
+template <>
+struct FpEstimateFormat<16> {
+  static constexpr int kExpBits = 5, kFracBits = 10;
+};
+template <>
+struct FpEstimateFormat<32> {
+  static constexpr int kExpBits = 8, kFracBits = 23;
+};
+template <>
+struct FpEstimateFormat<64> {
+  static constexpr int kExpBits = 11, kFracBits = 52;
+};
+
+namespace fp_estimate_internal {
+
+template <int kBits>
+struct Unpacked {
+  static constexpr int F = FpEstimateFormat<kBits>::kFracBits;
+  static constexpr uint64_t kExpMax = (uint64_t{1} << FpEstimateFormat<kBits>::kExpBits) - 1;
+  static constexpr uint64_t kFracMask = (uint64_t{1} << F) - 1;
+  static constexpr uint64_t kSign = uint64_t{1} << (kBits - 1);
+  static constexpr uint64_t kInf = kExpMax << F;
+  static constexpr uint64_t kQuiet = uint64_t{1} << (F - 1);
+  uint64_t sign;
+  int exp;
+  uint64_t frac;
+};
+
+// FPUnpack's flush of an input denormal under FPCR.FZ (FZ16 for half precision, which raises no IDC).
+template <int kBits>
+constexpr Unpacked<kBits> Unpack(uint64_t op, uint32_t fpcr, uint32_t* fpsr) {
+  using U = Unpacked<kBits>;
+  U u{op & U::kSign, static_cast<int>((op >> U::F) & U::kExpMax), op & U::kFracMask};
+  if (u.exp == 0 && u.frac != 0) {
+    if constexpr (kBits == 16) {
+      if (fpcr & kFpcrFz16) u.frac = 0;
+    } else if (fpcr & kFpcrFz) {
+      u.frac = 0;
+      *fpsr |= kFpsrIdc;
+    }
+  }
+  return u;
+}
+
+// FPProcessNaN: a signalling NaN raises Invalid Operation and is quietened; FPCR.DN selects the default NaN.
+template <int kBits>
+constexpr uint64_t ProcessNaN(uint64_t op, uint32_t fpcr, uint32_t* fpsr) {
+  using U = Unpacked<kBits>;
+  op &= U::kSign | U::kInf | U::kFracMask;
+  if (!(op & U::kQuiet)) {
+    *fpsr |= kFpsrIoc;
+    op |= U::kQuiet;
+  }
+  return (fpcr & kFpcrDn) ? (U::kInf | U::kQuiet) : op;
+}
+
+}  // namespace fp_estimate_internal
+
+// FPRecipEstimate (FRECPE). op holds kBits bits; fpsr gets the cumulative exception bits it raises.
+template <int kBits>
+constexpr uint64_t FpRecipEstimate(uint64_t op, uint32_t fpcr, uint32_t* fpsr) {
+  using namespace fp_estimate_internal;
+  using U = Unpacked<kBits>;
+  constexpr int F = U::F;
+  constexpr uint64_t kMask52 = (uint64_t{1} << 52) - 1;
+  const U u = Unpack<kBits>(op, fpcr, fpsr);
+  if (u.exp == static_cast<int>(U::kExpMax)) {
+    return u.frac ? ProcessNaN<kBits>(op, fpcr, fpsr) : u.sign;  // NaN; infinity -> zero
+  }
+  if (u.exp == 0 && u.frac == 0) {
+    *fpsr |= kFpsrDzc;
+    return u.sign | U::kInf;
+  }
+  if (u.exp == 0 && u.frac < (uint64_t{1} << (F - 2))) {
+    // |x| < 2^-(bias + 1): the reciprocal overflows. Round to infinity or to the largest normal by FPCR.RMode.
+    bool to_inf = true;
+    switch ((fpcr >> 22) & 3) {
+      case 1: to_inf = !u.sign; break;  // RP
+      case 2: to_inf = u.sign; break;   // RM
+      case 3: to_inf = false; break;    // RZ
+    }
+    *fpsr |= kFpsrOfc | kFpsrIxc;
+    return u.sign | (to_inf ? U::kInf : (((U::kExpMax - 1) << F) | U::kFracMask));
+  }
+  const bool fz = (kBits == 16) ? (fpcr & kFpcrFz16) : (fpcr & kFpcrFz);
+  if (fz && u.exp >= static_cast<int>(U::kExpMax) - 2) {
+    // |x| >= 2^(bias - 1): the reciprocal is denormal, flushed to zero.
+    *fpsr |= kFpsrUfc;
+    return u.sign;
+  }
+  uint64_t fraction = (u.frac << (52 - F)) & kMask52;
+  int exp = u.exp;
+  if (exp == 0) {
+    if (!(fraction >> 51)) {
+      exp = -1;
+      fraction = (fraction << 2) & kMask52;
+    } else {
+      fraction = (fraction << 1) & kMask52;
+    }
+  }
+  const uint32_t estimate = RecipEstimate(256 | static_cast<uint32_t>(fraction >> 44));
+  int result_exp = static_cast<int>(2 * (U::kExpMax >> 1)) - 1 - exp;  // 2 * bias - 1 - exp
+  fraction = uint64_t{estimate & 0xff} << 44;
+  if (result_exp == 0) {
+    fraction = (uint64_t{1} << 51) | (fraction >> 1);
+  } else if (result_exp == -1) {
+    fraction = (uint64_t{1} << 50) | (fraction >> 2);
+    result_exp = 0;
+  }
+  return u.sign | (static_cast<uint64_t>(result_exp) << F) | (fraction >> (52 - F));
+}
+
+// FPRSqrtEstimate (FRSQRTE).
+template <int kBits>
+constexpr uint64_t FpRSqrtEstimate(uint64_t op, uint32_t fpcr, uint32_t* fpsr) {
+  using namespace fp_estimate_internal;
+  using U = Unpacked<kBits>;
+  constexpr int F = U::F;
+  constexpr uint64_t kMask52 = (uint64_t{1} << 52) - 1;
+  const U u = Unpack<kBits>(op, fpcr, fpsr);
+  if (u.exp == static_cast<int>(U::kExpMax) && u.frac) {
+    return ProcessNaN<kBits>(op, fpcr, fpsr);
+  }
+  if (u.exp == 0 && u.frac == 0) {
+    *fpsr |= kFpsrDzc;
+    return u.sign | U::kInf;
+  }
+  if (u.sign) {
+    *fpsr |= kFpsrIoc;
+    return U::kInf | U::kQuiet;  // FPDefaultNaN
+  }
+  if (u.exp == static_cast<int>(U::kExpMax)) {
+    return 0;  // +infinity -> +0
+  }
+  uint64_t fraction = (u.frac << (52 - F)) & kMask52;
+  int exp = u.exp;
+  if (exp == 0) {
+    while (!(fraction >> 51)) {
+      fraction = (fraction << 1) & kMask52;
+      exp--;
+    }
+    fraction = (fraction << 1) & kMask52;
+  }
+  // Even exponent: '1':fraction<51:44> (0.5 .. 1.0); odd: '01':fraction<51:45> (0.25 .. 0.5).
+  const uint32_t scaled = (exp & 1) ? (128 | static_cast<uint32_t>(fraction >> 45))
+                                    : (256 | static_cast<uint32_t>(fraction >> 44));
+  const uint32_t estimate = RecipSqrtEstimate(scaled);
+  const int result_exp = (static_cast<int>(3 * (U::kExpMax >> 1)) - 1 - exp) / 2;  // (3 * bias - 1 - exp) DIV 2
+  return (static_cast<uint64_t>(result_exp) << F) | (uint64_t{estimate & 0xff} << (F - 8));
+}
+
+// UnsignedRecipEstimate (URECPE) and UnsignedRSqrtEstimate (URSQRTE) of one 32-bit lane.
+constexpr uint32_t UnsignedRecipEstimate(uint32_t op) {
+  return (op >> 31) ? RecipEstimate(op >> 23) << 23 : 0xffffffffu;
+}
+constexpr uint32_t UnsignedRSqrtEstimate(uint32_t op) {
+  return (op >> 30) ? RecipSqrtEstimate(op >> 23) << 23 : 0xffffffffu;
+}
+
+}  // namespace berberis::arm64
+
+#endif  // BERBERIS_GUEST_STATE_GUEST_FP_ESTIMATE_ARM64_H_
