-  EXPECT_EQ(r[2], -inf);                         // 1/-0 = -inf
-  EXPECT_FLOAT_EQ(r[3], 0.0f);                  // 1/+inf = +0
+// FRECPE / FRSQRTE in every form (scalar S/D, vector .2S/.4S/.2D), interpreter and lite tier, against
+// guest_fp_estimate_arm64.h, which matches QEMU's implementation of the Arm pseudocode on 189,200 cases
+// (scripts/compat/digitalis/fp-estimate in OpenBook). Inputs cover every class: zeros, denormals around the
+// FRECPE overflow threshold, normals whose reciprocal is denormal, the largest normals, infinities, quiet and
+// signalling NaNs, negatives, plus pseudo-random values; vector lanes mix them, so one special lane sends the
+// whole instruction down the lite tier's out-of-line path. Each case runs under several FPCR settings and checks
+// the result, the zeroed upper bits, the untouched source and FPSR.
+TEST_F(Arm64LiteTranslateRegionTest, FpEstimateMatchesReference) {
+  struct Form {
+    uint32_t insn;  // Vd = V0, Vn = V1
+    bool rsqrt, dbl;
+    unsigned lanes;
+  };
+  static const Form kForms[] = {
+      {kFrecpeSdSnV0 | (1 << 5), false, false, 1}, {kFrecpeDdDnV0 | (1 << 5), false, true, 1},
+      {kFrsqrteSdSnV0 | (1 << 5), true, false, 1}, {kFrsqrteDdDnV0 | (1 << 5), true, true, 1},
+      {FrecpeVec4S(0, 1), false, false, 4},        {FrecpeVec2S(0, 1), false, false, 2},
+      {FrecpeVec2D(0, 1), false, true, 2},         {FrsqrteVec4S(0, 1), true, false, 4},
+      {FrsqrteVec2S(0, 1), true, false, 2},        {FrsqrteVec2D(0, 1), true, true, 2},
+  };
+  // FPCR: default, FZ, DN, FZ|DN, RP, RM, RZ.
+  static const uint32_t kFpcrs[] = {0, 1u << 24, 1u << 25, 3u << 24, 1u << 22, 2u << 22, 3u << 22};
+  auto inputs = [](bool dbl) {
+    const int f = dbl ? 52 : 23;
+    const uint64_t emax = dbl ? 0x7ff : 0xff, fmask = (uint64_t{1} << f) - 1;
+    std::vector<uint64_t> v;
+    for (uint64_t sign : {uint64_t{0}, uint64_t{1}}) {
+      for (uint64_t e : {uint64_t{0}, uint64_t{1}, uint64_t{2}, emax / 2, emax / 2 + 1, emax - 3, emax - 2,
+                         emax - 1, emax}) {
+        for (uint64_t fr : {uint64_t{0}, uint64_t{1}, fmask, uint64_t{1} << (f - 1), uint64_t{1} << (f - 2),
+                            (uint64_t{1} << (f - 2)) - 1, (uint64_t{3} << (f - 2)) + 5}) {
+          v.push_back((sign << (dbl ? 63 : 31)) | (e << f) | fr);
+        }
+      }
+    }
+    uint64_t x = 0x9E3779B97F4A7C15ull;
+    for (int i = 0; i < 200; i++) {
+      x ^= x << 13;
+      x ^= x >> 7;
+      x ^= x << 17;
+      v.push_back(dbl ? x : (x & 0xffffffff));
+    }
+    return v;
+  };
+  int cases = 0;
+  for (const Form& form : kForms) {
+    const std::vector<uint64_t> in = inputs(form.dbl);
+    const unsigned esize = form.dbl ? 8 : 4;
+    for (uint32_t fpcr : kFpcrs) {
+      for (size_t i = 0; i < in.size(); i++) {
+        uint8_t src[16];
+        std::memset(src, 0xA5, sizeof(src));
+        uint8_t want[16] = {};
+        uint32_t want_fpsr = 0;
+        for (unsigned l = 0; l < form.lanes; l++) {
+          uint64_t x = in[(i + l * 7) % in.size()];
+          uint64_t r = form.dbl ? (form.rsqrt ? arm64::FpRSqrtEstimate<64>(x, fpcr, &want_fpsr)
+                                              : arm64::FpRecipEstimate<64>(x, fpcr, &want_fpsr))
+                                : (form.rsqrt ? arm64::FpRSqrtEstimate<32>(x, fpcr, &want_fpsr)
+                                              : arm64::FpRecipEstimate<32>(x, fpcr, &want_fpsr));
+          std::memcpy(src + l * esize, &x, esize);
+          std::memcpy(want + l * esize, &r, esize);
+        }
+        for (bool lite : {false, true}) {
+          SCOPED_TRACE(testing::Message() << std::hex << "insn=" << form.insn << " fpcr=" << fpcr
+                                          << " in[0]=" << in[i] << " lite=" << lite);
+          std::memcpy(&state_.cpu.v[1], src, 16);
+          state_.cpu.v[0] = ~__uint128_t{0};
+          state_.cpu.cached_fpcr = fpcr;
+          state_.cpu.emulated_fpsr = 0;
+          ClearHostFpExceptions();
+          const uint32_t code[] = {form.insn};
+          if (lite) {
+            ASSERT_TRUE(RunN(code, 1, ToGuestAddr(code) + sizeof(code)));
+          } else {
+            Interpret(code[0]);
+          }
+          EXPECT_EQ(std::memcmp(&state_.cpu.v[0], want, 16), 0);
+          EXPECT_EQ(std::memcmp(&state_.cpu.v[1], src, 16), 0);
+          EXPECT_EQ(state_.cpu.emulated_fpsr & 0x9f, want_fpsr);
+          cases++;
+        }
+      }
+    }
+  }
+  EXPECT_GT(cases, 10000);
 }
 
