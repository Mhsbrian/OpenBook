+// region digitalis
+const MachineInsnX86_64* InsnFolding::GetImmDefIfPossible(MachineReg reg) const {
+  auto general_insn_it = std::get<0>(def_map_.FindNonPseudoCopyDef(reg));
+  if (!general_insn_it.has_value()) {
+    return nullptr;
+  }
+  const auto* insn = AsMachineInsnX86_64(*general_insn_it.value());
+  if (insn->opcode() != kMachineOpMovqRegImm && insn->opcode() != kMachineOpMovlRegImm) {
+    return nullptr;
+  }
+  return insn;
+}
+
+std::optional<uint64_t> InsnFolding::ImmValue(const MachineInsnX86_64* def) {
+  if (def == nullptr) {
+    return std::nullopt;
+  }
+  if (def->opcode() == kMachineOpMovqRegImm) {
+    return def->imm();
+  }
+  return static_cast<uint64_t>(static_cast<uint32_t>(def->imm()));
+}
+
+std::tuple<PersistentOperand, uint64_t> InsnFolding::ImmProvenance(const MachineInsnX86_64* def) {
+  if (def == nullptr || !def->has_persistent_imm()) {
+    return {PersistentOperand::kNumKinds, 0};
+  }
+  return {def->imm_kind(), def->imm_symbol()};
+}
+
+// A folded address keeps its record only when the result is still that address plus a
+// constant: a 64-bit add of one address and a number, a number subtracted from an address, or
+// an address rounded down to at most a 4 KiB boundary (guest modules and the translator image
+// are page-aligned, so the rounding moves with them).
+//
+// One more pattern keeps it: the heavy tier's TBI masking, shl 8 then shr 8, which on a constant
+// address folds back to that address. A left shift of an address by up to 8 bits that loses no
+// bits keeps the record as an intermediate: same kind, the address as symbol, the shifted value
+// as immediate. A right shift by the same amount that gives the address back is plain again.
+// Nothing else may start from an intermediate; if one reaches the code, its immediate doesn't
+// match its symbol and SymbolizeTranslation refuses the region.
+//
+// Anything else (a 32-bit result, or/xor, other shifts, two addresses, an offset into a heap
+// resource) is still folded, so the code doesn't change, but the region can't be re-linked.
+void InsnFolding::SetFoldedProvenance(MachineOpcode opcode,
+                                      berberis::MachineInsn* folded,
+                                      std::tuple<PersistentOperand, uint64_t> provenance0,
+                                      std::tuple<PersistentOperand, uint64_t> provenance1,
+                                      uint64_t imm0,
+                                      uint64_t imm1) {
+  constexpr auto kNone = PersistentOperand::kNumKinds;
+  auto [kind0, symbol0] = provenance0;
+  auto kind1 = std::get<0>(provenance1);
+  if (kind0 == kNone && kind1 == kNone) {
+    return;
+  }
+  auto is_address = [](PersistentOperand kind) {
+    return kind == PersistentOperand::kGuestAddr || kind == PersistentOperand::kHostAddr;
+  };
+  const bool plain0 = is_address(kind0) && imm0 == symbol0;
+  const bool plain1 = is_address(kind1) && imm1 == std::get<1>(provenance1);
+  auto* result = AsMachineInsnX86_64(folded);
+  std::optional<std::tuple<PersistentOperand, uint64_t>> kept;
+  if (result->opcode() == kMachineOpMovqRegImm) {
+    switch (opcode) {
+      case kMachineOpAddqRegReg:
+      case kMachineOpAddqRegImm:
+        if (plain0 && kind1 == kNone) {
+          kept = {kind0, result->imm()};
+        } else if (kind0 == kNone && plain1) {
+          kept = {kind1, result->imm()};
+        }
+        break;
+      case kMachineOpSubqRegReg:
+      case kMachineOpSubqRegImm:
+        if (plain0 && kind1 == kNone) {
+          kept = {kind0, result->imm()};
+        }
+        break;
+      case kMachineOpAndqRegReg:
+      case kMachineOpAndqRegImm:
+        // A mask that clears at most the low 12 bits: ~(2^k - 1) with k <= 12.
+        if (plain0 && kind1 == kNone && imm1 >= ~uint64_t{0xfff} && ((~imm1 + 1) & ~imm1) == 0) {
+          kept = {kind0, result->imm()};
+        }
+        break;
+      case kMachineOpShlqRegReg:
+      case kMachineOpShlqRegImm:
+        if (plain0 && kind1 == kNone && imm1 > 0 && imm1 <= 8 && ((imm0 << imm1) >> imm1) == imm0) {
+          kept = {kind0, symbol0};  // An intermediate: the immediate is the shifted address.
+        }
+        break;
+      case kMachineOpShrqRegReg:
+      case kMachineOpShrqRegImm:
+        if (is_address(kind0) && !plain0 && kind1 == kNone && imm1 > 0 && imm1 <= 8 &&
+            result->imm() == symbol0) {
+          kept = {kind0, symbol0};  // The intermediate shifted back: the address again.
+        }
+        break;
+      default:
+        break;
+    }
+  }
+  if (!kept.has_value()) {
+    machine_ir_->MarkNotPersistable();
+    return;
+  }
+  // The address itself (aux 0), or one shifted left: the shift is what's pending.
+  auto [kind, symbol] = kept.value();
+  uint32_t shift = 0;
+  while (shift < 8 && (symbol << shift) != result->imm()) {
+    shift++;
+  }
+  CHECK_EQ(symbol << shift, result->imm());
+  result->set_imm_provenance(kind, shift);
+}
