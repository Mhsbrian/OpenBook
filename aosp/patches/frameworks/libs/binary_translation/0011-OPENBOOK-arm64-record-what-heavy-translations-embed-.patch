     // Both operands are immediates. This insn can be folded into one Movq.
     if (insn->opcode() == kMachineOpAndqRegReg || insn->opcode() == kMachineOpAndlRegReg ||
@@ -267,17 +394,40 @@ std::tuple<FoldingType, berberis::MachineInsn*> InsnFolding::TryFoldImmediateInp
         insn->opcode() == kMachineOpSubqRegReg || insn->opcode() == kMachineOpSublRegReg ||
         insn->opcode() == kMachineOpShlqRegReg || insn->opcode() == kMachineOpShllRegReg ||
         insn->opcode() == kMachineOpShrqRegReg || insn->opcode() == kMachineOpShrlRegReg) {
-      return {FoldingType::kInsertInsn,
-              NewInsnFromTwoImmediatesOperation(insn, imm64_0.value(), imm64_1.value())};
+      auto* folded = NewInsnFromTwoImmediatesOperation(insn, imm64_0.value(), imm64_1.value());
+      SetFoldedProvenance(  // digitalis
+          insn->opcode(),
+          folded,
+          ImmProvenance(def0),
+          provenance1,
+          imm64_0.value(),
+          imm64_1.value());
+      return {FoldingType::kInsertInsn, folded};
     }
   }
 
   // MovqRegReg is the only instruction that can encode full 64-bit immediate.
   if (insn->opcode() == kMachineOpMovqRegReg) {
-    return {FoldingType::kReplaceInsn,
-            machine_ir_->NewInsn<MovqRegImm>(insn->RegAt(0), imm64_1.value())};
+    auto* mov = machine_ir_->NewInsn<MovqRegImm>(insn->RegAt(0), imm64_1.value());
+    if (src1_is_address) {  // digitalis: a copy of an address is still that address.
+      mov->set_imm_provenance(def1->imm_kind(), def1->imm_aux());
+    }
+    return {FoldingType::kReplaceInsn, mov};
   }
 
+  // region digitalis
+  // An address is never narrowed into a 32-bit immediate operand: that only fits below 4 GiB,
+  // so the code would depend on where the module is. Above 4 GiB, where Android puts it, the
+  // fold couldn't happen anyway. A 32-bit operation on an address still folds (the code doesn't
+  // change), but the region can't be re-linked.
+  if (src1_is_address) {
+    if (kIsInput64Bit) {
+      return {FoldingType::kImpossible, nullptr};
