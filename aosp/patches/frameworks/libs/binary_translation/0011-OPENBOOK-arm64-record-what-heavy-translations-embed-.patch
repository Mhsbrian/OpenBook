+
   int64_t signed_imm = bit_cast<int64_t>(imm64_1.value());
   int32_t signed_imm32 = static_cast<int32_t>(signed_imm);
   if (!kIsInput64Bit) {
@@ -359,7 +509,8 @@ std::tuple<FoldingType, berberis::MachineInsn*> InsnFolding::TryFoldTwoImmediate
   const berberis::MachineInsn* insn = *insn_it;
   CHECK_GE(insn->NumRegOperands(), 2);
   MachineReg imm1_reg = insn->RegAt(0);
-  std::optional<uint64_t> imm1 = GetImmValueIfPossible(imm1_reg);
+  const MachineInsnX86_64* def1 = GetImmDefIfPossible(imm1_reg);  // digitalis
+  std::optional<uint64_t> imm1 = ImmValue(def1);
   if (!imm1.has_value()) {
     return {FoldingType::kImpossible, nullptr};
   }
@@ -369,7 +520,15 @@ std::tuple<FoldingType, berberis::MachineInsn*> InsnFolding::TryFoldTwoImmediate
   // Rest of IR may use the value of flags set by current insn. Therefore, we don't remove
   // current insn, rather simply insert the folded insn. The dead code eliminator will
   // remove the current insn if possible.
-  return {FoldingType::kInsertInsn, NewInsnFromTwoImmediatesOperation(insn, imm1.value(), imm2)};
+  auto* folded = NewInsnFromTwoImmediatesOperation(insn, imm1.value(), imm2);
+  // digitalis: imm2 is the instruction's own 32-bit constant, never an address.
+  SetFoldedProvenance(insn->opcode(),
+                      folded,
+                      ImmProvenance(def1),
+                      {PersistentOperand::kNumKinds, 0},
+                      imm1.value(),
+                      imm2);
+  return {FoldingType::kInsertInsn, folded};
 }
 
