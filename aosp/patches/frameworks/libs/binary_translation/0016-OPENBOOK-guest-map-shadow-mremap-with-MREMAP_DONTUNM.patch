+// mremap(MREMAP_DONTUNMAP) moves the pages but leaves the old range mapped, with its protection
+// (mremap(2)). V8 copies its embedded builtins that way (OS::RemapPages, Linux 5.13 and later) and
+// WebAssembly code keeps calling them at their old addresses. The translator used to treat every
+// mremap as a move and mark the old range non-executable, so a translated Chromium renderer died
+// with SIGSEGV in berberis_HandleNoExec on its first WebAssembly call (ANAL-392).
+//
+// These tests run guest code through the dispatcher before and after such an mremap: the old range
+// must stay executable, the new one must run the moved code, and a translation of the old range
+// must not outlive the mremap (anonymous memory reads as zeros afterwards).
+
+#include "gtest/gtest.h"
+
+#include <sys/mman.h>
+
+#include <cerrno>
+#include <cstdint>
+#include <cstring>
+
+#include "berberis/guest_os_primitives/guest_map_shadow.h"
+#include "berberis/guest_os_primitives/guest_thread_manager.h"
+#include "berberis/guest_state/guest_addr.h"
+#include "berberis/guest_state/guest_state.h"
+#include "berberis/kernel_api/sys_mman_emulation.h"
+#include "berberis/runtime/berberis.h"
+#include "berberis/runtime/execute_guest.h"
+#include "berberis/runtime_primitives/translation_cache.h"
+
+#ifndef MREMAP_DONTUNMAP
+#define MREMAP_DONTUNMAP 4
+#endif
+
+namespace berberis {
+
+namespace {
+
+constexpr size_t kSize = 2 * 4096;
+constexpr uint32_t kMovX1_1 = 0xd2800021;  // mov x1, #1
+constexpr uint32_t kMovX1_2 = 0xd2800041;  // mov x1, #2
+constexpr uint32_t kBNext = 0x14000001;    // b .+4 (ends the region at the stop pc)
+
+void WriteCode(void* at, uint32_t first) {
+  const uint32_t code[] = {first, kBNext};
+  memcpy(at, code, sizeof(code));
+}
+
+// Runs the two instructions at `pc` and returns x1.
+uint64_t RunAt(GuestAddr pc) {
+  GuestThread* thread = GetCurrentGuestThread();
+  auto& cpu = thread->state()->cpu;
+  cpu.insn_addr = pc;
+  cpu.x[1] = 0;
+  GuestAddr stop_pc = pc + 8;
+  TranslationCache* cache = TranslationCache::GetInstance();
+  cache->SetStop(stop_pc);
+  ExecuteGuest(thread->state());
+  cache->TestingClearStop(stop_pc);
+  return cpu.x[1];
+}
+
+class Arm64MremapDontUnmap : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    InitBerberis();
+    old_ = MmapForGuest(nullptr,
+                        kSize,
+                        PROT_READ | PROT_WRITE | PROT_EXEC,
+                        MAP_PRIVATE | MAP_ANONYMOUS,
+                        -1,
+                        0);
+    ASSERT_NE(old_, MAP_FAILED);
+    // The destination, reserved so MREMAP_FIXED has a free range of its own to land in.
+    new_ = MmapForGuest(nullptr, kSize, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    ASSERT_NE(new_, MAP_FAILED);
+  }
+
+  void TearDown() override {
+    if (old_ != MAP_FAILED) MunmapForGuest(old_, kSize);
+    if (new_ != MAP_FAILED) MunmapForGuest(new_, kSize);
+  }
+
+  // Returns false (and skips) on a kernel without MREMAP_DONTUNMAP.
+  bool RemapDontUnmap() {
+    void* result = MremapForGuest(
+        old_, kSize, kSize, MREMAP_MAYMOVE | MREMAP_FIXED | MREMAP_DONTUNMAP, new_);
+    if (result == MAP_FAILED && errno == EINVAL) {
+      return false;
+    }
+    EXPECT_EQ(result, new_);
+    return result == new_;
+  }
+
+  void* old_ = MAP_FAILED;
+  void* new_ = MAP_FAILED;
+};
+
+TEST_F(Arm64MremapDontUnmap, OldRangeStaysExecutable) {
+  GuestMapShadow* shadow = GuestMapShadow::GetInstance();
+  WriteCode(old_, kMovX1_1);
+  ASSERT_EQ(RunAt(ToGuestAddr(old_)), 1u);
+
+  if (!RemapDontUnmap()) {
+    GTEST_SKIP() << "the host kernel has no MREMAP_DONTUNMAP";
+  }
+
+  // Both ranges are guest-executable: the old one still is (its mapping and protection stay),
+  // and the new one has the old one's bits.
+  ASSERT_TRUE(shadow->IsExecutable(ToGuestAddr(old_), kSize));
+  ASSERT_TRUE(shadow->IsExecutable(ToGuestAddr(new_), kSize));
+
+  // The moved code runs at its new address.
+  EXPECT_EQ(RunAt(ToGuestAddr(new_)), 1u);
+
+  // The old range is anonymous memory, so it reads as zeros now; new code written there runs, not
+  // the translation of what used to be there.
+  uint32_t first_word;
+  memcpy(&first_word, old_, sizeof(first_word));
+  EXPECT_EQ(first_word, 0u);
+  WriteCode(old_, kMovX1_2);
+  EXPECT_EQ(RunAt(ToGuestAddr(old_)), 2u);
+}
+
+// Without MREMAP_DONTUNMAP the old range is unmapped, and loses its executable bits.
+TEST_F(Arm64MremapDontUnmap, PlainMoveClearsOldRange) {
+  GuestMapShadow* shadow = GuestMapShadow::GetInstance();
+  GuestAddr old_addr = ToGuestAddr(old_);
+  void* result = MremapForGuest(old_, kSize, kSize, MREMAP_MAYMOVE | MREMAP_FIXED, new_);
+  ASSERT_EQ(result, new_);
+  old_ = MAP_FAILED;  // unmapped by the move
+  EXPECT_EQ(kBitUnset, shadow->GetExecutable(old_addr, kSize));
+  EXPECT_EQ(kBitSet, shadow->GetExecutable(ToGuestAddr(new_), kSize));
+}
+
+}  // namespace
+
+}  // namespace berberis
