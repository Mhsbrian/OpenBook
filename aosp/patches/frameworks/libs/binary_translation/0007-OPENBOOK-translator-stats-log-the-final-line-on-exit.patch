index af2d63ee..bc9d7bc4 100644
--- a/kernel_api/arm64/syscall_emulation.cc
+++ b/kernel_api/arm64/syscall_emulation.cc
@@ -189,10 +189,11 @@ void RunGuestSyscall(ThreadState* state) {
     OnSyscall(state, guest_nr);
   }
 
-  // The guest's exit_group ends the process without the host's atexit
-  // handlers, so the translator counters log their last line here.
+  // The guest's exit_group (_exit) ends the process without the host's atexit
+  // handlers, so the translator counters log their last line here. A guest
+  // exit() ends in the host's exit() instead, and logs from its atexit handler.
   if (guest_nr == kGuestNrExitGroup) {
-    translator_stats::LogIfEnabled();
+    translator_stats::LogFinalLine();
   }
 
   // vDSO fast path for the hottest time syscalls.
diff --git a/runtime/arm64/translator_stats_test.cc b/runtime/arm64/translator_stats_test.cc
index 569bc501..7dfde012 100644
--- a/runtime/arm64/translator_stats_test.cc
+++ b/runtime/arm64/translator_stats_test.cc
@@ -32,6 +32,7 @@
 
 #include <cstdint>
 #include <cstdio>
+#include <cstdlib>
 #include <cstring>
 #include <string>
 #include <thread>
@@ -429,6 +430,110 @@ TEST_F(TranslatorStats, RawForkChildKeepsTheParentAsOwner) {
   EXPECT_EQ(WEXITSTATUS(status), 0) << "bit 0 owner, 1 baseline flag";
 }
 
+// What a fork() child wrote to stderr, where the host's liblog writes. body
+// ends the child's process. Buffers are flushed first, so the child's exit()
+// doesn't write the parent's again.
+struct ChildRun {
+  pid_t pid = -1;
+  int status = -1;
+  std::string err;
+};
+
+ChildRun RunInChild(void (*body)()) {
+  ChildRun run;
+  fflush(stdout);
+  fflush(stderr);
+  int fds[2];
+  if (pipe(fds) != 0) {
+    return run;
+  }
+  run.pid = fork();
+  if (run.pid == 0) {
+    close(fds[0]);
+    dup2(fds[1], STDERR_FILENO);
+    int null_fd = open("/dev/null", O_WRONLY);
+    dup2(null_fd, STDOUT_FILENO);
+    body();
+    _exit(99);
+  }
+  close(fds[1]);
+  char buf[4096];
+  ssize_t n;
+  while ((n = read(fds[0], buf, sizeof(buf))) > 0) {
+    run.err.append(buf, static_cast<size_t>(n));
+  }
+  close(fds[0]);
+  waitpid(run.pid, &run.status, 0);
+  return run;
+}
+
+// The pid of each "openbook-stats v1" line in out, in order.
+std::vector<pid_t> FinalLinePids(const std::string& out) {
+  std::vector<pid_t> pids;
+  const std::string kPrefix = "openbook-stats v1 pid=";
+  for (size_t at = out.find(kPrefix); at != std::string::npos; at = out.find(kPrefix, at + 1)) {
+    pids.push_back(static_cast<pid_t>(atoi(out.c_str() + at + kPrefix.size())));
+  }
+  return pids;
+}
+
+// A guest exit() or a return from main ends in the host's exit() (the native
+// bridge's guest libc forwards it), never at the guest exit_group syscall: the
+// atexit handler logs the final line.
+TEST_F(TranslatorStats, ExitLogsTheFinalLine) {
+  ChildRun run = RunInChild([] {
+    ts::Add(ts::kInstalledLite, 7);
+    exit(0);
+  });
+  ASSERT_TRUE(WIFEXITED(run.status)) << run.err;
+  EXPECT_EQ(WEXITSTATUS(run.status), 0) << run.err;
+  ASSERT_EQ(FinalLinePids(run.err), std::vector<pid_t>{run.pid}) << run.err;
+  EXPECT_NE(run.err.find(" installed_lite=7 "), std::string::npos) << run.err;
+}
+
+// One line per process, whichever exit path comes first (exit_group, then the
+// host's exit() in another thread, say).
+TEST_F(TranslatorStats, FinalLineIsLoggedOnce) {
+  ChildRun run = RunInChild([] {
+    ts::LogFinalLine();
+    ts::LogFinalLine();
+    exit(0);
+  });
+  ASSERT_TRUE(WIFEXITED(run.status)) << run.err;
+  EXPECT_EQ(FinalLinePids(run.err), std::vector<pid_t>{run.pid}) << run.err;
+}
+
+// Kept by pid, not once per address space or lineage: a child forked after
+// its parent logged logs its own line, and the parent doesn't log again.
+TEST_F(TranslatorStats, EachProcessLogsItsOwnFinalLine) {
+  ChildRun run = RunInChild([] {
+    ts::LogFinalLine();
+    pid_t grandchild = fork();
+    if (grandchild == 0) {
+      exit(0);
+    }
+    int status = 0;
+    waitpid(grandchild, &status, 0);
+    exit(WIFEXITED(status) && WEXITSTATUS(status) == 0 ? 0 : 1);
+  });
+  ASSERT_TRUE(WIFEXITED(run.status)) << run.err;
+  EXPECT_EQ(WEXITSTATUS(run.status), 0) << run.err;
+  std::vector<pid_t> pids = FinalLinePids(run.err);
+  ASSERT_EQ(pids.size(), 2u) << run.err;
+  EXPECT_EQ(pids[0], run.pid) << run.err;
+  EXPECT_NE(pids[1], run.pid) << run.err;
+}
+
+// Off: exit() logs nothing.
+TEST_F(TranslatorStats, OffExitLogsNothing) {
+  ChildRun run = RunInChild([] {
+    ts::SetEnabledForTesting(false);
+    exit(0);
+  });
+  ASSERT_TRUE(WIFEXITED(run.status)) << run.err;
+  EXPECT_TRUE(FinalLinePids(run.err).empty()) << run.err;
+}
+
 int g_opens = 0;
 int g_inherited_fd = -1;
 bool g_inherited_was_open_at_reopen = false;
