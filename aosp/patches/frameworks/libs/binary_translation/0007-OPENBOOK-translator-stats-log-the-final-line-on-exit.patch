diff --git a/runtime_primitives/translator_stats.cc b/runtime_primitives/translator_stats.cc
index 0b1282d9..8f9addc3 100644
--- a/runtime_primitives/translator_stats.cc
+++ b/runtime_primitives/translator_stats.cc
@@ -66,6 +66,20 @@ static_assert(sizeof(kNames) / sizeof(kNames[0]) == kNumCounters);
 
 std::atomic<uint64_t> g_init_ns{0};
 
+// The last pid that logged its final line. A pid, not a flag: a vfork child
+// shares this memory with its parent, and a fork child inherits it. Only the
+// last one is kept (see LogFinalLine in the header for what that guarantees).
+std::atomic<int> g_final_line_pid{0};
+
+// atexit handler. A guest exit() (and a return from main, which calls it) ends
+// in the host's exit(): the native bridge's guest libc replaces exit() with
+// one that runs the guest's __cxa_finalize and then calls the host's exit()
+// (frameworks/libs/native_bridge_support/android_api/libc/exit.c). That never
+// reaches the guest exit_group syscall, so the line is logged here.
+void LogFinalLineAtExit() {
+  LogFinalLine();
+}
+
 // pthread_atfork child handler: the child owns the counts from here on, and
 // what it inherited is its baseline.
 void OnForkChild() {
@@ -102,6 +116,10 @@ void Enable() {
   if (!fork_handler_registered) {
     ALOGE("berberis.stats: pthread_atfork failed; fork children keep their parent as owner");
   }
+  static bool exit_handler_registered = atexit(LogFinalLineAtExit) == 0;
+  if (!exit_handler_registered) {
+    ALOGE("berberis.stats: atexit failed; a guest exit() logs no final line");
+  }
   ALOGI("berberis.stats: on; block at 0x%lx (layout OBSTAT2, %lu counters, %lu bytes)",
         static_cast<unsigned long>(reinterpret_cast<uintptr_t>(&g_block)),
         static_cast<unsigned long>(kNumCounters),
@@ -123,10 +141,14 @@ void Init() {
