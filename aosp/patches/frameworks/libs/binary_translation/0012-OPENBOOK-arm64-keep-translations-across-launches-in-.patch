+// region digitalis
+namespace {
+
+std::atomic<GuestMappingObserver*> g_guest_mapping_observer{nullptr};
+
+// Holds the observer's exclusive lock, if there's an observer, around a host call.
+class ScopedObserverLock {
+ public:
+  ScopedObserverLock() : observer_(g_guest_mapping_observer.load(std::memory_order_acquire)) {
+    if (observer_ != nullptr) {
+      observer_->LockExclusive();
+    }
+  }
+  ~ScopedObserverLock() {
+    if (observer_ != nullptr) {
+      observer_->UnlockExclusive();
+    }
+  }
+  ScopedObserverLock(const ScopedObserverLock&) = delete;
+  ScopedObserverLock& operator=(const ScopedObserverLock&) = delete;
+  [[nodiscard]] GuestMappingObserver* observer() const { return observer_; }
+
+ private:
+  GuestMappingObserver* observer_;
+};
+
+}  // namespace
+
+void SetGuestMappingObserver(GuestMappingObserver* observer) {
+  g_guest_mapping_observer.store(observer, std::memory_order_release);
+}
+
+GuestMappingObserver* GetGuestMappingObserver() {
+  return g_guest_mapping_observer.load(std::memory_order_acquire);
+}
