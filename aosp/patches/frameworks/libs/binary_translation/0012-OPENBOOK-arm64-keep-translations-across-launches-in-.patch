+#ifndef BERBERIS_KERNEL_API_GUEST_MAPPING_OBSERVER_H_
+#define BERBERIS_KERNEL_API_GUEST_MAPPING_OBSERVER_H_
+
+#include <sys/types.h>
+
+#include <cstddef>
+
+namespace berberis {
+
+// region digitalis
+// Something that tracks guest mappings: the persistent translation cache's module registry
+// (ANAL-381). While one is set, every guest mmap, munmap, mprotect and mremap takes its
+// exclusive lock around the host call and the notification, so a reader holding the shared lock
+// sees mappings that can't change, and guest memory that can't be unmapped, under it. The
+// shadow updates and the invalidations they cause stay outside the lock. Without an observer,
+// the guest calls cost one atomic load.
+class GuestMappingObserver {
+ public:
+  virtual void LockExclusive() = 0;
+  virtual void UnlockExclusive() = 0;
+  // Called with the exclusive lock held, after the host call.
+  virtual void OnMap(void* addr, size_t length, int prot, int flags, int fd, off64_t offset) = 0;
+  virtual void OnUnmap(void* addr, size_t length) = 0;
+  virtual void OnProtect(void* addr, size_t length, int prot) = 0;
+  virtual void OnRemap(void* old_addr, size_t old_size, void* new_addr, size_t new_size) = 0;
+
+ protected:
+  ~GuestMappingObserver() = default;
+};
+
+void SetGuestMappingObserver(GuestMappingObserver* observer);
+[[nodiscard]] GuestMappingObserver* GetGuestMappingObserver();
+// endregion
+
+}  // namespace berberis
+
+#endif  // BERBERIS_KERNEL_API_GUEST_MAPPING_OBSERVER_H_
