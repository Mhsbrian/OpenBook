+  // persistent translation cache (ANAL-381). Each translation pass starts it afresh.
+  std::vector<uint32_t>* decoded_insns = nullptr;
+  // endregion
 };
 
 std::tuple<bool, GuestAddr> TryLiteTranslateRegion(GuestAddr start_pc,
