+using pcache::Mode;
+
+constexpr uint32_t kNop = 0xd503201f;
+constexpr uint32_t kBranchNext = 0x14000001;  // b .+4: ends a region.
+constexpr size_t kCodeOffset = 0x1000;        // File offset and ELF address of the code.
+constexpr size_t kCodeWords = 128;
+// Regions, as word offsets in the code.
+constexpr size_t kRegionA = 0;     // adrp, add, ldr, b: a guest address, a recovery point, a slot.
+constexpr size_t kRegionB = 16;    // 24 adds, ret: hot, heavy.
+constexpr size_t kRegionC = 64;    // 3 adds, b: a declined gear-up, settled lite.
+constexpr size_t kHeaderSize = 256;  // FileHeader.
+constexpr size_t kIndexEntrySize = 32;
+constexpr size_t kRecordHeaderSize = 48;
+
+std::vector<uint32_t> DefaultCode() {
+  std::vector<uint32_t> code(kCodeWords, kNop);
+  code[kRegionA + 0] = 0x90000000;  // adrp x0, .
+  code[kRegionA + 1] = 0x8b020023;  // add x3, x1, x2
+  code[kRegionA + 2] = 0xf9400020;  // ldr x0, [x1]
+  code[kRegionA + 3] = kBranchNext;
+  for (size_t i = 0; i < 24; i++) {
+    code[kRegionB + i] = 0x8b020063;  // add x3, x3, x2
+  }
+  code[kRegionB + 24] = 0xd65f03c0;  // ret: an indirect branch, through the main table.
+  for (size_t i = 0; i < 3; i++) {
+    code[kRegionC + i] = 0x8b020063;
+  }
+  code[kRegionC + 3] = kBranchNext;
+  return code;
+}
+
+// A minimal AArch64 ELF: one R+X PT_LOAD from offset 0, a GNU build-id note, the code at 0x1000.
+std::vector<uint8_t> MakeElf(const std::vector<uint32_t>& code, uint8_t build_id_seed) {
+  std::vector<uint8_t> f(kCodeOffset + code.size() * 4, 0);
+  Elf64_Ehdr eh{};
+  memcpy(eh.e_ident, ELFMAG, SELFMAG);
+  eh.e_ident[EI_CLASS] = ELFCLASS64;
+  eh.e_ident[EI_DATA] = ELFDATA2LSB;
+  eh.e_ident[EI_VERSION] = EV_CURRENT;
+  eh.e_type = ET_DYN;
+  eh.e_machine = EM_AARCH64;
+  eh.e_version = EV_CURRENT;
+  eh.e_phoff = sizeof(Elf64_Ehdr);
+  eh.e_ehsize = sizeof(Elf64_Ehdr);
+  eh.e_phentsize = sizeof(Elf64_Phdr);
+  eh.e_phnum = 2;
+  memcpy(f.data(), &eh, sizeof(eh));
+  Elf64_Phdr ph[2] = {};
+  ph[0].p_type = PT_LOAD;
+  ph[0].p_flags = PF_R | PF_X;
+  ph[0].p_filesz = ph[0].p_memsz = f.size();
+  ph[0].p_align = 0x1000;
+  ph[1].p_type = PT_NOTE;
+  ph[1].p_flags = PF_R;
+  ph[1].p_offset = ph[1].p_vaddr = 0x100;
+  ph[1].p_filesz = ph[1].p_memsz = 12 + 4 + 20;
+  ph[1].p_align = 4;
+  memcpy(f.data() + eh.e_phoff, ph, sizeof(ph));
+  uint32_t nhdr[3] = {4, 20, NT_GNU_BUILD_ID};
+  memcpy(f.data() + 0x100, nhdr, sizeof(nhdr));
+  memcpy(f.data() + 0x10c, "GNU", 4);
+  for (int i = 0; i < 20; i++) {
+    f[0x110 + i] = static_cast<uint8_t>(build_id_seed * 31 + i);
+  }
+  memcpy(f.data() + kCodeOffset, code.data(), code.size() * 4);
+  return f;
+}
+
+uint32_t Crc32c(const uint8_t* p, size_t n, size_t zero_at) {
+  uint32_t crc = ~0u;
+  for (size_t i = 0; i < n; i++) {
+    uint8_t b = (i >= zero_at && i < zero_at + 4) ? 0 : p[i];
+    crc ^= b;
+    for (int k = 0; k < 8; k++) {
+      crc = (crc & 1) ? (crc >> 1) ^ 0x82f63b78u : crc >> 1;
+    }
+  }
+  return ~crc;
+}
+
+std::vector<uint8_t> ReadFile(const std::string& path) {
+  std::vector<uint8_t> out;
+  FILE* f = fopen(path.c_str(), "rb");
+  if (f == nullptr) {
+    return out;
+  }
+  uint8_t buf[65536];
+  size_t n;
+  while ((n = fread(buf, 1, sizeof(buf), f)) > 0) {
+    out.insert(out.end(), buf, buf + n);
+  }
+  fclose(f);
+  return out;
+}
+
+void WriteFile(const std::string& path, const std::vector<uint8_t>& bytes) {
+  FILE* f = fopen(path.c_str(), "wb");
+  ASSERT_NE(f, nullptr) << path;
+  ASSERT_EQ(fwrite(bytes.data(), 1, bytes.size(), f), bytes.size());
+  fclose(f);
+}
+
+void RemoveTree(const std::string& dir) {
+  DIR* d = opendir(dir.c_str());
+  if (d == nullptr) {
+    return;
+  }
+  while (dirent* e = readdir(d)) {
+    std::string name = e->d_name;
+    if (name == "." || name == "..") {
+      continue;
+    }
+    std::string path = dir + "/" + name;
+    struct stat st;
+    if (lstat(path.c_str(), &st) == 0 && S_ISDIR(st.st_mode)) {
+      RemoveTree(path);
+    } else {
+      unlink(path.c_str());
+    }
+  }
+  closedir(d);
+  rmdir(dir.c_str());
+}
+
+struct Record {
+  uint64_t vaddr;
+  uint8_t tier;
+  uint64_t offset;  // In the data file.
+  std::vector<uint8_t> bytes;
+  uint32_t guest_size() const { return Field<uint32_t>(32); }
+  uint32_t code_size() const { return Field<uint32_t>(36); }
+  uint32_t num_operands() const { return Field<uint32_t>(40); }
+  uint32_t num_recovery_points() const { return Field<uint32_t>(44); }
+  size_t code_at() const { return kRecordHeaderSize + ((guest_size() + 7) & ~7u); }
+  size_t operands_at() const { return code_at() + ((code_size() + 7) & ~7u); }
+  size_t recovery_at() const { return operands_at() + num_operands() * 24; }
+  template <typename T>
+  T Field(size_t at) const {
+    T v;
+    memcpy(&v, bytes.data() + at, sizeof(v));
+    return v;
+  }
+  template <typename T>
+  void SetField(size_t at, T v) {
+    memcpy(bytes.data() + at, &v, sizeof(v));
+  }
+  void FixCrc() { SetField<uint32_t>(8, Crc32c(bytes.data(), bytes.size(), 8)); }
+  // The first code byte no operand covers.
+  size_t FirstPlainCodeByte() const {
+    for (size_t k = 0; k < code_size(); k++) {
+      bool covered = false;
+      for (uint32_t i = 0; i < num_operands(); i++) {
+        uint32_t off = Field<uint32_t>(operands_at() + i * 24);
+        uint8_t width = Field<uint8_t>(operands_at() + i * 24 + 4);
+        covered |= k >= off && k < off + width;
+      }
+      if (!covered) {
+        return k;
+      }
+    }
+    return SIZE_MAX;
+  }
+};
+
+class PersistentCacheTest : public TranslationTest {
+ protected:
+  void SetUp() override {
+    TranslationTest::SetUp();
+    std::string tmpl = ::testing::TempDir() + "/pcache-XXXXXX";
+    std::vector<char> buf(tmpl.begin(), tmpl.end());
+    buf.push_back('\0');
+    ASSERT_NE(mkdtemp(buf.data()), nullptr);
+    root_ = buf.data();
+    cache_dir_ = root_ + "/cache";
+    elf_path_ = root_ + "/lib.so";
+    WriteFile(elf_path_, MakeElf(DefaultCode(), 1));
+    settings_ = {2 /* two-gear */, static_cast<uint32_t>(GetGearUpMinInsns())};
+  }
+
+  void TearDown() override {
+    pcache::g_before_mapping_check_hook_for_testing = nullptr;
+    pcache::g_in_mapping_check_hook_for_testing = nullptr;
+    g_before_publish_hook_for_testing = nullptr;
+    g_pcache_verify_fresh_hook_for_testing = nullptr;
+    g_pcache_verify_before_decode_hook_for_testing = nullptr;
+    pcache::SetCapForTesting(0);
+    for (auto& [base, size] : mapped_) {
+      MunmapForGuest(base, size);
+    }
+    pcache::ShutdownForTesting();
+    RemoveTree(root_);
+    TranslationTest::TearDown();
+  }
+
+  void StartProcess(Mode mode = Mode::kOn) { pcache::InitForTesting(mode, cache_dir_, settings_); }
+  void EndProcess() { pcache::ShutdownForTesting(); }
+
+  size_t ElfSize() const { return kCodeOffset + kCodeWords * 4; }
+
+  // Maps `path` as the guest linker maps an executable segment.
+  uint8_t* MapElf(const std::string& path, void* fixed = nullptr) {
+    int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+    EXPECT_GE(fd, 0);
+    void* p = MmapForGuest(
+        fixed, ElfSize(), PROT_READ | PROT_EXEC, MAP_PRIVATE | (fixed ? MAP_FIXED : 0), fd, 0);
+    close(fd);
+    EXPECT_NE(p, MAP_FAILED);
+    if (fixed == nullptr) {
+      mapped_.emplace_back(p, ElfSize());
+    }
+    return static_cast<uint8_t*>(p);
+  }
+
+  void Unmap(uint8_t* base) {
+    for (auto it = mapped_.begin(); it != mapped_.end(); ++it) {
+      if (it->first == base) {
+        mapped_.erase(it);
+        break;
+      }
+    }
+    MunmapForGuest(base, ElfSize());
+  }
+
+  // Maps the library at a new address, and unmaps the old mapping if there is one.
+  uint8_t* Remap(uint8_t* old_base, const std::string& path) {
+    uint8_t* base = MapElf(path);
+    if (old_base != nullptr) {
+      EXPECT_NE(base, old_base);
+      Unmap(old_base);
+    }
+    return base;
+  }
+
+  static GuestAddr Pc(uint8_t* base, size_t region) {
+    return ToGuestAddr(base + kCodeOffset + region * 4);
+  }
+
+  static void Translate(GuestAddr pc) {
+    ThreadState state{};
+    state.cpu.insn_addr = pc;
+    berberis_HandleNotTranslated(&state);
+  }
+
+  static void GearUp(GuestAddr pc) {
+    ThreadState state{};
+    state.cpu.insn_addr = pc;
+    berberis_HandleLiteCounterThresholdReached(&state);
+  }
+
+  static GuestCodeEntry* Entry(GuestAddr pc) {
+    return TranslationCache::GetInstance()->ProfilerLookupGuestCodeEntryByGuestPC(pc);
+  }
+
+  static bool IsTranslated(GuestAddr pc) {
+    HostCodeAddr code = TranslationCache::GetInstance()->GetHostCodePtr(pc)->load();
+    return code != kEntryNotTranslated && code != kEntryNoExec && code != kEntryInterpret;
+  }
+
+  static const uint8_t* HostCode(GuestAddr pc) {
+    return static_cast<const uint8_t*>(
+        AsHostCode(TranslationCache::GetInstance()->GetHostCodePtr(pc)->load()));
+  }
+
+  // The module's cache file names (one module per test library).
+  std::string FileWith(const char* suffix) const {
+    std::string found;
+    DIR* d = opendir(cache_dir_.c_str());
+    if (d == nullptr) {
+      return found;
+    }
+    while (dirent* e = readdir(d)) {
+      std::string name = e->d_name;
+      if (name.size() > strlen(suffix) &&
+          name.compare(name.size() - strlen(suffix), strlen(suffix), suffix) == 0) {
+        found = cache_dir_ + "/" + name;
+      }
+    }
+    closedir(d);
+    return found;
+  }
+  std::string DataFile() const { return FileWith(".pcache"); }
+  // Total size of the cache files ending in `suffix`.
+  static size_t ReadFileSize(const std::string& dir, const char* suffix) {
+    size_t total = 0;
+    DIR* d = opendir(dir.c_str());
+    if (d == nullptr) {
+      return 0;
+    }
+    while (dirent* e = readdir(d)) {
+      std::string name = e->d_name;
+      struct stat st;
+      if (name.size() > strlen(suffix) &&
+          name.compare(name.size() - strlen(suffix), strlen(suffix), suffix) == 0 &&
+          stat((dir + "/" + name).c_str(), &st) == 0) {
+        total += st.st_size;
+      }
+    }
+    closedir(d);
+    return total;
+  }
+  std::string IndexFile() const { return FileWith(".pidx"); }
+
+  size_t IndexEntries() const {
+    std::vector<uint8_t> idx = ReadFile(IndexFile());
+    return idx.size() < kHeaderSize ? 0 : (idx.size() - kHeaderSize) / kIndexEntrySize;
+  }
+
+  // The last record written for `region`.
+  Record FindRecord(size_t region, uint8_t tier = 0) const {
+    std::vector<uint8_t> idx = ReadFile(IndexFile());
+    std::vector<uint8_t> data = ReadFile(DataFile());
+    Record r{};
+    uint64_t vaddr = kCodeOffset + region * 4;
+    for (size_t at = kHeaderSize; at + kIndexEntrySize <= idx.size(); at += kIndexEntrySize) {
+      uint64_t v;
+      uint64_t off;
+      uint32_t size;
+      memcpy(&v, idx.data() + at, 8);
+      memcpy(&off, idx.data() + at + 8, 8);
+      memcpy(&size, idx.data() + at + 16, 4);
+      uint8_t t = idx[at + 20];
+      if (v == vaddr && (tier == 0 || t == tier) && off + size <= data.size()) {
+        r.vaddr = v;
+        r.tier = t;
+        r.offset = off;
+        r.bytes.assign(data.begin() + off, data.begin() + off + size);
+      }
+    }
+    return r;
+  }
+
+  void WriteRecord(const Record& r) const {
+    std::vector<uint8_t> data = ReadFile(DataFile());
+    ASSERT_LE(r.offset + r.bytes.size(), data.size());
+    memcpy(data.data() + r.offset, r.bytes.data(), r.bytes.size());
+    WriteFile(DataFile(), data);
+  }
+
+  // Counter deltas from a snapshot.
+  struct Counts {
+    uint64_t v[pcache::kNumCounters];
+    Counts() {
+      for (int i = 0; i < pcache::kNumCounters; i++) {
+        v[i] = pcache::GetCounter(static_cast<pcache::Counter>(i));
+      }
+    }
+    uint64_t Delta(pcache::Counter c) const { return pcache::GetCounter(c) - v[c]; }
+  };
+
+  // Writes region A's record in one launch, from a library mapped at a first address.
+  uint8_t* WriteRegionA() {
+    StartProcess();
+    uint8_t* base = MapElf(elf_path_);
+    Translate(Pc(base, kRegionA));
+    EXPECT_TRUE(IsTranslated(Pc(base, kRegionA)));
+    EndProcess();
+    EXPECT_EQ(IndexEntries(), 1u);
+    return base;
+  }
+
+  std::string root_;
+  std::string cache_dir_;
+  std::string elf_path_;
+  pcache::TranslatorSettings settings_;
+  std::vector<std::pair<void*, size_t>> mapped_;
+};
+
+TEST_F(PersistentCacheTest, OffByDefault) {
+  EXPECT_FALSE(pcache::Active());
+  EXPECT_EQ(pcache::GetMode(), Mode::kOff);
+}
+
+// A region written by one launch is installed by the next, re-linked for the module's new address,
+// and matches a fresh translation there.
+TEST_F(PersistentCacheTest, LiteRegionLoadsInTheNextLaunch) {
+  Counts c0;
+  uint8_t* base1 = WriteRegionA();
+  EXPECT_EQ(c0.Delta(pcache::kMisses), 1u);
+  EXPECT_EQ(c0.Delta(pcache::kRecordsWritten), 1u);
+  Record r = FindRecord(kRegionA);
+  ASSERT_FALSE(r.bytes.empty());
+  EXPECT_EQ(r.tier, uint8_t(pcache::Tier::kLiteCounter));
+  EXPECT_EQ(r.guest_size(), 16u);
+  EXPECT_GT(r.num_operands(), 0u);
+  EXPECT_GT(r.num_recovery_points(), 0u);
+
+  StartProcess();
+  Counts c1;
+  uint8_t* base2 = Remap(base1, elf_path_);
+  Translate(Pc(base2, kRegionA));
+  EXPECT_EQ(c1.Delta(pcache::kHitsLite), 1u);
+  EXPECT_EQ(c1.Delta(pcache::kMisses), 0u);
+  ASSERT_TRUE(IsTranslated(Pc(base2, kRegionA)));
+  EXPECT_EQ(Entry(Pc(base2, kRegionA))->kind, GuestCodeEntry::Kind::kLiteTranslated);
+  EXPECT_EQ(Entry(Pc(base2, kRegionA))->guest_size, 16u);
+  EndProcess();
+  EXPECT_EQ(IndexEntries(), 1u) << "a loaded region is written again";
+
+  StartProcess(Mode::kVerify);
+  Counts c2;
+  uint8_t* base3 = Remap(base2, elf_path_);
+  Translate(Pc(base3, kRegionA));
+  EXPECT_EQ(c2.Delta(pcache::kVerifyMatch), 1u);
+  EXPECT_EQ(c2.Delta(pcache::kHitsLite), 1u);
+  EXPECT_EQ(c2.Delta(pcache::kVerifyMismatch) + c2.Delta(pcache::kVerifyInconclusive), 0u);
+}
+
+// Hot regions start in the tier they ended on: heavy, or lite settled after a declined gear-up.
+TEST_F(PersistentCacheTest, HeavyAndSettledRegionsLoadInTheirTier) {
+  StartProcess();
+  uint8_t* base1 = MapElf(elf_path_);
+  Translate(Pc(base1, kRegionB));
+  GearUp(Pc(base1, kRegionB));
+  ASSERT_EQ(Entry(Pc(base1, kRegionB))->kind, GuestCodeEntry::Kind::kHeavyOptimized);
+  Translate(Pc(base1, kRegionC));
+  GearUp(Pc(base1, kRegionC));
+  ASSERT_EQ(Entry(Pc(base1, kRegionC))->kind, GuestCodeEntry::Kind::kLiteTranslated);
+  EndProcess();
+  EXPECT_EQ(IndexEntries(), 4u);
+  EXPECT_FALSE(FindRecord(kRegionB, uint8_t(pcache::Tier::kHeavy)).bytes.empty());
+  EXPECT_FALSE(FindRecord(kRegionC, uint8_t(pcache::Tier::kLiteSettled)).bytes.empty());
+
+  StartProcess();
+  Counts c1;
+  uint8_t* base2 = Remap(base1, elf_path_);
+  Translate(Pc(base2, kRegionB));
+  Translate(Pc(base2, kRegionC));
+  EXPECT_EQ(c1.Delta(pcache::kHitsHeavy), 1u);
+  EXPECT_EQ(c1.Delta(pcache::kHitsLite), 1u);
+  EXPECT_EQ(Entry(Pc(base2, kRegionB))->kind, GuestCodeEntry::Kind::kHeavyOptimized);
+  EXPECT_EQ(Entry(Pc(base2, kRegionC))->kind, GuestCodeEntry::Kind::kLiteTranslated);
+  // Settled: no counter, so it never asks to gear up again.
+  Record settled = FindRecord(kRegionC, uint8_t(pcache::Tier::kLiteSettled));
+  for (uint32_t i = 0; i < settled.num_operands(); i++) {
+    EXPECT_NE(settled.Field<uint8_t>(settled.operands_at() + i * 24 + 5),
+              uint8_t(SymbolKind::kCounter));
+  }
+  EndProcess();
+
+  StartProcess(Mode::kVerify);
+  Counts c2;
+  uint8_t* base3 = Remap(base2, elf_path_);
+  Translate(Pc(base3, kRegionB));
+  Translate(Pc(base3, kRegionC));
+  EXPECT_EQ(c2.Delta(pcache::kVerifyMatch), 2u);
+  EXPECT_EQ(c2.Delta(pcache::kVerifyMismatch), 0u);
+}
