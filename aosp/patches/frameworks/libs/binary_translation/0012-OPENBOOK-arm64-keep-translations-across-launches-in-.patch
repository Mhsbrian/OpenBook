+// berberis.pcache=verify. The candidate is installed only if it equals, code and recovery
+// points at one address, a fresh translation with its tier and parameters. Otherwise the fresh
+// one is, and the region is translated once more to tell a wrong candidate (the two fresh ones
+// agree: a mismatch) from a translator that doesn't repeat itself (they don't: inconclusive).
+// Called after the candidate's checks, with the mapping lock the caller holds until the chosen
+// code is published: both translations read guest memory.
+Verdict VerifyCandidate(const pcache::Candidate& c,
+                        GuestCodeEntry* entry,
+                        uintptr_t counter,
+                        MachineCode* fresh) {
+  ScratchCode scratch;
+  if (!scratch.ok() || !TranslateLikeCandidate(c, entry, fresh, 1)) {
+    pcache::Count(pcache::kVerifyFallback);
+    return Verdict::kTranslate;
+  }
+  if (g_pcache_verify_fresh_hook_for_testing != nullptr) {
+    g_pcache_verify_fresh_hook_for_testing(fresh, 1);
+  }
+  Normalized candidate;
+  Normalized fresh1;
+  if (!NormalizeFresh(fresh, scratch, &fresh1)) {
+    pcache::Count(pcache::kVerifyFallback);
+    return Verdict::kFresh;
+  }
+  if (!NormalizeCandidate(c, scratch, counter, &candidate)) {
+    pcache::Count(pcache::kRejectsRecord);
+    return Verdict::kFresh;
+  }
+  if (candidate == fresh1) {
+    pcache::Count(pcache::kVerifyMatch);
+    return Verdict::kCandidate;
+  }
+  MachineCode again;
+  Normalized fresh2;
+  if (!TranslateLikeCandidate(c, entry, &again, 2)) {
+    pcache::Count(pcache::kVerifyFallback);
+    return Verdict::kFresh;
+  }
+  if (g_pcache_verify_fresh_hook_for_testing != nullptr) {
+    g_pcache_verify_fresh_hook_for_testing(&again, 2);
+  }
+  if (!NormalizeFresh(&again, scratch, &fresh2)) {
+    pcache::Count(pcache::kVerifyFallback);
+    return Verdict::kFresh;
+  }
+  bool code_differs = candidate.code != fresh1.code;
+  if (fresh1 == fresh2) {
+    pcache::Count(pcache::kVerifyMismatch);
+    ALOGW("berberis.pcache: verify mismatch at 0x%lx, module %s + 0x%lx (+%u, tier %d): %s differ",
+          static_cast<unsigned long>(c.pc),
+          pcache::ModuleKey(c),
+          static_cast<unsigned long>(c.pc - c.module_start),
+          c.guest_size,
+          static_cast<int>(c.tier),
+          code_differs ? "code" : "recovery points");
+  } else {
+    pcache::Count(pcache::kVerifyInconclusive);
+  }
+  return Verdict::kFresh;
