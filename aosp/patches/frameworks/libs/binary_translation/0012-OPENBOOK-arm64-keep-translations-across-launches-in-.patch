+// A writable buffer in the low 2 GiB, as the code pool is, where translations are installed to
+// be compared. Never executed.
+class ScratchCode {
+ public:
+  static constexpr size_t kSize = 1 << 20;
+  ScratchCode()
+      : buf_(mmap(nullptr,
+                  kSize,
+                  PROT_READ | PROT_WRITE,
+                  MAP_PRIVATE | MAP_ANONYMOUS | MAP_32BIT,
+                  -1,
+                  0)) {}
+  ~ScratchCode() {
+    if (buf_ != MAP_FAILED) {
+      munmap(buf_, kSize);
+    }
+  }
+  ScratchCode(const ScratchCode&) = delete;
+  ScratchCode& operator=(const ScratchCode&) = delete;
+  [[nodiscard]] bool ok() const { return buf_ != MAP_FAILED; }
+  [[nodiscard]] uint8_t* data() const { return static_cast<uint8_t*>(buf_); }
+
+ private:
+  void* buf_;
+};
+
+bool NormalizeFresh(MachineCode* machine_code, const ScratchCode& scratch, Normalized* out) {
+  if (machine_code->install_size() > ScratchCode::kSize) {
+    return false;
+  }
+  RecoveryMap recovery_map;
+  machine_code->InstallUnsafe(scratch.data(), &recovery_map);
+  uintptr_t base = reinterpret_cast<uintptr_t>(scratch.data());
+  out->code.assign(scratch.data(), scratch.data() + machine_code->install_size());
+  out->recovery_points.clear();
+  for (const auto& [fault, recovery] : recovery_map) {
+    out->recovery_points.emplace_back(fault - base, recovery - base);
+  }
+  std::sort(out->recovery_points.begin(), out->recovery_points.end());
+  return true;
+}
+
+bool NormalizeCandidate(const pcache::Candidate& c,
+                        const ScratchCode& scratch,
+                        uintptr_t counter,
+                        Normalized* out) {
+  out->code.resize(c.code_size);
+  if (!pcache::RelinkCandidateAt(
+          c, out->code.data(), reinterpret_cast<uintptr_t>(scratch.data()), counter)) {
+    return false;
+  }
+  out->recovery_points = c.recovery_points;
+  std::sort(out->recovery_points.begin(), out->recovery_points.end());
+  return true;
+}
