+// ---- Mapping registry ----
+
+class Registry final : public GuestMappingObserver {
+ public:
+  void LockExclusive() override { mutex_.lock(); }
+  void UnlockExclusive() override { mutex_.unlock(); }
+  void LockShared() { mutex_.lock_shared(); }
+  void UnlockShared() { mutex_.unlock_shared(); }
+
+  void OnMap(void* addr, size_t length, int prot, int flags, int fd, off64_t offset) override {
+    GuestAddr start = ToGuestAddr(addr);
+    GuestAddr end = start + AlignUp(length, kPageSize);
+    Remove(start, end);
+    if (fd < 0 || (flags & MAP_ANONYMOUS) || (flags & kMapType) != MAP_PRIVATE) {
+      return;
+    }
+    struct stat st;
+    if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode) || st.st_nlink == 0) {
+      return;  // Deleted files and memfds are never cached.
+    }
+    Mapping m{end, next_id_++, static_cast<uint64_t>(st.st_dev), static_cast<uint64_t>(st.st_ino),
+              static_cast<uint64_t>(offset), prot, nullptr, 0, 0};
+    if ((prot & PROT_EXEC) && !(prot & PROT_WRITE)) {
+      Attribute(start, fd, st, &m);
+    }
+    mappings_.emplace(start, m);
+  }
+
+  void OnUnmap(void* addr, size_t length) override {
+    GuestAddr start = ToGuestAddr(addr);
+    Remove(start, start + AlignUp(length, kPageSize));
+  }
+
+  void OnProtect(void* addr, size_t length, int prot) override {
+    GuestAddr start = ToGuestAddr(addr);
+    GuestAddr end = start + AlignUp(length, kPageSize);
+    std::vector<std::pair<GuestAddr, Mapping>> changed;
+    for (auto it = FirstOverlap(start); it != mappings_.end() && it->first < end;) {
+      if (it->second.prot == prot) {
+        ++it;
+        continue;
+      }
+      changed.emplace_back(*it);
+      it = mappings_.erase(it);
+    }
+    for (auto& [m_start, m] : changed) {
+      // Whatever changed protection loses its attribution: write access, or none, means the
+      // bytes may not be what was mapped.
+      GuestAddr mid_start = std::max(m_start, start);
+      GuestAddr mid_end = std::min(m.end, end);
+      AddPiece(m_start, m, m_start, mid_start, m.prot);
+      AddPiece(m_start, m, mid_start, mid_end, prot);
+      AddPiece(m_start, m, mid_end, m.end, m.prot);
+    }
+  }
+
+  void OnRemap(void* old_addr, size_t old_size, void* new_addr, size_t new_size) override {
+    GuestAddr old_start = ToGuestAddr(old_addr);
+    GuestAddr new_start = ToGuestAddr(new_addr);
+    // The moved range isn't attributed again: a conservative miss.
+    Remove(old_start, old_start + AlignUp(old_size, kPageSize));
+    Remove(new_start, new_start + AlignUp(new_size, kPageSize));
+  }
+
+  // With the lock held: the attributed mapping holding all of [pc, pc + size), or null.
+  const Mapping* Lookup(GuestAddr pc, size_t size) const {
+    auto it = mappings_.upper_bound(pc);
+    if (it == mappings_.begin()) {
+      return nullptr;
+    }
+    --it;
+    const Mapping& m = it->second;
+    if (m.module == nullptr || pc + size < pc || pc + size > m.end) {
+      return nullptr;
+    }
+    return &m;
+  }
+
+  void Clear() { mappings_.clear(); }
+
+ private:
+  std::map<GuestAddr, Mapping>::iterator FirstOverlap(GuestAddr start) {
+    auto it = mappings_.upper_bound(start);
+    if (it != mappings_.begin()) {
+      auto prev = std::prev(it);
+      if (prev->second.end > start) {
+        return prev;
+      }
+    }
+    return it;
+  }
+
+  // Adds [start, end) of `m` (which started at m_start) as a new, unattributed mapping.
+  void AddPiece(GuestAddr m_start, const Mapping& m, GuestAddr start, GuestAddr end, int prot) {
+    if (start >= end) {
+      return;
+    }
+    Mapping piece = m;
+    piece.end = end;
+    piece.id = next_id_++;
+    piece.offset = m.offset + (start - m_start);
+    piece.prot = prot;
+    piece.module = nullptr;
+    piece.module_start = piece.module_end = 0;
+    mappings_.emplace(start, piece);
+  }
+
+  // Forgets [start, end): what was there is gone or replaced. Parts of mappings outside it stay,
+  // unattributed.
+  void Remove(GuestAddr start, GuestAddr end) {
+    std::vector<std::pair<GuestAddr, Mapping>> removed;
+    for (auto it = FirstOverlap(start); it != mappings_.end() && it->first < end;) {
+      removed.emplace_back(*it);
+      it = mappings_.erase(it);
+    }
+    for (auto& [m_start, m] : removed) {
+      AddPiece(m_start, m, m_start, std::min(start, m.end), m.prot);
+      AddPiece(m_start, m, std::max(end, m_start), m.end, m.prot);
+    }
+  }
+
+  // Finds the ELF image an executable mapping at `start` belongs to: a tracked mapping of the same
+  // file at or below it whose file offset holds an AArch64 ELF header, whose first PT_LOAD it is,
+  // and whose executable PT_LOAD this mapping is, at the matching address and file offset.
+  void Attribute(GuestAddr start, int fd, const struct stat& st, Mapping* exec) {
+    std::vector<std::pair<GuestAddr, uint64_t>> candidates;  // {mapping start, file offset}
+    candidates.emplace_back(start, exec->offset);
+    auto it = mappings_.lower_bound(start);
+    for (int i = 0; i < kMaxHeaderCandidates && it != mappings_.begin(); i++) {
+      --it;
+      if (it->second.dev == exec->dev && it->second.ino == exec->ino &&
+          start - it->first <= (1ull << 30)) {
+        candidates.emplace_back(it->first, it->second.offset);
+      }
+    }
+    for (const auto& [cand_start, elf_offset] : candidates) {
+      Elf64_Ehdr eh;
+      if (!ReadFull(fd, &eh, sizeof(eh), elf_offset) || memcmp(eh.e_ident, ELFMAG, SELFMAG) != 0 ||
+          eh.e_ident[EI_CLASS] != ELFCLASS64 || eh.e_ident[EI_DATA] != ELFDATA2LSB ||
+          eh.e_machine != EM_AARCH64 || eh.e_phentsize != sizeof(Elf64_Phdr) || eh.e_phnum == 0 ||
+          eh.e_phnum > 64) {
+        continue;
+      }
+      Elf64_Phdr ph[64];
+      if (!ReadFull(fd, ph, eh.e_phnum * sizeof(Elf64_Phdr), elf_offset + eh.e_phoff)) {
+        continue;
+      }
+      const Elf64_Phdr* first = nullptr;
+      uint64_t load_end = 0;
+      for (int i = 0; i < eh.e_phnum; i++) {
+        if (ph[i].p_type == PT_LOAD) {
+          if (first == nullptr || ph[i].p_vaddr < first->p_vaddr) {
+            first = &ph[i];
+          }
+          load_end = std::max<uint64_t>(load_end, ph[i].p_vaddr + ph[i].p_memsz);
+        }
+      }
+      if (first == nullptr || PageStart(first->p_offset) != 0) {
+        continue;
+      }
+      GuestAddr bias = cand_start - PageStart(first->p_vaddr);
+      bool matched = false;
+      for (int i = 0; i < eh.e_phnum && !matched; i++) {
+        matched = ph[i].p_type == PT_LOAD && (ph[i].p_flags & PF_X) &&
+                  bias + PageStart(ph[i].p_vaddr) == start &&
+                  elf_offset + PageStart(ph[i].p_offset) == exec->offset;
+      }
+      if (!matched) {
+        continue;
+      }
+      std::string build_id;
+      for (int i = 0; i < eh.e_phnum && build_id.empty(); i++) {
+        if (ph[i].p_type == PT_NOTE && ph[i].p_filesz <= 1024) {
+          uint8_t notes[1024];
+          if (ReadFull(fd, notes, ph[i].p_filesz, elf_offset + ph[i].p_offset)) {
+            build_id = FindBuildId(notes, ph[i].p_filesz);
+          }
+        }
+      }
+      std::string key;
+      if (!build_id.empty()) {
+        key = "b" + Hex(reinterpret_cast<const uint8_t*>(build_id.data()), build_id.size());
+      } else {
+        uint64_t mtime_ns = static_cast<uint64_t>(st.st_mtim.tv_sec) * 1'000'000'000ull +
+                            static_cast<uint64_t>(st.st_mtim.tv_nsec);
+        key = "s" + HexNum(st.st_dev) + "-" + HexNum(st.st_ino) + "-" + HexNum(st.st_size) + "-" +
+              HexNum(mtime_ns);
+      }
+      key += "-" + HexNum(elf_offset);
+      exec->module = GetModule(key);
+      exec->module_start = bias;
+      exec->module_end = bias + load_end;
+      return;
+    }
+  }
+
+  static Module* GetModule(const std::string& key) {
+    State* state = GetState();
+    std::lock_guard<std::mutex> lock(state->modules_mutex);
+    auto& slot = state->modules[key];
+    if (!slot) {
+      slot = std::make_unique<Module>();
+      slot->key = key;
+      std::string base = state->dir + "/" + key;
+      slot->data_path = base + ".pcache";
+      slot->index_path = base + ".pidx";
+      slot->lock_path = base + ".lock";
+    }
+    return slot.get();
+  }
+
+  std::shared_mutex mutex_;
+  std::map<GuestAddr, Mapping> mappings_;
+  uint64_t next_id_ = 1;
+};
+
+// ---- Module files ----
+
+// Opens the module's files for reading, given a matching header pair. Fills the index; on a bad
+// index entry, keeps what came before it. `valid_index_size` is the index file's good prefix.
+bool ReadModuleFiles(Module* m, uint64_t* valid_index_size) {
+  int ifd = open(m->index_path.c_str(), O_RDONLY | O_CLOEXEC);
+  if (ifd < 0) {
+    return false;
+  }
+  struct stat ist;
+  FileHeader ih;
+  bool ok = fstat(ifd, &ist) == 0 && ReadFull(ifd, &ih, sizeof(ih), 0) &&
+            HeaderMatches(ih, kIndexMagic, m->key);
+  std::vector<IndexEntry> entries;
+  if (ok) {
+    size_t n = (ist.st_size - sizeof(FileHeader)) / sizeof(IndexEntry);
+    entries.resize(n);
+    ok = n == 0 || ReadFull(ifd, entries.data(), n * sizeof(IndexEntry), sizeof(FileHeader));
+  }
+  close(ifd);
+  if (!ok) {
+    return false;
+  }
+  // The data file is opened second: every index entry read above was written after its record.
+  int dfd = open(m->data_path.c_str(), O_RDONLY | O_CLOEXEC);
+  if (dfd < 0) {
+    return false;
+  }
+  struct stat dst;
+  FileHeader dh;
+  ok = fstat(dfd, &dst) == 0 && ReadFull(dfd, &dh, sizeof(dh), 0) &&
+       HeaderMatches(dh, kDataMagic, m->key) && dh.nonce == ih.nonce;
+  void* map = MAP_FAILED;
+  if (ok) {
+    map = mmap(nullptr, dst.st_size, PROT_READ, MAP_PRIVATE, dfd, 0);
+  }
+  close(dfd);
+  if (map == MAP_FAILED) {
+    return false;
+  }
+  m->data_map = map;
+  m->data_size = dst.st_size;
+  m->data_ino = dst.st_ino;
+  m->index_ino = ist.st_ino;
+  m->data_size_on_disk = dst.st_size;
+  *valid_index_size = sizeof(FileHeader);
+  for (const IndexEntry& e : entries) {
+    if (Crc32cExcept(reinterpret_cast<const uint8_t*>(&e), sizeof(e), offsetof(IndexEntry, crc)) !=
+        e.crc) {
+      break;  // A torn or corrupt tail: everything past it is translated afresh.
+    }
+    *valid_index_size += sizeof(IndexEntry);
+    auto [it, inserted] = m->index.emplace(e.vaddr, e);
+    // The tier a region ended on wins; within a tier, the later record.
+    if (!inserted && e.tier >= it->second.tier) {
+      it->second = e;
+    }
+  }
+  return true;
+}
+
+// Writes a header to a temporary file and renames it into place.
+bool PublishFile(const std::string& path, const FileHeader& header, uint64_t* ino) {
+  std::string tmp = path + ".tmp." + std::to_string(GetpidSyscall());
+  int fd = open(tmp.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0600);
+  if (fd < 0) {
+    return false;
+  }
+  bool ok = WriteFull(fd, &header, sizeof(header));
+  struct stat st;
+  ok = ok && fstat(fd, &st) == 0;
+  close(fd);
+  if (!ok || rename(tmp.c_str(), path.c_str()) != 0) {
+    unlink(tmp.c_str());
+    return false;
+  }
+  *ino = st.st_ino;
+  return true;
+}
+
+bool CreateModuleFiles(Module* m) {
+  uint64_t nonce = translator_stats::NowNs() ^ (uint64_t(GetpidSyscall()) << 40) ^
+                   reinterpret_cast<uintptr_t>(m);
+  FileHeader dh;
+  FileHeader ih;
+  MakeHeader(kDataMagic, m->key, nonce, &dh);
+  MakeHeader(kIndexMagic, m->key, nonce, &ih);
+  if (!PublishFile(m->data_path, dh, &m->data_ino) ||
+      !PublishFile(m->index_path, ih, &m->index_ino)) {
+    return false;
+  }
+  m->data_size_on_disk = sizeof(FileHeader);
+  m->index_size_on_disk = sizeof(FileHeader);
+  return true;
+}
+
+bool TryBecomeWriter(Module* m) {
+  State* state = GetState();
+  if (state->cap_reached.load(std::memory_order_relaxed)) {
+    return false;
+  }
+  int fd = open(m->lock_path.c_str(), O_RDWR | O_CREAT | O_CLOEXEC, 0600);
+  if (fd < 0) {
+    return false;
+  }
+  TagHostOwnedFdUnsafe(fd);
+  if (flock(fd, LOCK_EX | LOCK_NB) != 0) {
+    CloseHostOwnedFdUnsafe(fd);  // Another process writes this module; this one only reads.
+    return false;
+  }
+  for (size_t i = 0; i < kMaxWriterModules; i++) {
+    int expected = -1;
+    if (g_lock_fds[i].compare_exchange_strong(expected, fd)) {
+      m->lock_slot = static_cast<int>(i);
+      m->lock_fd = fd;
+      m->lock_identity = GetFdIdentityUnsafe(fd);
+      return true;
+    }
+  }
+  CloseHostOwnedFdUnsafe(fd);
+  return false;
+}
+
+void OpenModule(Module* m) {
+  std::lock_guard<std::mutex> lock(m->open_mutex);
+  if (m->opened.load(std::memory_order_relaxed)) {
+    return;
+  }
+  State* state = GetState();
+  bool writer = TryBecomeWriter(m);
+  uint64_t valid_index_size = 0;
+  bool exists = access(m->data_path.c_str(), F_OK) == 0;
+  bool readable = ReadModuleFiles(m, &valid_index_size);
+  if (!readable) {
+    if (exists) {
+      Count(kRejectsFile);
+    }
+    if (m->data_map != nullptr) {
+      munmap(m->data_map, m->data_size);
+    }
+    m->data_map = nullptr;
+    m->data_size = 0;
+    m->index.clear();
+    if (writer && !CreateModuleFiles(m)) {
+      writer = false;
+    }
+  } else if (writer) {
+    // Drop a torn index tail, so new entries aren't appended after it.
+    int ifd = open(m->index_path.c_str(), O_WRONLY | O_CLOEXEC);
+    struct stat st;
+    if (ifd < 0 || fstat(ifd, &st) != 0 || static_cast<uint64_t>(st.st_ino) != m->index_ino ||
+        ftruncate(ifd, valid_index_size) != 0) {
+      writer = false;
+    }
+    if (ifd >= 0) {
+      close(ifd);
+    }
+    m->index_size_on_disk = valid_index_size;
+  }
+  if (!writer && m->lock_fd >= 0) {
+    g_lock_fds[m->lock_slot].store(-1);
+    CloseHostOwnedFdUnsafe(m->lock_fd);
+    m->lock_fd = -1;
+  }
+  m->writer = writer;
+  if (writer) {
+    std::lock_guard<std::mutex> wlock(state->writer_mutex);
+    state->writer_modules.push_back(m);
+  }
+  m->opened.store(true, std::memory_order_release);
+}
+
+void EnsureOpen(Module* m) {
+  if (!m->opened.load(std::memory_order_acquire)) {
+    OpenModule(m);
+  }
+}
+
+// ---- Flushing ----
+
+struct Batch {
+  Module* module;
+  std::vector<uint8_t> data;
+  std::vector<IndexEntry> index;
+};
+
+bool AppendToFile(const std::string& path, uint64_t ino, uint64_t expected_size, const void* buf,
+                  size_t n) {
+  int fd = open(path.c_str(), O_WRONLY | O_APPEND | O_CLOEXEC);
+  if (fd < 0) {
+    return false;
+  }
+  struct stat st;
+  bool ok = fstat(fd, &st) == 0 && static_cast<uint64_t>(st.st_ino) == ino &&
+            static_cast<uint64_t>(st.st_size) == expected_size && WriteFull(fd, buf, n);
+  close(fd);
+  return ok;
+}
+
+uint64_t DirectoryBytes(const std::string& dir);
+
+// `dir_bytes` is the cache directory's size, which every process of the app writes into: the cap
+// is the app's, not this process's.
+void WriteBatch(State* state, Batch* batch, uint64_t* dir_bytes) {
+  Module* m = batch->module;
+  if (m->write_failed.load() || GetpidSyscall() != state->pid) {
+    return;
+  }
+  uint64_t bytes = batch->data.size() + batch->index.size() * sizeof(IndexEntry);
+  if (*dir_bytes + bytes > state->cap_bytes) {
+    state->cap_reached.store(true);
+    Count(kNotPersistable, batch->index.size());
+    return;
+  }
+  // The lock is held through an fd the guest could have closed or dup2'ed over.
+  if (!FdIdentityMatches(GetFdIdentityUnsafe(m->lock_fd), m->lock_identity)) {
+    m->write_failed.store(true);
+    return;
+  }
+  translator_stats::ScopedTimer timer(translator_stats::kPcacheWriteNs);
+  uint64_t base = m->data_size_on_disk;
+  if (!AppendToFile(m->data_path, m->data_ino, base, batch->data.data(), batch->data.size())) {
+    m->write_failed.store(true);
+    return;
+  }
+  m->data_size_on_disk += batch->data.size();
+  for (IndexEntry& e : batch->index) {
+    e.record_offset += base;
+    e.crc =
+        Crc32cExcept(reinterpret_cast<const uint8_t*>(&e), sizeof(e), offsetof(IndexEntry, crc));
+  }
+  size_t index_bytes = batch->index.size() * sizeof(IndexEntry);
+  if (!AppendToFile(m->index_path, m->index_ino, m->index_size_on_disk, batch->index.data(),
+                    index_bytes)) {
+    m->write_failed.store(true);
+    return;
+  }
+  m->index_size_on_disk += index_bytes;
+  *dir_bytes += bytes;
+  Count(kRecordsWritten, batch->index.size());
+  Count(kBytesWritten, bytes);
+}
+
+// With flush_mutex held.
+void FlushLocked(State* state) {
+  std::vector<Batch> batches;
+  {
+    std::lock_guard<std::mutex> lock(state->writer_mutex);
+    for (Module* m : state->writer_modules) {
+      if (!m->pending_index.empty()) {
+        batches.push_back({m, std::move(m->pending_data), std::move(m->pending_index)});
+        m->pending_data.clear();
+        m->pending_index.clear();
+      }
+    }
+    state->pending_bytes.store(0);
+    state->last_flush_ns.store(translator_stats::NowNs());
+  }
+  if (batches.empty()) {
+    return;
+  }
+  // Measured at each flush, so it counts what the app's other processes wrote. Processes flushing
+  // at the same moment can each still go over by one batch.
+  uint64_t dir_bytes = DirectoryBytes(state->dir);
+  for (Batch& batch : batches) {
+    WriteBatch(state, &batch, &dir_bytes);
+  }
+}
+
+void FlushAtExit() {
+  if (Active()) {
+    FlushAll();
+  }
+}
+
+// In a fork child: stop, without taking any lock the parent may have held. The child's copies of
+// the writer lock fds are closed, so a lock outlives neither its owner nor this child.
+void OnForkChild() {
+  if (g_disabled.exchange(true)) {
+    return;
+  }
+  State* state = GetState();
+  if (state != nullptr && GetGuestMappingObserver() == state->registry.get()) {
+    SetGuestMappingObserver(nullptr);
+  }
+  for (auto& slot : g_lock_fds) {
+    int fd = slot.exchange(-1);
+    if (fd >= 0) {
+      CloseHostOwnedFdUnsafe(fd);
+    }
+  }
+}
+
+Mode ParseMode() {
+  static ConfigStr config("BERBERIS_PCACHE", "berberis.pcache");
+  const char* value = config.get();
+  if (value == nullptr || *value == '\0' || strcmp(value, "off") == 0) {
+    return Mode::kOff;
+  }
+  if (strcmp(value, "on") == 0) {
+    return Mode::kOn;
+  }
+  if (strcmp(value, "verify") == 0) {
+    return Mode::kVerify;
+  }
+  ALOGW("berberis.pcache: unknown value '%s', off", value);
+  return Mode::kOff;
+}
+
+uint64_t DirectoryBytes(const std::string& dir) {
+  uint64_t total = 0;
+  DIR* d = opendir(dir.c_str());
+  if (d == nullptr) {
+    return 0;
+  }
+  while (dirent* e = readdir(d)) {
+    struct stat st;
+    if (fstatat(dirfd(d), e->d_name, &st, AT_SYMLINK_NOFOLLOW) == 0 && S_ISREG(st.st_mode)) {
+      total += st.st_size;
+    }
+  }
+  closedir(d);
+  return total;
+}
+
+bool Start(Mode mode, const std::string& dir, const TranslatorSettings& settings) {
+  if (mode == Mode::kOff || dir.empty()) {
+    return false;
+  }
+  if (mkdir(dir.c_str(), 0700) != 0 && errno != EEXIST) {
+    ALOGW("berberis.pcache: can't create %s: %s", dir.c_str(), strerror(errno));
+    return false;
+  }
+  struct stat st;
+  if (stat(dir.c_str(), &st) != 0 || !S_ISDIR(st.st_mode) || st.st_uid != geteuid()) {
+    ALOGW("berberis.pcache: %s isn't a directory of this user", dir.c_str());
+    return false;
+  }
+  auto* state = new State();
+  state->mode = mode;
+  state->dir = dir;
+  state->pid = GetpidSyscall();
+  if (!MakeFingerprint(settings, &state->fingerprint)) {
+    ALOGW("berberis.pcache: the translator has no build-id; off");
+    delete state;
+    return false;
+  }
+  state->registry = std::make_unique<Registry>();
+  if (g_cap_bytes_for_testing != 0) {
+    state->cap_bytes = g_cap_bytes_for_testing;
+  }
+  state->last_flush_ns.store(translator_stats::NowNs());
+  for (auto& slot : g_lock_fds) {
+    slot.store(-1);
+  }
+  g_record_default_before = g_record_persistent_relocs_by_default;
+  // Persisted translations name every absolute operand; the records come from the translator.
+  g_record_persistent_relocs_by_default = true;
+  g_state.store(state, std::memory_order_release);
+  g_disabled.store(false);
+  SetGuestMappingObserver(state->registry.get());
+  static bool hooks_registered = [] {
+    pthread_atfork(nullptr, nullptr, OnForkChild);
+    g_guest_fork_child_hooks.Add(OnForkChild);
+    g_guest_exit_hooks.Add(FlushAtExit);
+    atexit(FlushAtExit);
+    return true;
+  }();
+  (void)hooks_registered;
+  return true;
+}
+
+}  // namespace
+
+void Count(Counter counter, uint64_t value) {
+  g_counters[counter].fetch_add(value, std::memory_order_relaxed);
+  translator_stats::Add(kStatsCounter[counter], value);
+}
+
+uint64_t GetCounter(Counter counter) {
+  return g_counters[counter].load(std::memory_order_relaxed);
+}
+
+void Init(const TranslatorSettings& settings) {
+  Mode mode = ParseMode();
+  if (mode == Mode::kOff) {
+    return;
+  }
+  std::string dir;
+  if (const char* env = getenv("BERBERIS_PCACHE_DIR"); env != nullptr && *env != '\0') {
+    dir = env;
+  } else if (const char* app = GetAppPrivateDir(); app != nullptr) {
+    dir = std::string(app) + "/code_cache/berberis";
+  } else {
+    return;  // Isolated processes and others without a private directory translate as today.
+  }
+  if (!Start(mode, dir, settings)) {
+    return;
+  }
+  ALOGI("berberis.pcache: %s, %s", mode == Mode::kVerify ? "verify" : "on", dir.c_str());
+}
+
+bool Active() {
+  State* state = GetState();
+  return state != nullptr && !g_disabled.load(std::memory_order_relaxed);
+}
+
+Mode GetMode() {
+  State* state = GetState();
+  return state != nullptr ? state->mode : Mode::kOff;
+}
+
+ScopedMappingReadLock::ScopedMappingReadLock() : locked_(Active()) {
+  if (locked_) {
+    GetState()->registry->LockShared();
+  }
+}
+
+ScopedMappingReadLock::~ScopedMappingReadLock() {
+  if (locked_) {
+    GetState()->registry->UnlockShared();
+  }
+}
+
+FindResult FindCandidate(GuestAddr pc, Candidate* c) {
+  State* state = GetState();
+  Module* m;
+  {
+    ScopedMappingReadLock lock;
+    const Mapping* mapping = state->registry->Lookup(pc, 4);
+    if (mapping == nullptr) {
+      return FindResult::kNotCacheable;
+    }
+    m = mapping->module;
+    c->module = m;
+    c->mapping_id = mapping->id;
+    c->module_start = mapping->module_start;
+  }
+  EnsureOpen(m);
+  auto it = m->index.find(pc - c->module_start);
+  if (m->data_map == nullptr || it == m->index.end()) {
+    Count(kMisses);
+    return FindResult::kMiss;
+  }
+  const IndexEntry& e = it->second;
+  // Check 2, on a private copy.
+  if (e.record_size < sizeof(RecordHeader) || e.record_size > (16u << 20) ||
+      e.record_offset > m->data_size || e.record_size > m->data_size - e.record_offset) {
+    Count(kRejectsRecord);
+    return FindResult::kRejected;
+  }
+  std::vector<uint8_t>& rec = c->record;
+  rec.assign(static_cast<const uint8_t*>(m->data_map) + e.record_offset,
+             static_cast<const uint8_t*>(m->data_map) + e.record_offset + e.record_size);
+  RecordHeader h;
+  memcpy(&h, rec.data(), sizeof(h));
+  uint64_t expected_size = sizeof(RecordHeader);
+  bool ok = h.magic == kRecordMagic && h.size == rec.size() && h.tier >= 1 && h.tier <= 3 &&
+            h.tier == e.tier && h.vaddr == e.vaddr && h.guest_size > 0 &&
+            h.guest_size % 4 == 0 && h.guest_size <= kMaxGuestSize && h.code_size > 0 &&
+            h.code_size <= kMaxCodeSize && h.num_operands <= kMaxOperands &&
+            h.num_recovery_points <= kMaxRecoveryPoints;
+  if (ok) {
+    expected_size += Pad8(h.guest_size) + Pad8(h.code_size) +
+                     uint64_t{h.num_operands} * sizeof(PackedOperand) +
+                     uint64_t{h.num_recovery_points} * 8;
+    ok = expected_size == h.size &&
+         Crc32cExcept(rec.data(), rec.size(), offsetof(RecordHeader, crc)) == h.crc;
+  }
+  // pc + size and the end the translation was made with stay in range, without wrapping.
+  GuestAddr start = c->module_start + h.vaddr;
+  ok = ok && start == pc && h.vaddr <= UINT64_MAX - c->module_start &&
+       start + h.guest_size > start && h.end >= h.vaddr + h.guest_size &&
+       h.end <= UINT64_MAX - c->module_start;
+  if (!ok) {
+    Count(kRejectsRecord);
+    return FindResult::kRejected;
+  }
+  c->pc = pc;
+  c->end_pc = c->module_start + h.end;
+  c->guest_size = h.guest_size;
+  c->code_size = h.code_size;
+  c->tier = static_cast<Tier>(h.tier);
+  c->guest_bytes_at = sizeof(RecordHeader);
+  c->code_at = c->guest_bytes_at + Pad8(h.guest_size);
+  const uint8_t* p = rec.data() + c->code_at + Pad8(h.code_size);
+  c->operands.clear();
+  c->operands.reserve(h.num_operands);
+  for (uint32_t i = 0; i < h.num_operands; i++, p += sizeof(PackedOperand)) {
+    PackedOperand po;
+    memcpy(&po, p, sizeof(po));
+    if ((po.width != 4 && po.width != 8) || po.kind > uint8_t(SymbolKind::kResource) ||
+        po.offset > h.code_size || po.width > h.code_size - po.offset ||
+        (po.width == 4 && po.next_pc > h.code_size)) {
+      Count(kRejectsRecord);
+      return FindResult::kRejected;
+    }
+    c->operands.push_back({po.offset, po.width, static_cast<SymbolKind>(po.kind), po.next_pc,
+                           po.arg});
+  }
+  c->recovery_points.clear();
+  c->recovery_points.reserve(h.num_recovery_points);
+  for (uint32_t i = 0; i < h.num_recovery_points; i++, p += 8) {
+    uint32_t v[2];
+    memcpy(v, p, 8);
+    if (v[0] >= h.code_size || v[1] > h.code_size) {
+      Count(kRejectsRecord);
+      return FindResult::kRejected;
+    }
+    c->recovery_points.emplace_back(v[0], v[1]);
+  }
+  return FindResult::kFound;
+}
+
+bool CheckMappingAndBytes(const Candidate& c) {
+  if (g_in_mapping_check_hook_for_testing != nullptr) {
+    g_in_mapping_check_hook_for_testing(c.pc);
+  }
+  const Mapping* mapping = GetState()->registry->Lookup(c.pc, c.guest_size);
+  if (mapping == nullptr || mapping->id != c.mapping_id || mapping->module != c.module ||
+      !GuestMapShadow::GetInstance()->IsExecutable(c.pc, c.guest_size)) {
+    Count(kRejectsMapping);
+    return false;
+  }
+  // Mapped and readable while the lock is held: the registry only lists what's mapped.
+  if (memcmp(ToHostAddr<const void>(c.pc), c.guest_bytes(), c.guest_size) != 0) {
+    Count(kRejectsBytes);
+    return false;
+  }
+  return true;
+}
+
+bool RelinkCandidateAt(const Candidate& c, uint8_t* out, uintptr_t install_addr,
+                       uintptr_t counter) {
+  memcpy(out, c.code(), c.code_size);
+  return RelinkTranslation(out,
+                           c.code_size,
+                           c.operands.data(),
+                           c.operands.size(),
+                           c.module_start,
+                           install_addr,
+                           counter);
+}
+
+const char* ModuleKey(const Candidate& c) {
+  return c.module != nullptr ? static_cast<const Module*>(c.module)->key.c_str() : "?";
+}
+
+HostCodePiece InstallCandidate(const Candidate& c, uintptr_t counter) {
+  HostCodeAddr addr = GetDefaultCodePoolInstance()->AddPrebuilt(
+      c.code_size,
+      [&](uint8_t* bytes, uintptr_t install_addr) {
+        return RelinkCandidateAt(c, bytes, install_addr, counter);
+      },
+      c.recovery_points.data(),
+      c.recovery_points.size());
+  return {addr, c.code_size};
+}
+
+namespace {
+
+// A capture's storage, per thread: a thread translates one region at a time.
+struct CaptureBuffers {
+  std::vector<uint32_t> decoded_insns;
+  std::vector<uint8_t> record;
+  SymbolizedCode symbolized;
+};
+
+CaptureBuffers& Buffers() {
+  thread_local CaptureBuffers buffers;
+  return buffers;
+}
+
+}  // namespace
+
+std::vector<uint32_t>* Capture::decoded_insns() {
+  return active_ ? &Buffers().decoded_insns : nullptr;
+}
+
+void Capture::Begin(GuestAddr pc) {
+  active_ = false;
+  has_record_ = false;
+  State* state = GetState();
+  if (!Active() || state->cap_reached.load(std::memory_order_relaxed)) {
+    return;
+  }
+  Module* m;
+  {
+    ScopedMappingReadLock lock;
+    const Mapping* mapping = state->registry->Lookup(pc, 4);
+    if (mapping == nullptr) {
+      return;
+    }
+    m = mapping->module;
+    mapping_id_ = mapping->id;
+    module_start_ = mapping->module_start;
+    module_end_ = mapping->module_end;
+  }
+  EnsureOpen(m);
+  if (!m->writer || m->write_failed.load(std::memory_order_relaxed)) {
+    return;  // Another process writes this module.
+  }
+  module_ = m;
+  Buffers().decoded_insns.clear();
+  active_ = true;
+}
+
+void Capture::OnInstalled(const MachineCode& machine_code,
+                          HostCodePiece piece,
+                          GuestAddr pc,
+                          size_t guest_size,
+                          GuestAddr end_pc,
+                          Tier tier,
+                          uintptr_t counter) {
+  if (!active_) {
+    return;
+  }
+  active_ = false;
+  CaptureBuffers& buffers = Buffers();
+  if (guest_size == 0 || guest_size > kMaxGuestSize ||
+      buffers.decoded_insns.size() * 4 != guest_size ||
+      !machine_code.record_persistent_relocs() || end_pc < pc + guest_size ||
+      pc < module_start_ || piece.size == 0 || piece.size > kMaxCodeSize) {
+    Count(kNotPersistable);
+    return;
+  }
+  {
+    // The bytes were decoded from this mapping only if it's the one Begin saw.
+    ScopedMappingReadLock lock;
+    const Mapping* mapping = GetState()->registry->Lookup(pc, guest_size);
+    if (mapping == nullptr || mapping->id != mapping_id_) {
+      Count(kNotPersistable);
+      return;
+    }
+  }
+  const auto* code = reinterpret_cast<const uint8_t*>(AsHostCode(piece.code));
+  SymbolizedCode& sym = buffers.symbolized;
+  SymbolizeTranslationInto(machine_code,
+                           code,
+                           reinterpret_cast<uintptr_t>(code),
+                           GuestModule{module_start_, module_end_},
+                           counter,
+                           &sym);
+  if (sym.reason != NotPersistable::kNo || sym.operands.size() > kMaxOperands ||
+      sym.recovery_points.size() > kMaxRecoveryPoints) {
+    Count(kNotPersistable);
+    return;
+  }
+  RecordHeader h{};
+  h.magic = kRecordMagic;
+  h.tier = static_cast<uint8_t>(tier);
+  h.vaddr = pc - module_start_;
+  h.end = end_pc - module_start_;
+  h.guest_size = static_cast<uint32_t>(guest_size);
+  h.code_size = piece.size;
+  h.num_operands = sym.operands.size();
+  h.num_recovery_points = sym.recovery_points.size();
+  h.size = sizeof(RecordHeader) + Pad8(h.guest_size) + Pad8(h.code_size) +
+           h.num_operands * sizeof(PackedOperand) + h.num_recovery_points * 8;
+  std::vector<uint8_t>& record = buffers.record;
+  record.assign(h.size, 0);
+  uint8_t* p = record.data() + sizeof(RecordHeader);
+  memcpy(p, buffers.decoded_insns.data(), guest_size);
+  p += Pad8(h.guest_size);
+  memcpy(p, code, piece.size);
+  p += Pad8(h.code_size);
+  for (const SymbolicOperand& op : sym.operands) {
+    PackedOperand po{op.offset, op.width, static_cast<uint8_t>(op.kind), 0, op.next_pc, 0, op.arg};
+    memcpy(p, &po, sizeof(po));
+    p += sizeof(po);
+  }
+  for (const RecoveryPointOffsets& rp : sym.recovery_points) {
+    uint32_t v[2] = {rp.fault, rp.recovery};
+    memcpy(p, v, 8);
+    p += 8;
+  }
+  memcpy(record.data(), &h, sizeof(h));
+  h.crc = Crc32cExcept(record.data(), record.size(), offsetof(RecordHeader, crc));
+  memcpy(record.data(), &h, sizeof(h));
+  vaddr_ = h.vaddr;
+  tier_ = tier;
+  has_record_ = true;
+  active_ = true;
+}
+
+void Capture::Commit() {
+  if (!active_ || !has_record_) {
+    return;
+  }
+  active_ = false;
+  has_record_ = false;
+  const std::vector<uint8_t>& record = Buffers().record;
+  State* state = GetState();
+  if (!Active()) {
+    return;
+  }
+  auto* m = static_cast<Module*>(module_);
+  {
+    std::lock_guard<std::mutex> lock(state->writer_mutex);
+    if (m->write_failed.load(std::memory_order_relaxed)) {
+      return;
+    }
+    IndexEntry e{};
+    e.vaddr = vaddr_;
+    e.record_offset = m->pending_data.size();
+    e.record_size = record.size();
+    e.tier = static_cast<uint8_t>(tier_);
+    m->pending_data.insert(m->pending_data.end(), record.begin(), record.end());
+    m->pending_index.push_back(e);
+    state->pending_bytes.fetch_add(record.size() + sizeof(IndexEntry));
+  }
+  MaybeFlush();
+}
+
+void MaybeFlush() {
+  State* state = GetState();
+  if (state == nullptr || g_disabled.load(std::memory_order_relaxed)) {
+    return;
+  }
+  uint64_t pending = state->pending_bytes.load(std::memory_order_relaxed);
+  if (pending == 0) {
+    return;
+  }
+  // Opportunistic: a translating thread flushes when it gets here, not on a timer.
+  if (pending < kFlushBytes &&
+      translator_stats::NowNs() - state->last_flush_ns.load(std::memory_order_relaxed) <
+          kFlushIntervalNs) {
+    return;
+  }
+  if (state->flush_mutex.try_lock()) {
+    FlushLocked(state);
+    state->flush_mutex.unlock();
+  }
+}
+
+void FlushAll() {
+  State* state = GetState();
+  if (state == nullptr || g_disabled.load(std::memory_order_relaxed)) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(state->flush_mutex);
+  FlushLocked(state);
+}
+
+void InitForTesting(Mode mode, const std::string& dir, const TranslatorSettings& settings) {
+  ShutdownForTesting();
+  Start(mode, dir, settings);
+}
+
+void ShutdownForTesting() {
+  State* state = GetState();
+  if (state == nullptr) {
+    return;
+  }
+  if (!g_disabled.load()) {
+    FlushAll();
+  }
+  if (GetGuestMappingObserver() == state->registry.get()) {
+    SetGuestMappingObserver(nullptr);
+  }
+  for (auto& [key, m] : state->modules) {
+    if (m->data_map != nullptr) {
+      munmap(m->data_map, m->data_size);
+    }
+    if (m->lock_slot >= 0 && g_lock_fds[m->lock_slot].exchange(-1) >= 0) {
+      CloseHostOwnedFdUnsafe(m->lock_fd);
+    }
+  }
+  g_state.store(nullptr);
+  delete state;
+  g_record_persistent_relocs_by_default = g_record_default_before;
+  g_disabled.store(false);
+}
+
+void OnForkChildForTesting() {
+  OnForkChild();
+}
+
+bool IsWriterForTesting(const std::string& key_part) {
+  State* state = GetState();
+  if (state == nullptr) {
+    return false;
+  }
+  std::lock_guard<std::mutex> lock(state->modules_mutex);
+  for (auto& [key, m] : state->modules) {
+    if (key.find(key_part) != std::string::npos && m->opened.load() && m->writer &&
+        !m->write_failed.load() && !g_disabled.load()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void SetCapForTesting(uint64_t bytes) {
+  g_cap_bytes_for_testing = bytes;
+}
+
+int WriterLockFdForTesting(const std::string& key_part) {
+  State* state = GetState();
+  if (state == nullptr) {
+    return -1;
+  }
+  std::lock_guard<std::mutex> lock(state->modules_mutex);
+  for (auto& [key, m] : state->modules) {
+    if (key.find(key_part) != std::string::npos && m->opened.load() && m->writer) {
+      return m->lock_fd;
+    }
+  }
+  return -1;
+}
+// endregion
+
+}  // namespace berberis::pcache
