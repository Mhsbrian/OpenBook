+// What a translation depends on besides its guest bytes and addresses (section 3.3, check 1).
+struct Fingerprint {
+  uint8_t translator_build_id[32];
+  uint32_t translator_build_id_size;
+  uint32_t format_version;
+  uint32_t translation_mode;
+  uint32_t gearup_min_insns;
+  uint64_t config_flags;
+  uint8_t host_cpu[48];
+  uint32_t host_page_size;
+  uint32_t guest_page_size;
+  uint32_t guest_machine;
+  uint32_t recording;
+};
+static_assert(sizeof(host_platform::PlatformCapabilities) <= sizeof(Fingerprint::host_cpu));
+
+constexpr char kDataMagic[8] = {'O', 'B', 'P', 'C', 'D', 'A', 'T', '1'};
+constexpr char kIndexMagic[8] = {'O', 'B', 'P', 'C', 'I', 'D', 'X', '1'};
+
+struct FileHeader {
+  char magic[8];
+  uint32_t header_size;
+  uint32_t crc;  // Over the header, this field taken as zero.
+  uint64_t nonce;  // Pairs an index with its data file.
+  Fingerprint fingerprint;
+  char module_key[112];
+};
+static_assert(sizeof(Fingerprint) == 120);
+static_assert(sizeof(FileHeader) == 256);
+
+constexpr uint32_t kRecordMagic = 0x4352424f;  // "OBRC"
+
+struct RecordHeader {
+  uint32_t magic;
+  uint32_t size;  // Of the whole record, a multiple of 8.
+  uint32_t crc;   // Over the whole record, this field taken as zero.
+  uint8_t tier;
+  uint8_t reserved[3];
+  uint64_t vaddr;  // Region start - module start: the ELF address.
+  uint64_t end;    // The translation's end_pc - module start.
+  uint32_t guest_size;
+  uint32_t code_size;
+  uint32_t num_operands;
+  uint32_t num_recovery_points;
+};
+static_assert(sizeof(RecordHeader) == 48);
