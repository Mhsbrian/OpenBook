+// An unmap that starts while a candidate is compared waits for the comparison: guest memory read
+// under the mapping lock stays mapped. Its invalidation, made before it waits, stops the load.
+TEST_F(PersistentCacheTest, UnmapWaitsForTheComparison) {
+  uint8_t* base1 = WriteRegionA();
+  StartProcess();
+  static uint8_t* g_base;
+  static std::atomic<int> g_unmapped;
+  static std::thread* g_thread;
+  static bool g_waited_while_locked;
+  g_base = Remap(base1, elf_path_);
+  for (auto it = mapped_.begin(); it != mapped_.end(); ++it) {
+    if (it->first == g_base) {
+      mapped_.erase(it);  // Unmapped by the test.
+      break;
+    }
+  }
+  g_unmapped = 0;
+  g_waited_while_locked = false;
+  pcache::g_in_mapping_check_hook_for_testing = [](GuestAddr pc) {
+    g_thread = new std::thread([] {
+      MunmapForGuest(g_base, kCodeOffset + kCodeWords * 4);
+      g_unmapped = 1;
+    });
+    // Wait for the unmap's invalidation, then give the unmap time to finish if it could.
+    for (int i = 0; i < 5000 && GuestMapShadow::GetInstance()->IsExecutable(pc, 4); i++) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    g_waited_while_locked = g_unmapped == 0;
+  };
+  Counts c;
+  Translate(Pc(g_base, kRegionA));
+  g_thread->join();
+  delete g_thread;
+  EXPECT_TRUE(g_waited_while_locked) << "the unmap didn't wait for the mapping lock";
+  EXPECT_EQ(g_unmapped, 1);
+  EXPECT_EQ(c.Delta(pcache::kRejectsMapping), 1u);
+  EXPECT_EQ(c.Delta(pcache::kHitsLite), 0u);
+  EXPECT_FALSE(IsTranslated(Pc(g_base, kRegionA)));
+}
