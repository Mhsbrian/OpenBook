+// ---- verify reads guest memory under the mapping lock too ----
+
+// A guest mapping call on another thread, started while `verify` is about to decode: it clears
+// the executable bits, then has to wait for the mapping lock, so the memory stays mapped while
+// the decoder reads it. Without the lock, the decoder would fault.
+struct RacingMappingCall {
+  static inline uint8_t* base;
+  static inline int attempt;      // Which of verify's translations to race.
+  static inline bool unmap;       // Unmap, or take all protection away.
+  static inline std::thread* thread;
+  static inline std::atomic<int> done;
+  static inline bool waited_while_locked;
+
+  static void Arm(uint8_t* b, int a, bool u) {
+    base = b;
+    attempt = a;
+    unmap = u;
+    thread = nullptr;
+    done = 0;
+    waited_while_locked = false;
+    g_pcache_verify_before_decode_hook_for_testing = Hook;
+  }
+
+  static void Hook(GuestAddr pc, int a) {
+    if (a != attempt || thread != nullptr) {
+      return;
+    }
+    thread = new std::thread([] {
+      size_t size = kCodeOffset + kCodeWords * 4;
+      if (unmap) {
+        MunmapForGuest(base, size);
+      } else {
+        MprotectForGuest(base, size, PROT_NONE);
+      }
+      done = 1;
+    });
+    for (int i = 0; i < 5000 && GuestMapShadow::GetInstance()->IsExecutable(pc, 4); i++) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    waited_while_locked = done == 0;
+  }
+
+  static void Join() {
+    if (thread != nullptr) {
+      thread->join();
+      delete thread;
+      thread = nullptr;
+    }
+  }
+};
+
+// Protection taken away during verify's first translation of a good candidate: the decode is
+// safe, and the invalidation the mprotect made stops the publication.
+TEST_F(PersistentCacheTest, VerifyHoldsTheMappingWhileTranslating) {
+  uint8_t* base1 = WriteRegionA();
+  StartProcess(Mode::kVerify);
+  uint8_t* base2 = Remap(base1, elf_path_);
+  GuestAddr pc = Pc(base2, kRegionA);
+  RacingMappingCall::Arm(base2, 1, /*unmap=*/false);
+  Counts c;
+  Translate(pc);
+  RacingMappingCall::Join();
+  EXPECT_TRUE(RacingMappingCall::waited_while_locked) << "the mprotect didn't wait for the lock";
+  EXPECT_EQ(RacingMappingCall::done, 1);
+  EXPECT_EQ(c.Delta(pcache::kVerifyMatch), 1u);
+  EXPECT_EQ(c.Delta(pcache::kHitsLite), 0u) << "published after the invalidation";
+  EXPECT_FALSE(IsTranslated(pc));
+}
