+#ifndef BERBERIS_RUNTIME_PRIMITIVES_PROCESS_HOOKS_H_
+#define BERBERIS_RUNTIME_PRIMITIVES_PROCESS_HOOKS_H_
+
+#include <atomic>
+#include <cstddef>
+
+namespace berberis {
+
+// region digitalis
+// Process events that the code which sees them (kernel_api, guest_os_primitives) can't pass to
+// the code that needs them (the persistent translation cache in runtime/arm64, ANAL-381) by a
+// direct call. A few fixed slots, no allocation: the fork hooks run in a child that may have
+// inherited locked mutexes.
+inline constexpr size_t kMaxProcessHooks = 4;
+
+struct ProcessHookList {
+  std::atomic<void (*)()> hooks[kMaxProcessHooks];
+
+  void Add(void (*hook)()) {
+    for (auto& slot : hooks) {
+      void (*expected)() = nullptr;
+      if (slot.compare_exchange_strong(expected, hook) || expected == hook) {
+        return;
+      }
+    }
+  }
+
+  void Run() {
+    for (auto& slot : hooks) {
+      void (*hook)() = slot.load(std::memory_order_acquire);
+      if (hook != nullptr) {
+        hook();
+      }
+    }
+  }
+};
+
+// Run by the guest's exit_group, which ends the process without the host's atexit handlers.
+inline ProcessHookList g_guest_exit_hooks;
+// Run in the child of a guest fork (a raw clone without CLONE_VM), which skips pthread_atfork.
+// Hooks must not take locks the parent may have held.
+inline ProcessHookList g_guest_fork_child_hooks;
+// endregion
+
+}  // namespace berberis
+
+#endif  // BERBERIS_RUNTIME_PRIMITIVES_PROCESS_HOOKS_H_
