+#ifndef BERBERIS_RUNTIME_ARM64_PERSISTENT_CACHE_H_
+#define BERBERIS_RUNTIME_ARM64_PERSISTENT_CACHE_H_
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "berberis/assembler/machine_code.h"
+#include "berberis/guest_state/guest_addr.h"
+#include "berberis/runtime_primitives/host_code.h"
+
+#include "relocatable_code.h"
+
+namespace berberis::pcache {
+
+// region digitalis
+// The persistent translation cache (ANAL-381, OpenBook docs/digitalis-translation-cache.md):
+// translations of file-backed guest code, kept in the app's code_cache and installed on a later
+// launch instead of being translated again.
+//
+// - Lookup is lazy, per region, in TranslateRegion. A record is installed only if the file was
+//   written by this translator with these settings, the record is intact, the range is still
+//   executable and attributed to the record's module, and the guest bytes equal the bytes the
+//   record was translated from (section 3.3), in that order.
+// - Writes are appended per module by the one process holding the module's lock file; records
+//   collect in memory and are flushed by a translating thread (1 MiB, or 2 s after the last
+//   flush), at exit and at the guest's exit_group. No thread is started.
+// - berberis.pcache (BERBERIS_PCACHE) = off (the default) | on | verify.
+
+enum class Mode : uint8_t { kOff, kOn, kVerify };
+
+// The tier a region ended on, which is the tier it's installed as.
+enum class Tier : uint8_t {
+  kLiteCounter = 1,  // First-gear lite, with its hotness counter.
+  kLiteSettled = 2,  // Lite for good: a declined or bailed gear-up, in-region loops, no counter.
+  kHeavy = 3,
+};
+
+// What the translation depends on besides its guest bytes; the file header carries it.
+struct TranslatorSettings {
+  uint32_t translation_mode;
+  uint32_t gearup_min_insns;
+};
+
+// Reads the mode and the directory and starts tracking guest mappings. Once, from
+// InitTranslatorArch, after the translation settings are final.
+void Init(const TranslatorSettings& settings);
+
+// Whether this process uses the cache. False after a fork until reinitialized.
+[[nodiscard]] bool Active();
+[[nodiscard]] Mode GetMode();
+
+// ---- Loading ----
+
+// A record found for a region and checked for integrity: an owned copy, so nothing is read from
+// the file twice. Reusable: its storage is kept from one candidate to the next.
+struct Candidate {
+  void* module = nullptr;
+  uint64_t mapping_id = 0;
+  GuestAddr module_start = 0;
+  GuestAddr pc = 0;
+  GuestAddr end_pc = 0;  // The end the translation was made with.
+  uint32_t guest_size = 0;
+  uint32_t code_size = 0;
+  Tier tier = Tier::kLiteCounter;
+  std::vector<uint8_t> record;  // The private copy; guest bytes and code are in it.
+  size_t guest_bytes_at = 0;
+  size_t code_at = 0;
+  std::vector<SymbolicOperand> operands;
+  std::vector<std::pair<uint32_t, uint32_t>> recovery_points;
+
+  [[nodiscard]] const uint8_t* guest_bytes() const { return record.data() + guest_bytes_at; }
+  [[nodiscard]] const uint8_t* code() const { return record.data() + code_at; }
+};
+
+enum class FindResult { kNotCacheable, kMiss, kRejected, kFound };
+
+// Steps 1 and 2 of section 3.3: the module's file (settings) and the record (CRC, bounds).
+[[nodiscard]] FindResult FindCandidate(GuestAddr pc, Candidate* candidate);
+
+// Holds the mapping registry's shared lock: guest mmap, munmap, mprotect and mremap wait, so
+// guest memory checked under it stays mapped and attributed until it's released.
+class ScopedMappingReadLock {
+ public:
+  ScopedMappingReadLock();
+  ~ScopedMappingReadLock();
+  ScopedMappingReadLock(const ScopedMappingReadLock&) = delete;
+  ScopedMappingReadLock& operator=(const ScopedMappingReadLock&) = delete;
+
+ private:
+  bool locked_;
+};
+
+// Steps 3 and 4, under ScopedMappingReadLock: [pc, pc + size) is executable and still in the
+// mapping the candidate was found through, and holds the record's bytes. Counts the reject.
+[[nodiscard]] bool CheckMappingAndBytes(const Candidate& candidate);
+
+// Copies the candidate into the code pool, re-linked for its address there. `counter` is the
+// entry's hotness counter for kLiteCounter, else 0. kNullHostCodeAddr on failure.
+[[nodiscard]] HostCodePiece InstallCandidate(const Candidate& candidate, uintptr_t counter);
+
+// The key of the candidate's module, for logs.
+[[nodiscard]] const char* ModuleKey(const Candidate& candidate);
+
+// The candidate re-linked as if installed at `install_addr`, into `out` (for verify).
+[[nodiscard]] bool RelinkCandidateAt(const Candidate& candidate,
+                                     uint8_t* out,
+                                     uintptr_t install_addr,
+                                     uintptr_t counter);
+
+// ---- Writing ----
+
+// One translation, from before it's translated until it's published. Its buffers are per thread
+// and kept, so a capture doesn't allocate once they've grown.
+class Capture {
+ public:
+  // Before translating `pc`: notes the mapping it's in. Inactive if the code isn't cacheable.
+  void Begin(GuestAddr pc);
+  [[nodiscard]] bool active() const { return active_; }
+  // Where the translator leaves the instruction words it decoded.
+  [[nodiscard]] std::vector<uint32_t>* decoded_insns();
+  // After install, before publication: names the code's operands and builds the record. The
+  // mapping must be the one Begin saw.
+  void OnInstalled(const MachineCode& machine_code,
+                   HostCodePiece piece,
+                   GuestAddr pc,
+                   size_t guest_size,
+                   GuestAddr end_pc,
+                   Tier tier,
+                   uintptr_t counter);
+  // After a successful publication: queues the record for writing.
+  void Commit();
+
+ private:
+  bool active_ = false;
+  void* module_ = nullptr;
+  uint64_t mapping_id_ = 0;
+  GuestAddr module_start_ = 0;
+  GuestAddr module_end_ = 0;
+  bool has_record_ = false;
+  uint64_t vaddr_ = 0;
+  Tier tier_ = Tier::kLiteCounter;
+};
+
+// Flushes queued records if 2 s have passed since the last flush. Cheap when nothing is queued.
+void MaybeFlush();
+// Flushes everything queued now.
+void FlushAll();
+
+// ---- Counters (also in translator_stats when that's on) ----
+
+enum Counter {
+  kHitsLite,
+  kHitsHeavy,
+  kMisses,
+  kRejectsFile,
+  kRejectsRecord,
+  kRejectsMapping,
+  kRejectsBytes,
+  kNotPersistable,
+  kRecordsWritten,
+  kBytesWritten,
+  kVerifyMatch,
+  kVerifyMismatch,
+  kVerifyInconclusive,
+  kVerifyFallback,
+  kNumCounters,
+};
+void Count(Counter counter, uint64_t value = 1);
+[[nodiscard]] uint64_t GetCounter(Counter counter);
+
+// ---- Testing ----
+
+// Starts the cache in `mode` with `dir`, as Init would, dropping any earlier state (files stay).
+// The caller must be the only thread using the translator.
+void InitForTesting(Mode mode, const std::string& dir, const TranslatorSettings& settings);
+// Flushes, then forgets every module and mapping and stops: as if the process ended.
+void ShutdownForTesting();
+// The fork child handler, for tests.
+void OnForkChildForTesting();
+// Whether this process holds the writer lock of a module whose key contains `key_part`.
+[[nodiscard]] bool IsWriterForTesting(const std::string& key_part);
+// The fd holding that lock, or -1.
+[[nodiscard]] int WriterLockFdForTesting(const std::string& key_part);
+// Replaces the 128 MiB cap, for measurements; 0 restores it. Takes effect at the next start.
+void SetCapForTesting(uint64_t bytes);
+
+// Called before taking the mapping lock to check a candidate, and with it held. Null outside
+// tests.
+extern void (*g_before_mapping_check_hook_for_testing)(GuestAddr pc);
+extern void (*g_in_mapping_check_hook_for_testing)(GuestAddr pc);
+// endregion
+
+}  // namespace berberis::pcache
+
+#endif  // BERBERIS_RUNTIME_ARM64_PERSISTENT_CACHE_H_
