+// ---- Replay: load against compile on a real app's regions, run by hand ----
+//
+//   BERBERIS_PCACHE_REPLAY_CORPUS=<dir> berberis_arm64_host_tests \
+//       --gtest_filter=PersistentCacheBench.DISABLED_ReplayCorpus --gtest_also_run_disabled_tests
+//
+// <dir> is the translate-corpus format (libs.txt, libs/, regions.txt). Each library is mapped as
+// the guest linker maps it, segment by segment from its file, so the cache attributes it as it
+// would on a device. Passes, each with the libraries mapped afresh at new addresses:
+//   off     translate every region start with the cache off (compile);
+//   write   the same with the cache on, then flush (compile + capture, and the write);
+//   load    the same in a new launch (load where there's a record);
+//   verify  berberis.pcache=verify (load, and compare with a fresh translation);
+//   off     again, for drift.
+// BERBERIS_PCACHE_REPLAY_TIER=heavy gears every region up after translating it in the off and
+// write passes, so heavy and settled-lite regions are stored and loaded.
+
+struct ReplayLib {
+  std::string path;
+  size_t span = 0;
+  uint64_t lo = 0;
+};
+
+class PersistentCacheBench : public PersistentCacheTest {
+ protected:
+  // Maps a library segment by segment; returns its load bias, or 0.
+  uintptr_t MapLibrary(const ReplayLib& lib) {
+    int fd = open(lib.path.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd < 0) {
+      return 0;
+    }
+    Elf64_Ehdr eh;
+    Elf64_Phdr ph[64];
+    if (pread(fd, &eh, sizeof(eh), 0) != sizeof(eh) || eh.e_phnum > 64 ||
+        pread(fd, ph, eh.e_phnum * sizeof(Elf64_Phdr), eh.e_phoff) !=
+            ssize_t(eh.e_phnum * sizeof(Elf64_Phdr))) {
+      close(fd);
+      return 0;
+    }
+    void* reserve = mmap(nullptr, lib.span, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (reserve == MAP_FAILED) {
+      close(fd);
+      return 0;
+    }
+    uintptr_t bias = reinterpret_cast<uintptr_t>(reserve) - lib.lo;
+    for (int i = 0; i < eh.e_phnum; i++) {
+      if (ph[i].p_type != PT_LOAD || ph[i].p_filesz == 0) {
+        continue;
+      }
+      uint64_t start = ph[i].p_vaddr & ~uint64_t{4095};
+      uint64_t end = (ph[i].p_vaddr + ph[i].p_filesz + 4095) & ~uint64_t{4095};
+      int prot = ((ph[i].p_flags & PF_R) ? PROT_READ : 0) |
+                 ((ph[i].p_flags & PF_W) ? PROT_WRITE : 0) |
+                 ((ph[i].p_flags & PF_X) ? PROT_EXEC : 0);
+      void* p = MmapForGuest(reinterpret_cast<void*>(bias + start),
+                             end - start,
+                             prot,
+                             MAP_PRIVATE | MAP_FIXED,
+                             fd,
+                             ph[i].p_offset & ~uint64_t{4095});
+      if (p == MAP_FAILED) {
+        close(fd);
+        return 0;
+      }
+    }
+    close(fd);
+    return bias;
+  }
+
+  std::vector<uintptr_t> MapAll() {
+    std::vector<uintptr_t> biases;
+    for (const ReplayLib& lib : libs_) {
+      biases.push_back(MapLibrary(lib));
+    }
+    return biases;
+  }
+
+  void UnmapAll(const std::vector<uintptr_t>& biases) {
+    for (size_t i = 0; i < libs_.size(); i++) {
+      if (biases[i] != 0) {
+        MunmapForGuest(reinterpret_cast<void*>(biases[i] + libs_[i].lo), libs_[i].span);
+      }
+    }
+  }
+
+  static uint64_t NowNs() {
+    timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1'000'000'000ull + ts.tv_nsec;
+  }
+
+  // Translates every region start; returns the elapsed ns.
+  uint64_t TranslateAll(const std::vector<uintptr_t>& biases, bool gear_up, size_t* translated) {
+    *translated = 0;
+    uint64_t start = NowNs();
+    for (const auto& [li, vaddr] : regions_) {
+      if (biases[li] == 0) {
+        continue;
+      }
+      GuestAddr pc = biases[li] + vaddr;
+      if (!GuestMapShadow::GetInstance()->IsExecutable(pc, 4)) {
+        continue;
+      }
+      Translate(pc);
+      if (gear_up) {
+        GearUp(pc);
+      }
+      (*translated)++;
+    }
+    return NowNs() - start;
+  }
+
+  std::vector<ReplayLib> libs_;
+  std::vector<std::pair<unsigned, uint64_t>> regions_;
+};
+
+TEST_F(PersistentCacheBench, DISABLED_ReplayCorpus) {
+  const char* dir = getenv("BERBERIS_PCACHE_REPLAY_CORPUS");
+  if (dir == nullptr) {
+    GTEST_SKIP() << "set BERBERIS_PCACHE_REPLAY_CORPUS";
+  }
+  const char* tier = getenv("BERBERIS_PCACHE_REPLAY_TIER");
+  const bool heavy = tier != nullptr && strcmp(tier, "heavy") == 0;
+  {
+    FILE* f = fopen((std::string(dir) + "/libs.txt").c_str(), "r");
+    ASSERT_NE(f, nullptr);
+    char line[512];
+    while (fgets(line, sizeof(line), f)) {
+      ReplayLib lib;
+      lib.path = std::string(dir) + "/libs/" + std::string(line, strcspn(line, "\n"));
+      std::vector<uint8_t> file = ReadFile(lib.path);
+      ASSERT_GE(file.size(), sizeof(Elf64_Ehdr)) << lib.path;
+      Elf64_Ehdr eh;
+      memcpy(&eh, file.data(), sizeof(eh));
+      uint64_t lo = UINT64_MAX;
+      uint64_t hi = 0;
+      for (int i = 0; i < eh.e_phnum; i++) {
+        Elf64_Phdr ph;
+        memcpy(&ph, file.data() + eh.e_phoff + i * sizeof(ph), sizeof(ph));
+        if (ph.p_type == PT_LOAD) {
+          lo = std::min<uint64_t>(lo, ph.p_vaddr & ~uint64_t{4095});
+          hi = std::max<uint64_t>(hi, ph.p_vaddr + ph.p_memsz);
+        }
+      }
+      lib.lo = lo;
+      lib.span = ((hi + 4095) & ~uint64_t{4095}) - lo;
+      libs_.push_back(lib);
+    }
+    fclose(f);
+  }
+  {
+    FILE* f = fopen((std::string(dir) + "/regions.txt").c_str(), "r");
+    ASSERT_NE(f, nullptr);
+    unsigned li;
+    unsigned long long vaddr;
+    while (fscanf(f, "%u %llx", &li, &vaddr) == 2) {
+      ASSERT_LT(li, libs_.size());
+      regions_.emplace_back(li, vaddr);
+    }
+    fclose(f);
+  }
+  // BERBERIS_PCACHE_REPLAY_CAP_MB: another cap, to measure loads past the default 128 MiB.
+  if (const char* cap = getenv("BERBERIS_PCACHE_REPLAY_CAP_MB"); cap != nullptr) {
+    pcache::SetCapForTesting(strtoull(cap, nullptr, 10) << 20);
+  }
+  size_t n = 0;
+  auto report = [&](const char* pass, uint64_t ns) {
+    printf("REPLAY %s %s: %zu regions, %.0f ms, %.2f us/region\n",
+           heavy ? "heavy" : "lite",
+           pass,
+           n,
+           ns / 1e6,
+           n ? ns / 1e3 / n : 0.0);
+  };
+
+  std::vector<uintptr_t> off = MapAll();
+  report("off", TranslateAll(off, heavy, &n));
+
+  StartProcess(Mode::kOn);
+  std::vector<uintptr_t> write = MapAll();
+  UnmapAll(off);
+  Counts c_write;
+  report("write", TranslateAll(write, heavy, &n));
+  uint64_t flush_start = NowNs();
+  pcache::FlushAll();
+  report("write-flush", NowNs() - flush_start);
+  EndProcess();
+  printf("REPLAY write: %lu records, %lu bytes, %lu not persistable; data %zu bytes, index %zu\n",
+         (unsigned long)c_write.Delta(pcache::kRecordsWritten),
+         (unsigned long)c_write.Delta(pcache::kBytesWritten),
+         (unsigned long)c_write.Delta(pcache::kNotPersistable),
+         ReadFileSize(cache_dir_, ".pcache"),
+         ReadFileSize(cache_dir_, ".pidx"));
+
+  StartProcess(Mode::kOn);
+  std::vector<uintptr_t> load = MapAll();
+  UnmapAll(write);
+  Counts c_load;
+  report("load", TranslateAll(load, false, &n));
+  EndProcess();
+  printf("REPLAY load: hits lite %lu heavy %lu, misses %lu, rejects file %lu record %lu "
+         "mapping %lu bytes %lu, records written %lu\n",
+         (unsigned long)c_load.Delta(pcache::kHitsLite),
+         (unsigned long)c_load.Delta(pcache::kHitsHeavy),
+         (unsigned long)c_load.Delta(pcache::kMisses),
+         (unsigned long)c_load.Delta(pcache::kRejectsFile),
+         (unsigned long)c_load.Delta(pcache::kRejectsRecord),
+         (unsigned long)c_load.Delta(pcache::kRejectsMapping),
+         (unsigned long)c_load.Delta(pcache::kRejectsBytes),
+         (unsigned long)c_load.Delta(pcache::kRecordsWritten));
+
+  StartProcess(Mode::kVerify);
+  std::vector<uintptr_t> verify = MapAll();
+  UnmapAll(load);
+  Counts c_verify;
+  report("verify", TranslateAll(verify, false, &n));
+  EndProcess();
+  printf("REPLAY verify: match %lu, mismatch %lu, inconclusive %lu, fallback %lu, rejects record "
+         "%lu\n",
+         (unsigned long)c_verify.Delta(pcache::kVerifyMatch),
+         (unsigned long)c_verify.Delta(pcache::kVerifyMismatch),
+         (unsigned long)c_verify.Delta(pcache::kVerifyInconclusive),
+         (unsigned long)c_verify.Delta(pcache::kVerifyFallback),
+         (unsigned long)c_verify.Delta(pcache::kRejectsRecord));
+
+  std::vector<uintptr_t> off2 = MapAll();
+  UnmapAll(verify);
+  report("off-again", TranslateAll(off2, heavy, &n));
+  UnmapAll(off2);
+  pcache::SetCapForTesting(0);
+}
+
+}  // namespace
+
+}  // namespace berberis
