+// ---- CRC32C ----
+
+constexpr auto kCrc32cTable = [] {
+  struct {
+    uint32_t v[256];
+  } table{};
+  for (uint32_t i = 0; i < 256; i++) {
+    uint32_t c = i;
+    for (int k = 0; k < 8; k++) {
+      c = (c & 1) ? (c >> 1) ^ 0x82f63b78u : c >> 1;
+    }
+    table.v[i] = c;
+  }
+  return table;
+}();
+
+uint32_t Crc32cSoftware(uint32_t crc, const uint8_t* p, size_t n) {
+  for (size_t i = 0; i < n; i++) {
+    crc = kCrc32cTable.v[(crc ^ p[i]) & 0xff] ^ (crc >> 8);
+  }
+  return crc;
+}
+
+#if defined(__x86_64__)
+__attribute__((target("sse4.2"))) uint32_t Crc32cHardware(uint32_t crc, const uint8_t* p,
+                                                          size_t n) {
+  uint64_t c = crc;
+  for (; n >= 8; n -= 8, p += 8) {
+    uint64_t v;
+    memcpy(&v, p, 8);
+    c = __builtin_ia32_crc32di(c, v);
+  }
+  uint32_t c32 = static_cast<uint32_t>(c);
+  for (; n > 0; n--, p++) {
+    c32 = __builtin_ia32_crc32qi(c32, *p);
+  }
+  return c32;
+}
+#endif
+
+uint32_t Crc32cUpdate(uint32_t crc, const uint8_t* p, size_t n) {
+#if defined(__x86_64__)
+  if (host_platform::kHasSSE4_2) {
+    return Crc32cHardware(crc, p, n);
+  }
+#endif
+  return Crc32cSoftware(crc, p, n);
+}
+
+// CRC32C of `n` bytes, with the 4 bytes at `zero_at` taken as zero (where the CRC itself goes).
+uint32_t Crc32cExcept(const uint8_t* p, size_t n, size_t zero_at) {
+  static const uint8_t kZero[4] = {};
+  uint32_t crc = ~0u;
+  crc = Crc32cUpdate(crc, p, zero_at);
+  crc = Crc32cUpdate(crc, kZero, 4);
+  crc = Crc32cUpdate(crc, p + zero_at + 4, n - zero_at - 4);
+  return ~crc;
+}
