+
+std::string Hex(const uint8_t* p, size_t n) {
+  static const char kDigits[] = "0123456789abcdef";
+  std::string s;
+  for (size_t i = 0; i < n; i++) {
+    s += kDigits[p[i] >> 4];
+    s += kDigits[p[i] & 15];
+  }
+  return s;
+}
+
+std::string HexNum(uint64_t v) {
+  char buf[24];
+  snprintf(buf, sizeof(buf), "%llx", static_cast<unsigned long long>(v));
+  return buf;
+}
+
+// The GNU build-id in the notes at [p, p + size), or empty.
+std::string FindBuildId(const uint8_t* p, size_t size) {
+  size_t pos = 0;
+  while (pos + sizeof(Elf64_Nhdr) <= size) {
+    Elf64_Nhdr nh;
+    memcpy(&nh, p + pos, sizeof(nh));
+    size_t name_at = pos + sizeof(nh);
+    size_t desc_at = name_at + ((nh.n_namesz + 3) & ~size_t{3});
+    size_t next = desc_at + ((nh.n_descsz + 3) & ~size_t{3});
+    if (next > size || desc_at > size || nh.n_descsz > size) {
+      break;
+    }
+    if (nh.n_type == NT_GNU_BUILD_ID && nh.n_namesz == 4 && memcmp(p + name_at, "GNU", 4) == 0 &&
+        nh.n_descsz > 0 && nh.n_descsz <= 32) {
+      return std::string(reinterpret_cast<const char*>(p + desc_at), nh.n_descsz);
+    }
+    pos = next;
+  }
+  return {};
+}
+
+// The build-id of the image this code is in: the translator.
+std::string TranslatorBuildId() {
+  struct Search {
+    uintptr_t addr;
+    std::string id;
+  } search{reinterpret_cast<uintptr_t>(&TranslatorBuildId), {}};
+  dl_iterate_phdr(
+      [](dl_phdr_info* info, size_t, void* arg) -> int {
+        auto* s = static_cast<Search*>(arg);
+        bool contains = false;
+        for (int i = 0; i < info->dlpi_phnum; i++) {
+          const auto& ph = info->dlpi_phdr[i];
+          uintptr_t start = info->dlpi_addr + ph.p_vaddr;
+          if (ph.p_type == PT_LOAD && s->addr >= start && s->addr < start + ph.p_memsz) {
+            contains = true;
+          }
+        }
+        if (!contains) {
+          return 0;
+        }
+        for (int i = 0; i < info->dlpi_phnum; i++) {
+          const auto& ph = info->dlpi_phdr[i];
+          if (ph.p_type == PT_NOTE) {
+            s->id = FindBuildId(reinterpret_cast<const uint8_t*>(info->dlpi_addr + ph.p_vaddr),
+                                ph.p_memsz);
+            if (!s->id.empty()) {
+              break;
+            }
+          }
+        }
+        return 1;
+      },
+      &search);
+  return search.id;
+}
+
+bool MakeFingerprint(const TranslatorSettings& settings, Fingerprint* fp) {
+  memset(fp, 0, sizeof(*fp));
+  std::string id = TranslatorBuildId();
+  if (id.empty() || id.size() > sizeof(fp->translator_build_id)) {
+    return false;
+  }
+  memcpy(fp->translator_build_id, id.data(), id.size());
+  fp->translator_build_id_size = id.size();
+  fp->format_version = kFormatVersion;
+  fp->translation_mode = settings.translation_mode;
+  fp->gearup_min_insns = settings.gearup_min_insns;
+  for (int f = 0; f < kNumConfigFlags; f++) {
+    if (IsConfigFlagSet(static_cast<ConfigFlag>(f))) {
+      fp->config_flags |= uint64_t{1} << f;
+    }
+  }
+  memcpy(fp->host_cpu, &host_platform::kPlatformCapabilities,
+         sizeof(host_platform::kPlatformCapabilities));
+  fp->host_page_size = static_cast<uint32_t>(sysconf(_SC_PAGESIZE));
+  fp->guest_page_size = config::kGuestPageSize;
+  fp->guest_machine = EM_AARCH64;
+  fp->recording = 1;
+  return true;
+}
+
+void MakeHeader(const char (&magic)[8], const std::string& key, uint64_t nonce, FileHeader* h) {
+  State* state = GetState();
+  memset(h, 0, sizeof(*h));
+  memcpy(h->magic, magic, sizeof(h->magic));
+  h->header_size = sizeof(FileHeader);
+  h->nonce = nonce;
+  h->fingerprint = state->fingerprint;
+  memcpy(h->module_key, key.data(), std::min(key.size(), sizeof(h->module_key) - 1));
+  h->crc = Crc32cExcept(reinterpret_cast<const uint8_t*>(h), sizeof(*h), offsetof(FileHeader, crc));
+}
+
+bool HeaderMatches(const FileHeader& h, const char (&magic)[8], const std::string& key) {
+  FileHeader expected;
+  MakeHeader(magic, key, h.nonce, &expected);
+  return memcmp(&h, &expected, sizeof(h)) == 0;
+}
+
+bool ReadFull(int fd, void* buf, size_t n, off_t offset) {
+  auto* p = static_cast<uint8_t*>(buf);
+  while (n > 0) {
+    ssize_t r = pread(fd, p, n, offset);
+    if (r <= 0) {
+      if (r < 0 && errno == EINTR) {
+        continue;
+      }
+      return false;
+    }
+    p += r;
+    n -= r;
+    offset += r;
+  }
+  return true;
+}
+
+bool WriteFull(int fd, const void* buf, size_t n) {
+  auto* p = static_cast<const uint8_t*>(buf);
+  while (n > 0) {
+    ssize_t r = write(fd, p, n);
+    if (r <= 0) {
+      if (r < 0 && errno == EINTR) {
+        continue;
+      }
+      return false;
+    }
+    p += r;
+    n -= r;
+  }
+  return true;
+}
