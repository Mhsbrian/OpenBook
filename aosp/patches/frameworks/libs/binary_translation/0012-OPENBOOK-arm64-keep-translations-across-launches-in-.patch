+  // the new code. Invalidate them explicitly (ANAL-381).
+  const bool replaces_executable =
+      (flags & MAP_FIXED) && (prot & PROT_EXEC) &&
+      GuestMapShadow::GetInstance()->GetExecutable(ToGuestAddr(addr), length) != kBitUnset;
+  void* result;
+  {
+    ScopedObserverLock lock;
+    result = mmap64(addr, length, ToHostProt(prot), flags, fd, offset);
+    if (lock.observer() != nullptr) {
+      int saved_errno = errno;
+      if (result != MAP_FAILED) {
+        lock.observer()->OnMap(result, length, prot, flags, fd, offset);
+      } else if (flags & MAP_FIXED) {
+        lock.observer()->OnUnmap(addr, length);  // A failed MAP_FIXED may have unmapped some.
+      }
+      errno = saved_errno;
+    }
