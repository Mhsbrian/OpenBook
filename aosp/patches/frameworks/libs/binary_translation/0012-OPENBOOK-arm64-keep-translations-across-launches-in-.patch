+// One writer per module. A process that inherits the writer's lock fd by fork closes its copy and
+// doesn't write; an independent process (its own open of the lock file) can't take the lock.
+TEST_F(PersistentCacheTest, OneWriterAcrossForks) {
+  StartProcess();
+  uint8_t* base = MapElf(elf_path_);
+  Translate(Pc(base, kRegionA));
+  pcache::FlushAll();
+  ASSERT_TRUE(pcache::IsWriterForTesting("b"));
+  int lock_fd = pcache::WriterLockFdForTesting("b");
+  ASSERT_GE(lock_fd, 0);
+  size_t entries = IndexEntries();
+
+  // Fork, then go on as the parent's child.
+  pid_t pid = fork();
+  if (pid == 0) {
+    int status = 0;
+    if (pcache::Active()) status |= 1;
+    if (fcntl(lock_fd, F_GETFD) != -1 || errno != EBADF) status |= 2;
+    Translate(Pc(base, kRegionC));
+    pcache::FlushAll();
+    if (IndexEntries() != entries) status |= 4;
+    _exit(status);
+  }
+  ASSERT_GT(pid, 0);
+  int status;
+  ASSERT_EQ(waitpid(pid, &status, 0), pid);
+  ASSERT_TRUE(WIFEXITED(status));
+  EXPECT_EQ(WEXITSTATUS(status), 0) << "1: still active, 2: lock fd kept, 4: wrote";
+
+  // Fork, then start afresh as an independent process would.
+  pid = fork();
+  if (pid == 0) {
+    int status = 0;
+    pcache::InitForTesting(Mode::kOn, cache_dir_, settings_);
+    if (!pcache::Active()) status |= 1;
+    int fd = open(elf_path_.c_str(), O_RDONLY | O_CLOEXEC);
+    void* p = MmapForGuest(nullptr, ElfSize(), PROT_READ | PROT_EXEC, MAP_PRIVATE, fd, 0);
+    close(fd);
+    Translate(Pc(static_cast<uint8_t*>(p), kRegionC));
+    if (pcache::IsWriterForTesting("b")) status |= 2;
+    pcache::FlushAll();
+    if (IndexEntries() != entries) status |= 4;
+    _exit(status);
+  }
+  ASSERT_GT(pid, 0);
+  ASSERT_EQ(waitpid(pid, &status, 0), pid);
+  ASSERT_TRUE(WIFEXITED(status));
+  EXPECT_EQ(WEXITSTATUS(status), 0) << "1: not active, 2: became a writer, 4: wrote";
+
+  // The parent still writes.
+  EXPECT_TRUE(pcache::IsWriterForTesting("b"));
+  Translate(Pc(base, kRegionC));
+  pcache::FlushAll();
+  EXPECT_EQ(IndexEntries(), entries + 1);
+  Unmap(base);
+  EndProcess();
+
+  // Its lock released, the next launch writes.
+  StartProcess();
+  base = MapElf(elf_path_);
+  Translate(Pc(base, kRegionB));
+  EXPECT_TRUE(pcache::IsWriterForTesting("b"));
+}
+
+// The guest's fork is a raw clone without CLONE_VM, which runs no pthread_atfork handler; its
+// child runs the guest fork hooks. They must stop the cache without touching a lock the parent
+// may hold: here the mapping lock is held across the clone.
+TEST_F(PersistentCacheTest, GuestForkChildStopsWithoutLocks) {
+  StartProcess();
+  uint8_t* base = MapElf(elf_path_);
+  Translate(Pc(base, kRegionA));
+  int lock_fd = pcache::WriterLockFdForTesting("b");
+  ASSERT_GE(lock_fd, 0);
+  GuestMappingObserver* observer = GetGuestMappingObserver();
+  ASSERT_NE(observer, nullptr);
+  observer->LockExclusive();
+  long pid = syscall(SYS_clone, SIGCHLD, 0, 0, 0, 0);
+  if (pid == 0) {
+    g_guest_fork_child_hooks.Run();
+    int status = 0;
+    if (pcache::Active()) status |= 1;
+    if (fcntl(lock_fd, F_GETFD) != -1 || errno != EBADF) status |= 2;
+    // A guest mmap must not wait for the inherited, held lock.
+    void* p = MmapForGuest(nullptr, 4096, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1,
+                           0);
+    if (p == MAP_FAILED || MunmapForGuest(p, 4096) != 0) status |= 4;
+    _exit(status);
+  }
+  observer->UnlockExclusive();
+  ASSERT_GT(pid, 0);
+  int status = 0;
+  bool exited = false;
+  for (int i = 0; i < 1000 && !exited; i++) {
+    exited = waitpid(pid, &status, WNOHANG) == pid;
+    if (!exited) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    }
+  }
+  if (!exited) {
+    kill(pid, SIGKILL);
+    waitpid(pid, &status, 0);
+  }
+  ASSERT_TRUE(exited) << "the child deadlocked on the inherited mapping lock";
+  ASSERT_TRUE(WIFEXITED(status));
+  EXPECT_EQ(WEXITSTATUS(status), 0) << "1: still active, 2: lock fd kept, 4: mmap failed";
+  EXPECT_TRUE(pcache::Active());
+  EXPECT_TRUE(pcache::IsWriterForTesting("b"));
+}
