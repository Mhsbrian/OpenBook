+// The same for an unmap during the second translation, on the way to installing fresh code.
+TEST_F(PersistentCacheTest, VerifyHoldsTheMappingThroughTheFreshFallback) {
+  uint8_t* base1 = WriteRegionA();
+  Record r = FindRecord(kRegionA);
+  size_t k = r.FirstPlainCodeByte();
+  ASSERT_NE(k, SIZE_MAX);
+  r.bytes[r.code_at() + k] ^= 0xff;
+  r.FixCrc();
+  WriteRecord(r);
+  StartProcess(Mode::kVerify);
+  uint8_t* base2 = Remap(base1, elf_path_);
+  for (auto it = mapped_.begin(); it != mapped_.end(); ++it) {
+    if (it->first == base2) {
+      mapped_.erase(it);  // Unmapped by the test.
+      break;
+    }
+  }
+  GuestAddr pc = Pc(base2, kRegionA);
+  RacingMappingCall::Arm(base2, 2, /*unmap=*/true);
+  Counts c;
+  Translate(pc);
+  RacingMappingCall::Join();
+  EXPECT_TRUE(RacingMappingCall::waited_while_locked) << "the munmap didn't wait for the lock";
+  EXPECT_EQ(RacingMappingCall::done, 1);
+  EXPECT_EQ(c.Delta(pcache::kVerifyMismatch), 1u);
+  EXPECT_FALSE(IsTranslated(pc)) << "fresh code published after the invalidation";
+}
