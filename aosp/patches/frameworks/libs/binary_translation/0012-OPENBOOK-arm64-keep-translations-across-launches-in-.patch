+  StartProcess();
+  uint8_t* base = MapElf(elf_path_);
+  Translate(Pc(base, kRegionA));
+  // Another process's module file, written after this one started.
+  WriteFile(cache_dir_ + "/other.pcache", std::vector<uint8_t>(1 << 20, 0));
+  Counts c;
+  pcache::FlushAll();
+  EXPECT_EQ(c.Delta(pcache::kRecordsWritten), 0u);
+  EXPECT_EQ(c.Delta(pcache::kNotPersistable), 1u);
+  EXPECT_EQ(IndexEntries(), 0u);
