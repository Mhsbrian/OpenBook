+// ---- What's refused, in the order of section 3.3 ----
+
+TEST_F(PersistentCacheTest, OtherSettingsIgnoreTheFileWhichItsWriterReplaces) {
+  uint8_t* base1 = WriteRegionA();
+  settings_.gearup_min_insns++;
+  StartProcess();
+  Counts c1;
+  uint8_t* base2 = Remap(base1, elf_path_);
+  Translate(Pc(base2, kRegionA));
+  EXPECT_EQ(c1.Delta(pcache::kRejectsFile), 1u);
+  EXPECT_EQ(c1.Delta(pcache::kHitsLite), 0u);
+  EndProcess();
+  EXPECT_EQ(IndexEntries(), 1u) << "the writer replaces the file and writes its own record";
+
+  StartProcess();
+  Counts c2;
+  uint8_t* base3 = Remap(base2, elf_path_);
+  Translate(Pc(base3, kRegionA));
+  EXPECT_EQ(c2.Delta(pcache::kHitsLite), 1u);
+  EXPECT_EQ(c2.Delta(pcache::kRejectsFile), 0u);
+}
+
+TEST_F(PersistentCacheTest, SettingsAreCheckedBeforeTheRecord) {
+  uint8_t* base1 = WriteRegionA();
+  Record r = FindRecord(kRegionA);
+  r.bytes[r.code_at()] ^= 0xff;  // A bad CRC.
+  WriteRecord(r);
+  settings_.gearup_min_insns++;
+  StartProcess();
+  Counts c;
+  Translate(Pc(Remap(base1, elf_path_), kRegionA));
+  EXPECT_EQ(c.Delta(pcache::kRejectsFile), 1u);
+  EXPECT_EQ(c.Delta(pcache::kRejectsRecord), 0u);
+}
+
+TEST_F(PersistentCacheTest, RecordIsCheckedBeforeTheBytes) {
+  uint8_t* base1 = WriteRegionA();
+  Record r = FindRecord(kRegionA);
+  r.bytes[r.code_at()] ^= 0xff;  // A bad CRC.
+  WriteRecord(r);
+  // The same library (build-id) with other code in region A.
+  std::vector<uint32_t> code = DefaultCode();
+  code[kRegionA + 1] = 0x8b030023;  // add x3, x1, x3
+  std::string other = root_ + "/other.so";
+  WriteFile(other, MakeElf(code, 1));
+  StartProcess();
+  Counts c;
+  Translate(Pc(Remap(base1, other), kRegionA));
+  EXPECT_EQ(c.Delta(pcache::kRejectsRecord), 1u);
+  EXPECT_EQ(c.Delta(pcache::kRejectsBytes), 0u);
+}
+
+TEST_F(PersistentCacheTest, ChangedBytesAreRefused) {
+  uint8_t* base1 = WriteRegionA();
+  std::vector<uint32_t> code = DefaultCode();
+  code[kRegionA + 1] = 0x8b030023;
+  std::string other = root_ + "/other.so";
+  WriteFile(other, MakeElf(code, 1));
+  StartProcess();
+  Counts c;
+  uint8_t* base2 = Remap(base1, other);
+  Translate(Pc(base2, kRegionA));
+  EXPECT_EQ(c.Delta(pcache::kRejectsBytes), 1u);
