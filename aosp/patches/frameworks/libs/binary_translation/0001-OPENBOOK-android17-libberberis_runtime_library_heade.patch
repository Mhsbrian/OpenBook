+#ifndef BERBERIS_RUNTIME_LIBRARY_RUNTIME_LIBRARY_H_
+#define BERBERIS_RUNTIME_LIBRARY_RUNTIME_LIBRARY_H_
+
+// Android 17's native_bridge_support includes the runtime library under its android17-release path
+// (runtime/runtime_library in AOSP). This tree keeps it in runtime_primitives, with the same declarations.
+#include "berberis/runtime_primitives/runtime_library.h"
+
+#endif  // BERBERIS_RUNTIME_LIBRARY_RUNTIME_LIBRARY_H_
