 }  // namespace
 
 }  // namespace berberis
diff --git a/lite_translator/arm64_to_x86_64/lite_translator_simd_three_diff_perm.inc b/lite_translator/arm64_to_x86_64/lite_translator_simd_three_diff_perm.inc
index 2439226c..5eb2b6c6 100644
--- a/lite_translator/arm64_to_x86_64/lite_translator_simd_three_diff_perm.inc
+++ b/lite_translator/arm64_to_x86_64/lite_translator_simd_three_diff_perm.inc
@@ -965,6 +965,56 @@
     as_.Movdqu({.base = Assembler::rbp, .disp = vd_off}, xn);
   }
 
+  // OPENBOOK: single-table-register TBL/TBX (len == 0), the common case: constant
+  // byte shuffles compile to one TBL with a one-register table.  Two x86
+  // instructions give TBL exactly:
+  //   c[i] = PADDUSB(idx[i], 0x70)   (unsigned saturating add)
+  //   idx 0..15   -> c = 0x70..0x7F: bit 7 clear, low nibble = idx, so
+  //                  PSHUFB(table, c)[i] = table[idx]
+  //   idx 16..255 -> c >= 0x80 (saturates at 0xFF): bit 7 set, so PSHUFB
+  //                  gives 0, TBL's out-of-range result
+  // TBX keeps the old Vd byte in the out-of-range lanes: miss = PCMPGTB(0, c)
+  // expands bit 7 to an all-ones byte, and result = lookup | (old_Vd & miss).
+  // Vm, Vn and (TBX) Vd are read before Vd is written, so every alias (Vd == Vn,
+  // Vd == Vm, Vn == Vm, all three) reads the original bytes.  Q=0 zeroes the
+  // upper 64 bits, TBX included.  SSSE3 (PSHUFB) as before; no SSE4.1.
+  void AdvSimdTableLookupOneReg(uint8_t rd, uint8_t rn, uint8_t rm, uint8_t op,
+                                bool q) {
+    SimdRegister xmm_c   = AllocTempSimdReg();
+    SimdRegister xmm_out = AllocTempSimdReg();
+    SimdRegister xmm_t   = AllocTempSimdReg();  // 0x70 broadcast, then the miss mask
+    SimdRegister xmm_old = op ? AllocTempSimdReg() : xmm_t;
+    if (xmm_c == no_simd_register || xmm_out == no_simd_register ||
+        xmm_t == no_simd_register || xmm_old == no_simd_register) {
+      success_ = false; return;
+    }
+    Register r_const = AllocTempReg();
+    if (r_const == no_register) { success_ = false; return; }
+
+    as_.Movdqu(xmm_c, {.base = Assembler::rbp, .disp = VRegOffset(rm)});
+    as_.Movq(r_const, static_cast<int64_t>(0x7070707070707070LL));
+    as_.Movq(xmm_t, r_const);
+    as_.Punpcklqdq(xmm_t, xmm_t);
+    as_.Paddusb(xmm_c, xmm_t);
+    as_.Movdqu(xmm_out, {.base = Assembler::rbp, .disp = VRegOffset(rn)});
+    if (op /* TBX */) {
+      as_.Movdqu(xmm_old, {.base = Assembler::rbp, .disp = VRegOffset(rd)});
+      as_.Pxor(xmm_t, xmm_t);
+      as_.Pcmpgtb(xmm_t, xmm_c);  // 0xFF where c is negative (bit 7 set): a miss
+      as_.Pand(xmm_old, xmm_t);
+    }
+    as_.Pshufb(xmm_out, xmm_c);
+    if (op /* TBX */) {
+      as_.Por(xmm_out, xmm_old);
+    }
+    if (!q) {
+      // Q=0: zero the upper 64 bits per D-register semantics.
+      as_.Pslldq(xmm_out, int8_t{8});
+      as_.Psrldq(xmm_out, int8_t{8});
+    }
+    as_.Movdqu({.base = Assembler::rbp, .disp = VRegOffset(rd)}, xmm_out);
+  }
+
   // JIT for AdvSIMD TBL/TBX (table lookup / table lookup extended).
   //   TBL Vd.<T>, {Vn.16B [, V(n+1) [, V(n+2) [, V(n+3)]]]}, Vm.<T>
   //   TBX Vd.<T>, {Vn.16B [, V(n+1) [, V(n+2) [, V(n+3)]]]}, Vm.<T>
@@ -1001,6 +1051,10 @@
   void AdvSimdTableLookup(uint8_t rd, uint8_t rn, uint8_t rm, uint8_t len,
                           uint8_t op, bool q) {
     NonRaisingSimdScope non_raising(this);
+    if (len == 0) {
+      AdvSimdTableLookupOneReg(rd, rn, rm, op, q);
+      return;
+    }
     const uint8_t table_regs = static_cast<uint8_t>(len + 1);  // 1..4
     const int32_t vm_off = VRegOffset(rm);
     const int32_t vd_off = VRegOffset(rd);
