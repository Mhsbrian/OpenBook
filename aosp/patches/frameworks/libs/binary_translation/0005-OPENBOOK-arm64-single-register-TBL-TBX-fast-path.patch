diff --git a/heavy_optimizer/arm64/frontend.cc b/heavy_optimizer/arm64/frontend.cc
index 04f2cd60..079364ff 100644
--- a/heavy_optimizer/arm64/frontend.cc
+++ b/heavy_optimizer/arm64/frontend.cc
@@ -15525,10 +15525,48 @@ void HeavyOptimizerFrontend::AdvSimdPermute(uint8_t rd, uint8_t rn, uint8_t rm,
   SetVRegFull(rd, xn, q);
 }
 
+// OPENBOOK: single-table-register TBL/TBX (len == 0), the common case (constant
+// byte shuffles). Same lowering as the lite tier's AdvSimdTableLookupOneReg:
+//   c = PADDUSB(idx, 0x70): idx 0..15 -> 0x70..0x7F (bit 7 clear, low nibble =
+//   idx); idx 16..255 -> >= 0x80 (bit 7 set). PSHUFB(table, c) is then exactly
+//   TBL: table[idx] in range, 0 out of range. TBX: miss = PCMPGTB(0, c) expands
+//   bit 7 to an all-ones byte; result = lookup | (old_Vd & miss). Vm, Vn and Vd
+//   are read before SetVRegFull writes Vd, so aliases read the original bytes;
+//   SetVRegFull zeroes Vd[127:64] when q=false.
+void HeavyOptimizerFrontend::AdvSimdTableLookupOneReg(uint8_t rd, uint8_t rn, uint8_t rm, uint8_t op, bool q) {
+  FpRegister c = AllocTempSimdReg();
+  FpRegister out = AllocTempSimdReg();
+  FpRegister t = AllocTempSimdReg();
+  builder_.GenGetSimd<16>(c.machine_reg(), GetVRegOffset(rm));
+  builder_.Gen<x86_64::MovqXRegReg>(t.machine_reg(), GetImm(uint64_t{0x7070707070707070ULL}));
+  builder_.Gen<x86_64::PunpcklqdqXRegXReg>(t.machine_reg(), t.machine_reg());
+  builder_.Gen<x86_64::PaddusbXRegXReg>(c.machine_reg(), t.machine_reg());
+  builder_.GenGetSimd<16>(out.machine_reg(), GetVRegOffset(rn));
+  FpRegister old;
+  if (op /* TBX */) {
+    old = AllocTempSimdReg();
+    builder_.GenGetSimd<16>(old.machine_reg(), GetVRegOffset(rd));
+    // A full-def zero (MOVQ from a zero GP reg), as AdvSimdTableLookup does: a
+    // self-PXOR would read an undefined vreg in this tier's lifetime analysis.
+    builder_.Gen<x86_64::MovqXRegReg>(t.machine_reg(), GetImm(uint64_t{0}));
+    builder_.Gen<x86_64::PcmpgtbXRegXReg>(t.machine_reg(), c.machine_reg());
+    builder_.Gen<x86_64::PandXRegXReg>(old.machine_reg(), t.machine_reg());
+  }
+  builder_.Gen<x86_64::PshufbXRegXReg>(out.machine_reg(), c.machine_reg());
+  if (op /* TBX */) {
+    builder_.Gen<x86_64::PorXRegXReg>(out.machine_reg(), old.machine_reg());
+  }
+  SetVRegFull(rd, out, q);
+}
+
 void HeavyOptimizerFrontend::AdvSimdTableLookup(uint8_t rd, uint8_t rn, uint8_t rm, uint8_t len, uint8_t op, bool q) {
   if (!success()) {
     return;
   }
+  if (len == 0) {
+    AdvSimdTableLookupOneReg(rd, rn, rm, op, q);
+    return;
+  }
   // TBL/TBX: per-byte gather across 1..4 consecutive table registers, mirroring
   // the lite lowering (register-domain-pure, no BB-splits). For each table reg r,
   // shift the index vector down by r*16 (bytewise) so PSHUFB picks lane (idx-r*16)
diff --git a/heavy_optimizer/arm64/frontend.h b/heavy_optimizer/arm64/frontend.h
index 790d5b4f..081f26a5 100644
--- a/heavy_optimizer/arm64/frontend.h
+++ b/heavy_optimizer/arm64/frontend.h
@@ -534,6 +534,8 @@ class HeavyOptimizerFrontend {
   void AdvSimdPermute(uint8_t rd, uint8_t rn, uint8_t rm, uint8_t size, uint8_t opcode, bool q);
 
   void AdvSimdTableLookup(uint8_t rd, uint8_t rn, uint8_t rm, uint8_t len, uint8_t op, bool q);
+  // OPENBOOK: the single-table-register case of AdvSimdTableLookup (len == 0).
+  void AdvSimdTableLookupOneReg(uint8_t rd, uint8_t rn, uint8_t rm, uint8_t op, bool q);
 
   void AdvSimdMultiStruct(uint8_t rt,
                           uint8_t rn,
diff --git a/heavy_optimizer/arm64/frontend_tests.cc b/heavy_optimizer/arm64/frontend_tests.cc
index 15e362e1..9dcb0b11 100644
--- a/heavy_optimizer/arm64/frontend_tests.cc
+++ b/heavy_optimizer/arm64/frontend_tests.cc
@@ -18219,4 +18219,87 @@ TEST_F(Arm64HeavyOptimizerFrontendTest, UshlVec16BBails) {
   EXPECT_FALSE(RunOneInstruction(&state_, ToGuestAddr(code) + sizeof(code)));
 }
 
+
+// OPENBOOK: the single-table-register TBL/TBX fast path (len == 0) in this tier:
+// every index value 0..255, both arrangements (8B, 16B), TBL and TBX, nonzero old
+// Vd bytes, zeros in the table, and every alias of Vd, Vn and Vm (the simd-bench
+// swizzle kernel itself compiles to TBL Vd=Vn). Each region must translate in this
+// tier, not fall back to the interpreter, and all 16 result bytes are checked
+// (the upper 8 must be zero for 8B, TBX included).
+namespace {
+
+struct OneRegTblAlias {
+  uint8_t rd, rn, rm;
+  const char* name;
+};
+constexpr OneRegTblAlias kOneRegTblAliases[] = {
+    {0, 1, 2, "distinct"}, {1, 1, 2, "d=n"}, {2, 1, 2, "d=m"}, {0, 1, 1, "n=m"}, {1, 1, 1, "d=n=m"}};
+
+constexpr uint32_t OneRegTblTbx(bool q, uint8_t rd, uint8_t rn, uint8_t rm, bool tbx) {
+  return (static_cast<uint32_t>(q) << 30) | 0x0E000000u | (static_cast<uint32_t>(rm) << 16) |
+         (static_cast<uint32_t>(tbx) << 12) | (static_cast<uint32_t>(rn) << 5) | rd;
+}
+
+// Arm semantics, from the register values before the instruction.
+uint8_t OneRegTblExpected(bool tbx, bool q, const uint8_t* table, const uint8_t* idx,
+                          const uint8_t* old, int lane) {
+  if (lane >= (q ? 16 : 8)) return 0;
+  const uint8_t i = idx[lane];
+  if (i < 16) return table[i];
+  return tbx ? old[lane] : 0;
+}
+
+// Runs every case through RUN(state, code, end) -> translated?, checking the results.
+template <typename RunFn>
+void OneRegTblSweep(ThreadState& state, RunFn run) {
+  for (bool tbx : {false, true}) {
+    for (bool q : {false, true}) {
+      for (const OneRegTblAlias& a : kOneRegTblAliases) {
+        const int chunks = q ? 16 : 32;  // 16 or 8 meaningful lanes per run: all 256 indices
+        for (int c = 0; c < chunks; ++c) {
+          uint8_t idx[16], table[16], old[16];
+          for (int l = 0; l < 16; ++l) {
+            idx[l] = (q || l < 8) ? static_cast<uint8_t>(c * (q ? 16 : 8) + l) : 0xEE;  // 8B: upper ignored
+            table[l] = (l % 4 == 0) ? 0 : static_cast<uint8_t>(0x11 * l + 3);
+            old[l] = static_cast<uint8_t>(0xC0 | l);
+          }
+          // Aliased registers share their bytes: the shared register holds the index bytes when Vm is
+          // aliased, else the table.
+          if (a.rd == a.rn) std::memcpy(old, table, 16);
+          if (a.rn == a.rm) std::memcpy(table, idx, 16);
+          if (a.rd == a.rm) std::memcpy(old, idx, 16);
+          if (a.rd == a.rn && a.rn == a.rm) {
+            std::memcpy(table, idx, 16);
+            std::memcpy(old, idx, 16);
+          }
+          std::memcpy(&state.cpu.v[a.rd], old, 16);
+          std::memcpy(&state.cpu.v[a.rn], table, 16);
+          std::memcpy(&state.cpu.v[a.rm], idx, 16);
+          static uint32_t code[1];
+          code[0] = OneRegTblTbx(q, a.rd, a.rn, a.rm, tbx);
+          ASSERT_TRUE(run(state, code, ToGuestAddr(code) + sizeof(code)))
+              << "not translated: " << (tbx ? "TBX" : "TBL") << (q ? ".16B " : ".8B ") << a.name;
+          uint8_t out[16];
+          std::memcpy(out, &state.cpu.v[a.rd], 16);
+          for (int l = 0; l < 16; ++l) {
+            EXPECT_EQ(out[l], OneRegTblExpected(tbx, q, table, idx, old, l))
+                << (tbx ? "TBX" : "TBL") << (q ? ".16B " : ".8B ") << a.name << " chunk " << c
+                << " lane " << l << " idx " << int{idx[l]};
+          }
+        }
+      }
+    }
+  }
+}
+
+}  // namespace
+
+TEST_F(Arm64HeavyOptimizerFrontendTest, OpenBookOneRegTblTbxAllIndicesAllAliases) {
+  OneRegTblSweep(state_, [](ThreadState& s, uint32_t(&code)[1], GuestAddr end) {
+    bool ok = false;
+    RunRegion(&s, code, end, &ok);
+    return ok;
+  });
+}
+
 }  // namespace berberis
