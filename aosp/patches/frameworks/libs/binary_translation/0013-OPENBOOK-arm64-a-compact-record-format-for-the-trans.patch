+// A small valid record, and the same with one thing wrong.
+std::vector<uint8_t> SmallRecord(void (*change)(RawRecord*) = nullptr, uint8_t tier = 1) {
+  RawRecord r(tier);
+  r.V(0x100).V(8).V(8).V(16).V(1).V(1);  // vaddr, end - vaddr, sizes, counts
+  r.Fill(8, 0x11).Fill(16, 0x22);
+  r.V(0).Raw({0x00}).V(0);  // a guest offset at 0, arg = vaddr
+  r.V(2).V(6);              // recovery {2, 5}
+  if (change != nullptr) {
+    change(&r);
+  }
+  return r.Finish();
+}
