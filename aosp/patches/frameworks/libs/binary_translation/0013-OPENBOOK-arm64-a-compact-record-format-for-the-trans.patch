+// Index entries hold 32-bit offsets. A record that fits below 4 GiB is written and found; one that
+// would end past it isn't written, rather than narrowed. The file is sparse.
+TEST_F(PersistentCacheTest, OffsetsPast4GiBAreNotWritten) {
+  pcache::SetCapForTesting(1ull << 40);
+  uint8_t* base = WriteRegionA();
+  ASSERT_EQ(truncate(DataFile().c_str(), (1ll << 32) - (64 << 10)), 0);
+  StartProcess();
+  Counts c1;
+  base = Remap(base, elf_path_);
+  Translate(Pc(base, kRegionC));
+  pcache::FlushAll();
+  EXPECT_EQ(c1.Delta(pcache::kRecordsWritten), 1u);
+  EndProcess();
+  ASSERT_EQ(IndexEntries(), 2u);
+  EXPECT_GT(FindRecord(kRegionC).offset, (1ull << 32) - (64 << 10) - 1);
+
+  StartProcess();
+  Counts c2;
+  base = Remap(base, elf_path_);
+  Translate(Pc(base, kRegionC));
+  EXPECT_EQ(c2.Delta(pcache::kHitsLite), 1u) << "a record near 4 GiB loads";
+  EndProcess();
+
+  ASSERT_EQ(truncate(DataFile().c_str(), (1ll << 32) - 16), 0);
+  StartProcess();
+  Counts c3;
+  base = Remap(base, elf_path_);
+  Translate(Pc(base, kRegionB));
+  pcache::FlushAll();
+  EXPECT_EQ(c3.Delta(pcache::kRecordsWritten), 0u);
+  EXPECT_EQ(c3.Delta(pcache::kNotPersistable), 1u);
+  EndProcess();
+  EXPECT_EQ(IndexEntries(), 2u);
+}
