+constexpr GuestAddr kFormatModuleStart = 0x7000'0000'0000;
+constexpr uint64_t kFormatModuleSpan = 0x10000;
+
+pcache::RecordContents EveryKindContents() {
+  pcache::RecordContents c;
+  c.tier = pcache::Tier::kLiteCounter;
+  c.vaddr = 0x4000;
+  c.end = 0x4000 + 0x100;
+  c.guest_bytes.assign(16, 0xab);
+  c.code.resize(300);
+  for (size_t i = 0; i < c.code.size(); i++) {
+    c.code[i] = static_cast<uint8_t>(i * 7);
+  }
+  c.operands = {
+      {0, 8, SymbolKind::kGuestOffset, 0, 0x4000 + 0x100},         // forward
+      {8, 8, SymbolKind::kGuestOffset, 0, 0x4000 - 0x50},          // backward
+      {16, 8, SymbolKind::kGuestOffset, 0, 0},                     // the module's start
+      {24, 8, SymbolKind::kGuestOffset, 0, kFormatModuleSpan},     // its end, included
+      {40, 8, SymbolKind::kTableSlot, 0, 0x4000 + 4},
+      {200, 8, SymbolKind::kTableSlot, 0, 0x4000 - 0x3000},        // a 2-byte offset delta
+      {208, 8, SymbolKind::kMainTable, 0, 0},
+      {216, 8, SymbolKind::kCounter, 0, 0},
+      {224, 8, SymbolKind::kImageOffset, 0, 0x12'3456},
+      {232, 4, SymbolKind::kImageOffset, 236, 0x1000},             // next_pc = offset + 4
+      {240, 4, SymbolKind::kEntry, 250, 3},                        // explicit next_pc
+      {250, 8, SymbolKind::kEntry, 0, 1},
+      {258, 8, SymbolKind::kResource, 0, (uint64_t{0x123} << 8) | 3},  // a resource with an offset
+      {266, 8, SymbolKind::kImageOffset, 0, UINT64_MAX},           // a 10-byte varint
+      {274, 4, SymbolKind::kEntry, 299, 7},                        // explicit, near the end
+  };
+  c.recovery_points = {{10, 200}, {30, 5}, {30, 31}, {299, 300}, {0, 0}};
+  return c;
+}
+
+pcache::Candidate DecodeForFormatTest(const std::vector<uint8_t>& bytes, bool* ok) {
+  pcache::Candidate c;
+  c.record = bytes;
+  *ok = pcache::DecodeRecord(
+      c.record.data(), c.record.size(), kFormatModuleStart, kFormatModuleStart + kFormatModuleSpan, &c);
+  return c;
+}
+
+TEST(PersistentCacheFormat, EveryKindRoundTrips) {
+  pcache::RecordContents in = EveryKindContents();
+  std::vector<uint8_t> bytes;
+  ASSERT_TRUE(pcache::EncodeRecord(in, &bytes));
+  bool ok;
+  pcache::Candidate out = DecodeForFormatTest(bytes, &ok);
+  ASSERT_TRUE(ok);
+  EXPECT_EQ(out.tier, in.tier);
+  EXPECT_EQ(out.pc, kFormatModuleStart + in.vaddr);
+  EXPECT_EQ(out.end_pc, kFormatModuleStart + in.end);
+  EXPECT_EQ(std::vector<uint8_t>(out.guest_bytes(), out.guest_bytes() + out.guest_size),
+            in.guest_bytes);
+  EXPECT_EQ(std::vector<uint8_t>(out.code(), out.code() + out.code_size), in.code);
+  ASSERT_EQ(out.operands.size(), in.operands.size());
+  for (size_t i = 0; i < in.operands.size(); i++) {
+    const SymbolicOperand& a = in.operands[i];
+    const SymbolicOperand& b = out.operands[i];
+    EXPECT_EQ(a.offset, b.offset) << i;
+    EXPECT_EQ(a.width, b.width) << i;
+    EXPECT_EQ(a.kind, b.kind) << i;
+    EXPECT_EQ(a.next_pc, b.next_pc) << i;
+    EXPECT_EQ(a.arg, b.arg) << i;
+  }
+  std::vector<std::pair<uint32_t, uint32_t>> sorted = in.recovery_points;
+  std::sort(sorted.begin(), sorted.end());
+  EXPECT_EQ(out.recovery_points, sorted);
+  // Every tier.
+  for (pcache::Tier tier : {pcache::Tier::kLiteSettled, pcache::Tier::kHeavy}) {
+    pcache::RecordContents no_counter = in;
+    no_counter.tier = tier;
+    no_counter.operands.erase(no_counter.operands.begin() + 7);  // the counter
+    ASSERT_TRUE(pcache::EncodeRecord(no_counter, &bytes));
+    DecodeForFormatTest(bytes, &ok);
+    EXPECT_TRUE(ok) << int(tier);
+  }
+}
