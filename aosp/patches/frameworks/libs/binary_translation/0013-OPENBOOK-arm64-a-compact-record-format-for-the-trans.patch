+// A file of format 1 fails check 1. A process that doesn't hold the module's lock leaves it alone;
+// the writer replaces it.
+TEST_F(PersistentCacheTest, Version1FilesAreRefusedAndOnlyTheWriterReplacesThem) {
+  uint8_t* base = WriteRegionA();
+  for (const std::string& path : {DataFile(), IndexFile()}) {
+    std::vector<uint8_t> file = ReadFile(path);
+    uint32_t version = 1;
+    memcpy(file.data() + 60, &version, 4);  // FileHeader.fingerprint.format_version
+    uint32_t crc = Crc32c(file.data(), kHeaderSize, 12);
+    memcpy(file.data() + 12, &crc, 4);
+    WriteFile(path, file);
+  }
+  const std::vector<uint8_t> v1 = ReadFile(DataFile());
+  // Another process holds the lock: this one only reads.
+  int lock = open(FileWith(".lock").c_str(), O_RDWR | O_CLOEXEC);
+  ASSERT_GE(lock, 0);
+  ASSERT_EQ(flock(lock, LOCK_EX | LOCK_NB), 0);
+  StartProcess();
+  Counts c1;
+  base = Remap(base, elf_path_);
+  Translate(Pc(base, kRegionA));
+  EXPECT_EQ(c1.Delta(pcache::kRejectsFile), 1u);
+  EXPECT_EQ(c1.Delta(pcache::kHitsLite), 0u);
+  EndProcess();
+  EXPECT_EQ(ReadFile(DataFile()), v1) << "a reader replaced the file";
+  close(lock);
+
+  StartProcess();
+  Counts c2;
+  base = Remap(base, elf_path_);
+  Translate(Pc(base, kRegionA));
+  EXPECT_EQ(c2.Delta(pcache::kRejectsFile), 1u);
+  EndProcess();
+  EXPECT_NE(ReadFile(DataFile()), v1);
+  EXPECT_EQ(IndexEntries(), 1u);
+
+  StartProcess();
+  Counts c3;
+  base = Remap(base, elf_path_);
+  Translate(Pc(base, kRegionA));
+  EXPECT_EQ(c3.Delta(pcache::kHitsLite), 1u);
+}
