+TEST(PersistentCacheFormat, EncoderRefusesWhatItCantRepresent) {
+  std::vector<uint8_t> bytes;
+  auto refused = [&](void (*change)(pcache::RecordContents*)) {
+    pcache::RecordContents c = EveryKindContents();
+    change(&c);
+    return !pcache::EncodeRecord(c, &bytes);
+  };
+  EXPECT_TRUE(refused([](auto* c) { c->tier = pcache::Tier::kHeavy; }));  // a counter
+  EXPECT_TRUE(refused([](auto* c) { c->operands[0].width = 4; }));  // a guest displacement
+  EXPECT_TRUE(refused([](auto* c) { std::swap(c->operands[0], c->operands[1]); }));  // order
+  EXPECT_TRUE(refused([](auto* c) { c->operands[1].offset = 4; }));  // overlapping
+  EXPECT_TRUE(refused([](auto* c) { c->operands[6].arg = 1; }));     // a main table argument
+  EXPECT_TRUE(refused([](auto* c) { c->operands[9].next_pc = 235; }));  // inside the operand
+  EXPECT_TRUE(refused([](auto* c) { c->operands[0].arg = UINT64_MAX; }));  // past int64
+  EXPECT_TRUE(refused([](auto* c) { c->recovery_points[0].first = 300; }));  // past the code
+  EXPECT_TRUE(refused([](auto* c) { c->guest_bytes.resize(6); }));
+  EXPECT_TRUE(refused([](auto* c) { c->end = c->vaddr + 8; }));
+}
