+// ---- The record format (version 2) ----
+//
+// A record is a fixed 16-byte prefix (magic, size, CRC32C over the record with the CRC taken as
+// zero, tier, three zero bytes), then canonical LEB128 varints and unpadded bytes:
+//   vaddr, end - vaddr, guest size, code size, operand count, recovery point count;
+//   the guest bytes; the code;
+//   each operand: its offset minus the previous operand's end, a tag byte (kind in bits 0-2, bit 3
+//     for a 4-byte displacement, bit 4 when next_pc isn't offset + 4, then next_pc - offset - 4),
+//     and its argument: zigzag(arg - vaddr) for a guest offset or table slot, nothing for the main
+//     table or counter, the argument itself otherwise;
+//   each recovery point, by fault offset: fault - previous fault, zigzag(recovery - fault).
+// Decoding fails closed: anything non-canonical, out of bounds, overflowing or left over refuses
+// the record.
+
+struct RecordContents {
+  Tier tier = Tier::kLiteCounter;
+  uint64_t vaddr = 0;  // Region start - module start.
+  uint64_t end = 0;    // The translation's end_pc - module start.
+  std::vector<uint8_t> guest_bytes;
+  std::vector<uint8_t> code;
+  std::vector<SymbolicOperand> operands;  // By offset, not overlapping.
+  std::vector<std::pair<uint32_t, uint32_t>> recovery_points;
+};
+
+// False if `contents` can't be represented (the record isn't persistable).
+[[nodiscard]] bool EncodeRecord(const RecordContents& contents, std::vector<uint8_t>* out);
+// Checks and decodes a whole record into `out`, for a module at [module_start, module_end]: fills
+// everything but the module and mapping, and pc and end_pc from module_start. `record` must be
+// out->record's data: out->guest_bytes() and out->code() point into it.
+[[nodiscard]] bool DecodeRecord(const uint8_t* record,
+                                size_t size,
+                                GuestAddr module_start,
+                                GuestAddr module_end,
+                                Candidate* out);
+void PutVarint(std::vector<uint8_t>* out, uint64_t value);
+// Reads a canonical varint at *pos, advancing it. False if it's truncated, overlong or overflows.
+[[nodiscard]] bool GetVarint(const uint8_t* p, size_t size, size_t* pos, uint64_t* value);
+
 // The candidate re-linked as if installed at `install_addr`, into `out` (for verify).
 [[nodiscard]] bool RelinkCandidateAt(const Candidate& candidate,
                                      uint8_t* out,
