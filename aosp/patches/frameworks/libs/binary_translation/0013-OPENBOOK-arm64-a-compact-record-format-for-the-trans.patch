+TEST(PersistentCacheFormat, VarintsRoundTripAtEverySizeAndRefuseNonCanonicalForms) {
+  const std::pair<uint64_t, size_t> kValues[] = {
+      {0, 1},           {1, 1},           {127, 1},         {128, 2},          {16383, 2},
+      {16384, 3},       {(1u << 21) - 1, 3}, {1u << 21, 4},   {UINT32_MAX, 5},   {1ull << 32, 5},
+      {1ull << 56, 9},  {INT64_MAX, 9},   {1ull << 63, 10}, {UINT64_MAX, 10},
+  };
+  for (auto [value, length] : kValues) {
+    std::vector<uint8_t> b;
+    pcache::PutVarint(&b, value);
+    EXPECT_EQ(b.size(), length) << value;
+    size_t pos = 0;
+    uint64_t back = 0;
+    ASSERT_TRUE(pcache::GetVarint(b.data(), b.size(), &pos, &back)) << value;
+    EXPECT_EQ(back, value);
+    EXPECT_EQ(pos, b.size());
+    // Any shorter prefix is truncated.
+    for (size_t n = 0; n < b.size(); n++) {
+      pos = 0;
+      EXPECT_FALSE(pcache::GetVarint(b.data(), n, &pos, &back)) << value << " cut at " << n;
+    }
+  }
+  const std::vector<std::vector<uint8_t>> kBad = {
+      {0x80, 0x00},                                                     // 0, overlong
+      {0xff, 0x00},                                                     // 127, overlong
+      {0x80, 0x80, 0x00},                                               // overlong
+      {0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x02},     // past 64 bits
+      {0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x01},  // 11 bytes
+  };
+  for (const auto& b : kBad) {
+    size_t pos = 0;
+    uint64_t v;
+    EXPECT_FALSE(pcache::GetVarint(b.data(), b.size(), &pos, &v)) << b.size();
+  }
+}
