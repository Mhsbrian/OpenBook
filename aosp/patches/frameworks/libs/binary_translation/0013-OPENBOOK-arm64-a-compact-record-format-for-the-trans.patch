+// ---- Format v2 in the cache ----
+
+// Every byte of a real record flipped in turn, its CRC repaired, then loaded with verify. A flip is
+// either refused outright, or the record decodes and verify decides: only code equal to a fresh
+// translation is published. Whatever happens, the code installed equals the unchanged record's
+// code re-linked there, which is the fresh translation. This doesn't authenticate records against
+// a writer who means harm (design doc, section 4).
+TEST_F(PersistentCacheTest, EveryFlippedByteIsRefusedOrVerified) {
+  uint8_t* base = WriteRegionA();
+  const std::vector<uint8_t> data = ReadFile(DataFile());
+  const std::vector<uint8_t> index = ReadFile(IndexFile());
+  const Record original = FindRecord(kRegionA);
+  ASSERT_FALSE(original.bytes.empty());
+  pcache::Candidate expected = original.Decoded();
+  size_t refused = 0;
+  size_t matched = 0;
+  size_t fresh = 0;
+  for (size_t i = 0; i < original.bytes.size(); i++) {
+    if (i >= kRecordCrcAt && i < kRecordCrcAt + 4) {
+      continue;  // The CRC itself: repairing it undoes the flip.
+    }
+    WriteFile(DataFile(), data);
+    WriteFile(IndexFile(), index);
+    Record flipped = original;
+    flipped.bytes[i] ^= 0xff;
+    flipped.FixCrc();
+    WriteRecord(flipped);
+    StartProcess(Mode::kVerify);
+    base = Remap(base, elf_path_);
+    GuestAddr pc = Pc(base, kRegionA);
+    Counts c;
+    Translate(pc);
+    if (c.Delta(pcache::kRejectsRecord) + c.Delta(pcache::kRejectsBytes) +
+            c.Delta(pcache::kRejectsMapping) >
+        0) {
+      refused++;
+    } else if (c.Delta(pcache::kVerifyMatch) > 0) {
+      matched++;
+    } else {
+      EXPECT_EQ(c.Delta(pcache::kVerifyMismatch) + c.Delta(pcache::kVerifyInconclusive) +
+                    c.Delta(pcache::kVerifyFallback),
+                1u)
+          << "byte " << i;
+      fresh++;
+    }
+    ASSERT_TRUE(IsTranslated(pc)) << "byte " << i;
+    GuestCodeEntry* entry = Entry(pc);
+    ASSERT_EQ(entry->host_size, expected.code_size) << "byte " << i;
+    std::vector<uint8_t> want(expected.code_size);
+    pcache::Candidate at_base = expected;
+    at_base.module_start = ToGuestAddr(base);
+    ASSERT_TRUE(pcache::RelinkCandidateAt(at_base,
+                                          want.data(),
+                                          reinterpret_cast<uintptr_t>(HostCode(pc)),
+                                          reinterpret_cast<uintptr_t>(&entry->invocation_counter)));
+    EXPECT_EQ(memcmp(HostCode(pc), want.data(), want.size()), 0) << "byte " << i;
+    EndProcess();
+  }
+  printf("flipped %zu bytes: %zu refused, %zu decoded and verified equal, %zu replaced by fresh code\n",
+         original.bytes.size() - 4, refused, matched, fresh);
+  EXPECT_EQ(refused + matched + fresh, original.bytes.size() - 4);
+  EXPECT_GT(refused, 0u);
+  EXPECT_GT(fresh, 0u);
+}
