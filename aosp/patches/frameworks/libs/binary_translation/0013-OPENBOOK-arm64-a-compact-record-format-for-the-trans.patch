+// ---- The record format ----
+
+void PutVarint(std::vector<uint8_t>* out, uint64_t value) {
+  while (value >= 0x80) {
+    out->push_back(static_cast<uint8_t>(value) | 0x80);
+    value >>= 7;
+  }
+  out->push_back(static_cast<uint8_t>(value));
+}
+
+bool GetVarint(const uint8_t* p, size_t size, size_t* pos, uint64_t* value) {
+  uint64_t result = 0;
+  for (unsigned i = 0; i < 10; i++) {
+    if (*pos >= size) {
+      return false;  // Truncated.
+    }
+    uint8_t byte = p[(*pos)++];
+    if (i == 9 && byte > 1) {
+      return false;  // Past 64 bits.
+    }
+    result |= uint64_t{byte & 0x7fu} << (7 * i);
+    if ((byte & 0x80) == 0) {
+      if (i > 0 && byte == 0) {
+        return false;  // Overlong: a canonical varint doesn't end in a zero byte.
+      }
+      *value = result;
+      return true;
+    }
+  }
+  return false;  // More than 10 bytes.
+}
+
+namespace {
+
+constexpr uint64_t ZigZag(int64_t v) {
+  return (static_cast<uint64_t>(v) << 1) ^ static_cast<uint64_t>(v >> 63);
+}
+
+constexpr int64_t UnZigZag(uint64_t v) {
+  return static_cast<int64_t>(v >> 1) ^ -static_cast<int64_t>(v & 1);
+}
+
+// base + delta, or false if it leaves [0, UINT64_MAX].
+bool AddSigned(uint64_t base, int64_t delta, uint64_t* out) {
+  if (delta >= 0) {
+    if (base > UINT64_MAX - static_cast<uint64_t>(delta)) {
+      return false;
+    }
+    *out = base + static_cast<uint64_t>(delta);
+    return true;
+  }
+  uint64_t magnitude = static_cast<uint64_t>(-(delta + 1)) + 1;  // No overflow at INT64_MIN.
+  if (base < magnitude) {
+    return false;
+  }
+  *out = base - magnitude;
+  return true;
+}
+
+bool IsGuestKind(SymbolKind kind) {
+  return kind == SymbolKind::kGuestOffset || kind == SymbolKind::kTableSlot;
+}
+
+bool HasArg(SymbolKind kind) {
+  return kind != SymbolKind::kMainTable && kind != SymbolKind::kCounter;
+}
+
+// What a translation may contain: displacements only to host entries and the translator image
+// (SymbolizeTranslation's RelocAbsToDisp32 operands), a counter only in a counting region.
+bool OperandShapeValid(SymbolKind kind, uint8_t width, Tier tier) {
+  if (width == 4) {
+    return kind == SymbolKind::kEntry || kind == SymbolKind::kImageOffset;
+  }
+  if (width != 8) {
+    return false;
+  }
+  return kind != SymbolKind::kCounter || tier == Tier::kLiteCounter;
+}
+
+// Appends a record to `out`. Operands by offset, not overlapping; recovery points by fault offset.
+bool EncodeRecordInto(Tier tier,
+                      uint64_t vaddr,
+                      uint64_t end,
+                      const uint8_t* guest,
+                      size_t guest_size,
+                      const uint8_t* code,
+                      size_t code_size,
+                      const SymbolicOperand* operands,
+                      size_t num_operands,
+                      const std::pair<uint32_t, uint32_t>* recovery_points,
+                      size_t num_recovery_points,
+                      std::vector<uint8_t>* out) {
+  if (guest_size == 0 || guest_size > kMaxGuestSize || guest_size % 4 != 0 || code_size == 0 ||
+      code_size > kMaxCodeSize || num_operands > kMaxOperands ||
+      num_recovery_points > kMaxRecoveryPoints || end < vaddr || end - vaddr < guest_size) {
+    return false;
+  }
+  out->clear();
+  out->resize(kRecordPrefixSize, 0);
+  uint32_t magic = kRecordMagic;
+  memcpy(out->data(), &magic, 4);
+  (*out)[kRecordTierAt] = static_cast<uint8_t>(tier);
+  PutVarint(out, vaddr);
+  PutVarint(out, end - vaddr);
+  PutVarint(out, guest_size);
+  PutVarint(out, code_size);
+  PutVarint(out, num_operands);
+  PutVarint(out, num_recovery_points);
+  // Copied with memcpy, as everywhere on these paths: a range insert measured about 2 µs a record
+  // in the host build.
+  size_t at = out->size();
+  out->resize(at + guest_size + code_size);
+  memcpy(out->data() + at, guest, guest_size);
+  memcpy(out->data() + at + guest_size, code, code_size);
+  uint64_t prev_end = 0;
+  for (size_t i = 0; i < num_operands; i++) {
+    const SymbolicOperand& op = operands[i];
+    if (!OperandShapeValid(op.kind, op.width, tier) || op.offset < prev_end ||
+        uint64_t{op.offset} + op.width > code_size) {
+      return false;
+    }
+    PutVarint(out, op.offset - prev_end);
+    uint8_t tag = static_cast<uint8_t>(op.kind) | (op.width == 4 ? kTagDisp32 : 0);
+    if (op.width == 4) {
+      if (uint64_t{op.next_pc} < uint64_t{op.offset} + 4 || op.next_pc > code_size) {
+        return false;
+      }
+      bool explicit_next_pc = op.next_pc != op.offset + 4;
+      out->push_back(tag | (explicit_next_pc ? kTagExplicitNextPc : 0));
+      if (explicit_next_pc) {
+        PutVarint(out, op.next_pc - op.offset - 4);
+      }
+    } else {
+      out->push_back(tag);
+    }
+    if (IsGuestKind(op.kind)) {
+      // arg - vaddr as a signed 64-bit value.
+      if ((op.arg >= vaddr && op.arg - vaddr > uint64_t{INT64_MAX}) ||
+          (op.arg < vaddr && vaddr - op.arg > uint64_t{INT64_MAX})) {
+        return false;
+      }
+      int64_t delta = op.arg >= vaddr ? static_cast<int64_t>(op.arg - vaddr)
+                                      : -static_cast<int64_t>(vaddr - op.arg);
+      PutVarint(out, ZigZag(delta));
+    } else if (HasArg(op.kind)) {
+      PutVarint(out, op.arg);
+    } else if (op.arg != 0) {
+      return false;
+    }
+    prev_end = op.offset + op.width;
+  }
+  uint32_t prev_fault = 0;
+  for (size_t i = 0; i < num_recovery_points; i++) {
+    auto [fault, recovery] = recovery_points[i];
+    if (fault < prev_fault || fault >= code_size || recovery > code_size) {
+      return false;
+    }
+    PutVarint(out, fault - prev_fault);
+    PutVarint(out, ZigZag(int64_t{recovery} - int64_t{fault}));
+    prev_fault = fault;
+  }
+  if (out->size() > (16u << 20)) {
+    return false;
+  }
+  uint32_t size = static_cast<uint32_t>(out->size());
+  memcpy(out->data() + 4, &size, 4);
+  uint32_t crc = Crc32cExcept(out->data(), out->size(), kRecordCrcAt);
+  memcpy(out->data() + kRecordCrcAt, &crc, 4);
+  return true;
+}
+
+}  // namespace
+
+bool EncodeRecord(const RecordContents& contents, std::vector<uint8_t>* out) {
+  std::vector<std::pair<uint32_t, uint32_t>> recovery = contents.recovery_points;
+  std::sort(recovery.begin(), recovery.end());
+  return EncodeRecordInto(contents.tier,
+                          contents.vaddr,
+                          contents.end,
+                          contents.guest_bytes.data(),
+                          contents.guest_bytes.size(),
+                          contents.code.data(),
+                          contents.code.size(),
+                          contents.operands.data(),
+                          contents.operands.size(),
+                          recovery.data(),
+                          recovery.size(),
+                          out);
+}
+
+bool DecodeRecord(const uint8_t* rec,
+                  size_t size,
+                  GuestAddr module_start,
+                  GuestAddr module_end,
+                  Candidate* c) {
+  // The outer size and the CRC first, on the caller's private copy.
+  if (size < kRecordPrefixSize || size > (16u << 20) || module_end < module_start) {
+    return false;
+  }
+  uint32_t magic;
+  uint32_t declared_size;
+  uint32_t crc;
+  memcpy(&magic, rec, 4);
+  memcpy(&declared_size, rec + 4, 4);
+  memcpy(&crc, rec + kRecordCrcAt, 4);
+  uint8_t tier = rec[kRecordTierAt];
+  if (magic != kRecordMagic || declared_size != size || tier < 1 || tier > 3 ||
+      rec[kRecordTierAt + 1] != 0 || rec[kRecordTierAt + 2] != 0 || rec[kRecordTierAt + 3] != 0 ||
+      Crc32cExcept(rec, size, kRecordCrcAt) != crc) {
+    return false;
+  }
+  size_t pos = kRecordPrefixSize;
+  uint64_t vaddr;
+  uint64_t end_delta;
+  uint64_t guest_size;
+  uint64_t code_size;
+  uint64_t num_operands;
+  uint64_t num_recovery_points;
+  if (!GetVarint(rec, size, &pos, &vaddr) || !GetVarint(rec, size, &pos, &end_delta) ||
+      !GetVarint(rec, size, &pos, &guest_size) || !GetVarint(rec, size, &pos, &code_size) ||
+      !GetVarint(rec, size, &pos, &num_operands) ||
+      !GetVarint(rec, size, &pos, &num_recovery_points)) {
+    return false;
+  }
+  if (guest_size == 0 || guest_size > kMaxGuestSize || guest_size % 4 != 0 || code_size == 0 ||
+      code_size > kMaxCodeSize || end_delta < guest_size || vaddr > UINT64_MAX - end_delta) {
+    return false;
+  }
+  // The region and its end, as addresses: no wrapping, and the region inside the module.
+  uint64_t module_span = module_end - module_start;
+  uint64_t end = vaddr + end_delta;
+  if (vaddr > module_span || guest_size > module_span - vaddr || end > UINT64_MAX - module_start) {
+    return false;
+  }
+  if (guest_size > size - pos || code_size > size - pos - guest_size) {
+    return false;
+  }
+  size_t guest_at = pos;
+  size_t code_at = pos + guest_size;
+  pos = code_at + code_size;
+  // Counts bounded by what's left (an operand takes at least 2 bytes, a recovery point 2) before
+  // anything grows.
+  uint64_t left = size - pos;
+  if (num_operands > kMaxOperands || num_recovery_points > kMaxRecoveryPoints ||
+      2 * num_operands + 2 * num_recovery_points > left) {
+    return false;
+  }
+  c->operands.clear();
+  c->operands.reserve(num_operands);
+  uint64_t prev_end = 0;
+  for (uint64_t i = 0; i < num_operands; i++) {
+    uint64_t delta;
+    if (!GetVarint(rec, size, &pos, &delta) || delta > code_size - prev_end || pos >= size) {
+      return false;
+    }
+    uint64_t offset = prev_end + delta;
+    uint8_t tag = rec[pos++];
+    if ((tag & kTagReserved) != 0 || (tag & kTagKindMask) > uint8_t(SymbolKind::kResource)) {
+      return false;
+    }
+    auto kind = static_cast<SymbolKind>(tag & kTagKindMask);
+    uint8_t width = (tag & kTagDisp32) ? 4 : 8;
+    bool explicit_next_pc = (tag & kTagExplicitNextPc) != 0;
+    if (!OperandShapeValid(kind, width, static_cast<Tier>(tier)) ||
+        (explicit_next_pc && width != 4) || width > code_size - offset) {
+      return false;
+    }
+    uint64_t next_pc = 0;
+    if (width == 4) {
+      next_pc = offset + 4;
+      if (explicit_next_pc) {
+        uint64_t extra;
+        if (!GetVarint(rec, size, &pos, &extra) || extra == 0 || extra > code_size - next_pc) {
+          return false;  // Explicit means not offset + 4, and inside the code.
+        }
+        next_pc += extra;
+      }
+      if (next_pc > code_size) {
+        return false;
+      }
+    }
+    uint64_t arg = 0;
+    if (IsGuestKind(kind)) {
+      uint64_t zz;
+      if (!GetVarint(rec, size, &pos, &zz) || !AddSigned(vaddr, UnZigZag(zz), &arg) ||
+          arg > module_span) {
+        return false;  // A guest address must lie in the module: [start, end].
+      }
+    } else if (HasArg(kind) && !GetVarint(rec, size, &pos, &arg)) {
+      return false;
+    }
+    c->operands.push_back({static_cast<uint32_t>(offset),
+                           width,
+                           kind,
+                           static_cast<uint32_t>(next_pc),
+                           arg});
+    prev_end = offset + width;
+  }
+  c->recovery_points.clear();
+  c->recovery_points.reserve(num_recovery_points);
+  uint64_t prev_fault = 0;
+  for (uint64_t i = 0; i < num_recovery_points; i++) {
+    uint64_t delta;
+    uint64_t zz;
+    uint64_t recovery;
+    if (!GetVarint(rec, size, &pos, &delta) || delta >= code_size - prev_fault ||
+        !GetVarint(rec, size, &pos, &zz)) {
+      return false;
+    }
+    uint64_t fault = prev_fault + delta;
+    if (!AddSigned(fault, UnZigZag(zz), &recovery) || recovery > code_size) {
+      return false;
+    }
+    c->recovery_points.emplace_back(static_cast<uint32_t>(fault), static_cast<uint32_t>(recovery));
+    prev_fault = fault;
+  }
+  if (pos != size) {
+    return false;  // Trailing bytes.
+  }
+  c->module_start = module_start;
+  c->module_end = module_end;
+  c->pc = module_start + vaddr;
+  c->end_pc = module_start + end;
+  c->guest_size = static_cast<uint32_t>(guest_size);
+  c->code_size = static_cast<uint32_t>(code_size);
+  c->tier = static_cast<Tier>(tier);
+  c->guest_bytes_at = guest_at;
+  c->code_at = code_at;
+  return true;
+}
