From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: B Honey <9922368+Mhsbrian@users.noreply.github.com>
Date: Thu, 5 Nov 2026 12:00:00 +0000
Subject: [PATCH] OPENBOOK: arm64: skip the heavy backend for gear-ups whose
 result is discarded

A hot lite region gears up: HeavyOptimizeRegion runs the frontend and then
the backend (x86_64::GenCode: the optimization passes and code generation,
most of the heavy tier's time), and only then does the caller look at the
outcome. Two outcomes throw the code away: a fully translated region below
the minimum size (declined as too small), and a bail with no in-region
loop captured. On the G14, 86% of Lichess's heavy attempts were declined as
too small (ANAL-381), each after a full backend run, and the region is then
lite-translated again anyway.

HeavyOptimizeParams gains skip_codegen_below_instructions and
skip_codegen_if_bailed_without_backedge (off by default: every other caller
and test keeps codegen). With them HeavyOptimizeRegion returns after the
frontend for those two outcomes, with machine_code empty and the same
stop_pc, success, instruction count and back-edge flag. The gear-up path
turns both on with the gear-up minimum, so what is installed is unchanged:
regions of at least the minimum size, and bailed prefixes that hold a loop.

Tests: heavy_optimizer/arm64/skip_codegen_tests.cc checks the same outcome
with and without the options, no code for a declined small region and for a
bail without a loop, and full code for a large region and for a bail after
a captured loop.
---
 heavy_optimizer/arm64/Android.bp              |   1 +
 .../arm64/heavy_optimize_region.cc            |   8 ++
 .../arm64/heavy_optimize_region.h             |   9 ++
 heavy_optimizer/arm64/skip_codegen_tests.cc   | 118 ++++++++++++++++++
 runtime/arm64/translator_x86_64.cc            |  13 +-
 5 files changed, 147 insertions(+), 2 deletions(-)
 create mode 100644 heavy_optimizer/arm64/skip_codegen_tests.cc

diff --git a/heavy_optimizer/arm64/Android.bp b/heavy_optimizer/arm64/Android.bp
index 6919487c..c43e6c54 100644
--- a/heavy_optimizer/arm64/Android.bp
+++ b/heavy_optimizer/arm64/Android.bp
@@ -87,6 +87,7 @@ cc_test_library {
         "heavy_differential_fuzz_tests.cc",
         "heavy_memory_differential_fuzz_tests.cc",
         "loop_context_tests.cc",
+        "skip_codegen_tests.cc",
         "tier_coverage_test.cc",
     ],
 }
diff --git a/heavy_optimizer/arm64/heavy_optimize_region.cc b/heavy_optimizer/arm64/heavy_optimize_region.cc
index eff0b753..123ea0f8 100644
--- a/heavy_optimizer/arm64/heavy_optimize_region.cc
+++ b/heavy_optimizer/arm64/heavy_optimize_region.cc
@@ -77,6 +77,14 @@ std::tuple<GuestAddr, bool, size_t> HeavyOptimizeRegion(GuestAddr pc,
     *out_has_in_region_backedge = frontend.has_in_region_backedge();
   }
 
+  bool unused = frontend.success()
+                    ? number_of_instructions < params.skip_codegen_below_instructions
+                    : params.skip_codegen_if_bailed_without_backedge &&
+                          !frontend.has_in_region_backedge();
+  if (unused) {
+    return {stop_pc, frontend.success(), number_of_instructions};
+  }
+
   x86_64::GenCode(&machine_ir, machine_code);
 
   return {stop_pc, frontend.success(), number_of_instructions};
diff --git a/heavy_optimizer/arm64/include/berberis/heavy_optimizer/arm64/heavy_optimize_region.h b/heavy_optimizer/arm64/include/berberis/heavy_optimizer/arm64/heavy_optimize_region.h
index 23ec2721..075b5daa 100644
--- a/heavy_optimizer/arm64/include/berberis/heavy_optimizer/arm64/heavy_optimize_region.h
+++ b/heavy_optimizer/arm64/include/berberis/heavy_optimizer/arm64/heavy_optimize_region.h
@@ -30,6 +30,15 @@ struct HeavyOptimizeParams {
   // use grows with region length, so cap region size like the riscv64 tier.
   size_t max_number_of_instructions = 200;
   GuestAddr end_pc = GetGuestAddrRangeEnd();
+  // Skip the backend (x86_64::GenCode: the optimization passes and code
+  // generation, most of the heavy tier's time) when the caller would throw the
+  // result away: a fully translated region shorter than this many
+  // instructions, or, with skip_codegen_if_bailed_without_backedge, a region
+  // the frontend bailed on before finding an in-region loop. machine_code is
+  // then left empty; the returned stop_pc, success and instruction count are
+  // the same as with codegen. The defaults keep codegen for every region.
+  size_t skip_codegen_below_instructions = 0;
+  bool skip_codegen_if_bailed_without_backedge = false;
 };
 
 // Optimizing (second-gear) translation of the ARM64 region at `pc` into
diff --git a/heavy_optimizer/arm64/skip_codegen_tests.cc b/heavy_optimizer/arm64/skip_codegen_tests.cc
new file mode 100644
index 00000000..80e06558
--- /dev/null
+++ b/heavy_optimizer/arm64/skip_codegen_tests.cc
@@ -0,0 +1,118 @@
