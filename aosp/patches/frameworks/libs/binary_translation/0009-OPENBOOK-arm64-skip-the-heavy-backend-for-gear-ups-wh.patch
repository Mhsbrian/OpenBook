+
+// HeavyOptimizeParams' skip_codegen options: the backend is skipped exactly
+// when the gear-up caller would throw the result away (a fully translated
+// region below the minimum size, a bail with no in-region loop), and kept
+// otherwise. stop_pc, success and the instruction count must not change.
+
+#include "gtest/gtest.h"
+
+#include <cstdint>
+
+#include "berberis/assembler/machine_code.h"
+#include "berberis/guest_state/guest_addr.h"
+#include "berberis/heavy_optimizer/arm64/heavy_optimize_region.h"
+
+namespace berberis {
+
+namespace {
+
+constexpr uint32_t kMovzX0 = 0xd2800220;   // movz x0, #0x11
+constexpr uint32_t kMovzX1 = 0xd2800441;   // movz x1, #0x22
+constexpr uint32_t kRet = 0xd65f03c0;      // ret: ends the region
+constexpr uint32_t kAddX0 = 0x91000400;    // add x0, x0, #1
+constexpr uint32_t kAddX3 = 0x8b020023;    // add x3, x1, x2
+constexpr uint32_t kBrk = 0xd4200000;      // brk #0: the heavy frontend bails
+constexpr uint32_t kSubsX0 = 0xf1000400;   // subs x0, x0, #1
+constexpr uint32_t kBneBack1 = 0x54ffffe1; // b.ne .-4
+
+const uint32_t kSmall[] = {kMovzX0, kMovzX1, kRet};
+const uint32_t kLarge[] = {kAddX0, kAddX0, kAddX0, kAddX0, kAddX0, kAddX0, kAddX0, kAddX0, kAddX0,
+                           kAddX0, kAddX0, kAddX0, kAddX0, kAddX0, kAddX0, kAddX0, kAddX0, kAddX0,
+                           kAddX0, kAddX0, kAddX0, kAddX0, kAddX0, kAddX0, kRet};
+const uint32_t kBailsWithoutLoop[] = {kAddX3, kBrk};
+// movz; loop: subs; b.ne loop; brk -- a captured in-region loop, then a bail.
+const uint32_t kBailsAfterLoop[] = {kMovzX0, kSubsX0, kBneBack1, kBrk};
+
+struct Result {
+  GuestAddr stop;
+  bool ok;
+  size_t n;
+  uint32_t code_size;
+  bool backedge;
+};
+
+template <size_t N>
+Result Optimize(const uint32_t (&code)[N], bool skip) {
+  GuestAddr start = ToGuestAddr(code);
+  HeavyOptimizeParams params{.end_pc = start + N * 4};
+  if (skip) {
+    params.skip_codegen_below_instructions = 20;
+    params.skip_codegen_if_bailed_without_backedge = true;
+  }
+  MachineCode machine_code;
+  bool backedge = false;
+  auto [stop, ok, n] = HeavyOptimizeRegion(start, &machine_code, params, &backedge);
+  return {stop, ok, n, machine_code.install_size(), backedge};
+}
+
+template <size_t N>
+void ExpectSameOutcome(const uint32_t (&code)[N], Result* with_skip, Result* without) {
+  *with_skip = Optimize(code, true);
+  *without = Optimize(code, false);
+  EXPECT_EQ(with_skip->stop, without->stop);
+  EXPECT_EQ(with_skip->ok, without->ok);
+  EXPECT_EQ(with_skip->n, without->n);
+  EXPECT_EQ(with_skip->backedge, without->backedge);
+  EXPECT_GT(without->code_size, 0u) << "the defaults always run the backend";
+}
+
+TEST(Arm64HeavySkipCodegen, DeclinedSmallRegionGetsNoCode) {
+  Result skip, full;
+  ExpectSameOutcome(kSmall, &skip, &full);
+  EXPECT_TRUE(skip.ok);
+  EXPECT_EQ(skip.n, 3u);
+  EXPECT_EQ(skip.code_size, 0u);
+}
+
+TEST(Arm64HeavySkipCodegen, BailWithoutLoopGetsNoCode) {
+  Result skip, full;
+  ExpectSameOutcome(kBailsWithoutLoop, &skip, &full);
+  EXPECT_FALSE(skip.ok);
+  EXPECT_FALSE(skip.backedge);
+  EXPECT_EQ(skip.code_size, 0u);
+}
+
+TEST(Arm64HeavySkipCodegen, LargeRegionKeepsItsCode) {
+  Result skip, full;
+  ExpectSameOutcome(kLarge, &skip, &full);
+  EXPECT_TRUE(skip.ok);
+  EXPECT_EQ(skip.code_size, full.code_size);
+}
+
+// The prefix of a bail that captured a loop is installed, so it needs its code.
+TEST(Arm64HeavySkipCodegen, BailAfterALoopKeepsItsCode) {
+  Result skip, full;
+  ExpectSameOutcome(kBailsAfterLoop, &skip, &full);
+  EXPECT_FALSE(skip.ok);
+  ASSERT_TRUE(skip.backedge) << "the region doesn't capture its loop; the test would be vacuous";
+  EXPECT_EQ(skip.code_size, full.code_size);
+}
+
+}  // namespace
+
+}  // namespace berberis
diff --git a/runtime/arm64/translator_x86_64.cc b/runtime/arm64/translator_x86_64.cc
index bacba731..5212aabf 100644
--- a/runtime/arm64/translator_x86_64.cc
+++ b/runtime/arm64/translator_x86_64.cc
@@ -218,8 +218,17 @@ std::tuple<bool, HostCodePiece, size_t, GuestCodeEntry::Kind> HeavyOptimizeAndIn
     GuestAddr pc) {
   MachineCode machine_code;
   bool has_in_region_backedge = false;
-  auto [stop_pc, success, number_of_instructions] = HeavyOptimizeRegion(
-      pc, &machine_code, {.end_pc = pc + GetExecutableRegionSize(pc)}, &has_in_region_backedge);
+  // The outcomes below that discard the result (declined as too small, bailed
+  // without a captured loop) are known once the frontend has run, so the
+  // optimizer's backend is skipped for them. 86% of Lichess's gear-ups on the
+  // G14 were declined as too small (ANAL-381), each after a full backend run.
+  auto [stop_pc, success, number_of_instructions] =
+      HeavyOptimizeRegion(pc,
+                          &machine_code,
+                          {.end_pc = pc + GetExecutableRegionSize(pc),
+                           .skip_codegen_below_instructions = GetGearUpMinInsns(),
+                           .skip_codegen_if_bailed_without_backedge = true},
+                          &has_in_region_backedge);
   size_t size = stop_pc - pc;
   // When the heavy frontend bails partway through, the prefix it did translate is
   // still a valid region ending in an exit to the bailing PC. Install that prefix
-- 
