diff --git a/assembler/include/berberis/assembler/common.h b/assembler/include/berberis/assembler/common.h
index 364aa912..7a91b344 100644
--- a/assembler/include/berberis/assembler/common.h
+++ b/assembler/include/berberis/assembler/common.h
@@ -118,6 +118,12 @@ class AssemblerBase {
     code_->AddRelocation(dst, type, pc, data);
   }
 
+  // region digitalis
+  void AddPersistentReloc(uint32_t offset, uint8_t width, PersistentOperand kind, uint64_t value) {
+    code_->AddPersistentReloc(offset, width, kind, value);
+  }
+  // endregion
+
   // These are 'static' relocations, resolved when code is finalized.
