diff --git a/decoder/include/berberis/decoder/arm64/semantics_player.h b/decoder/include/berberis/decoder/arm64/semantics_player.h
index 7fcc61f7..38a25b3b 100644
--- a/decoder/include/berberis/decoder/arm64/semantics_player.h
+++ b/decoder/include/berberis/decoder/arm64/semantics_player.h
@@ -107,7 +107,7 @@ class SemanticsPlayer {
   void BranchImm(const typename Decoder::BranchImmArgs& args) {
     if (args.is_link) {
       // BL: save return address in X30.
-      Register ret_addr = listener_->GetImm(listener_->GetInsnAddr() + 4);
+      Register ret_addr = GetGuestAddrImm(listener_->GetInsnAddr() + 4);
       listener_->SetReg(30, ret_addr);
     }
     listener_->Branch(args.offset);
@@ -129,7 +129,7 @@ class SemanticsPlayer {
       if (args.src == 30) {
         target = listener_->Copy(target);
       }
-      Register ret_addr = listener_->GetImm(listener_->GetInsnAddr() + 4);
+      Register ret_addr = GetGuestAddrImm(listener_->GetInsnAddr() + 4);
       listener_->SetReg(30, ret_addr);
     }
     listener_->BranchRegister(target);
@@ -635,6 +635,20 @@ class SemanticsPlayer {
 
  private:
   // ARM64: register 31 as zero register.
+  // region digitalis
+  // A guest address as an immediate. A listener that records what its operands refer to
+  // (the lite translator, for the persistent translation cache) provides GetGuestAddrImm;
+  // the others get a plain immediate.
+  template <typename Addr>
+  Register GetGuestAddrImm(Addr addr) {
+    if constexpr (requires { listener_->GetGuestAddrImm(addr); }) {
+      return listener_->GetGuestAddrImm(addr);
+    } else {
+      return listener_->GetImm(addr);
+    }
+  }
+  // endregion
+
   Register GetRegOrZero(uint8_t reg) {
     return reg == 31 ? listener_->GetImm(0) : listener_->GetReg(reg);
   }
