+// Lite translation time over a real app's region set, run by hand:
+//
+//   BERBERIS_TRANSLATE_CORPUS=<dir> berberis_arm64_host_tests \
+//       --gtest_filter=DigitalisBench.DISABLED_TranslateRegionCorpus \
+//       --gtest_also_run_disabled_tests
+//
+// <dir> holds libs.txt (one arm64 library per line, in <dir>/libs/) and regions.txt
+// (`<library index> <ELF vaddr hex>` per region start, e.g. from a G14 profile's perf map). Each
+// region is lite-translated as first-gear lite is in two-gear mode (with its hotness counter) and
+// installed, the way the runtime does, in three passes. Prints each pass's ns per region. Uses only
+// the translator's own entry points, so the same file times any revision.
+// BERBERIS_TRANSLATE_CORPUS_RECORD=1 also records persistent operands (patch 10 and later).
+
+#include "gtest/gtest.h"
+
+#include <elf.h>
+#include <sys/mman.h>
