+TEST_F(RelocatableCodeTest, EveryFixtureTranslatesAndNamesItsOperands) {
+  Env env;
+  ASSERT_TRUE(env.Init(0, kHighEnvCode));
+  std::set<SymbolKind> kinds;
+  for (size_t i = 0; i < kNumFixtures; i++) {
+    Translation t = Translate(env, i);
+    ASSERT_TRUE(t.success) << kFixtures[i].name;
+    SymbolizedCode s = Symbolize(env, t);
+    if (kFixtures[i].offset == kFarFixture) {
+      EXPECT_EQ(s.reason, NotPersistable::kGuestAddrOutsideModule) << NotPersistableName(s.reason);
+      continue;
+    }
+    EXPECT_EQ(s.reason, NotPersistable::kNo)
+        << kFixtures[i].name << ": " << NotPersistableName(s.reason);
+    for (const auto& op : s.operands) {
+      kinds.insert(op.kind);
+    }
+  }
+  // Between them the fixtures hit every kind of operand a lite translation has.
+  for (SymbolKind kind : {SymbolKind::kGuestOffset, SymbolKind::kTableSlot, SymbolKind::kMainTable,
+                          SymbolKind::kCounter, SymbolKind::kImageOffset, SymbolKind::kEntry,
+                          SymbolKind::kResource}) {
+    EXPECT_EQ(kinds.count(kind), 1u) << "no fixture has kind " << static_cast<int>(kind);
+  }
+}
