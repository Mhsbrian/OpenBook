+// Not a test on its own: the second process RunChild starts.
+TEST(RelocatableCode, DISABLED_ProduceInAnotherProcess) {
+  const char* path = getenv(kDumpEnv);
+  ASSERT_NE(path, nullptr);
+  g_record_persistent_relocs_by_default = true;
+  g_omit_persistent_relocs_for_testing =
+      static_cast<uint32_t>(strtoul(getenv(kOmitEnv), nullptr, 10));
+  g_symbolize_skip_displacements_for_testing = strcmp(getenv(kSkipDispEnv), "1") == 0;
+  Env env;
+  // A module base the kernel picks (above 4 GiB), an install buffer the parent doesn't use, and
+  // entry trampolines moved from where the parent has them.
+  ASSERT_TRUE(env.Init(0, kChildCode));
+  ScopedMovedEntries moved;
+  ASSERT_TRUE(moved.ok());
+  std::vector<Translation> all = TranslateAll(env);
+  FILE* f = fopen(path, "wb");
+  ASSERT_NE(f, nullptr);
+  Put(f, kDumpMagic);
+  Put(f, FactsOf(env));
+  Put(f, static_cast<uint32_t>(kNumFixtures));
+  for (const Translation& t : all) {
+    SymbolizedCode s;
+    uint32_t uncovered = 0;
+    if (t.success) {
+      s = Symbolize(env, t);
+      uncovered = Scan(env, t).size();
+    }
+    Put(f, static_cast<uint8_t>(t.success));
+    Put(f, static_cast<uint8_t>(s.reason));
+    Put(f, uncovered);
+    Put(f, static_cast<uint32_t>(t.bytes.size()));
+    fwrite(t.bytes.data(), 1, t.bytes.size(), f);
+    Put(f, static_cast<uint32_t>(s.operands.size()));
+    for (const auto& op : s.operands) {
+      Put(f, op);
+    }
+    Put(f, static_cast<uint32_t>(s.recovery_points.size()));
+    for (const auto& rp : s.recovery_points) {
+      Put(f, rp);
+    }
+  }
+  ASSERT_EQ(fclose(f), 0);
+}
