+// Coverage on real code, run by hand (it needs the corpus): every region start of an app's profile,
+// as `<library index> <ELF vaddr hex>` lines in $BERBERIS_RELOC_CORPUS/regions.txt, with the arm64
+// libraries named in libs.txt beside it. Each region is translated with its library loaded once
+// above and once below 4 GiB. The first is named and scanned, then re-linked into the second.
+// Prints a summary; fails only on an uncovered pointer or a re-link mismatch.
+namespace {
+
+struct CorpusLib {
+  std::string name;
+  uintptr_t bias = 0;  // Address of ELF vaddr 0.
+  GuestModule module{};
+  GuestAddr exec_end = 0;
+};
+
+bool LoadElf(const std::string& path, uintptr_t hint, CorpusLib* lib) {
+  FILE* f = fopen(path.c_str(), "rb");
+  if (f == nullptr) {
+    return false;
+  }
+  std::vector<uint8_t> file;
+  uint8_t buf[65536];
+  size_t n;
+  while ((n = fread(buf, 1, sizeof(buf), f)) > 0) {
+    file.insert(file.end(), buf, buf + n);
+  }
+  fclose(f);
+  if (file.size() < sizeof(Elf64_Ehdr)) {
+    return false;
+  }
+  Elf64_Ehdr ehdr;
+  memcpy(&ehdr, file.data(), sizeof(ehdr));
+  uint64_t lo = UINT64_MAX;
+  uint64_t hi = 0;
+  std::vector<Elf64_Phdr> loads;
+  for (int i = 0; i < ehdr.e_phnum; i++) {
+    Elf64_Phdr ph;
+    memcpy(&ph, file.data() + ehdr.e_phoff + i * sizeof(ph), sizeof(ph));
+    if (ph.p_type != PT_LOAD) {
+      continue;
+    }
+    loads.push_back(ph);
+    lo = std::min<uint64_t>(lo, ph.p_vaddr & ~uint64_t{4095});
+    hi = std::max<uint64_t>(hi, ph.p_vaddr + ph.p_memsz);
+  }
+  size_t span = (hi - lo + 4095) & ~size_t{4095};
+  void* m = MapAt(hint, span);
+  if (m == nullptr) {
+    return false;
+  }
+  lib->bias = reinterpret_cast<uintptr_t>(m) - lo;
+  for (const auto& ph : loads) {
+    if (ph.p_offset + ph.p_filesz > file.size()) {
+      return false;
+    }
+    memcpy(reinterpret_cast<void*>(lib->bias + ph.p_vaddr), file.data() + ph.p_offset,
+           ph.p_filesz);
+    if (ph.p_flags & PF_X) {
+      lib->exec_end = std::max<GuestAddr>(lib->exec_end, lib->bias + ph.p_vaddr + ph.p_filesz);
+    }
+  }
+  lib->module = {lib->bias + lo, lib->bias + hi};
+  return true;
+}
+
+uint64_t NowNs() {
+  timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return ts.tv_sec * 1'000'000'000ull + ts.tv_nsec;
+}
+
+}  // namespace
+
+TEST_F(RelocatableCodeTest, DISABLED_RegionCorpus) {
+  const char* dir = getenv("BERBERIS_RELOC_CORPUS");
+  if (dir == nullptr) {
+    GTEST_SKIP() << "set BERBERIS_RELOC_CORPUS";
+  }
+  std::vector<std::string> names;
+  {
+    FILE* f = fopen((std::string(dir) + "/libs.txt").c_str(), "r");
+    ASSERT_NE(f, nullptr);
+    char line[512];
+    while (fgets(line, sizeof(line), f)) {
+      names.emplace_back(line, strcspn(line, "\n"));
+    }
+    fclose(f);
+  }
+  std::vector<CorpusLib> high(names.size());
+  std::vector<CorpusLib> low(names.size());
+  uintptr_t low_hint = 0x7000'0000;
+  for (size_t i = 0; i < names.size(); i++) {
+    std::string path = std::string(dir) + "/libs/" + names[i];
+    high[i].name = low[i].name = names[i];
+    ASSERT_TRUE(LoadElf(path, 0, &high[i])) << path;
+    ASSERT_TRUE(LoadElf(path, low_hint, &low[i])) << path;
+    low_hint = (low[i].module.end + 0x10'0000) & ~uintptr_t{0xffff};
+    ASSERT_LT(low[i].module.end, uint64_t{1} << 32);
+  }
+  constexpr size_t kSlot = 64 * 1024;
+  uint8_t* code = static_cast<uint8_t*>(MapAt(kHighEnvCode, 2 * kSlot));
+  ASSERT_NE(code, nullptr);
+  uint32_t* counters = new uint32_t[2]();
+  const AddrRange code_range{reinterpret_cast<uintptr_t>(code),
+                             reinterpret_cast<uintptr_t>(code) + 2 * kSlot, "installed code"};
+  const AddrRange counter_range{reinterpret_cast<uintptr_t>(counters),
+                                reinterpret_cast<uintptr_t>(counters + 2), "counters"};
+  std::vector<std::vector<AddrRange>> high_ranges;
+  std::vector<std::vector<AddrRange>> low_ranges;
+  for (size_t i = 0; i < names.size(); i++) {
+    high_ranges.push_back(PersistenceSensitiveRanges(high[i].module, code_range, counter_range));
+    low_ranges.push_back(PersistenceSensitiveRanges(low[i].module, code_range, counter_range));
+  }
+
+  struct PerLib {
+    size_t regions = 0, translated = 0, partial = 0, interpreted = 0, persistable = 0;
+    size_t uncovered = 0, mismatched = 0;
+    std::map<std::string, size_t> not_persistable;
+  };
+  std::vector<PerLib> per(names.size());
+  uint64_t translate_ns = 0, symbolize_ns = 0, relink_ns = 0, scan_ns = 0;
+  size_t host_bytes = 0, operands = 0;
+  std::vector<std::string> examples;
+
+  // One map for every install: the two slots are reused, so its entries are overwritten, not added.
+  RecoveryMap recovery_map;
+  FILE* f = fopen((std::string(dir) + "/regions.txt").c_str(), "r");
+  ASSERT_NE(f, nullptr);
+  unsigned li;
+  unsigned long long vaddr;
+  while (fscanf(f, "%u %llx", &li, &vaddr) == 2) {
+    ASSERT_LT(li, names.size());
+    PerLib& p = per[li];
+    p.regions++;
+    auto translate = [&](const CorpusLib& lib, size_t slot, Translation* t) {
+      t->machine_code = std::make_unique<MachineCode>();
+      LiteTranslateParams params;
+      params.end_pc = lib.exec_end;
+      params.enable_self_profiling = true;  // As first-gear lite is, in two-gear mode.
+      params.counter_location = &counters[slot];
+      t->counter = reinterpret_cast<uintptr_t>(&counters[slot]);
+      GuestAddr pc = lib.bias + vaddr;
+      auto [success, stop_pc] = TryLiteTranslateRegion(pc, t->machine_code.get(), params);
+      if (!success && stop_pc > pc) {  // As the runtime does: re-translate up to the failure.
+        t->machine_code = std::make_unique<MachineCode>();
+        params.end_pc = stop_pc;
+        std::tie(success, stop_pc) = TryLiteTranslateRegion(pc, t->machine_code.get(), params);
+        t->success = success;
+        return success ? 2 : 0;
+      }
+      t->success = success;
+      return success ? 1 : 0;
+    };
+    Translation a;
+    Translation b;
+    uint64_t t0 = NowNs();
+    int kind = translate(high[li], 0, &a);
+    translate_ns += NowNs() - t0;
+    if (kind == 0) {
+      p.interpreted++;
+      continue;
+    }
+    if (a.machine_code->install_size() > kSlot) {
+      p.not_persistable["larger than the test slot"]++;
+      continue;
+    }
+    (kind == 1 ? p.translated : p.partial)++;
+    a.install = reinterpret_cast<uintptr_t>(code);
+    a.machine_code->InstallUnsafe(code, &recovery_map);
+    a.bytes.assign(code, code + a.machine_code->install_size());
+    host_bytes += a.bytes.size();
+    t0 = NowNs();
+    SymbolizedCode sa =
+        SymbolizeTranslation(*a.machine_code, a.bytes.data(), a.install, high[li].module,
+                             a.counter);
+    symbolize_ns += NowNs() - t0;
+    t0 = NowNs();
+    auto found = FindUncoveredPointers(a.bytes.data(), a.bytes.size(),
+                                       RecordedIntervals(*a.machine_code), high_ranges[li]);
+    scan_ns += NowNs() - t0;
+    if (!found.empty()) {
+      p.uncovered++;
+      if (examples.size() < 20) {
+        char buf[128];
+        snprintf(buf, sizeof(buf), "uncovered %s+0x%llx:", names[li].c_str(), vaddr);
+        examples.push_back(buf + Describe(found, &a.bytes));
+      }
+    }
+    if (sa.reason != NotPersistable::kNo) {
+      p.not_persistable[NotPersistableName(sa.reason)]++;
+      continue;
+    }
+    p.persistable++;
+    operands += sa.operands.size();
+    if (translate(low[li], 1, &b) != kind) {
+      p.mismatched++;
+      continue;
+    }
+    b.install = reinterpret_cast<uintptr_t>(code + kSlot);
+    b.machine_code->InstallUnsafe(code + kSlot, &recovery_map);
+    b.bytes.assign(code + kSlot, code + kSlot + b.machine_code->install_size());
+    // The low copy isn't scanned: a 4-byte window over an 80 MB range below 4 GiB matches ordinary
+    // displacements by chance (mov [rbp+0x70], r9 reads as 0x704d894c). The differential below
+    // checks it instead; an operand emitted narrower there would change its bytes or length.
+    std::vector<uint8_t> copy = a.bytes;
+    t0 = NowNs();
+    bool relinked = copy.size() == b.bytes.size() &&
+                    RelinkTranslation(copy.data(), copy.size(), sa.operands, low[li].bias,
+                                      b.install, b.counter);
+    relink_ns += NowNs() - t0;
+    if (!relinked || copy != b.bytes) {
+      p.mismatched++;
+      if (examples.size() < 20) {
+        char buf[128];
+        snprintf(buf, sizeof(buf), "mismatch %s+0x%llx (sizes %zu/%zu)", names[li].c_str(), vaddr,
+                 a.bytes.size(), b.bytes.size());
+        examples.push_back(buf);
+      }
+    }
+  }
+  fclose(f);
+
+  PerLib total;
+  printf("corpus: %s\n%-36s %8s %8s %8s %8s %8s %8s %8s  not persistable\n", dir, "library",
+         "regions", "full", "partial", "interp", "persist", "uncov", "mismatch");
+  for (size_t i = 0; i < names.size(); i++) {
+    const PerLib& p = per[i];
+    std::string why;
+    for (const auto& [reason, count] : p.not_persistable) {
+      why += reason + "=" + std::to_string(count) + " ";
+      total.not_persistable[reason] += count;
+    }
+    printf("%-36s %8zu %8zu %8zu %8zu %8zu %8zu %8zu  %s\n", names[i].c_str(), p.regions,
+           p.translated, p.partial, p.interpreted, p.persistable, p.uncovered, p.mismatched,
+           why.c_str());
+    total.regions += p.regions;
+    total.translated += p.translated;
+    total.partial += p.partial;
+    total.interpreted += p.interpreted;
+    total.persistable += p.persistable;
+    total.uncovered += p.uncovered;
+    total.mismatched += p.mismatched;
+  }
+  std::string why;
+  for (const auto& [reason, count] : total.not_persistable) {
+    why += reason + "=" + std::to_string(count) + " ";
+  }
+  printf("%-36s %8zu %8zu %8zu %8zu %8zu %8zu %8zu  %s\n", "TOTAL", total.regions,
+         total.translated, total.partial, total.interpreted, total.persistable, total.uncovered,
+         total.mismatched, why.c_str());
+  size_t translated = total.translated + total.partial;
+  printf("host bytes %zu (%.0f per region), operands %zu (%.1f per persistable region)\n",
+         host_bytes, translated ? double(host_bytes) / translated : 0.0, operands,
+         total.persistable ? double(operands) / total.persistable : 0.0);
+  printf("ns per region: translate %.0f, symbolize %.0f, scan %.0f, relink %.0f\n",
+         translated ? double(translate_ns) / total.regions : 0.0,
+         translated ? double(symbolize_ns) / translated : 0.0,
+         translated ? double(scan_ns) / translated : 0.0,
+         total.persistable ? double(relink_ns) / total.persistable : 0.0);
+  for (const auto& e : examples) {
+    printf("  %s\n", e.c_str());
+  }
+  EXPECT_EQ(total.uncovered, 0u);
+  EXPECT_EQ(total.mismatched, 0u);
+}
