diff --git a/assembler/include/berberis/assembler/machine_code.h b/assembler/include/berberis/assembler/machine_code.h
index 48a2f405..7049eea2 100644
--- a/assembler/include/berberis/assembler/machine_code.h
+++ b/assembler/include/berberis/assembler/machine_code.h
@@ -54,14 +54,49 @@ enum class RelocationType {
 
 using RecoveryMap = ForeverMap<uintptr_t, uintptr_t>;
 
+// region digitalis
+// What an absolute operand embedded in generated code refers to. These records are kept so a
+// translation can be checked for, and later given, a new process's addresses: the persistent
+// translation cache (ANAL-381; OpenBook docs/digitalis-translation-cache.md, section 3.4). They
+// are never applied at install time and change no generated code. The RelocAbsToDisp32 records
+// above already name their targets.
+enum class PersistentOperand : uint8_t {
+  kGuestAddr,     // A guest address. value: the address.
+  kTableSlot,     // The translation-table slot of a guest pc. value: the pc.
+  kMainTable,     // The translation table's main table. value: unused.
+  kCounter,       // The region's own hotness counter. value: unused.
+  kHostAddr,      // A host code or data address, classified when symbolized. value: the address.
+  kHostResource,  // Helper data built on the heap. value: its resource id.
+  kNumKinds,
+};
+
+struct PersistentReloc {
+  uint32_t offset;  // Of the operand in the code.
+  uint8_t width;    // In bytes.
+  PersistentOperand kind;
+  uint64_t value;
+};
+
+// Whether a new MachineCode records persistent operands. Off by default: recording costs a
+// median 2.4% of lite translation time on Lichess's region set (ANAL-381), and nothing persists
+// translations yet. The typed emitters always produce the same fixed-width encodings, so the code
+// is the same either way.
+extern bool g_record_persistent_relocs_by_default;
+
+// Test-only: kinds whose records AddPersistentReloc drops (bit 1 << kind), so the
+// completeness checks can be shown to fail on a missing record.
+extern uint32_t g_omit_persistent_relocs_for_testing;
+// endregion
+
 // Generated machine code for host architecture. Used by trampolines
 // and JIT translator.
 // NOTE: this class is not intended for concurrent usage by multiple threads.
 class MachineCode {
  public:
-  MachineCode() : code_(&arena_), relocations_(&arena_) {
+  MachineCode() : code_(&arena_), relocations_(&arena_), persistent_relocs_(&arena_) {
     // The amount is chosen according to the performance of spec2000 benchmarks.
     code_.reserve(1024);
+    set_record_persistent_relocs(g_record_persistent_relocs_by_default);  // digitalis
   }
 
   Arena* arena() { return &arena_; }
@@ -99,6 +134,38 @@ class MachineCode {
     relocations_.push_back(Relocation{dst, type, pc, data});
   }
 
+  // region digitalis
+  void AddPersistentReloc(uint32_t offset, uint8_t width, PersistentOperand kind, uint64_t value) {
+    if (!record_persistent_relocs_ ||
+        (g_omit_persistent_relocs_for_testing & (1u << static_cast<unsigned>(kind)))) {
+      return;
+    }
+    persistent_relocs_.push_back(PersistentReloc{offset, width, kind, value});
+  }
+
+  void set_record_persistent_relocs(bool record) {
+    record_persistent_relocs_ = record;
+    if (record) {
+      // A lite region averages 16 operands on Lichess's region set.
+      persistent_relocs_.reserve(32);
+    }
+  }
+  [[nodiscard]] bool record_persistent_relocs() const { return record_persistent_relocs_; }
+
+  struct Relocation {
+    uint32_t dst;
+    RelocationType type;
+    uint32_t pc;
+    intptr_t data;
+  };
+  using RelocationList = ArenaVector<Relocation>;
+
+  [[nodiscard]] const RelocationList& relocations() const { return relocations_; }
+  [[nodiscard]] const ArenaVector<PersistentReloc>& persistent_relocs() const {
+    return persistent_relocs_;
+  }
+  // endregion
+
   // Install to executable memory.
   template <typename ExecRegionType>
   void Install(ExecRegionType* exec, const uint8_t* code, RecoveryMap* recovery_map) {
@@ -119,14 +186,6 @@ class MachineCode {
   void DumpCode(InstructionSize insn_size) const;
 
  private:
-  struct Relocation {
-    uint32_t dst;
-    RelocationType type;
-    uint32_t pc;
-    intptr_t data;
-  };
-  using RelocationList = ArenaVector<Relocation>;
-
   [[nodiscard]] uint8_t* AddrOf(uint32_t offset);
   [[nodiscard]] const uint8_t* AddrOf(uint32_t offset) const;
   uint32_t Grow(uint32_t count);
@@ -137,6 +196,8 @@ class MachineCode {
   Arena arena_;
   ArenaVector<uint8_t> code_;
   RelocationList relocations_;
+  ArenaVector<PersistentReloc> persistent_relocs_;  // digitalis
+  bool record_persistent_relocs_ = false;            // digitalis
 
   DISALLOW_COPY_AND_ASSIGN(MachineCode);
 };
diff --git a/assembler/include/berberis/assembler/x86_64.h b/assembler/include/berberis/assembler/x86_64.h
index a54f1fa8..a9db011a 100644
--- a/assembler/include/berberis/assembler/x86_64.h
+++ b/assembler/include/berberis/assembler/x86_64.h
@@ -163,8 +163,23 @@ class Assembler : public x86_32_or_x86_64::Assembler<Assembler> {
     // these 8 bytes.
     Emit64(0x08eb'0000'0002'15ff);
     Emit64(bit_cast<int64_t>(target));
+    AddPersistentReloc(pc() - 8, 8, PersistentOperand::kHostAddr, bit_cast<uintptr_t>(target));
   }
 
+  // region digitalis
+  // movabs dest, imm64, always in the 10-byte form whatever the value, recording what the
+  // operand refers to (machine_code.h). `symbol` is the record's value: the address for
+  // kGuestAddr and kHostAddr, the pc for kTableSlot, the resource id for kHostResource.
+  void MovqPersistent(Register dest, int64_t imm64, PersistentOperand kind, uint64_t symbol) {
+    EmitInstruction<0xb8>(Register64Bit(dest), imm64);
+    AddPersistentReloc(pc() - 8, 8, kind, symbol);
+  }
+
+  void MovqGuestAddr(Register dest, uint64_t guest_addr) {
+    MovqPersistent(dest, bit_cast<int64_t>(guest_addr), PersistentOperand::kGuestAddr, guest_addr);
+  }
+  // endregion
+
   // Unhide Jcc(Label), hidden by special version below.
   using BaseAssembler::Jcc;
 
@@ -195,6 +210,7 @@ class Assembler : public x86_32_or_x86_64::Assembler<Assembler> {
     // address), then jmpq with address stored right after jmpq.
     Emit64(0x0000'0000'25ff'0e70 | static_cast<int8_t>(ToReverseCond(cc)));
     Emit64(bit_cast<int64_t>(target));
+    AddPersistentReloc(pc() - 8, 8, PersistentOperand::kHostAddr, target);
   }
 
   // Emit short relative jcc to an absolute address.
@@ -240,6 +256,7 @@ class Assembler : public x86_32_or_x86_64::Assembler<Assembler> {
     Emit16(0x25ff);
     Emit32(0x0000'0000);
     Emit64(bit_cast<int64_t>(target));
+    AddPersistentReloc(pc() - 8, 8, PersistentOperand::kHostAddr, target);
   }
 
   // Emit short relative jump to an absolute address.
