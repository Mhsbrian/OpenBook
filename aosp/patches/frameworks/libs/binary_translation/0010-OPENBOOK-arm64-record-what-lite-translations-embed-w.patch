+TEST_F(RelocatableCodeTest, TwoBasesRelinkToIdenticalCode) {
+  Env high;
+  Env low;
+  ASSERT_TRUE(high.Init(0, kHighEnvCode));
+  ASSERT_TRUE(low.Init(kLowModule, kLowCode));
+  ASSERT_GT(high.module, uint64_t{1} << 32);
+  for (size_t i = 0; i < kNumFixtures; i++) {
+    if (kFixtures[i].offset == kFarFixture) {
+      continue;
+    }
+    Translation a = Translate(high, i);
+    SymbolizedCode sa = Symbolize(high, a);
+    // The second environment's entry trampolines are elsewhere too.
+    ScopedMovedEntries moved;
+    ASSERT_TRUE(moved.ok());
+    Translation b = Translate(low, i);
