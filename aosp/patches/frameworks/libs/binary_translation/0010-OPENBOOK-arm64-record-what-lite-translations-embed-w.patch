+// The fixture module, assembled with llvm-mc (aarch64). Offsets of each fixture are below.
+alignas(64) const uint32_t kModule[] = {
+    // 0x00 branch: add x0, x0, #1 ; b 0xc ; nop ; ret
+    0x91000400, 0x14000002, 0xd503201f, 0xd65f03c0,
+    // 0x10 cond: cmp x0, #3 ; b.eq 0x24 ; cbz x1, 0x24 ; tbnz w2, #3, 0x24 ; add x0, x0, #1 ; ret
+    0xf1000c1f, 0x54000080, 0xb4000061, 0x37180042, 0x91000400, 0xd65f03c0,
+    // 0x28 bl: bl 0x2c ; ret
+    0x94000001, 0xd65f03c0,
+    // 0x30 blr: blr x3 ; br x4
+    0xd63f0060, 0xd61f0080,
+    // 0x38 adr: adr x0, 0x78 ; adrp x1, <its own page> ; ret
+    0x10000200, 0x90000001, 0xd65f03c0,
+    // 0x44 literal: ldr x0, 0x60 ; ldr w1, 0x60 ; ldrsw x2, 0x60 ; ldr q0, 0x70 ; ret ; nop ; nop
+    0x580000e0, 0x180000c1, 0x980000a2, 0x9c000100, 0xd65f03c0, 0xd503201f, 0xd503201f,
+    // 0x60 the literals
+    0x55667788, 0x11223344, 0xd503201f, 0xd503201f, 0x00000000, 0x00000000, 0x00000000,
+    0x00000000,
+    // 0x80 svc: mov x8, #172 ; svc #0 ; ret
+    0xd2801588, 0xd4000001, 0xd65f03c0,
+    // 0x8c ldst: ldr x0, [x1] ; str x0, [x2, #8] ; ret
+    0xf9400020, 0xf9000440, 0xd65f03c0,
+    // 0x98 frecpe: frecpe v0.4s, v1.4s ; frsqrte v2.2d, v3.2d ; ret
+    0x4ea1d820, 0x6ee1d862, 0xd65f03c0,
+    // 0xa4 urecpe: urecpe v0.4s, v1.4s ; ursqrte v2.2s, v3.2s ; ret
+    0x4ea1c820, 0x2ea1c862, 0xd65f03c0,
+    // 0xb0 loop: add x0, x0, #1 ; subs x1, x1, #1 ; b.ne 0xb0 ; ret
+    0x91000400, 0xf1000421, 0x54ffffc1, 0xd65f03c0,
+    // 0xc0 far: adr x0, <0x80000 past itself, outside the module> ; ret
+    0x10400000, 0xd65f03c0,
+};
+
+enum class Variant { kDefault, kNoDispatch, kSelfProfiling, kInRegionLoops };
+
+struct Fixture {
+  const char* name;
+  uint32_t offset;
+  Variant variant;
+};
+
+const Fixture kFixtures[] = {
+    {"branch", 0x00, Variant::kDefault},
+    {"branch, no dispatch", 0x00, Variant::kNoDispatch},
+    {"branch, hotness counter", 0x00, Variant::kSelfProfiling},
+    {"cond, cbz, tbnz", 0x10, Variant::kDefault},
+    {"bl", 0x28, Variant::kDefault},
+    {"blr", 0x30, Variant::kDefault},
+    {"adr, adrp", 0x38, Variant::kDefault},
+    {"literal loads", 0x44, Variant::kDefault},
+    {"svc", 0x80, Variant::kDefault},
+    {"load, store", 0x8c, Variant::kDefault},
+    {"frecpe, frsqrte", 0x98, Variant::kDefault},
+    {"urecpe, ursqrte", 0xa4, Variant::kDefault},
+    {"in-region loop", 0xb0, Variant::kInRegionLoops},
+    {"address outside the module", 0xc0, Variant::kDefault},
+};
+constexpr size_t kNumFixtures = sizeof(kFixtures) / sizeof(kFixtures[0]);
+constexpr uint32_t kFarFixture = 0xc0;
+
+constexpr size_t kModuleSize = 64 * 1024;
+constexpr size_t kCodeBufSize = 64 * 1024;
+constexpr size_t kRegionSlot = 4096;  // Installed code per fixture, at most.
+
+// Below 4 GiB, with top bytes that are rare in x86 code so the 4-byte scan has few chance hits.
+// Installed code must be within 2 GiB of the entry trampolines, so every install buffer is low.
+constexpr uintptr_t kLowModule = 0x6b5c'0000;
+constexpr uintptr_t kLowCode = 0x1d65'0000;
+constexpr uintptr_t kHighEnvCode = 0x3d65'0000;
+constexpr uintptr_t kChildCode = 0x2d65'0000;
+constexpr uintptr_t kMovedEntries = 0x5e65'0000;
+
+void* MapAt(uintptr_t hint, size_t size) {
+  int flags = MAP_PRIVATE | MAP_ANONYMOUS;
+  if (hint != 0) {
+    flags |= MAP_FIXED_NOREPLACE;
+  }
+  void* p = mmap(reinterpret_cast<void*>(hint), size, PROT_READ | PROT_WRITE, flags, -1, 0);
+  if (p == MAP_FAILED || (hint != 0 && p != reinterpret_cast<void*>(hint))) {
+    return nullptr;
+  }
+  return p;
+}
+
+// One place the fixtures are translated in: a module base, an install buffer, counters.
+struct Env {
+  GuestAddr module = 0;
+  uint8_t* code = nullptr;
+  uint32_t* counters = nullptr;
+
+  Env() = default;
+  Env(const Env&) = delete;
+  Env& operator=(const Env&) = delete;
+  ~Env() {
+    if (module != 0) {
+      munmap(reinterpret_cast<void*>(module), kModuleSize);
+    }
+    if (code != nullptr) {
+      munmap(code, kCodeBufSize);
+    }
+    delete[] counters;
+  }
+
+  bool Init(uintptr_t module_hint, uintptr_t code_hint) {
+    void* m = MapAt(module_hint, kModuleSize);
+    void* c = MapAt(code_hint, kCodeBufSize);
+    if (m == nullptr || c == nullptr) {
+      if (m != nullptr) {
+        munmap(m, kModuleSize);
+      }
+      if (c != nullptr) {
+        munmap(c, kCodeBufSize);
+      }
+      return false;
+    }
+    memcpy(m, kModule, sizeof(kModule));
+    module = reinterpret_cast<GuestAddr>(m);
+    code = static_cast<uint8_t*>(c);
+    counters = new uint32_t[kNumFixtures]();
+    return true;
+  }
+
+  [[nodiscard]] GuestModule Module() const { return {module, module + kModuleSize}; }
+  [[nodiscard]] AddrRange CodeRange() const {
+    return {reinterpret_cast<uintptr_t>(code), reinterpret_cast<uintptr_t>(code) + kCodeBufSize,
+            "installed code"};
+  }
+  [[nodiscard]] AddrRange CounterRange() const {
+    return {reinterpret_cast<uintptr_t>(counters),
+            reinterpret_cast<uintptr_t>(counters + kNumFixtures), "counters"};
+  }
+};
+
+// Copies the host entry trampolines elsewhere in the low 2 GiB and points kEntry* at the copies,
+// so translations made meanwhile refer to different entry addresses. Each trampoline is a
+// rip-relative jmp to the 8 bytes after it, so its copy works too (and nothing here runs it).
+class ScopedMovedEntries {
+ public:
+  ScopedMovedEntries() {
+    HostCodeAddr* entries[] = {&kEntryInterpret,     &kEntryExitGeneratedCode, &kEntryStop,
+                               &kEntryNoExec,        &kEntryNotTranslated,     &kEntryTranslating,
+                               &kEntryInvalidating, &kEntryWrapping};
+    static_assert(sizeof(entries) / sizeof(entries[0]) == kNumEntries);
+    buf_ = static_cast<uint8_t*>(MapAt(kMovedEntries, kEntryBytes * kNumEntries));
+    if (buf_ == nullptr) {
+      return;
+    }
+    for (size_t i = 0; i < kNumEntries; i++) {
+      saved_[i] = *entries[i];
+      memcpy(buf_ + i * kEntryBytes, reinterpret_cast<const void*>(uintptr_t{saved_[i]}), 14);
+      *entries[i] = static_cast<HostCodeAddr>(reinterpret_cast<uintptr_t>(buf_ + i * kEntryBytes));
+      entries_[i] = entries[i];
+    }
+  }
+  ~ScopedMovedEntries() {
+    if (buf_ == nullptr) {
+      return;
+    }
+    for (size_t i = 0; i < kNumEntries; i++) {
+      *entries_[i] = saved_[i];
+    }
+    munmap(buf_, kEntryBytes * kNumEntries);
+  }
+  [[nodiscard]] bool ok() const { return buf_ != nullptr; }
+
+ private:
+  static constexpr size_t kNumEntries = 8;
+  static constexpr size_t kEntryBytes = 64;
+  uint8_t* buf_ = nullptr;
+  HostCodeAddr saved_[kNumEntries] = {};
+  HostCodeAddr* entries_[kNumEntries] = {};
+};
+
+struct Translation {
+  std::unique_ptr<MachineCode> machine_code;
+  bool success = false;
+  uintptr_t install = 0;
+  uintptr_t counter = 0;
+  std::vector<uint8_t> bytes;
+};
+
+Translation Translate(const Env& env, size_t i) {
+  const Fixture& fixture = kFixtures[i];
+  Translation t;
+  t.machine_code = std::make_unique<MachineCode>();
+  LiteTranslateParams params;
+  params.end_pc = env.module + kModuleSize;
+  switch (fixture.variant) {
+    case Variant::kDefault:
+      break;
+    case Variant::kNoDispatch:
+      params.allow_dispatch = false;
+      break;
+    case Variant::kSelfProfiling:
+      params.enable_self_profiling = true;
+      params.counter_location = &env.counters[i];
+      t.counter = reinterpret_cast<uintptr_t>(&env.counters[i]);
+      break;
+    case Variant::kInRegionLoops:
+      params.allow_in_region_loops = true;
+      break;
+  }
+  auto [success, stop_pc] = TryLiteTranslateRegion(env.module + fixture.offset,
+                                                   t.machine_code.get(), params);
+  t.success = success;
+  if (!success || t.machine_code->install_size() > kRegionSlot) {
+    t.success = false;
+    return t;
+  }
+  uint8_t* dest = env.code + i * kRegionSlot;
+  RecoveryMap recovery_map;
+  t.machine_code->InstallUnsafe(dest, &recovery_map);
+  t.install = reinterpret_cast<uintptr_t>(dest);
+  t.bytes.assign(dest, dest + t.machine_code->install_size());
+  return t;
+}
+
+std::vector<Translation> TranslateAll(const Env& env) {
+  std::vector<Translation> all;
+  for (size_t i = 0; i < kNumFixtures; i++) {
+    all.push_back(Translate(env, i));
+  }
+  return all;
+}
+
+SymbolizedCode Symbolize(const Env& env, const Translation& t) {
+  return SymbolizeTranslation(*t.machine_code, t.bytes.data(), t.install, env.Module(), t.counter);
+}
+
+std::vector<UncoveredPointer> Scan(const Env& env, const Translation& t) {
+  return FindUncoveredPointers(t.bytes.data(),
+                               t.bytes.size(),
+                               RecordedIntervals(*t.machine_code),
+                               PersistenceSensitiveRanges(env.Module(), env.CodeRange(),
+                                                          env.CounterRange()));
+}
+
+std::string Describe(const std::vector<UncoveredPointer>& found,
+                     const std::vector<uint8_t>* code = nullptr) {
+  std::string s;
+  char buf[96];
+  for (const auto& f : found) {
+    snprintf(buf, sizeof(buf), " [+0x%x/%u 0x%llx %s", f.offset, f.width,
+             static_cast<unsigned long long>(f.value), f.range);
+    s += buf;
+    if (code != nullptr) {
+      s += ":";
+      size_t from = f.offset >= 8 ? f.offset - 8 : 0;
+      for (size_t k = from; k < std::min(code->size(), size_t{f.offset} + 12); k++) {
+        snprintf(buf, sizeof(buf), k == f.offset ? " |%02x" : " %02x", (*code)[k]);
+        s += buf;
+      }
+    }
+    s += "]";
+  }
+  return s;
+}
+
+// `from`'s bytes, re-linked into `to`'s environment, against `to`'s own translation.
+// Returns the first differing offset, or -1 if identical.
+long RelinkAndCompare(const std::vector<uint8_t>& from_bytes,
+                      const std::vector<SymbolicOperand>& from_operands,
+                      const Env& to_env,
+                      const Translation& to) {
+  std::vector<uint8_t> copy = from_bytes;
+  if (copy.size() != to.bytes.size()) {
+    return static_cast<long>(std::min(copy.size(), to.bytes.size()));
+  }
+  if (!RelinkTranslation(copy.data(), copy.size(), from_operands, to_env.module, to.install,
+                         to.counter)) {
+    return 0;
+  }
+  for (size_t k = 0; k < copy.size(); k++) {
+    if (copy[k] != to.bytes[k]) {
+      return static_cast<long>(k);
+    }
+  }
+  return -1;
+}
+
+bool SameRecoveryPoints(const std::vector<RecoveryPointOffsets>& a,
+                        const std::vector<RecoveryPointOffsets>& b) {
+  if (a.size() != b.size()) {
+    return false;
+  }
+  for (size_t k = 0; k < a.size(); k++) {
+    if (a[k].fault != b[k].fault || a[k].recovery != b[k].recovery) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// --- The second process: translate the fixtures, write what the parent needs. ---
+
+constexpr const char* kDumpEnv = "BERBERIS_RELOC_TEST_DUMP";
+constexpr const char* kOmitEnv = "BERBERIS_RELOC_TEST_OMIT";
+constexpr const char* kSkipDispEnv = "BERBERIS_RELOC_TEST_SKIP_DISP";
+constexpr uint32_t kDumpMagic = 0x4f425231;  // "OBR1"
+
+struct ProcessFacts {
+  uint64_t image_function;  // Address of a function in the translator image.
+  uint64_t entry;           // kEntryExitGeneratedCode.
+  uint64_t main_table;
+  uint64_t resource;        // kHostResourceUnsignedRecipEstimate.
+  uint64_t install_buffer;
+  uint64_t module;
+};
+
+ProcessFacts FactsOf(const Env& env) {
+  return {reinterpret_cast<uint64_t>(&SymbolizeTranslation),
+          kEntryExitGeneratedCode,
+          ResolveSymbol(SymbolKind::kMainTable, 0, 0, 0),
+          ResolveSymbol(SymbolKind::kResource, kHostResourceUnsignedRecipEstimate, 0, 0),
+          reinterpret_cast<uint64_t>(env.code), env.module};
+}
+
+template <typename T>
+void Put(FILE* f, const T& v) {
+  fwrite(&v, sizeof(v), 1, f);
+}
+
+template <typename T>
+bool Get(FILE* f, T* v) {
+  return fread(v, sizeof(*v), 1, f) == 1;
+}
+
+struct ChildRegion {
+  bool success = false;
+  NotPersistable reason = NotPersistable::kNo;
+  std::vector<uint8_t> bytes;
+  std::vector<SymbolicOperand> operands;
+  std::vector<RecoveryPointOffsets> recovery_points;
+  uint32_t uncovered = 0;
+};
+
+struct ChildDump {
+  ProcessFacts facts;
+  std::vector<ChildRegion> regions;
+};
+
+// Runs this binary's producer test in a new process, with record kinds `omit` dropped and,
+// with skip_displacements, displacements left unnamed. False if it didn't produce a dump.
+bool RunChild(uint32_t omit, bool skip_displacements, ChildDump* dump) {
+  char path[] = "/tmp/berberis-reloc-XXXXXX";
+  int fd = mkstemp(path);
+  if (fd < 0) {
+    return false;
+  }
+  close(fd);
+  std::string omit_str = std::to_string(omit);
+  setenv(kDumpEnv, path, 1);
+  setenv(kOmitEnv, omit_str.c_str(), 1);
+  setenv(kSkipDispEnv, skip_displacements ? "1" : "0", 1);
+  char arg0[] = "berberis_arm64_host_tests";
+  char arg1[] = "--gtest_filter=RelocatableCode.DISABLED_ProduceInAnotherProcess";
+  char arg2[] = "--gtest_also_run_disabled_tests";
+  char* argv[] = {arg0, arg1, arg2, nullptr};
+  posix_spawn_file_actions_t actions;
+  posix_spawn_file_actions_init(&actions);
+  posix_spawn_file_actions_addopen(&actions, STDOUT_FILENO, "/dev/null", O_WRONLY, 0);
+  pid_t pid;
+  int rc = posix_spawn(&pid, "/proc/self/exe", &actions, nullptr, argv, environ);
+  posix_spawn_file_actions_destroy(&actions);
+  unsetenv(kDumpEnv);
+  unsetenv(kOmitEnv);
+  unsetenv(kSkipDispEnv);
+  if (rc != 0) {
+    unlink(path);
+    return false;
+  }
+  int status;
+  if (waitpid(pid, &status, 0) != pid || !WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+    unlink(path);
+    return false;
+  }
+  FILE* f = fopen(path, "rb");
+  unlink(path);
+  if (f == nullptr) {
+    return false;
+  }
+  uint32_t magic = 0;
+  uint32_t count = 0;
+  bool ok = Get(f, &magic) && magic == kDumpMagic && Get(f, &dump->facts) && Get(f, &count) &&
+            count == kNumFixtures;
+  for (uint32_t i = 0; ok && i < count; i++) {
+    ChildRegion r;
+    uint8_t success = 0;
+    uint8_t reason = 0;
+    uint32_t n_bytes = 0;
+    uint32_t n_ops = 0;
+    uint32_t n_rec = 0;
+    ok = Get(f, &success) && Get(f, &reason) && Get(f, &r.uncovered) && Get(f, &n_bytes) &&
+         n_bytes <= kRegionSlot;
+    r.success = success != 0;
+    r.reason = static_cast<NotPersistable>(reason);
+    r.bytes.resize(n_bytes);
+    ok = ok && fread(r.bytes.data(), 1, n_bytes, f) == n_bytes && Get(f, &n_ops) &&
+         n_ops <= n_bytes;
+    r.operands.resize(n_ops);
+    for (uint32_t k = 0; ok && k < n_ops; k++) {
+      ok = Get(f, &r.operands[k]);
+    }
+    ok = ok && Get(f, &n_rec) && n_rec <= n_bytes;
+    r.recovery_points.resize(n_rec);
+    for (uint32_t k = 0; ok && k < n_rec; k++) {
+      ok = Get(f, &r.recovery_points[k]);
+    }
+    dump->regions.push_back(std::move(r));
+  }
+  fclose(f);
+  return ok;
+}
+
+// What a check of the parent against a child's dump found.
+struct CrossProcessResult {
+  size_t compared = 0;
+  size_t relink_mismatches = 0;
+  size_t recovery_mismatches = 0;
+  size_t child_uncovered = 0;
+  std::string first_mismatch;
+};
+
+CrossProcessResult CheckAgainstChild(const ChildDump& dump, const Env& env) {
+  CrossProcessResult result;
+  std::vector<Translation> mine = TranslateAll(env);
+  for (size_t i = 0; i < kNumFixtures; i++) {
+    const ChildRegion& theirs = dump.regions[i];
+    result.child_uncovered += theirs.uncovered;
+    if (!theirs.success || theirs.reason != NotPersistable::kNo || !mine[i].success) {
+      continue;
+    }
+    result.compared++;
+    long at = RelinkAndCompare(theirs.bytes, theirs.operands, env, mine[i]);
+    if (at >= 0) {
+      if (result.relink_mismatches++ == 0) {
+        result.first_mismatch = std::string(kFixtures[i].name) + " at +" + std::to_string(at);
+      }
+    }
+    if (!SameRecoveryPoints(theirs.recovery_points, Symbolize(env, mine[i]).recovery_points)) {
+      result.recovery_mismatches++;
+    }
+  }
+  return result;
+}
+
+class RelocatableCodeTest : public ::testing::Test {
+ protected:
+  void SetUp() override { g_record_persistent_relocs_by_default = true; }
+  void TearDown() override {
+    g_record_persistent_relocs_by_default = false;
+    g_omit_persistent_relocs_for_testing = 0;
+    g_symbolize_skip_displacements_for_testing = false;
+  }
+};
