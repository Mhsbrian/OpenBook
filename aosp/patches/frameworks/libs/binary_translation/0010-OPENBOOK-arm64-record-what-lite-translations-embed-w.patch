+#ifndef BERBERIS_RUNTIME_ARM64_RELOCATABLE_CODE_H_
+#define BERBERIS_RUNTIME_ARM64_RELOCATABLE_CODE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+#include "berberis/assembler/machine_code.h"
+#include "berberis/guest_state/guest_addr.h"
+
+namespace berberis {
+
+// region digitalis
+// Naming a translation's absolute operands so it can be given another process's addresses: the
+// groundwork for a persistent translation cache (ANAL-381, OpenBook
+// docs/digitalis-translation-cache.md, section 3.4). Nothing is persisted yet; the completeness
+// checks in relocatable_code_test.cc use this to show every operand is named.
+
+// What a named operand resolves to in the process the code is re-linked into.
+enum class SymbolKind : uint8_t {
+  kGuestOffset,  // The guest module's base + arg.
+  kTableSlot,    // The translation-table slot of guest pc (module base + arg).
+  kMainTable,    // The translation table's main table.
+  kCounter,      // The region's own hotness counter.
+  kImageOffset,  // This translator image's load bias + arg.
+  kEntry,        // Host entry trampoline number arg (kHostEntries order in the .cc).
+  kResource,     // Heap-built helper data with resource id arg.
+};
+
+struct SymbolicOperand {
+  uint32_t offset;   // In the code.
+  uint8_t width;     // 8: an absolute address. 4: a displacement relative to next_pc.
+  SymbolKind kind;
+  uint32_t next_pc;  // Displacements only: the offset the displacement is relative to.
+  uint64_t arg;
+};
+
+struct RecoveryPointOffsets {
+  uint32_t fault;
+  uint32_t recovery;
+};
+
+enum class NotPersistable : uint8_t {
+  kNo,                      // Persistable.
+  kGuestAddrOutsideModule,  // A guest address (or slot) outside the region's module.
+  kUnknownHostAddr,         // A host address in neither this image nor an entry trampoline.
+  kUnknownDispTarget,       // A displacement whose target is neither.
+  kUnknownResource,         // A resource id this process doesn't know.
+  kOperandMismatch,         // The installed bytes don't hold the recorded value.
+  kOverlappingOperands,
+  kNoCounter,               // A counter operand without a counter.
+};
+
+const char* NotPersistableName(NotPersistable reason);
+
+struct SymbolizedCode {
+  NotPersistable reason = NotPersistable::kNo;
+  std::vector<SymbolicOperand> operands;  // Ordered by offset.
+  std::vector<RecoveryPointOffsets> recovery_points;
+};
+
+// The guest module a translation belongs to. Guest operands are named relative to start; an
+// address in [start, end] belongs to it (end included: an exit to the first address past it).
+struct GuestModule {
+  GuestAddr start;
+  GuestAddr end;
+};
+
+// Names every absolute operand of `machine_code`, installed at `install_addr` with its bytes at
+// `code`, and checks each against those bytes. `counter` is the region's counter, or 0.
+SymbolizedCode SymbolizeTranslation(const MachineCode& machine_code,
+                                    const uint8_t* code,
+                                    uintptr_t install_addr,
+                                    GuestModule module,
+                                    uintptr_t counter);
+
+// Gives `code` (a copy of a translation's bytes) this process's addresses: its module at
+// `module_base`, installed at `install_addr`, with counter `counter`. False if an operand is out
+// of bounds, its value can't be resolved, or a displacement doesn't fit.
+bool RelinkTranslation(uint8_t* code,
+                       size_t size,
+                       const std::vector<SymbolicOperand>& operands,
+                       GuestAddr module_base,
+                       uintptr_t install_addr,
+                       uintptr_t counter);
+
+// Where an operand's value would point in this process; for the completeness checks.
+uint64_t ResolveSymbol(SymbolKind kind, uint64_t arg, GuestAddr module_base, uintptr_t counter);
+
+// A range of addresses a translation may only embed through a recorded operand.
+struct AddrRange {
+  uintptr_t start;
+  uintptr_t end;
+  const char* name;
+  // Also look for it in 4-byte windows (when below 4 GiB). Off for the entry trampolines: the code
+  // pool starts at a round address (0x41000000 on x86_64), whose bytes 00 00 00 41 are what any
+  // small 32-bit immediate followed by a REX.B prefix produces. Their 32-bit references are checked
+  // by moving the entries between the differential's environments instead.
+  bool narrow = true;
+};
+
+// This process's ranges for a translation of `module`: the translator image, the entry
+// trampolines, the translation tables covering the module, the helper resources, the module
+// itself, plus the caller's installed-code and counter ranges.
+std::vector<AddrRange> PersistenceSensitiveRanges(GuestModule module,
+                                                  AddrRange installed_code,
+                                                  AddrRange counters);
+
+// Byte ranges [first, second) of the code the records name: persistent operands and the
+// RelocAbsToDisp32 displacements.
+std::vector<std::pair<uint32_t, uint32_t>> RecordedIntervals(const MachineCode& machine_code);
+
+struct UncoveredPointer {
+  uint32_t offset;
+  uint8_t width;
+  uint64_t value;
+  const char* range;
+};
+
+// Every 8-byte window of `code` whose value falls in `ranges`, and every 4-byte window whose
+// value falls in a narrow range below 4 GiB, that doesn't touch a recorded interval.
+std::vector<UncoveredPointer> FindUncoveredPointers(
+    const uint8_t* code,
+    size_t size,
+    const std::vector<std::pair<uint32_t, uint32_t>>& recorded,
+    const std::vector<AddrRange>& ranges);
+
+// Test-only: SymbolizeTranslation leaves out RelocAbsToDisp32 displacements, so the
+// differential check can be shown to fail without them.
+extern bool g_symbolize_skip_displacements_for_testing;
+// endregion
+
+}  // namespace berberis
