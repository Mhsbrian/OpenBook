+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "relocatable_code.h"
+
+#include <link.h>
+
+#include <algorithm>
+#include <cstring>
+#include <limits>
+#include <tuple>
+#include <utility>
+
+#include "berberis/lite_translator/lite_translate_region.h"
+#include "berberis/runtime_primitives/host_code.h"
+#include "berberis/runtime_primitives/runtime_library.h"
+#include "berberis/runtime_primitives/translation_cache.h"
+
+namespace berberis {
+
+bool g_symbolize_skip_displacements_for_testing = false;
+
+namespace {
+
+// The order kEntry symbols are numbered in. Appending is fine; reordering changes their names.
+constexpr size_t kNumHostEntries = 8;
+
+HostCodeAddr HostEntry(size_t i) {
+  switch (i) {
+    case 0:
+      return kEntryInterpret;
+    case 1:
+      return kEntryExitGeneratedCode;
+    case 2:
+      return kEntryStop;
+    case 3:
+      return kEntryNoExec;
+    case 4:
+      return kEntryNotTranslated;
+    case 5:
+      return kEntryTranslating;
+    case 6:
+      return kEntryInvalidating;
+    case 7:
+      return kEntryWrapping;
+    default:
+      return 0;
+  }
+}
+
+// The translation table splits a guest pc into 24-bit halves (EmitIndirectDispatch does the same).
+constexpr unsigned kTableBits = 24;
+constexpr uint64_t kTableMask = (uint64_t{1} << kTableBits) - 1;
+
+constexpr uint64_t kResourceIds[] = {kHostResourceUnsignedRecipEstimate,
+                                     kHostResourceUnsignedRSqrtEstimate};
+
+// The loaded image (libberberis, or a test binary) this code is part of.
+struct ImageRange {
+  uintptr_t bias;
+  uintptr_t start;
+  uintptr_t end;
+};
+
+struct FindImageArg {
+  uintptr_t self;
+  ImageRange range;
+};
+
+int FindImage(dl_phdr_info* info, size_t, void* data) {
+  auto* arg = static_cast<FindImageArg*>(data);
+  uintptr_t lo = std::numeric_limits<uintptr_t>::max();
+  uintptr_t hi = 0;
+  bool contains_self = false;
+  for (int i = 0; i < info->dlpi_phnum; i++) {
+    const auto& phdr = info->dlpi_phdr[i];
+    if (phdr.p_type != PT_LOAD) {
+      continue;
+    }
+    uintptr_t start = info->dlpi_addr + phdr.p_vaddr;
+    uintptr_t end = start + phdr.p_memsz;
+    lo = std::min(lo, start);
+    hi = std::max(hi, end);
+    if (arg->self >= start && arg->self < end) {
+      contains_self = true;
+    }
+  }
+  if (!contains_self) {
+    return 0;
+  }
+  arg->range = {info->dlpi_addr, lo, hi};
+  return 1;
+}
+
+ImageRange ThisImage() {
+  static const ImageRange kRange = [] {
+    FindImageArg arg{reinterpret_cast<uintptr_t>(&HostEntry), {0, 0, 0}};
+    dl_iterate_phdr(FindImage, &arg);
+    return arg.range;
+  }();
+  return kRange;
+}
+
+bool ClassifyHostAddr(uint64_t addr, SymbolKind* kind, uint64_t* arg) {
+  for (size_t i = 0; i < kNumHostEntries; i++) {
+    if (addr == HostEntry(i)) {
+      *kind = SymbolKind::kEntry;
+      *arg = i;
+      return true;
+    }
+  }
+  const ImageRange image = ThisImage();
+  if (addr >= image.start && addr < image.end) {
+    *kind = SymbolKind::kImageOffset;
+    *arg = addr - image.bias;
+    return true;
+  }
+  return false;
+}
+
+uintptr_t MainTable() {
+  return reinterpret_cast<uintptr_t>(TranslationCache::GetInstance()->main_table_ptr());
+}
+
+uintptr_t TableSlot(GuestAddr pc) {
+  return reinterpret_cast<uintptr_t>(TranslationCache::GetInstance()->GetHostCodePtr(pc));
+}
+
+}  // namespace
+
+const char* NotPersistableName(NotPersistable reason) {
+  switch (reason) {
+    case NotPersistable::kNo:
+      return "persistable";
+    case NotPersistable::kGuestAddrOutsideModule:
+      return "guest address outside the module";
+    case NotPersistable::kUnknownHostAddr:
+      return "unknown host address";
+    case NotPersistable::kUnknownDispTarget:
+      return "unknown displacement target";
+    case NotPersistable::kUnknownResource:
+      return "unknown resource";
+    case NotPersistable::kOperandMismatch:
+      return "operand doesn't match the code";
+    case NotPersistable::kOverlappingOperands:
+      return "overlapping operands";
+    case NotPersistable::kNoCounter:
+      return "counter operand without a counter";
+  }
+  return "?";
+}
+
+SymbolizedCode SymbolizeTranslation(const MachineCode& machine_code,
+                                    const uint8_t* code,
+                                    uintptr_t install_addr,
+                                    GuestModule module,
+                                    uintptr_t counter) {
+  SymbolizedCode out;
+  const size_t size = machine_code.install_size();
+  auto fail = [&out](NotPersistable reason) {
+    out.reason = reason;
+    out.operands.clear();
+    out.recovery_points.clear();
+    return out;
+  };
+  auto in_module = [&module](uint64_t addr) { return addr >= module.start && addr <= module.end; };
+
+  for (const PersistentReloc& reloc : machine_code.persistent_relocs()) {
+    if (reloc.width != 8 || reloc.offset > size || size - reloc.offset < 8) {
+      return fail(NotPersistable::kOperandMismatch);
+    }
+    uint64_t value;
+    memcpy(&value, code + reloc.offset, sizeof(value));
+    SymbolicOperand op{reloc.offset, 8, SymbolKind::kGuestOffset, 0, 0};
+    switch (reloc.kind) {
+      case PersistentOperand::kGuestAddr:
+        if (value != reloc.value) {
+          return fail(NotPersistable::kOperandMismatch);
+        }
+        if (!in_module(reloc.value)) {
+          return fail(NotPersistable::kGuestAddrOutsideModule);
+        }
+        op.kind = SymbolKind::kGuestOffset;
+        op.arg = reloc.value - module.start;
+        break;
+      case PersistentOperand::kTableSlot:
+        if (!in_module(reloc.value)) {
+          return fail(NotPersistable::kGuestAddrOutsideModule);
+        }
+        if (value != TableSlot(reloc.value)) {
+          return fail(NotPersistable::kOperandMismatch);
+        }
+        op.kind = SymbolKind::kTableSlot;
+        op.arg = reloc.value - module.start;
+        break;
+      case PersistentOperand::kMainTable:
+        if (value != MainTable()) {
+          return fail(NotPersistable::kOperandMismatch);
+        }
+        op.kind = SymbolKind::kMainTable;
+        break;
+      case PersistentOperand::kCounter:
+        if (counter == 0) {
+          return fail(NotPersistable::kNoCounter);
+        }
+        if (value != counter) {
+          return fail(NotPersistable::kOperandMismatch);
+        }
+        op.kind = SymbolKind::kCounter;
+        break;
+      case PersistentOperand::kHostAddr:
+        if (value != reloc.value) {
+          return fail(NotPersistable::kOperandMismatch);
+        }
+        if (!ClassifyHostAddr(reloc.value, &op.kind, &op.arg)) {
+          return fail(NotPersistable::kUnknownHostAddr);
+        }
+        break;
+      case PersistentOperand::kHostResource: {
+        auto [resource, resource_size] = GetLiteHostResource(reloc.value);
+        if (resource == nullptr) {
+          return fail(NotPersistable::kUnknownResource);
+        }
+        if (value != reinterpret_cast<uintptr_t>(resource)) {
+          return fail(NotPersistable::kOperandMismatch);
+        }
+        op.kind = SymbolKind::kResource;
+        op.arg = reloc.value;
+        break;
+      }
+      case PersistentOperand::kNumKinds:
+        return fail(NotPersistable::kOperandMismatch);
+    }
+    out.operands.push_back(op);
+  }
+
+  for (const MachineCode::Relocation& reloc : machine_code.relocations()) {
+    if (reloc.type == RelocationType::RelocRecoveryPoint) {
+      out.recovery_points.push_back({reloc.pc, static_cast<uint32_t>(reloc.data)});
+      continue;
+    }
+    if (g_symbolize_skip_displacements_for_testing) {
+      continue;
+    }
+    if (reloc.dst > size || size - reloc.dst < 4) {
+      return fail(NotPersistable::kOperandMismatch);
+    }
+    int32_t disp;
+    memcpy(&disp, code + reloc.dst, sizeof(disp));
+    if (static_cast<intptr_t>(install_addr + reloc.pc) + disp != reloc.data) {
+      return fail(NotPersistable::kOperandMismatch);
+    }
+    SymbolicOperand op{reloc.dst, 4, SymbolKind::kEntry, reloc.pc, 0};
+    if (!ClassifyHostAddr(reloc.data, &op.kind, &op.arg)) {
+      return fail(NotPersistable::kUnknownDispTarget);
+    }
+    out.operands.push_back(op);
+  }
+
+  std::sort(out.operands.begin(), out.operands.end(), [](const auto& a, const auto& b) {
+    return a.offset < b.offset;
+  });
+  for (size_t i = 1; i < out.operands.size(); i++) {
+    if (out.operands[i - 1].offset + out.operands[i - 1].width > out.operands[i].offset) {
+      return fail(NotPersistable::kOverlappingOperands);
+    }
+  }
+  return out;
+}
+
+uint64_t ResolveSymbol(SymbolKind kind, uint64_t arg, GuestAddr module_base, uintptr_t counter) {
+  switch (kind) {
+    case SymbolKind::kGuestOffset:
+      return module_base + arg;
+    case SymbolKind::kTableSlot:
+      return TableSlot(module_base + arg);
+    case SymbolKind::kMainTable:
+      return MainTable();
+    case SymbolKind::kCounter:
+      return counter;
+    case SymbolKind::kImageOffset:
+      return ThisImage().bias + arg;
+    case SymbolKind::kEntry:
+      return HostEntry(arg);
+    case SymbolKind::kResource:
+      return reinterpret_cast<uintptr_t>(std::get<0>(GetLiteHostResource(arg)));
+  }
+  return 0;
+}
+
+bool RelinkTranslation(uint8_t* code,
+                       size_t size,
+                       const std::vector<SymbolicOperand>& operands,
+                       GuestAddr module_base,
+                       uintptr_t install_addr,
+                       uintptr_t counter) {
+  for (const SymbolicOperand& op : operands) {
+    if (op.offset > size || size - op.offset < op.width) {
+      return false;
+    }
+    uint64_t value = ResolveSymbol(op.kind, op.arg, module_base, counter);
+    if (value == 0) {
+      return false;
+    }
+    if (op.width == 8) {
+      memcpy(code + op.offset, &value, sizeof(value));
+    } else if (op.width == 4) {
+      int64_t disp = static_cast<int64_t>(value) - static_cast<int64_t>(install_addr + op.next_pc);
+      if (disp < std::numeric_limits<int32_t>::min() ||
+          disp > std::numeric_limits<int32_t>::max()) {
+        return false;
+      }
+      int32_t disp32 = static_cast<int32_t>(disp);
+      memcpy(code + op.offset, &disp32, sizeof(disp32));
+    } else {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::vector<AddrRange> PersistenceSensitiveRanges(GuestModule module,
+                                                  AddrRange installed_code,
+                                                  AddrRange counters) {
+  std::vector<AddrRange> ranges;
+  const ImageRange image = ThisImage();
+  ranges.push_back({image.start, image.end, "translator image"});
+  for (size_t i = 0; i < kNumHostEntries; i++) {
+    // An entry trampoline is a 14-byte jmp.
+    ranges.push_back({HostEntry(i), HostEntry(i) + 16, "entry trampoline", /*narrow=*/false});
+  }
+  ranges.push_back({MainTable(), MainTable() + (uintptr_t{1} << kTableBits) * sizeof(void*),
+                    "main table"});
+  for (GuestAddr pc : {module.start, module.end}) {
+    uintptr_t table = TableSlot(pc) - (pc & kTableMask) * sizeof(HostCodeAddr);
+    AddrRange range{table, table + (uintptr_t{1} << kTableBits) * sizeof(HostCodeAddr),
+                    "translation table"};
+    if (ranges.back().start != range.start) {
+      ranges.push_back(range);
+    }
+  }
+  for (uint64_t id : kResourceIds) {
+    auto [resource, resource_size] = GetLiteHostResource(id);
+    uintptr_t start = reinterpret_cast<uintptr_t>(resource);
+    ranges.push_back({start, start + resource_size, "helper resource"});
+  }
+  ranges.push_back({module.start, module.end + 1, "guest module"});
+  ranges.push_back(installed_code);
+  ranges.push_back(counters);
+  return ranges;
+}
+
+std::vector<std::pair<uint32_t, uint32_t>> RecordedIntervals(const MachineCode& machine_code) {
+  std::vector<std::pair<uint32_t, uint32_t>> intervals;
+  for (const PersistentReloc& reloc : machine_code.persistent_relocs()) {
+    intervals.emplace_back(reloc.offset, reloc.offset + reloc.width);
+  }
+  for (const MachineCode::Relocation& reloc : machine_code.relocations()) {
+    if (reloc.type == RelocationType::RelocAbsToDisp32) {
+      intervals.emplace_back(reloc.dst, reloc.dst + 4);
+    }
+  }
+  std::sort(intervals.begin(), intervals.end());
+  return intervals;
+}
+
+std::vector<UncoveredPointer> FindUncoveredPointers(
+    const uint8_t* code,
+    size_t size,
+    const std::vector<std::pair<uint32_t, uint32_t>>& recorded,
+    const std::vector<AddrRange>& ranges) {
+  constexpr uint64_t k4GiB = uint64_t{1} << 32;
+  // A window that touches a recorded operand isn't another operand: instruction fields don't
+  // overlap. (Its value can still look like an address: the opcode bytes before a recorded
+  // guest address, followed by that address's low bytes.)
+  auto covered = [&recorded](uint32_t offset, uint32_t width) {
+    for (const auto& [start, end] : recorded) {
+      if (offset < end && start < offset + width) {
+        return true;
+      }
+    }
+    return false;
+  };
+  std::vector<UncoveredPointer> found;
+  for (size_t i = 0; i + 8 <= size; i++) {
+    uint64_t value;
+    memcpy(&value, code + i, sizeof(value));
+    for (const AddrRange& range : ranges) {
+      if (value >= range.start && value < range.end) {
+        if (!covered(i, 8)) {
+          found.push_back({static_cast<uint32_t>(i), 8, value, range.name});
+        }
+        break;
+      }
+    }
+  }
+  for (size_t i = 0; i + 4 <= size; i++) {
+    uint32_t value32;
+    memcpy(&value32, code + i, sizeof(value32));
+    uint64_t value = value32;
+    for (const AddrRange& range : ranges) {
+      if (range.start >= k4GiB || !range.narrow) {
+        continue;
+      }
+      if (value >= range.start && value < std::min<uint64_t>(range.end, k4GiB)) {
+        if (!covered(i, 4)) {
+          found.push_back({static_cast<uint32_t>(i), 4, value, range.name});
+        }
+        break;
+      }
+    }
+  }
+  return found;
+}
+
+}  // namespace berberis
