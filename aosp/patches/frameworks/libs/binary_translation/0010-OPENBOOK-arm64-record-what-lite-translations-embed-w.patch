     as->Jmp32(kEntryExitGeneratedCode);
@@ -136,8 +136,11 @@ void EmitDirectDispatch(x86_64::Assembler* as, GuestAddr pc, bool check_pending_
   }
 
   CHECK_EQ(pc & 0xffff'0000'0000'0000, 0);
-  as->Movq(as->rcx,
-           reinterpret_cast<uint64_t>(TranslationCache::GetInstance()->GetHostCodePtr(pc)));
+  as->MovqPersistent(
+      as->rcx,
