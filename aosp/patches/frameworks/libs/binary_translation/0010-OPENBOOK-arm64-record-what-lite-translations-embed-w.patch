+// region digitalis
+std::tuple<const void*, size_t> GetLiteHostResource(uint64_t id) {
+  switch (id) {
+    case kHostResourceUnsignedRecipEstimate:
+      return {LiteTranslator::UnsignedEstimateTable(false), 512 * sizeof(uint32_t)};
