+TEST(DigitalisBench, DISABLED_TranslateRegionCorpus) {
+  const char* dir = getenv("BERBERIS_TRANSLATE_CORPUS");
+  if (dir == nullptr) {
+    GTEST_SKIP() << "set BERBERIS_TRANSLATE_CORPUS";
+  }
+  std::vector<BenchLib> libs;
+  {
+    FILE* f = fopen((std::string(dir) + "/libs.txt").c_str(), "r");
+    ASSERT_NE(f, nullptr);
+    char line[512];
+    while (fgets(line, sizeof(line), f)) {
+      BenchLib lib;
+      std::string path = std::string(dir) + "/libs/" + std::string(line, strcspn(line, "\n"));
+      ASSERT_TRUE(LoadElfAnywhere(path, &lib)) << path;
+      libs.push_back(lib);
+    }
+    fclose(f);
+  }
+  std::vector<std::pair<unsigned, uint64_t>> regions;
+  {
+    FILE* f = fopen((std::string(dir) + "/regions.txt").c_str(), "r");
+    ASSERT_NE(f, nullptr);
+    unsigned li;
+    unsigned long long vaddr;
+    while (fscanf(f, "%u %llx", &li, &vaddr) == 2) {
+      ASSERT_LT(li, libs.size());
+      regions.emplace_back(li, vaddr);
+    }
+    fclose(f);
+  }
+  // Installed into one reused slot within 2 GiB of the entry trampolines, as the code pool is.
+  constexpr size_t kSlot = 64 * 1024;
+  void* slot = mmap(nullptr, kSlot, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_32BIT,
+                    -1, 0);
+  ASSERT_NE(slot, MAP_FAILED);
+  // BERBERIS_TRANSLATE_CORPUS_RECORD=1 turns recording on, where the translator has it.
+  const char* record = getenv("BERBERIS_TRANSLATE_CORPUS_RECORD");
+  if (record != nullptr && strcmp(record, "1") == 0) {
+    ASSERT_NE(&g_record_persistent_relocs_by_default, nullptr) << "this translator can't record";
+    g_record_persistent_relocs_by_default = true;
+  }
+  uint32_t counter = 0;
+  RecoveryMap recovery_map;
+  for (int pass = 0; pass < 3; pass++) {
+    size_t translated = 0;
+    size_t host_bytes = 0;
+    uint64_t start = MonotonicNs();
+    for (const auto& [li, vaddr] : regions) {
+      MachineCode machine_code;
+      LiteTranslateParams params;
+      params.end_pc = libs[li].exec_end;
+      params.enable_self_profiling = true;
+      params.counter_location = &counter;
+      GuestAddr pc = libs[li].bias + vaddr;
+      auto [success, stop_pc] = TryLiteTranslateRegion(pc, &machine_code, params);
+      if (!success && stop_pc > pc) {
+        MachineCode retry;
+        params.end_pc = stop_pc;
+        std::tie(success, stop_pc) = TryLiteTranslateRegion(pc, &retry, params);
+        if (success && retry.install_size() <= kSlot) {
+          retry.InstallUnsafe(static_cast<uint8_t*>(slot), &recovery_map);
+          host_bytes += retry.install_size();
+          translated++;
+        }
+        continue;
+      }
+      if (success && machine_code.install_size() <= kSlot) {
+        machine_code.InstallUnsafe(static_cast<uint8_t*>(slot), &recovery_map);
+        host_bytes += machine_code.install_size();
+        translated++;
+      }
+    }
+    uint64_t ns = MonotonicNs() - start;
+    printf("BENCH translate-corpus pass %d: %zu regions, %zu translated, %zu host bytes, "
+           "%.1f ns/region\n",
+           pass, regions.size(), translated, host_bytes, double(ns) / regions.size());
+  }
+  munmap(slot, kSlot);
+  if (&g_record_persistent_relocs_by_default != nullptr) {
+    g_record_persistent_relocs_by_default = false;
+  }
+}
