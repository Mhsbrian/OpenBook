+    // The guest base's width doesn't change the code's length.
+    ASSERT_EQ(a.bytes.size(), b.bytes.size()) << kFixtures[i].name;
+    SymbolizedCode sb = Symbolize(low, b);
+    ASSERT_EQ(sa.reason, NotPersistable::kNo);
+    ASSERT_EQ(sb.reason, NotPersistable::kNo);
+    EXPECT_EQ(RelinkAndCompare(a.bytes, sa.operands, low, b), -1) << kFixtures[i].name;
+    EXPECT_TRUE(SameRecoveryPoints(sa.recovery_points, sb.recovery_points)) << kFixtures[i].name;
+  }
