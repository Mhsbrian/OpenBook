       case Decoder::SystemReg::kRndr:
       case Decoder::SystemReg::kRndrrs: {
         // RNDR / RNDRRS (FEAT_RNG): return a 64-bit random value and report
@@ -587,6 +582,11 @@ class Interpreter {
             (static_cast<__uint128_t>(ns) * 19200000ULL) / 1000000000ULL);
       }
       default:
+        // MIDR_EL1, MPIDR_EL1, REVIDR_EL1 and the ID_AA64* feature registers, as the Linux kernel emulates
+        // them for EL0 (Go's x/sys/cpu reads ID_AA64ISAR0_EL1 when it cannot read /proc/self/auxv).
+        if (auto value = arm64::EmulatedIdRegister(static_cast<uint16_t>(sysreg))) {
+          return *value;
+        }
         Undefined();
         return 0;
     }
