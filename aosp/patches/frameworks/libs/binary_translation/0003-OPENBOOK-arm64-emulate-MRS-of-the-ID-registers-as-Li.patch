+#ifndef BERBERIS_GUEST_STATE_GUEST_ID_REGISTERS_ARM64_H_
+#define BERBERIS_GUEST_STATE_GUEST_ID_REGISTERS_ARM64_H_
+
+#include <cstdint>
+#include <optional>
+
+namespace berberis::arm64 {
+
+// The guest's CPU identity: what EL0 sees through AT_HWCAP and through MRS of the ID registers. Every
+// execution tier and the guest loader take it from here, so the two views cannot drift apart.
+
+// AT_HWCAP bits (Linux arch/arm64/include/uapi/asm/hwcap.h) for the features the translator implements.
+// HWCAP_CPUID says that MRS of the ID registers below works, as the Linux kernel's MRS emulation does.
+inline constexpr uint64_t kGuestHwcap = (uint64_t{1} << 0) |   // HWCAP_FP
+                                        (uint64_t{1} << 1) |   // HWCAP_ASIMD
+                                        (uint64_t{1} << 3) |   // HWCAP_AES
+                                        (uint64_t{1} << 4) |   // HWCAP_PMULL
+                                        (uint64_t{1} << 5) |   // HWCAP_SHA1
+                                        (uint64_t{1} << 6) |   // HWCAP_SHA2
+                                        (uint64_t{1} << 7) |   // HWCAP_CRC32
+                                        (uint64_t{1} << 8) |   // HWCAP_ATOMICS
+                                        (uint64_t{1} << 11);   // HWCAP_CPUID
+
+// MRS system register key: (op0 << 14) | (op1 << 11) | (CRn << 7) | (CRm << 3) | op2, as the decoder builds it.
+constexpr uint16_t IdRegKey(unsigned op0, unsigned op1, unsigned crn, unsigned crm, unsigned op2) {
+  return static_cast<uint16_t>((op0 << 14) | (op1 << 11) | (crn << 7) | (crm << 3) | op2);
+}
+
+// MIDR_EL1: Cortex-A53 r0p4 (implementer 0x41, architecture 0xF, part 0xD03, revision 4).
+inline constexpr uint64_t kGuestMidrEl1 = 0x410FD034;
+
+// User-visible values of the ID registers, built the way Linux builds them for EL0 (arm64_ftr_reg_user_value in
+// arch/arm64/kernel/cpufeature.c, Documentation/arch/arm64/cpu-feature-registers.rst): visible fields describe
+// the guest CPU above, hidden fields read as the kernel's safe value. They agree with kGuestHwcap.
+//   ID_AA64ISAR0_EL1: AES=2 (AES+PMULL) [7:4], SHA1=1 [11:8], SHA2=1 [15:12], CRC32=1 [19:16], Atomic=2 [23:20]
+inline constexpr uint64_t kGuestIdAa64Isar0El1 = 0x0000000000211120;
+//   ID_AA64PFR0_EL1: FP=0 and AdvSIMD=0 (implemented, no FP16) [19:16] [23:20]; hidden EL1=1, EL0=1 (AArch64)
+inline constexpr uint64_t kGuestIdAa64Pfr0El1 = 0x0000000000000011;
+//   ID_AA64MMFR0_EL1: hidden TGran4_2/TGran64_2/TGran16_2=1 [43:32], TGran4=0xF, TGran64=0xF [31:24]
+inline constexpr uint64_t kGuestIdAa64Mmfr0El1 = 0x00000111FF000000;
+//   ID_AA64DFR0_EL1: hidden DebugVer=6 [3:0]
+inline constexpr uint64_t kGuestIdAa64Dfr0El1 = 0x0000000000000006;
+
+// Linux emulates EL0 MRS for the feature ID space: op0=3, op1=0, CRn=0 and CRm 0 or 2..7. With CRm=0 only
+// MIDR_EL1, MPIDR_EL1 and REVIDR_EL1 are emulated (the rest of CRm=0 raises SIGILL); with CRm 2..7 a register the
+// kernel does not track reads as zero (RAZ). Returns nullopt for registers outside that space, which raise SIGILL
+// on a real arm64 kernel too.
+constexpr std::optional<uint64_t> EmulatedIdRegister(uint16_t key) {
+  const unsigned op0 = key >> 14, op1 = (key >> 11) & 7, crn = (key >> 7) & 15, crm = (key >> 3) & 15;
+  if (op0 != 3 || op1 != 0 || crn != 0 || crm == 1 || crm > 7) {
+    return std::nullopt;
+  }
+  switch (key) {
+    case IdRegKey(3, 0, 0, 0, 0):  // MIDR_EL1
+      return kGuestMidrEl1;
+    case IdRegKey(3, 0, 0, 0, 5):  // MPIDR_EL1: SYS_MPIDR_SAFE_VAL
+      return uint64_t{1} << 31;
+    case IdRegKey(3, 0, 0, 0, 6):  // REVIDR_EL1: IMPLEMENTATION DEFINED, emulated as 0
+      return 0;
+    case IdRegKey(3, 0, 0, 4, 0):  // ID_AA64PFR0_EL1
+      return kGuestIdAa64Pfr0El1;
+    case IdRegKey(3, 0, 0, 5, 0):  // ID_AA64DFR0_EL1
+      return kGuestIdAa64Dfr0El1;
+    case IdRegKey(3, 0, 0, 6, 0):  // ID_AA64ISAR0_EL1
+      return kGuestIdAa64Isar0El1;
+    case IdRegKey(3, 0, 0, 7, 0):  // ID_AA64MMFR0_EL1
+      return kGuestIdAa64Mmfr0El1;
+    default:
+      // The rest of CRm=0 is not emulated; everything else in CRm 2..7 (ID_AA64PFR1/ZFR0/SMFR0, ISAR1/2,
+      // MMFR1-4, DFR1, the AArch32 ID registers, ...) has no feature the guest implements, or is untracked: 0.
+      if (crm == 0) {
+        return std::nullopt;
+      }
+      return 0;
+  }
+}
+
+}  // namespace berberis::arm64
+
+#endif  // BERBERIS_GUEST_STATE_GUEST_ID_REGISTERS_ARM64_H_
