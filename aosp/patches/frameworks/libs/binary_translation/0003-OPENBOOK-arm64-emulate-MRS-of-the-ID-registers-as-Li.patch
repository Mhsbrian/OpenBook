+// MRS of the ID registers, as Linux emulates it for EL0 (guest_id_registers_arm64.h), in the interpreter and the
+// lite tier: MIDR/MPIDR/REVIDR, the ID_AA64* feature registers matching AT_HWCAP, and an unallocated register of
+// the feature ID space, which reads as zero. Go's x/sys/cpu reads ISAR0/ISAR1/PFR0 when /proc/self/auxv is
+// unreadable; an SIGILL here killed every gomobile library (Tor VPN).
+TEST_F(Arm64LiteTranslateRegionTest, MrsIdRegistersAsLinux) {
+  constexpr auto Mrs = [](unsigned crm, unsigned op2) {  // mrs x3, S3_0_C0_C<crm>_<op2>
+    return 0xD5380003u | (crm << 8) | (op2 << 5);
+  };
+  struct Case {
+    uint32_t insn;
+    uint64_t want;
+  };
+  const Case kCases[] = {
+      {Mrs(0, 0), 0x410FD034},          // MIDR_EL1
+      {Mrs(0, 5), 0x80000000},          // MPIDR_EL1
+      {Mrs(0, 6), 0},                   // REVIDR_EL1
+      {Mrs(4, 0), 0x11},                // ID_AA64PFR0_EL1: FP, AdvSIMD, EL0/EL1 AArch64
+      {Mrs(4, 1), 0},                   // ID_AA64PFR1_EL1
+      {Mrs(4, 4), 0},                   // ID_AA64ZFR0_EL1
+      {Mrs(5, 0), 0x6},                 // ID_AA64DFR0_EL1
+      {Mrs(6, 0), 0x211120},            // ID_AA64ISAR0_EL1: AES+PMULL, SHA1, SHA2, CRC32, LSE
+      {Mrs(6, 1), 0},                   // ID_AA64ISAR1_EL1
+      {Mrs(6, 2), 0},                   // ID_AA64ISAR2_EL1
+      {Mrs(7, 0), 0x00000111FF000000},  // ID_AA64MMFR0_EL1
+      {Mrs(7, 7), 0},                   // unallocated: RAZ
+      {Mrs(2, 0), 0},                   // ID_ISAR0_EL1 (AArch32): RAZ
+  };
+  for (const Case& c : kCases) {
+    SCOPED_TRACE(testing::Message() << std::hex << "insn=" << c.insn);
+    state_.cpu.x[3] = 0xDEADBEEF;
+    Interpret(c.insn);
+    EXPECT_EQ(state_.cpu.x[3], c.want);
+    state_.cpu.x[3] = 0xDEADBEEF;
+    const uint32_t code[] = {c.insn};
+    ASSERT_TRUE(RunN(code, 1, ToGuestAddr(code) + sizeof(code)));
+    EXPECT_EQ(state_.cpu.x[3], c.want);
+  }
+  // HWCAP_CPUID tells the guest the ID registers can be read, and the HWCAPs and ISAR0 describe the same CPU.
+  EXPECT_TRUE(arm64::kGuestHwcap & (1u << 11));
+  EXPECT_EQ(((arm64::kGuestIdAa64Isar0El1 >> 4) & 0xf) >= 2, (arm64::kGuestHwcap & (1u << 4)) != 0);  // PMULL
+  EXPECT_EQ(((arm64::kGuestIdAa64Isar0El1 >> 20) & 0xf) >= 2, (arm64::kGuestHwcap & (1u << 8)) != 0);  // LSE
+}
+
