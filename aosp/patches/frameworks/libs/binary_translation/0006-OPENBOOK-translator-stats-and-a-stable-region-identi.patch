+  *file_backed = false;
 
   auto mapped_object_record = maps_snapshot->GetMappedObjectRecordOrUpdateAndRetry(guest_addr);
   if (!mapped_object_record.has_value()) {
@@ -97,6 +107,15 @@ MappedNameBuffer ConstructMappedNameBuffer(GuestAddr guest_addr) {
     buf[0] = '\0';
     return buf;
   }
+  const auto& path = mapped_object_record.value().pathname;
+  // Only a mapped file has a stable identity. "[anon:...]", "[stack]", memfds
+  // and deleted files are process-local.
+  if (!path.empty() && path.c_str()[0] == '/' && strncmp(path.c_str(), "/memfd:", 7) != 0 &&
+      !strstr(path.c_str(), " (deleted)")) {
+    *file_offset =
+        guest_addr - mapped_object_record.value().start + mapped_object_record.value().offset;
+    *file_backed = true;
+  }
 
   // We can use more clever logic here and try to extract the basename, but the parent directory
   // name may also be interesting (e.g. <guest_arch>/libc.so) so we just take the last
@@ -122,36 +141,110 @@ MappedNameBuffer ConstructMappedNameBuffer(GuestAddr guest_addr) {
 
 }  // namespace
 
-void ProfilerLogGeneratedCode(const void* start,
-                              size_t size,
-                              GuestAddr guest_start,
-                              size_t guest_size,
-                              const char* jit_suffix) {
-  static int fd = ProfilerOpenLogFile();
-  if (fd == -1) {
-    return;
-  }
+namespace {
 
-  MappedNameBuffer mapped_name_buf = ConstructMappedNameBuffer(guest_start);
+// The map belongs to one process: perf-<pid>.map. A child made by fork (an app
+// zygote's children) or by a guest's raw clone must not write into the
+// parent's map, so the descriptor is kept with the pid it was opened for and
+// reopened, once, by the first region a new process logs. The inherited
+// descriptor is closed in the child only. Lock-free, so a fork in the middle of
+// an open can't leave the child waiting for a lock no thread will release.
+// Regions the child inherited from its parent stay in the parent's map.
+std::atomic<uint64_t> g_map_state{0};  // (pid << 1) | ready
+std::atomic<int> g_map_fd{-1};
+
+int GetMapFd(int (*open_map)()) {
+  auto pid = static_cast<uint64_t>(GetpidSyscall());
+  const uint64_t ready = (pid << 1) | 1;
+  const uint64_t opening = pid << 1;
+  uint64_t state = g_map_state.load(std::memory_order_acquire);
+  if (state == ready) {
+    return g_map_fd.load(std::memory_order_relaxed);
+  }
+  if (state != opening && g_map_state.compare_exchange_strong(state, opening)) {
+    int inherited = g_map_fd.exchange(-1);
+    if (inherited != -1) {
+      close(inherited);  // the parent's map; the parent keeps its own descriptor
+    }
+    g_map_fd.store(open_map(), std::memory_order_relaxed);
+    g_map_state.store(ready, std::memory_order_release);
+    return g_map_fd.load(std::memory_order_relaxed);
+  }
+  while (g_map_state.load(std::memory_order_acquire) != ready) {
+    sched_yield();  // another thread of this process is opening it
+  }
+  return g_map_fd.load(std::memory_order_relaxed);
+}
+
+}  // namespace
+
+void ResetProfilerMapForTesting() {
+  int fd = g_map_fd.exchange(-1);
+  if (fd != -1) {
+    close(fd);
+  }
+  g_map_state.store(0);
+}
+
+int GetProfilerMapFdForTesting(int (*open_map)()) {
+  return GetMapFd(open_map);
+}
+
+size_t FormatPerfMapLine(char* buf,
+                         size_t buf_size,
+                         const void* start,
+                         size_t size,
+                         GuestAddr guest_start,
+                         size_t guest_size,
+                         const char* jit_suffix) {
+  uintptr_t file_offset;
+  bool file_backed;
+  MappedNameBuffer mapped_name_buf =
+      ConstructMappedNameBuffer(guest_start, &file_offset, &file_backed);
 
   char guest_range_buf[64];
 
   if (IsConfigFlagSet(kMergeProfilesForSameModeRegions)) {
     guest_range_buf[0] = '\0';
+  } else if (file_backed) {
+    // "@0x<file offset>" names the region by its place in the library, so the
+    // same region can be matched between launches.
+    FormatBuffer(guest_range_buf,
+                 sizeof(guest_range_buf),
+                 "_0x%lx+%zu@0x%lx",
+                 guest_start,
+                 guest_size,
+                 static_cast<unsigned long>(file_offset));
   } else {
+    // No file, no stable identity: the guest address is all there is.
     FormatBuffer(guest_range_buf, sizeof(guest_range_buf), "_0x%lx+%zu", guest_start, guest_size);
   }
 
-  char buf[128];
   // start size symbol-name
-  size_t n = FormatBuffer(buf,
-                          sizeof(buf),
-                          "%p 0x%zx %s%s%s\n",
-                          start,
-                          size,
-                          mapped_name_buf.data(),
-                          jit_suffix,
-                          guest_range_buf);
+  return FormatBuffer(buf,
+                      buf_size,
+                      "%p 0x%zx %s%s%s\n",
+                      start,
+                      size,
+                      mapped_name_buf.data(),
+                      jit_suffix,
+                      guest_range_buf);
+}
+
+void ProfilerLogGeneratedCode(const void* start,
+                              size_t size,
+                              GuestAddr guest_start,
+                              size_t guest_size,
+                              const char* jit_suffix) {
+  if (!GetProfilingConfig()) {
+    return;  // profiling off: no pid check, no syscall
+  }
+  int fd = GetMapFd(ProfilerOpenLogFile);
+  if (fd == -1) {
+    return;
+  }
+  char buf[160];
+  size_t n = FormatPerfMapLine(buf, sizeof(buf), start, size, guest_start, guest_size, jit_suffix);
   UNUSED(write(fd, buf, n));
 }
 
