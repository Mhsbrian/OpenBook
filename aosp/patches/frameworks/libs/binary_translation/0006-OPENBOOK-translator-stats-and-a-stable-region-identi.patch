+  RunIcIvau(pc + 4);
+
+  EXPECT_EQ(ts::Get(ts::kInvalidationRequests), 1u);
+  EXPECT_EQ(ts::Get(ts::kInvalidationsFromIcIvau), 1u);
+  EXPECT_EQ(ts::Get(ts::kInvalidationBytes), 64u);
+  EXPECT_EQ(ts::Get(ts::kEntriesInvalidated), 1u);
+  EXPECT_EQ(ts::Get(ts::kDispatcherFlushes), 1u);
+
+  RunIcIvau(ToGuestAddr(kOtherLine));
+
+  EXPECT_EQ(ts::Get(ts::kInvalidationRequests), 2u);
+  EXPECT_EQ(ts::Get(ts::kInvalidationsFromIcIvau), 2u);
+  EXPECT_EQ(ts::Get(ts::kEntriesInvalidated), 1u);
+  EXPECT_EQ(ts::Get(ts::kDispatcherFlushes), 1u);
+  EXPECT_EQ(ts::Get(ts::kInvalidationsFromUnmap), 0u);
+}
+
+// The record keeps the file offset, so addr - start + offset names a place in
+// the file that stays the same between launches.
+TEST(TranslatorStatsMapsSnapshot, FileOffset) {
+  auto* maps_snapshot = MapsSnapshot::GetInstance();
+
+  int fd = open("/proc/self/exe", O_RDONLY | O_CLOEXEC);
+  ASSERT_NE(fd, -1);
+  constexpr size_t kPage = 4096;
+  void* addr = mmap(nullptr, kPage, PROT_READ, MAP_PRIVATE, fd, 2 * kPage);
+  close(fd);
+  ASSERT_NE(addr, MAP_FAILED);
+  maps_snapshot->Update();
+  auto result = maps_snapshot->GetMappedObjectRecord(bit_cast<uintptr_t>(addr));
+  munmap(addr, kPage);
+
+  ASSERT_TRUE(result.has_value());
+  EXPECT_FALSE(result.value().pathname.empty());
+  EXPECT_EQ(result.value().start, bit_cast<uintptr_t>(addr));
+  EXPECT_EQ(result.value().offset, 2 * kPage);
+}
+
+TEST(TranslatorStatsMapsSnapshot, AnonymousMappingHasNoOffset) {
+  auto* maps_snapshot = MapsSnapshot::GetInstance();
+
+  void* addr = mmap(nullptr, 4096, PROT_READ, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  ASSERT_NE(addr, MAP_FAILED);
+  maps_snapshot->Update();
+  auto result = maps_snapshot->GetMappedObjectRecord(bit_cast<uintptr_t>(addr));
+  munmap(addr, 4096);
+
+  ASSERT_TRUE(result.has_value());
+  EXPECT_TRUE(result.value().pathname.empty());
+  EXPECT_EQ(result.value().offset, 0u);
+}
