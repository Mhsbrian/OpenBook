+MappedNameBuffer ConstructMappedNameBuffer(GuestAddr guest_addr,
+                                           uintptr_t* file_offset,
+                                           bool* file_backed) {
   MappedNameBuffer buf;
   auto* maps_snapshot = MapsSnapshot::GetInstance();
