+// A child made by fork() owns its counts from the fork on; what it inherited is
+// its baseline. The parent's ownership is untouched.
+TEST_F(TranslatorStats, ForkChildOwnsItsCounts) {
+  ts::Add(ts::kInstalledLite, 5);
+  pid_t parent = getpid();
+  pid_t child = fork();
+  ASSERT_NE(child, -1);
+  if (child == 0) {
+    const ts::Block& b = ts::g_block;
+    int bad = 0;
+    bad |= (b.owner_pid.load() != static_cast<uint64_t>(getpid())) << 0;
+    bad |= (b.baseline_valid.load() != 1) << 1;
+    bad |= (b.baseline[ts::kInstalledLite].load() != 5) << 2;
+    ts::Add(ts::kInstalledLite);
+    bad |= (b.counters[ts::kInstalledLite].load() - b.baseline[ts::kInstalledLite].load() != 1) << 3;
+    _exit(bad);
+  }
+  int status = 0;
+  ASSERT_EQ(waitpid(child, &status, 0), child);
+  ASSERT_TRUE(WIFEXITED(status));
+  EXPECT_EQ(WEXITSTATUS(status), 0) << "bit 0 owner, 1 baseline flag, 2 baseline, 3 own count";
+  EXPECT_EQ(ts::g_block.owner_pid.load(), static_cast<uint64_t>(parent));
+  EXPECT_EQ(ts::g_block.baseline_valid.load(), 0u);
+  EXPECT_EQ(ts::Get(ts::kInstalledLite), 5u);
+}
+
+// A raw fork syscall (how a guest forks) runs no pthread_atfork handler: the
+// child's counts stay owned by the parent, with no baseline, and a reader can
+// tell from owner_pid.
+TEST_F(TranslatorStats, RawForkChildKeepsTheParentAsOwner) {
+  pid_t parent = getpid();
+  long child = syscall(SYS_fork);
+  ASSERT_NE(child, -1);
+  if (child == 0) {
+    const ts::Block& b = ts::g_block;
+    int bad = 0;
+    bad |= (b.owner_pid.load() != static_cast<uint64_t>(parent)) << 0;
+    bad |= (b.baseline_valid.load() != 0) << 1;
+    syscall(SYS_exit_group, bad);
+  }
+  int status = 0;
+  ASSERT_EQ(waitpid(static_cast<pid_t>(child), &status, 0), child);
+  ASSERT_TRUE(WIFEXITED(status));
+  EXPECT_EQ(WEXITSTATUS(status), 0) << "bit 0 owner, 1 baseline flag";
+}
+
+int g_opens = 0;
+int g_inherited_fd = -1;
+bool g_inherited_was_open_at_reopen = false;
+
+int OpenDevNull() {
+  g_opens++;
+  if (g_inherited_fd != -1) {
+    g_inherited_was_open_at_reopen = fcntl(g_inherited_fd, F_GETFD) != -1;
+  }
+  return open("/dev/null", O_WRONLY | O_CLOEXEC);
+}
+
+int FailToOpen() {
+  g_opens++;
+  return -1;
+}
+
+// The perf map belongs to one process. A fork child never writes into the
+// parent's map: it closes the inherited descriptor and opens its own, once.
+TEST(TranslatorStatsPerfMap, ForkChildOpensItsOwnMap) {
+  ResetProfilerMapForTesting();
+  g_opens = 0;
+  g_inherited_fd = -1;
+  int fd = GetProfilerMapFdForTesting(OpenDevNull);
+  ASSERT_NE(fd, -1);
+  EXPECT_EQ(GetProfilerMapFdForTesting(OpenDevNull), fd);
+  EXPECT_EQ(g_opens, 1) << "opened again in the same process";
+
+  pid_t child = fork();
+  ASSERT_NE(child, -1);
+  if (child == 0) {
+    g_inherited_fd = fd;
+    int own = GetProfilerMapFdForTesting(OpenDevNull);
+    int bad = 0;
+    bad |= (g_opens != 2) << 0;                       // reopened, once
+    bad |= g_inherited_was_open_at_reopen << 1;       // the parent's map was closed first
+    bad |= (own == -1) << 2;
+    bad |= (GetProfilerMapFdForTesting(OpenDevNull) != own || g_opens != 2) << 3;
+    _exit(bad);
+  }
+  int status = 0;
+  ASSERT_EQ(waitpid(child, &status, 0), child);
+  ASSERT_TRUE(WIFEXITED(status));
+  EXPECT_EQ(WEXITSTATUS(status), 0) << "bit 0 reopen count, 1 inherited still open, 2 open failed, 3 not kept";
+  EXPECT_NE(fcntl(fd, F_GETFD), -1) << "the child's close reached the parent";
+  EXPECT_EQ(GetProfilerMapFdForTesting(OpenDevNull), fd);
+  EXPECT_EQ(g_opens, 1);
+  ResetProfilerMapForTesting();
+}
+
+// A failed open is remembered for this process only: no retry on every region,
+// but a fork child tries for its own map.
+TEST(TranslatorStatsPerfMap, FailedOpenIsPerProcess) {
+  ResetProfilerMapForTesting();
+  g_opens = 0;
+  EXPECT_EQ(GetProfilerMapFdForTesting(FailToOpen), -1);
+  EXPECT_EQ(GetProfilerMapFdForTesting(FailToOpen), -1);
+  EXPECT_EQ(g_opens, 1);
+  pid_t child = fork();
+  ASSERT_NE(child, -1);
+  if (child == 0) {
+    GetProfilerMapFdForTesting(FailToOpen);
+    _exit(g_opens == 2 ? 0 : 1);
+  }
+  int status = 0;
+  ASSERT_EQ(waitpid(child, &status, 0), child);
+  ASSERT_TRUE(WIFEXITED(status));
+  EXPECT_EQ(WEXITSTATUS(status), 0);
+  ResetProfilerMapForTesting();
+}
+
+// A region in a mapped file is named by its offset in the file; anonymous
+// memory (a guest JIT) has no stable identity and gets no offset, so two
+// anonymous regions can never share a name.
+TEST(TranslatorStatsPerfMap, OnlyFileBackedRegionsGetAnOffset) {
+  MapsSnapshot::GetInstance()->ClearForTesting();
+  int fd = open("/proc/self/exe", O_RDONLY | O_CLOEXEC);
+  ASSERT_NE(fd, -1);
+  constexpr size_t kPage = 4096;
+  void* file = mmap(nullptr, kPage, PROT_READ, MAP_PRIVATE, fd, 3 * kPage);
+  close(fd);
+  ASSERT_NE(file, MAP_FAILED);
+  void* anon = mmap(nullptr, 2 * kPage, PROT_READ, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  ASSERT_NE(anon, MAP_FAILED);
+  GuestAddr in_file = bit_cast<uintptr_t>(file) + 0x40;
+  GuestAddr anon_a = bit_cast<uintptr_t>(anon) + 0x10;
+  GuestAddr anon_b = bit_cast<uintptr_t>(anon) + kPage;
+
+  char buf[160];
+  FormatPerfMapLine(buf, sizeof(buf), anon, 0x20, in_file, 16, "lite");
+  std::string file_line(buf);
+  FormatPerfMapLine(buf, sizeof(buf), anon, 0x20, anon_a, 16, "lite");
+  std::string a_line(buf);
+  FormatPerfMapLine(buf, sizeof(buf), anon, 0x20, anon_b, 32, "heavy");
+  std::string b_line(buf);
+  munmap(file, kPage);
+  munmap(anon, 2 * kPage);
+
+  char want[64];
+  snprintf(want, sizeof(want), "lite_0x%lx+16@0x%zx\n", static_cast<unsigned long>(in_file), 3 * kPage + 0x40);
+  EXPECT_NE(file_line.find(want), std::string::npos) << file_line;
+  EXPECT_EQ(a_line.find('@'), std::string::npos) << a_line;
+  EXPECT_EQ(b_line.find('@'), std::string::npos) << b_line;
+  snprintf(want, sizeof(want), "_lite_0x%lx+16\n", static_cast<unsigned long>(anon_a));
+  EXPECT_NE(a_line.find(want), std::string::npos) << a_line;
+  snprintf(want, sizeof(want), "_heavy_0x%lx+32\n", static_cast<unsigned long>(anon_b));
+  EXPECT_NE(b_line.find(want), std::string::npos) << b_line;
+}
+
+// The three invalidation counts are distinct: a request over a translated
+// line drops one entry and flushes the dispatcher; a request over a line with
+// nothing translated is still a request, but drops nothing and does not flush.
+TEST_F(TranslatorStats, InvalidationRequestsEntriesAndFlushesAreSeparate) {
+  GuestAddr pc = ToGuestAddr(kRegion);
+  ScopedGuestExecRegion exec_region(pc, sizeof(kRegion));
+  HandleNotTranslated(pc);
