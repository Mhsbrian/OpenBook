+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#ifndef BERBERIS_RUNTIME_PRIMITIVES_TRANSLATOR_STATS_H_
+#define BERBERIS_RUNTIME_PRIMITIVES_TRANSLATOR_STATS_H_
+
+// Process-wide translator counters, off by default.
+//
+// `setprop berberis.stats 1` (or BERBERIS_STATS=1) before the process starts
+// turns them on. When off, each counting site costs one load of a
+// process-wide flag; nothing is counted and no clock is read.
+//
+// Reading them: the counters live in one self-describing block (Block below),
+// whose address Init() logs to logcat (tag "berberis"). A root shell reads it
+// from /proc/<pid>/mem at any time, so a running app needs no extra thread.
+// A thread is deliberately avoided: the native bridge also initializes in
+// child zygotes (app zygotes), and ART refuses to fork a zygote that has more
+// than one thread. A process that exits normally (a program run through the
+// binfmt runner, through the guest's exit_group) also logs one
+// "openbook-stats v1" line at exit.
+//
+// Counters are relaxed atomics: every value is exact on its own, but one read
+// of the block is not an atomic snapshot of all counters together. A forked
+// process inherits its parent's counts; the block says whose they are (see
+// Block).
+//
+// The counters say how often the translator compiled, geared up, invalidated
+// and flushed, and how much elapsed time compiling took. They do not measure how long the
+// generated code runs or how much register traffic it has: that comes from
+// tier-labelled samples (the berberis.profiling perf map names each region's
+// tier and library offset) and from inspecting generated code.
+//
+// Header-only counting, so the interpreter and guest_os_primitives can count
+// without a link dependency; Init() and Format() live in translator_stats.cc.
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <ctime>
+
+namespace berberis::translator_stats {
+
+// Keep in sync with kNames in translator_stats.cc.
+enum Counter : size_t {
+  // Regions installed, by tier: published in the translation cache. First-gear
+  // and gear-up installs both count.
+  kInstalledInterp,  // translation failed or interpret-only mode
+  kInstalledLite,
+  kInstalledHeavy,
+  kInstalledNoExec,  // pc not executable
+  // Results not published because the region was invalidated while it was
+  // being translated (see kInFlightTranslationsInvalidated).
+  kDiscardedAtPublication,
+  // Accumulated elapsed (CLOCK_MONOTONIC, not CPU) time inside the lite
+  // translator and the heavy optimizer, failed and discarded attempts included
+  // (a heavy attempt that bails is counted here, then its re-lite under lite).
+  kLiteNs,
+  kHeavyNs,
+  // Guest bytes covered and host code bytes emitted by installed regions.
+  kLiteGuestBytes,
+  kHeavyGuestBytes,
+  kLiteHostBytes,
+  kHeavyHostBytes,
+  // Gear-up: requests (hot lite region reached the threshold) and how the
+  // heavy attempt ended. heavy + heavy_prefix + declined_small + bailed +
+  // no_mem == heavy attempts. gearup_heavy and gearup_heavy_prefix count heavy
+  // code emitted, before publication; installed_heavy counts what was published.
+  kGearUpRequests,
+  kGearUpHeavy,          // fully translated and installed
+  kGearUpHeavyPrefix,    // bailed, but the prefix holds an in-region loop: installed
+  kGearUpDeclinedSmall,  // fully translated but below the minimum size: re-lite
+  kGearUpBailed,         // unsupported instruction, no loop in the prefix: re-lite
+  kGearUpNoMem,          // code pool could not take the region
+  // Interpreter batches (berberis_HandleInterpret calls).
+  kInterpretBatches,
+  // Invalidation. A request is one InvalidateGuestRange call, whatever caused
+  // it; requests from IC IVAU and from executable mappings going away are also
+  // counted by source. Entries invalidated are translation-cache entries
+  // dropped. A dispatcher flush (FlushGuestCodeCache) asks every other guest
+  // thread to return to the dispatcher; it does not discard translations.
+  kInvalidationRequests,
+  kInvalidationBytes,
+  kInvalidationNs,  // accumulated elapsed time, as kLiteNs
+  kInvalidationsFromIcIvau,
+  kInvalidationsFromUnmap,
+  kEntriesInvalidated,
+  // Translations in progress when a request came in, on any thread and at any
+  // address (the cache invalidates them all); their result is thrown away.
+  kInFlightTranslationsInvalidated,
+  kDispatcherFlushes,
+  kDispatcherFlushThreads,  // other threads asked to return, summed over flushes
+  kNumCounters,
+};
+
+// Layout "OBSTAT2", all fields little-endian 64-bit words except magic and
+// names: magic, number of counters, size of names, enabled (0 or 1), owner pid,
+// baseline valid (0 or 1), the counters in Counter order, the baseline in the
+// same order, then the counter names separated by spaces and NUL-terminated
+// (filled in by Init when counting is turned on).
+//
+// Origin: the owner is the process the counts are measured from. Init makes
+// the calling process the owner. A child made by fork() (a zygote's children)
+// becomes the owner in a pthread_atfork handler, which also copies the counts
+// it inherited into the baseline: counters - baseline is then the child's own.
+// A child made by a raw clone syscall (a guest's fork) runs no handler: the
+// owner stays the parent's pid, and its counters include the parent's counts
+// up to the fork, with no baseline.
+constexpr size_t kNamesCapacity = 1024;
+struct Block {
+  char magic[8];
+  uint64_t count;
+  uint64_t names_size;
+  std::atomic<uint64_t> enabled;
+  std::atomic<uint64_t> owner_pid;
+  std::atomic<uint64_t> baseline_valid;
+  std::atomic<uint64_t> counters[kNumCounters];
+  std::atomic<uint64_t> baseline[kNumCounters];
+  char names[kNamesCapacity];
+};
+inline Block g_block{
+    {'O', 'B', 'S', 'T', 'A', 'T', '2', '\0'}, kNumCounters, 0, {0}, {0}, {0}, {}, {}, {}};
+
+inline bool Enabled() {
+  return g_block.enabled.load(std::memory_order_relaxed) != 0;
+}
+
+inline void Add(Counter counter, uint64_t value = 1) {
+  if (Enabled()) {
+    g_block.counters[counter].fetch_add(value, std::memory_order_relaxed);
+  }
+}
+
+inline uint64_t Get(Counter counter) {
+  return g_block.counters[counter].load(std::memory_order_relaxed);
+}
+
+inline uint64_t NowNs() {
+  timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return static_cast<uint64_t>(ts.tv_sec) * 1000000000u + static_cast<uint64_t>(ts.tv_nsec);
+}
+
+// Adds the time from construction to destruction to `counter`. Reads the clock
+// only when counting is on.
+class ScopedTimer {
+ public:
+  explicit ScopedTimer(Counter counter) : counter_(counter), start_(Enabled() ? NowNs() : 0) {}
+  ~ScopedTimer() {
+    if (start_ != 0) {
+      Add(counter_, NowNs() - start_);
+    }
+  }
+  ScopedTimer(const ScopedTimer&) = delete;
+  ScopedTimer& operator=(const ScopedTimer&) = delete;
+
+ private:
+  Counter counter_;
+  uint64_t start_;
+};
+
+// Reads berberis.stats / BERBERIS_STATS. When set (to anything but "" or "0"),
+// fills in the block's names, makes this process the owner, registers the fork
+// handler, turns counting on and logs the block's address. Call once at
+// translator init.
+void Init();
+
+// Logs the Format() line when counting is on (the guest's exit_group).
+void LogIfEnabled();
+
+const char* GetName(Counter counter);
+
+// Writes "openbook-stats v1 pid=<pid> t_ms=<ms since Init> name=value ..." to
+// buf (always NUL-terminated). Returns the length written.
+size_t Format(char* buf, size_t size);
+
+// Init()'s work after the config check: names, enabled, the log line.
+void EnableForTesting();
+// What the fork handler does in a child made by fork().
+void OnForkChildForTesting();
+void SetEnabledForTesting(bool enabled);
+void ResetForTesting();
+
+}  // namespace berberis::translator_stats
+
+#endif  // BERBERIS_RUNTIME_PRIMITIVES_TRANSLATOR_STATS_H_
