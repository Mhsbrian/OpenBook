--- a/base/include/berberis/base/maps_snapshot.h
+++ b/base/include/berberis/base/maps_snapshot.h
@@ -46,6 +46,9 @@ class MapsSnapshot {
   struct Record {
     uintptr_t start;
     uintptr_t end;
+    // File offset of `start` in the mapped object (0 for anonymous mappings).
+    // addr - start + offset is stable across launches, unlike addr itself.
+    uintptr_t offset;
