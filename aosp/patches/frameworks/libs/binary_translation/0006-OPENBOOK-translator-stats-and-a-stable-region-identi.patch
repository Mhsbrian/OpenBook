+
+namespace berberis::translator_stats {
+
+namespace {
+
+constexpr const char* kNames[] = {
+    "installed_interp",
+    "installed_lite",
+    "installed_heavy",
+    "installed_noexec",
+    "discarded_at_publication",
+    "lite_ns",
+    "heavy_ns",
+    "lite_guest_bytes",
+    "heavy_guest_bytes",
+    "lite_host_bytes",
+    "heavy_host_bytes",
+    "gearup_requests",
+    "gearup_heavy",
+    "gearup_heavy_prefix",
+    "gearup_declined_small",
+    "gearup_bailed",
+    "gearup_no_mem",
+    "interpret_batches",
+    "invalidation_requests",
+    "invalidation_bytes",
+    "invalidation_ns",
+    "invalidations_from_ic_ivau",
+    "invalidations_from_unmap",
+    "entries_invalidated",
+    "inflight_translations_invalidated",
+    "dispatcher_flushes",
+    "dispatcher_flush_threads",
+};
+static_assert(sizeof(kNames) / sizeof(kNames[0]) == kNumCounters);
+
+std::atomic<uint64_t> g_init_ns{0};
+
+// pthread_atfork child handler: the child owns the counts from here on, and
+// what it inherited is its baseline.
+void OnForkChild() {
+  if (!Enabled()) {
+    return;
+  }
+  for (size_t i = 0; i < kNumCounters; i++) {
+    g_block.baseline[i].store(g_block.counters[i].load(std::memory_order_relaxed),
+                              std::memory_order_relaxed);
+  }
+  g_block.baseline_valid.store(1, std::memory_order_relaxed);
+  g_block.owner_pid.store(static_cast<uint64_t>(GetpidSyscall()), std::memory_order_release);
+}
+
+// Turns counting on: names first, so a reader that sees enabled=1 sees them.
+void Enable() {
+  size_t len = 0;
+  for (size_t i = 0; i < kNumCounters; i++) {
+    size_t n = strlen(kNames[i]);
+    CHECK_LT(len + n + 1, kNamesCapacity);
+    if (i) {
+      g_block.names[len++] = ' ';
+    }
+    memcpy(g_block.names + len, kNames[i], n);
+    len += n;
+  }
+  g_block.names[len] = '\0';
+  g_block.names_size = len + 1;
+  g_init_ns.store(NowNs(), std::memory_order_relaxed);
+  g_block.owner_pid.store(static_cast<uint64_t>(GetpidSyscall()), std::memory_order_relaxed);
+  g_block.baseline_valid.store(0, std::memory_order_relaxed);
+  g_block.enabled.store(1, std::memory_order_release);
+  static bool fork_handler_registered = pthread_atfork(nullptr, nullptr, OnForkChild) == 0;
+  if (!fork_handler_registered) {
+    ALOGE("berberis.stats: pthread_atfork failed; fork children keep their parent as owner");
+  }
+  ALOGI("berberis.stats: on; block at 0x%lx (layout OBSTAT2, %lu counters, %lu bytes)",
+        static_cast<unsigned long>(reinterpret_cast<uintptr_t>(&g_block)),
+        static_cast<unsigned long>(kNumCounters),
+        static_cast<unsigned long>(offsetof(Block, names) + g_block.names_size));
+}
+
+}  // namespace
+
+const char* GetName(Counter counter) {
+  return counter < kNumCounters ? kNames[counter] : "?";
+}
+
+void Init() {
+  static ConfigStr config("BERBERIS_STATS", "berberis.stats");
+  const char* value = config.get();
+  if (!value || !*value || strcmp(value, "0") == 0 || Enabled()) {
+    return;
+  }
+  Enable();
+}
+
+void LogIfEnabled() {
+  if (!Enabled()) {
+    return;
+  }
+  char buf[1536];
+  Format(buf, sizeof(buf));
+  ALOGI("%s", buf);
+}
+
+size_t Format(char* buf, size_t size) {
+  if (size == 0) {
+    return 0;
+  }
+  uint64_t init_ns = g_init_ns.load(std::memory_order_relaxed);
+  uint64_t t_ms = init_ns ? (NowNs() - init_ns) / 1000000u : 0;
+  size_t len = FormatBuffer(buf,
+                            size,
+                            "openbook-stats v1 pid=%d t_ms=%lu",
+                            static_cast<int>(getpid()),
+                            static_cast<unsigned long>(t_ms));
+  for (size_t i = 0; i < kNumCounters && len + 1 < size; i++) {
+    len += FormatBuffer(buf + len,
+                        size - len,
+                        " %s=%lu",
+                        kNames[i],
+                        static_cast<unsigned long>(Get(static_cast<Counter>(i))));
+  }
+  return len;
+}
+
+void EnableForTesting() {
+  Enable();
+}
+
+void OnForkChildForTesting() {
+  OnForkChild();
+}
+
+void SetEnabledForTesting(bool enabled) {
+  g_block.enabled.store(enabled ? 1 : 0, std::memory_order_relaxed);
+}
+
+void ResetForTesting() {
+  for (auto& counter : g_block.counters) {
+    counter.store(0, std::memory_order_relaxed);
+  }
+  for (auto& value : g_block.baseline) {
+    value.store(0, std::memory_order_relaxed);
+  }
+  g_block.baseline_valid.store(0, std::memory_order_relaxed);
+}
+
+}  // namespace berberis::translator_stats
