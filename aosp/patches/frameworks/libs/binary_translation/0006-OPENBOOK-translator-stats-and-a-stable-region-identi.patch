+// berberis.stats counters: thread-safe, off by default, readable from outside
+// the process through /proc/<pid>/mem, and each counter counts what its name
+// says. Also the file offset MapsSnapshot keeps for the
+// perf map's stable region identity (here because the base unit tests only
+// run in the riscv64 host suite). The translator tests drive the real entry points
+// (berberis_HandleNotTranslated, berberis_HandleLiteCounterThresholdReached,
+// IC IVAU through the interpreter) rather than the counters themselves.
+
+#include "gtest/gtest.h"
+
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "berberis/base/bit_util.h"
+#include "berberis/base/maps_snapshot.h"
+#include "berberis/guest_state/guest_addr.h"
+#include "berberis/guest_state/guest_state.h"
+#include "berberis/interpreter/arm64/interpreter.h"
+#include "berberis/runtime_primitives/host_code.h"
+#include "berberis/runtime_primitives/profiler_interface.h"
+#include "berberis/runtime_primitives/runtime_library.h"
+#include "berberis/runtime_primitives/translation_cache.h"
+#include "berberis/runtime_primitives/translator_stats.h"
+#include "berberis/test_utils/scoped_guest_exec_region.h"
+#include "berberis/test_utils/translation_test.h"
+
+// Hidden-visibility entry points in runtime/arm64/translator_x86_64.cc, linked
+// statically into the test.
+extern "C" void berberis_HandleNotTranslated(berberis::ThreadState* state);
+extern "C" void berberis_HandleLiteCounterThresholdReached(berberis::ThreadState* state);
+
+namespace berberis {
+
+// runtime/arm64/translator_x86_64.cc: called between translating and publishing.
+extern void (*g_before_publish_hook_for_testing)(GuestAddr pc);
+
+namespace {
+
+namespace ts = translator_stats;
+
+// add x3, x1, x2 ; b .+4. The lite tier translates it in full.
+alignas(64) const uint32_t kRegion[] = {0x8b020023, 0x14000001};
+// A second region in a different cache line, never translated.
+alignas(64) const uint32_t kOtherLine[] = {0x8b020023, 0x14000001};
+// Gear-up regions, one per heavy-attempt outcome. ret ends a region.
+// movz x0, #0x11 ; movz x1, #0x22 ; ret: heavy translates it in full, but 3
+// instructions is below the minimum region size.
+alignas(64) const uint32_t kSmall[] = {0xd2800220, 0xd2800441, 0xd65f03c0};
+// add x0, x0, #1 (x24) ; ret: heavy translates and installs it.
+alignas(64) const uint32_t kLarge[] = {
+    0x91000400, 0x91000400, 0x91000400, 0x91000400, 0x91000400, 0x91000400, 0x91000400,
+    0x91000400, 0x91000400, 0x91000400, 0x91000400, 0x91000400, 0x91000400, 0x91000400,
+    0x91000400, 0x91000400, 0x91000400, 0x91000400, 0x91000400, 0x91000400, 0x91000400,
+    0x91000400, 0x91000400, 0x91000400, 0xd65f03c0};
+// add x3, x1, x2 ; brk #0: heavy bails on brk with no loop in the prefix.
+alignas(64) const uint32_t kBails[] = {0x8b020023, 0xd4200000};
+
+constexpr uint32_t kIcIvauX5 = 0xD50B7525;  // ic ivau, x5
+
+class TranslatorStats : public TranslationTest {
+ protected:
+  void SetUp() override {
+    TranslationTest::SetUp();
+    DropAll();
+    ts::ResetForTesting();
+    ts::EnableForTesting();
+  }
+
+  void TearDown() override {
+    g_before_publish_hook_for_testing = nullptr;
+    ts::SetEnabledForTesting(false);
+    ts::ResetForTesting();
+    DropAll();
+    TranslationTest::TearDown();
+  }
+
+  static void DropAll() {
+    Drop(kRegion, sizeof(kRegion));
+    Drop(kOtherLine, sizeof(kOtherLine));
+    Drop(kSmall, sizeof(kSmall));
+    Drop(kLarge, sizeof(kLarge));
+    Drop(kBails, sizeof(kBails));
+  }
+
+  // Removes any entry left by an earlier test, without counting it.
+  static void Drop(const void* code, size_t size) {
+    bool was_enabled = ts::Enabled();
+    ts::SetEnabledForTesting(false);
+    TranslationCache::GetInstance()->InvalidateGuestRange(ToGuestAddr(code),
+                                                          ToGuestAddr(code) + size);
+    ts::SetEnabledForTesting(was_enabled);
+  }
+
+  static GuestCodeEntry::Kind KindAt(GuestAddr pc) {
+    GuestCodeEntry* entry = TranslationCache::GetInstance()->LookupGuestCodeEntryUnsafeForTesting(pc);
+    return entry ? entry->kind : GuestCodeEntry::Kind::kUnderProcessing;
+  }
+
+  static void HandleNotTranslated(GuestAddr pc) {
+    ThreadState state{};
+    state.cpu.insn_addr = pc;
+    berberis_HandleNotTranslated(&state);
+  }
+
+  // First-gear lite install, then the gear-up a hot region triggers.
+  static void InstallAndGearUp(GuestAddr pc) {
+    HandleNotTranslated(pc);
+    ASSERT_EQ(KindAt(pc), GuestCodeEntry::Kind::kLiteTranslated) << "test would be vacuous";
+    ASSERT_EQ(ts::Get(ts::kInstalledLite), 1u);
+    ThreadState state{};
+    state.cpu.insn_addr = pc;
+    berberis_HandleLiteCounterThresholdReached(&state);
+  }
+
+  static uint64_t HeavyAttempts() {
+    return ts::Get(ts::kGearUpHeavy) + ts::Get(ts::kGearUpHeavyPrefix) +
+           ts::Get(ts::kGearUpDeclinedSmall) + ts::Get(ts::kGearUpBailed) +
+           ts::Get(ts::kGearUpNoMem);
+  }
+
+  static void RunIcIvau(GuestAddr addr) {
+    ThreadState state{};
+    static uint32_t insn;
+    insn = kIcIvauX5;
+    state.cpu.x[5] = addr;
+    state.cpu.insn_addr = ToGuestAddr(&insn);
+    InterpretInsn(&state);
+  }
+
+  static uint64_t Sum() {
+    uint64_t sum = 0;
+    for (size_t i = 0; i < ts::kNumCounters; i++) {
+      sum += ts::Get(static_cast<ts::Counter>(i));
+    }
+    return sum;
+  }
+};
+
+TEST_F(TranslatorStats, OffCountsNothing) {
+  ts::SetEnabledForTesting(false);
+  GuestAddr pc = ToGuestAddr(kRegion);
+  ScopedGuestExecRegion exec_region(pc, sizeof(kRegion));
+
+  ts::Add(ts::kInstalledLite);
+  { ts::ScopedTimer timer(ts::kLiteNs); }
+  HandleNotTranslated(pc);
+  ASSERT_EQ(KindAt(pc), GuestCodeEntry::Kind::kLiteTranslated) << "test would be vacuous";
+  RunIcIvau(pc);
+
+  EXPECT_EQ(Sum(), 0u);
+}
+
+TEST_F(TranslatorStats, ConcurrentAddsAreExact) {
+  constexpr int kThreads = 8;
+  constexpr int kAdds = 100000;
+  std::vector<std::thread> threads;
+  for (int t = 0; t < kThreads; t++) {
+    threads.emplace_back([] {
+      for (int i = 0; i < kAdds; i++) {
+        ts::Add(ts::kInterpretBatches);
+        ts::Add(ts::kLiteGuestBytes, 3);
+      }
+    });
+  }
+  for (auto& thread : threads) {
+    thread.join();
+  }
+  EXPECT_EQ(ts::Get(ts::kInterpretBatches), uint64_t{kThreads} * kAdds);
+  EXPECT_EQ(ts::Get(ts::kLiteGuestBytes), uint64_t{kThreads} * kAdds * 3);
+}
+
+TEST_F(TranslatorStats, FormatNamesEveryCounter) {
+  ts::Add(ts::kDispatcherFlushes, 7);
+  char buf[1536];
+  size_t len = ts::Format(buf, sizeof(buf));
+  ASSERT_EQ(len, strlen(buf));
+  std::string line(buf);
+  EXPECT_EQ(line.rfind("openbook-stats v1 pid=", 0), 0u) << line;
+  for (size_t i = 0; i < ts::kNumCounters; i++) {
+    std::string name = std::string(" ") + ts::GetName(static_cast<ts::Counter>(i)) + "=";
+    EXPECT_NE(line.find(name), std::string::npos) << name << " missing from " << line;
+  }
+  EXPECT_NE(line.find(" dispatcher_flushes=7"), std::string::npos) << line;
+
+  // A short buffer truncates, still NUL-terminated.
+  char small[24];
+  memset(small, 'x', sizeof(small));
+  len = ts::Format(small, sizeof(small));
+  EXPECT_LT(len, sizeof(small));
+  EXPECT_EQ(small[len], '\0');
+}
+
+TEST_F(TranslatorStats, BlockIsSelfDescribing) {
+  const ts::Block& b = ts::g_block;
+  EXPECT_EQ(memcmp(b.magic, "OBSTAT2", 8), 0);
+  EXPECT_EQ(b.owner_pid.load(), static_cast<uint64_t>(getpid()));
+  EXPECT_EQ(b.baseline_valid.load(), 0u);
+  EXPECT_EQ(b.count, uint64_t{ts::kNumCounters});
+  EXPECT_EQ(b.enabled.load(), 1u);
+  ASSERT_EQ(b.names_size, strlen(b.names) + 1);
+  std::string expected;
+  for (size_t i = 0; i < ts::kNumCounters; i++) {
+    expected += (i ? " " : "") + std::string(ts::GetName(static_cast<ts::Counter>(i)));
+  }
+  EXPECT_EQ(std::string(b.names), expected);
+}
+
+// What app-perf does as root on the device: read the block by address from
+// /proc/<pid>/mem, check the header, and find each counter by its name.
+TEST_F(TranslatorStats, ReadableThroughProcMem) {
+  ts::Add(ts::kDispatcherFlushes, 5);
+  ts::Add(ts::kInstalledHeavy, 2);
+  int fd = open("/proc/self/mem", O_RDONLY | O_CLOEXEC);
+  ASSERT_NE(fd, -1);
+  auto addr = static_cast<off_t>(bit_cast<uintptr_t>(&ts::g_block));
+  uint64_t header[6];
+  ASSERT_EQ(pread(fd, header, sizeof(header), addr), static_cast<ssize_t>(sizeof(header)));
+  EXPECT_EQ(memcmp(&header[0], "OBSTAT2", 8), 0);
+  uint64_t count = header[1], names_size = header[2];
+  ASSERT_EQ(count, uint64_t{ts::kNumCounters});
+  EXPECT_EQ(header[3], 1u);  // enabled
+  EXPECT_EQ(header[4], static_cast<uint64_t>(getpid()));  // owner
+  EXPECT_EQ(header[5], 0u);                               // no baseline
+  std::vector<char> rest(2 * count * 8 + names_size);
+  ASSERT_EQ(pread(fd, rest.data(), rest.size(), addr + sizeof(header)),
+            static_cast<ssize_t>(rest.size()));
+  close(fd);
+  std::vector<uint64_t> values(count);
+  memcpy(values.data(), rest.data(), count * 8);
+  std::string names(rest.data() + 2 * count * 8);
+  std::vector<std::string> split;
+  for (size_t pos = 0, next; pos <= names.size(); pos = next + 1) {
+    next = names.find(' ', pos);
+    if (next == std::string::npos) next = names.size();
+    split.push_back(names.substr(pos, next - pos));
+  }
+  ASSERT_EQ(split.size(), count);
+  for (size_t i = 0; i < count; i++) {
+    if (split[i] == "dispatcher_flushes") EXPECT_EQ(values[i], 5u);
+    else if (split[i] == "installed_heavy") EXPECT_EQ(values[i], 2u);
+    else EXPECT_EQ(values[i], 0u) << split[i];
+  }
+}
+
+TEST_F(TranslatorStats, FirstGearCountsALiteInstall) {
+  GuestAddr pc = ToGuestAddr(kRegion);
+  ScopedGuestExecRegion exec_region(pc, sizeof(kRegion));
+
+  HandleNotTranslated(pc);
+
+  ASSERT_EQ(KindAt(pc), GuestCodeEntry::Kind::kLiteTranslated);
+  EXPECT_EQ(ts::Get(ts::kInstalledLite), 1u);
+  EXPECT_EQ(ts::Get(ts::kInstalledHeavy), 0u);
+  EXPECT_EQ(ts::Get(ts::kInstalledInterp), 0u);
