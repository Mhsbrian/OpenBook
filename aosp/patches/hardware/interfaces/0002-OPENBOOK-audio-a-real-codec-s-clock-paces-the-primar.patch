From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenBook <noreply@anybook.invalid>
Date: Sat, 17 Oct 2026 10:30:50 -0400
Subject: [PATCH] OPENBOOK: audio: a real codec's clock paces the primary
 module's streams

StreamPrimary paces synchronous streams to the wall clock and, when a stream
falls behind, drops a buffer: a workaround for the emulator's host-side buffer
(b/302587331). Its MonoPipe, one buffer deep, drops output that does not fit
and pads input that has not arrived with silence. On the ASUS GA403WR (ALC285)
an AAudio capture got 4096 frames of silence about every 0.7 s
("incomplete data received, inserting 4096 frames of silence", 7 times in
3.5 s), and the speaker-to-mic loopback through Android lost most of its tone,
while the same loopback straight on ALSA was clean (ANAL-179).

With vendor.audio.primary.pacing=false the stream is device-clocked instead:
no wall-clock pacing, a pipe two buffers deep, a writer that waits for room
(MonoPipe's blocking write) and a reader that waits up to two buffers for its
data. Unset, nothing changes.

Bug: ANAL-179
Change-Id: I59d1f7218e292790b68be71736233e5da4976508
---
 .../aidl/default/alsa/StreamAlsaMonoPipe.cpp  | 24 +++++++++++++++++--
 .../include/core-impl/StreamAlsaMonoPipe.h    |  6 +++++
 .../default/include/core-impl/StreamPrimary.h |  4 ++++
 audio/aidl/default/primary/StreamPrimary.cpp  |  6 +++--
 4 files changed, 36 insertions(+), 4 deletions(-)

diff --git a/audio/aidl/default/alsa/StreamAlsaMonoPipe.cpp b/audio/aidl/default/alsa/StreamAlsaMonoPipe.cpp
index 3738f3056f..cc899c337b 100644
--- a/audio/aidl/default/alsa/StreamAlsaMonoPipe.cpp
+++ b/audio/aidl/default/alsa/StreamAlsaMonoPipe.cpp
@@ -14,6 +14,8 @@
  * limitations under the License.
  */
 
+#include <chrono>
+
 #define LOG_TAG "AHAL_StreamAlsaMonoPipe"
 #include <Log.h>
 
@@ -42,7 +44,9 @@ StreamAlsaMonoPipe::~StreamAlsaMonoPipe() {
 
 ::android::sp<::android::MonoPipe> StreamAlsaMonoPipe::makeSink(bool writeCanBlock) {
     const ::android::NBAIO_Format format = getPipeFormat();
-    auto sink = ::android::sp<::android::MonoPipe>::make(mBufferSizeFrames, format, writeCanBlock);
+    // A device-clocked stream gets room for a second buffer, so the two sides' periods need not line up.
+    auto sink = ::android::sp<::android::MonoPipe>::make(
+            mDeviceClocked ? 2 * mBufferSizeFrames : mBufferSizeFrames, format, writeCanBlock);
     const ::android::NBAIO_Format offers[1] = {format};
     size_t numCounterOffers = 0;
     ssize_t index = sink->negotiate(offers, 1, nullptr, numCounterOffers);
@@ -79,7 +83,8 @@ StreamAlsaMonoPipe::~StreamAlsaMonoPipe() {
         return status;
     }
     for (size_t i = 0; i < alsaDeviceProxies.size(); ++i) {
-        auto sink = makeSink(mIsInput);  // Do not block the writer when it is on our thread.
+        // Do not block the writer when it is on our thread, unless the device's clock paces the stream.
+        auto sink = makeSink(mIsInput || mDeviceClocked);
         if (sink != nullptr) {
             sinks.push_back(sink);
         } else {
@@ -116,6 +121,21 @@ StreamAlsaMonoPipe::~StreamAlsaMonoPipe() {
         LOG(VERBOSE) << __func__ << ": reading from sink " << i;
         ssize_t framesRead = mSources[i]->read(buffer, frameCount);
         LOG_IF(FATAL, framesRead < 0) << "Error reading from the pipe: " << framesRead;
+        if (mDeviceClocked && framesRead < static_cast<ssize_t>(frameCount)) {
+            // The capture thread delivers at the device's clock, a period at a time: wait for the rest (at
+            // most two buffers' worth) instead of padding the client's data with silence.
+            const auto deadline = std::chrono::steady_clock::now() +
+                                  std::chrono::microseconds(2 * frameCount * 1000000LL /
+                                                            getContext().getSampleRate());
+            while (framesRead < static_cast<ssize_t>(frameCount) && mIoThreadIsRunning &&
+                   std::chrono::steady_clock::now() < deadline) {
+                usleep(1000);
+                ssize_t more = mSources[i]->read(static_cast<char*>(buffer) + framesRead * mFrameSizeBytes,
+                                                 frameCount - framesRead);
+                if (more < 0) break;
+                framesRead += more;
+            }
+        }
         if (ssize_t framesMissing = static_cast<ssize_t>(frameCount) - framesRead;
             framesMissing > 0) {
             LOG(WARNING) << __func__ << ": incomplete data received, inserting " << framesMissing
diff --git a/audio/aidl/default/include/core-impl/StreamAlsaMonoPipe.h b/audio/aidl/default/include/core-impl/StreamAlsaMonoPipe.h
index 98f4d3bd1b..8e2adb656f 100644
--- a/audio/aidl/default/include/core-impl/StreamAlsaMonoPipe.h
+++ b/audio/aidl/default/include/core-impl/StreamAlsaMonoPipe.h
@@ -43,6 +43,12 @@ class StreamAlsaMonoPipe : public StreamAlsaBase {
                                  int32_t* latencyMs) override;
     void shutdown() override;
 
+  protected:
+    // The device's own clock paces the stream (a real codec): transfer() then waits for the pipe instead of
+    // dropping output that does not fit or padding input that has not arrived yet. Off by default, which keeps
+    // the non-blocking behaviour the emulator's wall-clock pacing relies on. Set before start().
+    bool mDeviceClocked = false;
+
   private:
     ::android::NBAIO_Format getPipeFormat() const;
     ::android::sp<::android::MonoPipe> makeSink(bool writeCanBlock);
diff --git a/audio/aidl/default/include/core-impl/StreamPrimary.h b/audio/aidl/default/include/core-impl/StreamPrimary.h
index 90ed71eca8..a90b5ecf6a 100644
--- a/audio/aidl/default/include/core-impl/StreamPrimary.h
+++ b/audio/aidl/default/include/core-impl/StreamPrimary.h
@@ -51,6 +51,10 @@ class StreamPrimary : public StreamAlsaMonoPipe {
     bool isStubStream();
 
     const bool mIsAsynchronous;
+    // Wall-clock pacing of synchronous streams, dropping a buffer whenever the stream falls behind: the
+    // emulator's workaround (b/302587331). vendor.audio.primary.pacing=false turns it off for a real codec,
+    // whose clock then paces the stream through the pipe (StreamAlsaMonoPipe::mDeviceClocked).
+    const bool mPaceToWallClock;
     int64_t mStartTimeNs = 0;
     long mFramesSinceStart = 0;
     bool mSkipNextTransfer = false;
diff --git a/audio/aidl/default/primary/StreamPrimary.cpp b/audio/aidl/default/primary/StreamPrimary.cpp
index 2513911615..f5219fa4ed 100644
--- a/audio/aidl/default/primary/StreamPrimary.cpp
+++ b/audio/aidl/default/primary/StreamPrimary.cpp
@@ -42,7 +42,9 @@ namespace aidl::android::hardware::audio::core {
 StreamPrimary::StreamPrimary(StreamContext* context, const Metadata& metadata)
     : StreamAlsaMonoPipe(context, metadata, 3 /*readWriteRetries*/),
       mIsAsynchronous(!!getContext().getAsyncCallback()),
+      mPaceToWallClock(GetBoolProperty("vendor.audio.primary.pacing", true)),
       mStubDriver(getContext()) {
+    mDeviceClocked = !mPaceToWallClock;
     context->startStreamDataProcessor();
 }
 
@@ -108,7 +110,7 @@ StreamPrimary::StreamPrimary(StreamContext* context, const Metadata& metadata)
         if (mIsInput) memset(buffer, 0, frameCount * mFrameSizeBytes);
         mSkipNextTransfer = false;
     }
-    if (!mIsAsynchronous) {
+    if (!mIsAsynchronous && mPaceToWallClock) {
         const long bufferDurationUs =
                 (*actualFrameCount) * MICROS_PER_SECOND / mContext.getSampleRate();
         const auto totalDurationUs =
@@ -125,7 +127,7 @@ StreamPrimary::StreamPrimary(StreamContext* context, const Metadata& metadata)
             mSkipNextTransfer = true;
         }
     } else {
-        LOG(VERBOSE) << __func__ << ": asynchronous transfer";
+        LOG(VERBOSE) << __func__ << (mIsAsynchronous ? ": asynchronous transfer" : ": device-clocked transfer");
     }
     return ::android::OK;
 }
