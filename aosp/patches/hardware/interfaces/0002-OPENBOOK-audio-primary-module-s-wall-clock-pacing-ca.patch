From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenBook <noreply@anybook.invalid>
Date: Fri, 16 Oct 2026 23:38:16 -0400
Subject: [PATCH] OPENBOOK: audio: primary module's wall-clock pacing can be
 turned off

StreamPrimary paces synchronous streams to the wall clock and, when it falls
behind, drops the next buffer: a workaround for the emulator's host-side
buffer (b/302587331). On a real codec the blocking ALSA writes and reads pace
the stream already, and a slow start makes the workaround drop audio (ANAL-179:
in QEMU an AAudio tone through the HAL lost about 1.3 s of its 2 s, while the
same tone written to ALSA directly arrived whole).

vendor.audio.primary.pacing=false turns it off. Unset, nothing changes.

Bug: ANAL-179
Change-Id: If6690fc6822620ec7fc9e8400765d54c481ebb05
---
 audio/aidl/default/include/core-impl/StreamPrimary.h | 4 ++++
 audio/aidl/default/primary/StreamPrimary.cpp         | 5 +++--
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/audio/aidl/default/include/core-impl/StreamPrimary.h b/audio/aidl/default/include/core-impl/StreamPrimary.h
index 90ed71eca8..7f9dc1bf8b 100644
--- a/audio/aidl/default/include/core-impl/StreamPrimary.h
+++ b/audio/aidl/default/include/core-impl/StreamPrimary.h
@@ -51,6 +51,10 @@ class StreamPrimary : public StreamAlsaMonoPipe {
     bool isStubStream();
 
     const bool mIsAsynchronous;
+    // Whether transfer() paces the stream to the wall clock and drops a buffer when it falls behind: the
+    // emulator's workaround (b/302587331), on unless vendor.audio.primary.pacing=false. A real codec's blocking
+    // ALSA reads and writes pace the stream themselves, and dropping buffers there loses audio.
+    const bool mPaceTransfers;
     int64_t mStartTimeNs = 0;
     long mFramesSinceStart = 0;
     bool mSkipNextTransfer = false;
diff --git a/audio/aidl/default/primary/StreamPrimary.cpp b/audio/aidl/default/primary/StreamPrimary.cpp
index 2513911615..f205540028 100644
--- a/audio/aidl/default/primary/StreamPrimary.cpp
+++ b/audio/aidl/default/primary/StreamPrimary.cpp
@@ -42,6 +42,7 @@ namespace aidl::android::hardware::audio::core {
 StreamPrimary::StreamPrimary(StreamContext* context, const Metadata& metadata)
     : StreamAlsaMonoPipe(context, metadata, 3 /*readWriteRetries*/),
       mIsAsynchronous(!!getContext().getAsyncCallback()),
+      mPaceTransfers(GetBoolProperty("vendor.audio.primary.pacing", true)),
       mStubDriver(getContext()) {
     context->startStreamDataProcessor();
 }
@@ -108,7 +109,7 @@ StreamPrimary::StreamPrimary(StreamContext* context, const Metadata& metadata)
         if (mIsInput) memset(buffer, 0, frameCount * mFrameSizeBytes);
         mSkipNextTransfer = false;
     }
-    if (!mIsAsynchronous) {
+    if (!mIsAsynchronous && mPaceTransfers) {
         const long bufferDurationUs =
                 (*actualFrameCount) * MICROS_PER_SECOND / mContext.getSampleRate();
         const auto totalDurationUs =
@@ -125,7 +126,7 @@ StreamPrimary::StreamPrimary(StreamContext* context, const Metadata& metadata)
             mSkipNextTransfer = true;
         }
     } else {
-        LOG(VERBOSE) << __func__ << ": asynchronous transfer";
+        LOG(VERBOSE) << __func__ << (mIsAsynchronous ? ": asynchronous transfer" : ": unpaced transfer");
     }
     return ::android::OK;
 }
