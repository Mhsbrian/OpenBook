diff --git a/Android.bp b/Android.bp
index 1a855117..3c9092e2 100644
--- a/Android.bp
+++ b/Android.bp
@@ -614,6 +614,56 @@ cc_binary {
     init_rc: ["update_engine.rc"],
 }
 
+// Explicit experimental target only. No product inclusion or init service:
+// package as /system/bin/update_engine only in a reviewed disposable Ruby image.
+cc_test_host {
+    name: "openbook_ota_guard_test",
+    srcs: ["aosp/openbook_ota_guard_test.cc"],
+    include_dirs: ["system"],
+    gtest: false,
+    cflags: ["-Wall", "-Wextra", "-Werror"],
+}
+
+cc_binary {
+    name: "openbook_ota_guard_probe",
+    defaults: ["ue_defaults", "libupdate_engine_android_exports"],
+    exclude_shared_libs: ["libprotobuf-cpp-lite"],
+    ldflags: ["-Wl,--exclude-libs,ALL"],
+    static_libs: ["libupdate_engine_android_openbook_guard", "libprotobuf-cpp-lite"],
+    srcs: ["aosp/openbook_ota_guard_probe.cc"],
+}
+
+cc_library_static {
+    name: "libupdate_engine_android_openbook_guard",
+    defaults: [
+        "libupdate_engine_android_defaults",
+        "libupdate_engine_android_exports",
+    ],
+    cflags: ["-DOPENBOOK_RUBY_OTA_GUARD"],
+}
+
+cc_binary {
+    name: "openbook_ruby_update_engine",
+    defaults: [
+        "ue_defaults",
+        "libupdate_engine_android_exports",
+    ],
+    cflags: ["-DOPENBOOK_RUBY_OTA_GUARD"],
+    // Ruby's protobuf has a different SONAME/Abseil revision. Keep this
+    // build's generated-message runtime private; never replace Ruby's library.
+    exclude_shared_libs: ["libprotobuf-cpp-lite"],
+    ldflags: ["-Wl,--exclude-libs,ALL"],
+    static_libs: [
+        "libupdate_engine_android_openbook_guard",
+        "libgflags",
+        "libprotobuf-cpp-lite",
+    ],
+    srcs: [
+        "main.cc",
+        "aosp/metrics_reporter_android.cc",
+    ],
+}
+
