# Platform graphics HALs for products that don't bring their own (ANYBOOK_GRAPHICS_PLATFORM_HALS,
# BoardConfig.mk): the minigbm allocator and mapper, drm_hwcomposer. Cuttlefish labels the same
# files in device/google/cuttlefish/shared/graphics/sepolicy, so VM boards leave this directory out.

/dev/dri                                                                 u:object_r:gpu_device:s0
/dev/dri/card[0-9]+                                                      u:object_r:graphics_device:s0
/dev/dri/renderD[0-9]+                                                   u:object_r:gpu_device:s0

/vendor/bin/hw/android\.hardware\.graphics\.allocator-service\.minigbm   u:object_r:hal_graphics_allocator_default_exec:s0
/vendor/bin/hw/android\.hardware\.composer\.hwc3-service\.drm            u:object_r:hal_graphics_composer_default_exec:s0

/vendor/lib64/libdrm\.so                                                 u:object_r:same_process_hal_file:s0
/vendor/lib64/libminigbm_gralloc\.so                                     u:object_r:same_process_hal_file:s0
/vendor/lib64/libminigbm_gralloc4_utils\.so                              u:object_r:same_process_hal_file:s0
/vendor/lib64/hw/mapper\.minigbm\.so                                     u:object_r:same_process_hal_file:s0
