# drm_hwcomposer on a KMS device (amdgpu DC). Modeled on Cuttlefish's policy for the same binary.
hal_client_domain(hal_graphics_composer_default, hal_graphics_allocator);
vndbinder_use(hal_graphics_composer_default)
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket { bind create read };
allow hal_graphics_composer_default kmsg_device:chr_file w_file_perms;
allow hal_graphics_composer_default hal_graphics_mapper_service:service_manager find;
allow hal_graphics_composer_server hal_graphics_allocator_default_tmpfs:file read;
# drm_hwcomposer probes optional vendor.hwc.* properties that AnyBook does not set.
dontaudit hal_graphics_composer_default default_prop:file read;
