#
# Graphics HAL selection for the GPU this boot runs on (docs/graphics-amd.md).
# anybook_gpu_probe reads /sys/class/drm and /sys/bus/pci at early-init and publishes
# vendor.anybook.gpu.{pci_id,driver,source,others,hal}.
#   hal=amdgpu  AMD GPU (bound to amdgpu, or a display controller amdgpu has not bound yet):
#               the properties below.
#   hal=virtio  virtio-gpu: nothing here. VM products configure their virtual GPU themselves
#               (Cuttlefish: androidboot.hardware.* from the launcher, init_graphics.vendor.rc).
#   hal=none    no supported GPU: nothing here.
# Gralloc needs no switch: minigbm picks its backend from the DRM driver name (amdgpu, virtio_gpu).
# On a laptop with an ASUS MUX the probe follows the panel (ANAL-246): the GPU whose card drives the connected
# internal panel. After each HAL event, `anybook_gpu_probe --pin` pins drm_hwcomposer (vendor.hwc.drm.device) and
# minigbm (vendor.minigbm.render_node) to that GPU, so neither can move to another, such as the dGPU in Hybrid.

# It writes what it found to the kernel log itself (stdio_to_kmsg's /dev/kmsg_debug is unlabelled on Ruby).
service vendor.anybook-gpu-probe /vendor/bin/anybook_gpu_probe
    user system
    group system
    oneshot
    disabled

# Waits up to 5 s for the chosen GPU's card and render node, then sets the pins it found.
service vendor.anybook-gpu-pin /vendor/bin/anybook_gpu_probe --pin
    user system
    group system
    oneshot
    disabled

on early-init
    exec_start vendor.anybook-gpu-probe
    # Act on the probe's choice through an event, not a property trigger. init runs the property triggers of
    # values set during early-init only after the whole late-init chain, `on boot` included, where the HALs and
    # SurfaceFlinger start; on the G14 SurfaceFlinger then sometimes started before ro.hardware.egl was set and
    # aborted ("couldn't find an OpenGL ES implementation", ANAL-176 live-002). An event queued here runs right
    # after late-init's own commands, before early-fs.
    trigger vendor-anybook-gpu-${vendor.anybook.gpu.hal:-none}

# Vulkan: Mesa RADV. GLES: ANGLE on RADV (as on Google's own desktop builds); radeonsi stays
# installed as the fallback, e.g. `setprop persist.graphics.egl mesa` or androidboot.hardware.egl=mesa.
# Gralloc0 (gralloc.minigbm) serves Mesa's "cros" buffer-info queries. Composer: drm_hwcomposer.
# A value the bootloader passes as androidboot.hardware.* still wins.
on vendor-anybook-gpu-amdgpu
    setprop ro.hardware.vulkan ${ro.boot.hardware.vulkan:-radv}
    setprop ro.hardware.egl ${ro.boot.hardware.egl:-angle}
    setprop ro.hardware.gralloc ${ro.boot.hardware.gralloc:-minigbm}
    setprop ro.hardware.hwcomposer ${ro.boot.hardware.hwcomposer:-drm}
    setprop ro.opengles.version ${ro.boot.opengles.version:-196610}
    exec_start vendor.anybook-gpu-pin
