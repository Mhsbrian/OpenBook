<resources>
    <!-- No sound on keypress in the on-screen keyboard (ANAL-206). LatinIME plays it with
         AudioManager.playSoundEffect(type, volume), which ignores the system "Touch sounds" setting. AOSP turns it
         on for screens of 600 dp and up (values-sw600dp, values-sw768dp), which is every OpenBook desktop. An
         overlay value only wins where its configuration is at least as specific as the target's (AssetManager2),
         so the same value is repeated for both. -->
    <bool name="config_default_sound_enabled">false</bool>
</resources>
