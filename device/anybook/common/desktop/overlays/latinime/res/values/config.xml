<resources>
    <!-- No sound on keypress in the on-screen keyboard (ANAL-206). AOSP turns it on for screens of 600 dp and up
         (values-sw600dp, values-sw768dp), which is every OpenBook desktop. LatinIME plays it with
         AudioManager.playSoundEffect(type, volume), which ignores the system "Touch sounds" setting. An overlay
         value replaces all of the target's configurations, so values/ is enough. -->
    <bool name="config_default_sound_enabled">false</bool>
</resources>
