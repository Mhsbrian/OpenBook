  SystemUI (and WM Shell, whose resources are built into SystemUI) config for an Android desktop device,
  taken from the SystemUI vendor RRO in Google's AOSP Desktop (Preview) emulator image. Left out:
  config_disableSplitShade (not in AOSP SystemUI) and hsu_allow_list_qs_tiles (HSUM only; we don't use HSUM).
  Defaults: frameworks/base/packages/SystemUI/res/values/config.xml and
  frameworks/base/libs/WindowManager/Shell/res/values/config.xml.
-->
<resources>
    <bool name="config_useDesktopStatusBar">true</bool>
    <bool name="config_notificationShadeOnTopEnd">true</bool>
    <bool name="config_statusBarTapToExpandShade">true</bool>
    <bool name="config_enableDesktopAudioTileDetailsView">true</bool>
    <bool name="config_enableHideNotificationsShadeOnAllAppsKey">true</bool>
    <bool name="config_enableInputRouting">true</bool>
    <bool name="config_enableSignOutButtonOnKeyguardStatusBar">true</bool>
    <bool name="config_improveLargeScreenInteractionOnLockscreen">true</bool>
    <bool name="config_isDesktopForFalsingPurposes">true</bool>
    <bool name="config_largeScreenPrivacyIndicator">true</bool>
    <bool name="config_testDesktopScreenSize">true</bool>
    <bool name="config_useBrightnessMirrorInOverlay">false</bool>
    <!-- WM Shell -->
    <bool name="config_letterboxIsReachabilityEducationEnabled">true</bool>
    <bool name="config_letterboxIsRestartDialogEnabled">true</bool>
    <bool name="config_removeStatusBarInputLayer">false</bool>
    <dimen name="lock_icon_padding">24px</dimen>
</resources>
