<?xml version="1.0" encoding="utf-8"?>
<!--
  Copyright (C) 2026 The OpenBook Authors. SPDX-License-Identifier: Apache-2.0
  OpenBook's wallpapers in Wallpaper & style (ANAL-207). WallpaperPicker2 reads res/xml/wallpapers.xml from the
  partner customization package (DefaultWallpaperCategoryClientImpl.getSystemCategories) and lists each
  <static-wallpaper> in its category. The images are assets/wallpapers/2880x1800 (CC-BY-4.0), the thumbnails
  assets/wallpapers/thumbs; the picker crops them to the display.
-->
<wallpapers>
    <category id="openbook" title="@string/openbook_wallpapers" thumbnail="@drawable/openbook_folio_light_thumb"
        featured="openbook_folio_light">
        <static-wallpaper id="openbook_folio_light" src="@drawable/openbook_folio_light"
            thumbnail="@drawable/openbook_folio_light_thumb" title="@string/openbook_wallpaper_folio"
            subtitle1="@string/openbook_wallpaper_light" subtitle2="@string/openbook_wallpaper_credit" />
        <static-wallpaper id="openbook_folio_dark" src="@drawable/openbook_folio_dark"
            thumbnail="@drawable/openbook_folio_dark_thumb" title="@string/openbook_wallpaper_folio"
            subtitle1="@string/openbook_wallpaper_dark" subtitle2="@string/openbook_wallpaper_credit" />
        <static-wallpaper id="openbook_bloom_light" src="@drawable/openbook_bloom_light"
            thumbnail="@drawable/openbook_bloom_light_thumb" title="@string/openbook_wallpaper_bloom"
            subtitle1="@string/openbook_wallpaper_light" subtitle2="@string/openbook_wallpaper_credit" />
        <static-wallpaper id="openbook_bloom_dark" src="@drawable/openbook_bloom_dark"
            thumbnail="@drawable/openbook_bloom_dark_thumb" title="@string/openbook_wallpaper_bloom"
            subtitle1="@string/openbook_wallpaper_dark" subtitle2="@string/openbook_wallpaper_credit" />
        <static-wallpaper id="openbook_strata_light" src="@drawable/openbook_strata_light"
            thumbnail="@drawable/openbook_strata_light_thumb" title="@string/openbook_wallpaper_strata"
            subtitle1="@string/openbook_wallpaper_light" subtitle2="@string/openbook_wallpaper_credit" />
        <static-wallpaper id="openbook_strata_dark" src="@drawable/openbook_strata_dark"
            thumbnail="@drawable/openbook_strata_dark_thumb" title="@string/openbook_wallpaper_strata"
            subtitle1="@string/openbook_wallpaper_dark" subtitle2="@string/openbook_wallpaper_credit" />
        <static-wallpaper id="openbook_tide_light" src="@drawable/openbook_tide_light"
            thumbnail="@drawable/openbook_tide_light_thumb" title="@string/openbook_wallpaper_tide"
            subtitle1="@string/openbook_wallpaper_light" subtitle2="@string/openbook_wallpaper_credit" />
        <static-wallpaper id="openbook_tide_dark" src="@drawable/openbook_tide_dark"
            thumbnail="@drawable/openbook_tide_dark_thumb" title="@string/openbook_wallpaper_tide"
            subtitle1="@string/openbook_wallpaper_dark" subtitle2="@string/openbook_wallpaper_credit" />
    </category>
</wallpapers>
