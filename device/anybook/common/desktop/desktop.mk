# Android desktop (laptop) configuration, matching Google's AOSP Desktop (Preview) emulator image
# (sdk_gdesktop_x86_64, Android 17). Inherit it from any AnyBook product, VM or bare metal.
# docs/aosp-desktop.md maps every setting to the reference image and to the code that reads it.

# desktop variants of resource strings (aapt --product, plus auto-generated characteristics RROs).
PRODUCT_CHARACTERISTICS := desktop

# Window extensions (persist.wm.extensions.enabled, ...activity_embedding_guard_with_android_15=false) and the
# two-pane Settings layout (persist.settings.large_screen_opt.enabled), as in the reference image.
$(call inherit-product, $(SRC_TARGET_DIR)/product/large_screen_common.mk)

# OpenBook's boot animation, sounds and pointer theme (ANAL-207). The default wallpaper is in the framework overlay
# below (res/drawable-*nodpi/default_wallpaper.jpg).
$(call inherit-product, device/anybook/common/branding/branding.mk)

# Desktop windowing and desktop SystemUI configs (framework and SystemUI RROs on /product).
PRODUCT_PACKAGES += \
    AnyBookDesktopFrameworkOverlay \
    AnyBookDesktopSettingsProviderOverlay \
    AnyBookDesktopSystemUIOverlay

# A clean default desktop (ANAL-206): no search box (the launcher RRO also replaces QuickSearchBox), taskbar pins
# from the partner customization package, no touch or keypress sounds (SettingsProvider and LatinIME RROs).
PRODUCT_PACKAGES += \
    AnyBookDesktopLauncherOverlay \
    AnyBookDesktopLatinIMEOverlay \
    AnyBookDesktopPartnerCustomization

# Wallpaper colour hints, as on Googlebook (ANAL-205). android.app.WallpaperColors reads them once per process:
# a wallpaper supports dark text (HINT_SUPPORTS_DARK_TEXT: Launcher3's DarkText theme, SystemUI's lock screen
# colours) when its mean luminance is above threshold % and at most max_dark_area % of its pixels are dark.
# AOSP defaults: 70 and 5.
PRODUCT_PRODUCT_PROPERTIES += \
    persist.wallpapercolors.threshold=55 \
    persist.wallpapercolors.max_dark_area=12

# Typography: Google Sans and Google Sans Flex (OFL) in /product/fonts, and the 40 font families AOSP 17's
# SystemUI, Launcher3 and SettingsLib name, in /product/etc/fonts_customization.xml (fonts/, ANAL-202). The
# framework RRO above selects them.
PRODUCT_PACKAGES += openbook_fonts_customization.xml

# Quire core (ANAL-216, docs/quire.md): the assistant, the contextual search app and the computer-control agent. Its
# flags are in release/openbook/ below.
$(call inherit-product, device/anybook/common/quire/quire.mk)
$(call inherit-product, device/anybook/common/linux-env/linux-env.mk)

# Desktop aconfig flags: every flag the reference image enables that cp2a leaves disabled, generated by
# scripts/desktop-flags.py, plus the few OpenBook picks itself (release/openbook/). Layered onto the core release
# configs for products that inherit this file only.
PRODUCT_RELEASE_CONFIG_MAPS += device/anybook/common/desktop/release/release_config_map.textproto
