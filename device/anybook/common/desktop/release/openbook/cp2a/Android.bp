//
// Flags OpenBook turns on by its own choice rather than because the reference desktop image does. Kept apart
// from ../../aconfig/, which scripts/desktop-flags.py rewrites. Same layout: one directory per package, one
// <flag>_flag_values.textproto per flag. Listed in ../../release_configs/cp2a.textproto.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aconfig_value_set {
    name: "aconfig_value_set-openbook_desktop-cp2a",
    srcs: [
        "*/Android.bp",
    ],
}
