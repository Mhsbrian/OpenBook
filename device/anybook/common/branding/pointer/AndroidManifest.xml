  package="android" is deliberate: it is the resource package aapt2 compiles this overlay as, so that its vectors can
  name the framework's private pointer attributes. Android.bp renames the manifest to dev.anybook.overlay.pointer.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="android">
    <application android:hasCode="false" />
    <overlay android:targetPackage="android" android:isStatic="true" android:priority="11" />
</manifest>
