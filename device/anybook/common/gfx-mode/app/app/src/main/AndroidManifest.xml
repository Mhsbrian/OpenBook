  OpenBook Graphics: Eco, Hybrid and Ultimate on laptops with an ASUS MUX (ANAL-246,
  docs/nvidia-graphics-modes.md §7). A privileged system app in its own SELinux domain
  (openbook_graphics_app), which alone may set openbook.gfx.request for openbook-gfx-mode. Its privileged
  permissions (privapp-permissions-org.openbook.graphics.xml): REBOOT, and WRITE_SECURE_SETTINGS for the games rule
  (ANAL-312, docs/nvidia-offload-ruby.md), which keeps Android's updatable-driver allow-list equal to the installed
  games and writes the owner's per-app choices.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Restart after the owner confirms. Privileged: granted only to the allow-listed system app. -->
    <uses-permission android:name="android.permission.REBOOT"
        tools:ignore="ProtectedPermissions" />
    <!-- The games rule: Settings.Global updatable_driver_*. Privileged: granted only to the allow-listed system app. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Every installed app, to find the games (Android 11 package visibility). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenBookGraphics"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- An entry under Settings > Display, through Settings' injection of system apps' activities
             (HYPOTHESIS that Googlebook's Settings keeps it; checked in the Ruby VM). -->
        <activity-alias
            android:name=".ui.SettingsEntry"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@drawable/ic_graphics"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.display" />
            <meta-data android:name="com.android.settings.summary"
                android:resource="@string/settings_summary" />
            <meta-data android:name="com.android.settings.icon"
                android:resource="@drawable/ic_graphics" />
        </activity-alias>

        <!-- Apps on the NVIDIA GPU: the games rule and each app's choice. Opened from the main screen. -->
        <activity
            android:name=".ui.AppsActivity"
            android:exported="false"
            android:label="@string/apps_title"
            android:parentActivityName=".ui.MainActivity" />

        <!-- A Quick Settings tile showing the mode; a tap opens the app. -->
        <service
            android:name=".GraphicsTile"
            android:exported="true"
            android:icon="@drawable/ic_graphics"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Protected broadcasts: only the system can send them. Boot, this app's own update, and an app's removal
             (PACKAGE_FULLY_REMOVED reaches manifest receivers; PACKAGE_ADDED does not since Android 8, so new games
             are found by GamesJob). -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- The games rule's periodic sync (every 15 minutes, persisted across boots). -->
        <service
            android:name=".GamesJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
