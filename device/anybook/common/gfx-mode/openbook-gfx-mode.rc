#
# Graphics modes (ANAL-246, docs/nvidia-graphics-modes.md): openbook-gfx-mode at each point of the boot.
# init.openbook.rc runs the early-init steps in order, after the modules load and before the stack selector:
#   vendor.openbook.gfx-boot   the record in /metadata against the firmware: finish or undo a switch, count an
#                              Ultimate boot, roll back; publishes vendor.openbook.gfx.* and .kms
#   vendor.openbook.gfx-kms    the KMS driver for the mode (gfx-kms.<kms>.load; nothing outside Ultimate)
# Every Ultimate boot then runs the watchdog. Requests come from the OpenBook Graphics app (openbook.gfx.request,
# a platform property only its domain may set) and from adb (debug.openbook.gfx). Firmware writes stay off unless
# the image sets ro.vendor.openbook.gfx.fw_writes=1. Logs: `adb logcat -s openbook-gfx-mode`, and the kernel log at
# early init.

service vendor.openbook.gfx-boot /vendor/bin/openbook-gfx-mode boot
    user root
    group root system
    oneshot
    disabled
    stdio_to_kmsg

service vendor.openbook.gfx-kms /vendor/bin/modprobe -s -d /vendor/lib/modules --all=/vendor/etc/openbook/gfx-kms.${vendor.openbook.gfx.kms:-none}.load
    user root
    group root system
    seclabel u:r:vendor_modprobe:s0
    oneshot
    disabled
    stdio_to_kmsg

# The frame, boot-completion and keep deadlines of an Ultimate boot. It exits once the boot is healthy.
service vendor.openbook.gfx-watchdog /vendor/bin/openbook-gfx-mode watchdog
    user root
    group root system
    oneshot
    disabled
    stdio_to_kmsg

on vendor-openbook-gfx-kms-nouveau
    start vendor.openbook.gfx-watchdog

# drm_hwcomposer's first frame on an internal display (aosp/patches/external/drm_hwcomposer): CARD:CONNECTOR.
service vendor.openbook.gfx-frame /vendor/bin/openbook-gfx-mode frame ${vendor.hwc.openbook.first_present:-none}
    user root
    group root system
    oneshot
    disabled

on property:vendor.hwc.openbook.first_present=*
    start vendor.openbook.gfx-frame

service vendor.openbook.gfx-booted /vendor/bin/openbook-gfx-mode booted
    user root
    group root system
    oneshot
    disabled

on property:sys.boot_completed=1
    start vendor.openbook.gfx-booted

# The OpenBook Graphics app: VERB[:MODE]@SEQ. One request at a time; the app waits for SEQ's answer.
service vendor.openbook.gfx-app /vendor/bin/openbook-gfx-mode app ${openbook.gfx.request:-none}
    user root
    group root system
    oneshot
    disabled

on property:openbook.gfx.request=*
    start vendor.openbook.gfx-app

# adb: `adb shell setprop debug.openbook.gfx hybrid` (also restore, revert, status; eco, ultimate, keep, lock and
# unlock with the lab switch). Add @N to repeat a command.
service vendor.openbook.gfx-adb /vendor/bin/openbook-gfx-mode adb ${debug.openbook.gfx:-none}
    user root
    group root system
    oneshot
    disabled

on property:debug.openbook.gfx=*
    start vendor.openbook.gfx-adb
