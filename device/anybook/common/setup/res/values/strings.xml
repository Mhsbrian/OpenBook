    <!-- 1. Welcome -->
    <string name="hero_hello">Welcome to\nOpenBook.</string>
    <string name="hero_tag">A laptop OS built on open Android. A few steps and it\'s yours.</string>
    <string name="welcome_title">Let\'s set up your laptop</string>
    <string name="welcome_lede">It takes a few minutes, and you won\'t need an account. Here\'s what comes next:</string>
    <string name="welcome_item_region">Your language, keyboard layout and time zone</string>
    <string name="welcome_item_network">Wi-Fi, if you want to connect now</string>
    <string name="welcome_item_account">Your name and a screen lock</string>
    <string name="welcome_item_extras">Optional extras for apps that need Google services</string>
    <string name="welcome_skip_note">Skip setup keeps the current settings and takes you straight to the desktop. You can change everything later in Settings.</string>

    <!-- 2. Language and region -->
    <string name="language_title">Language and region</string>
    <string name="language_lede">Choose the language OpenBook speaks, and your region for dates, numbers, units and the first day of the week.</string>
    <string name="language_label">Language</string>
    <string name="region_label">Region</string>
    <string name="region_search">Search regions</string>

    <!-- 3. Keyboard -->
    <string name="keyboard_title">Keyboard layout</string>
    <string name="keyboard_lede">Pick the layout printed on your keys. It applies to every keyboard connected now.</string>
    <string name="keyboard_layout_label">Layout</string>
    <string name="keyboard_search">Search layouts</string>
    <string name="keyboard_suggested">Suggested</string>
    <string name="keyboard_all">All layouts</string>
    <string name="keyboard_devices_label">Keyboards</string>
    <string name="keyboard_in_use">In use: <xliff:g id="layout">%1$s</xliff:g></string>
    <string name="keyboard_default">Default</string>
    <string name="keyboard_none">No physical keyboard found. You can choose a layout later in Settings › System › Keyboard.</string>
    <string name="keyboard_try">Try it</string>
    <string name="keyboard_try_hint">Type here to check the layout</string>
    <string name="keyboard_keys_note">Your laptop\'s special keys keep their functions with every layout.</string>

    <!-- 4. Internet -->
    <string name="network_title">Connect to the internet</string>
    <string name="network_lede">Being online lets OpenBook set the clock and get apps and updates. You can skip this and connect later.</string>
    <string name="network_online">You\'re online</string>
    <string name="network_online_body">Connected over <xliff:g id="link">%1$s</xliff:g>. You can choose another network if you like.</string>
    <string name="network_offline">Not connected</string>
    <string name="network_offline_body">Choose a Wi-Fi network, or plug in a network cable.</string>
    <string name="network_choose">Choose a network</string>
    <string name="network_note">OpenBook doesn\'t need an account or the internet to work.</string>
    <string name="link_wifi">Wi-Fi</string>
    <string name="link_ethernet">Ethernet</string>
    <string name="link_other">a network</string>
    <string name="link_none">Not connected</string>

    <!-- 5. Date and time -->
    <string name="time_title">Date and time</string>
    <string name="time_lede">Check your time zone. When OpenBook is online it sets the clock by itself.</string>
    <string name="time_auto">Set time automatically</string>
    <string name="time_auto_detail">Uses network time while you\'re online</string>
    <string name="time_zone_auto">Set time zone automatically</string>
    <string name="time_24h">Use 24-hour format</string>
    <string name="time_24h_detail">13:00 instead of 1:00 PM</string>
    <string name="time_manual">Set date and time by hand</string>
    <string name="time_zone_label">Time zone</string>
    <string name="time_zone_region">In <xliff:g id="region">%1$s</xliff:g></string>
    <string name="time_zone_all">All time zones</string>
    <string name="time_zone_search">Search cities and time zones</string>
    <string name="time_zone_detected">The time zone is set automatically. Turn that off to choose one.</string>

    <!-- 6. About you -->
    <string name="account_title">About you</string>
    <string name="account_lede">Your name appears on the lock screen and in Quick Settings. A screen lock keeps your files private if someone else opens the lid.</string>
    <string name="account_name_label">Your name</string>
    <string name="account_name_hint">Name</string>
    <string name="account_name_note">It stays on this laptop. No account is created.</string>
    <string name="lock_label">Screen lock</string>
    <string name="lock_pin">PIN</string>
    <string name="lock_password">Password</string>
    <string name="lock_none">No screen lock</string>
    <string name="lock_pin_hint">PIN (at least 4 digits)</string>
    <string name="lock_password_hint">Password (at least 4 characters)</string>
    <string name="lock_again_hint">Enter it again</string>
    <string name="lock_none_note">Anyone who opens your laptop can use it and see your files. You can add a lock later in Settings › Security.</string>
    <string name="lock_unsupported">This device has no secure lock screen.</string>
    <string name="lock_error_pin">Use at least 4 digits, numbers only.</string>
    <string name="lock_error_password">Use at least 4 characters.</string>
    <string name="lock_error_mismatch">The two entries don\'t match.</string>
    <string name="lock_error_failed">The screen lock couldn\'t be set. Try again, or set it later in Settings › Security.</string>
    <string name="lock_set">Screen lock set: <xliff:g id="kind">%1$s</xliff:g></string>

    <!-- 7. This device (the orange-state notice, docs/installer.md §2) -->
    <string name="notice_title">OpenBook isn\'t a Google-certified device</string>
    <string name="notice_lede">OpenBook is built from open-source Android. It doesn\'t come from Google, and Google hasn\'t tested or certified it. Certified Android devices show a warning about this at every start; OpenBook tells you here instead.</string>
    <string name="notice_boot_title">Verified boot is in the orange state</string>
    <string name="notice_boot_body">This laptop starts OpenBook in Android\'s unlocked state, because OpenBook isn\'t signed with a key the laptop trusts. OpenBook still checks its own system files every time it starts.</string>
    <string name="notice_boot_state">Verified boot state: <xliff:g id="state">%1$s</xliff:g></string>
    <string name="notice_apps_title">Some apps may not work</string>
    <string name="notice_apps_body">Apps that require a certified device or Play Integrity, such as some banking, payment and streaming apps, may refuse to run.</string>
    <string name="notice_google_title">No Google apps included</string>
    <string name="notice_google_body">OpenBook doesn\'t include Google Play, Google apps or Google Play services, and doesn\'t download them.</string>

    <!-- 8. Extras -->
    <string name="extras_title">Optional extras</string>
    <string name="extras_lede">OpenBook works without Google. If some of your apps need Google services, these are your options.</string>
    <string name="microg_title">Google services compatibility (microG)</string>
    <string name="microg_body">microG is an open-source stand-in for Google Play services. Some apps that need Google services, for push messages or maps, work with it. It isn\'t Google software, and apps that check Play Integrity still won\'t work.</string>
    <string name="microg_installed">Installed, version <xliff:g id="version">%1$s</xliff:g></string>
    <string name="microg_not_installed">Not installed</string>
    <string name="microg_how">The OpenBook installer offers it as an add-on, off unless you choose it. It installs on the first start, as apps you can uninstall.</string>
    <string name="microg_open">Open microG settings</string>
    <string name="gapps_title">Google apps you provide</string>
    <string name="gapps_body">OpenBook never downloads Google apps or the Play Store. If you are licensed to use a Google apps package for Android 17 on x86_64, the "Google apps" guide in the OpenBook documentation explains what works and what doesn\'t.</string>
    <string name="gapps_installed">Google apps are installed</string>
    <string name="gapps_register">Google asks owners of uncertified devices to register them at google.com/android/uncertified, with the ID below.</string>
    <string name="gapps_id">Google Services Framework ID: <xliff:g id="id">%1$s</xliff:g></string>
    <string name="extras_note">Nothing here is needed to use OpenBook.</string>

