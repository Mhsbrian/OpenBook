<resources>
    <!-- Compose draws everything; the window only needs the surface color (light/dark follow the system).
         The same window theme as the installer (Theme.OpenBookInstaller). -->
    <style name="Theme.OpenBookSetup" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
