  Privileged permissions of OpenBookSetup (system_ext priv-app, platform certificate). Only permissions with the
  "privileged" protection flag are listed; SET_KEYBOARD_LAYOUT, WRITE_SETTINGS and ACCESS_KEYGUARD_SECURE_STORAGE come
  from the platform signature, ACCESS_NETWORK_STATE is normal.
-->
<permissions>
    <privapp-permissions package="org.openbook.setup">
        <permission name="android.permission.CHANGE_CONFIGURATION" />
        <permission name="android.permission.MANAGE_TIME_AND_ZONE_DETECTION" />
        <permission name="android.permission.MANAGE_USERS" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
    </privapp-permissions>
</permissions>
