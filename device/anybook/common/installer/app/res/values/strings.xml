    <string name="gapps_multi_abi">Some apps also carry code for other processor types. This system only runs their x86_64 code.</string>
    <string name="gapps_warning_title">Before you continue</string>
    <string name="gapps_warning_certified">This computer won\'t be Play Protect certified. To use Google Play, register its Google Services Framework (GSF) Android ID at google.com/android/uncertified after setup. OpenBook shows the ID during setup and in Settings › About.</string>
    <string name="gapps_warning_integrity">OpenBook can\'t pass Play Integrity\'s device checks. Google Wallet tap to pay, Netflix from Google Play and many banking apps may not work.</string>
    <string name="gapps_warning_system">The apps go into the system\'s read-only product partition, which dm-verity checks on every start. To remove them, install OpenBook again without them.</string>
    <string name="gapps_warning_no_bypass">OpenBook doesn\'t work around these checks.</string>
    <string name="gapps_confirm">I understand. Install this package.</string>
    <string name="rail_hint_gapps">Google apps package</string>
    <string name="confirm_gapps">Also installs <xliff:g id="name">%1$s</xliff:g>: <xliff:g id="apps">%2$d</xliff:g> apps, <xliff:g id="size">%3$s</xliff:g>, into the new system.</string>
    <string name="plan_warning_gapps_uncertified">With the Google apps package, this computer won\'t be Play Protect certified, and apps that need Play Integrity may not work.</string>
    <string name="plan_warning_privapp_not_enforced">This system doesn\'t limit privileged apps to an allowlist: the package\'s privileged apps get every privileged permission they ask for.</string>
