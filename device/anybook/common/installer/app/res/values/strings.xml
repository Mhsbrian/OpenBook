    <string name="gapps_reg_copy">Copy the ID</string>
    <string name="gapps_reg_steps">1. On any device, open google.com/android/uncertified and sign in with your Google account.\n2. Enter the GSF Android ID shown here and submit it.\n3. After a few minutes, restart this computer. Google Play then treats it as registered.</string>
