    <string name="gapps_reg_window_title">Google apps registration</string>
    <string name="gapps_reg_settings_title">Google apps registration</string>
    <string name="gapps_reg_settings_summary">GSF Android ID and how to register this computer</string>
    <string name="gapps_reg_title">Register this computer with Google</string>
    <string name="gapps_reg_body">You installed <xliff:g id="name">%1$s</xliff:g>. Google Play only works on devices Google knows about, so register this computer. It takes a minute.</string>
    <string name="gapps_reg_id_label">GSF Android ID</string>
