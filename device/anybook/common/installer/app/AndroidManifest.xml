  OpenBookInstaller (ANAL-191). Privileged permissions are listed in privapp-permissions-openbook-installer.xml.
  Talking to openbook-installd needs no Android permission: SELinux lets platform_app connect to its socket.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.openbook.installer">

    <!-- Apply the chosen language system-wide (LocalePicker). -->
    <uses-permission android:name="android.permission.CHANGE_CONFIGURATION" />
    <!-- Accessibility toggles: font scale (System), high-contrast text (Secure), animation scales (Global). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- "Restart now". -->
    <uses-permission android:name="android.permission.REBOOT" />
    <!-- Open the wizard at boot in the live session, and skip its insecure keyguard. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.ACCESS_KEYGUARD_SECURE_STORAGE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.OpenBookInstaller"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:resizeableActivity="true">

        <!-- The wizard. Not exported: the launcher reaches it through the InstallLauncher alias below. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/window_title"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|density|uiMode|locale|layoutDirection|fontScale|fontWeightAdjustment|colorMode|touchscreen|mcc|mnc|grammaticalGender">
            <layout
                android:defaultWidth="1200dp"
                android:defaultHeight="780dp"
                android:gravity="center"
                android:minWidth="840dp"
                android:minHeight="560dp" />
        </activity>

        <!-- "Install OpenBook" in the launcher and taskbar: enabled by BootReceiver in the live session only. -->
        <activity-alias
            android:name=".InstallLauncher"
            android:targetActivity=".MainActivity"
            android:label="@string/window_title"
            android:icon="@mipmap/ic_launcher"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
