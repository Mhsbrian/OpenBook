// The built-in sound card of an OpenBook PC for AOSP's example audio HAL (docs/g14-audio-net.md).

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "openbook_audio_defaults",
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

// Boot: pick the codec's PCM, publish it for the HAL, set its mixer up. Also `list` and a direct ALSA `test`.
cc_binary {
    name: "openbook-audio-setup",
    defaults: ["openbook_audio_defaults"],
    srcs: [
        "alsa_cards.cpp",
        "openbook-audio-setup.cpp",
    ],
    shared_libs: [
        "libcutils",
        "libtinyalsa",
    ],
    vendor: true,
}

// The loopback test through Android (AAudio, AudioFlinger, the HAL). userdebug only (openbook-hwtest).
cc_binary {
    name: "openbook-audio-test",
    defaults: ["openbook_audio_defaults"],
    srcs: [
        "alsa_cards.cpp",
        "openbook-audio-test.cpp",
    ],
    shared_libs: ["libaaudio"],
    system_ext_specific: true,
}

// atest openbook_audio_logic_test, or out/host/linux-x86/nativetest64/openbook_audio_logic_test/openbook_audio_logic_test
cc_test_host {
    name: "openbook_audio_logic_test",
    defaults: ["openbook_audio_defaults"],
    srcs: [
        "alsa_cards.cpp",
        "audio_test.cpp",
    ],
    test_options: {
        unit_test: true,
    },
}

// Explicit test target only. Never install a synthetic Bluetooth stack on a laptop.
cc_test {
    name: "openbook-hfp-hal-test",
    vendor: true,
    gtest: false,
    defaults: [
        "latest_android_hardware_audio_common_ndk_static",
        "latest_android_hardware_audio_core_ndk_static",
        "latest_android_hardware_audio_core_sounddose_ndk_static",
        "latest_android_hardware_audio_effect_ndk_static",
        "latest_android_hardware_bluetooth_audio_ndk_static",
        "latest_android_media_audio_common_types_ndk_static",
        "latest_android_media_audio_eraser_types_ndk_static",
    ],
    srcs: ["hfp-hal-test.cpp"],
    static_libs: ["android.hardware.common-V2-ndk", "android.hardware.common.fmq-V1-ndk"],
    shared_libs: ["libbinder_ndk", "libbase"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
