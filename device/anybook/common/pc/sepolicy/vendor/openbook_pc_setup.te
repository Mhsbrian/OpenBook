# /vendor/bin/openbook-pc-setup (bin/openbook-pc-setup.sh), run as root by init at boot.
type openbook_pc_setup, domain;
type openbook_pc_setup_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(openbook_pc_setup)

allow openbook_pc_setup vendor_shell_exec:file rx_file_perms;
allow openbook_pc_setup vendor_toolbox_exec:file rx_file_perms;
allow openbook_pc_setup kmsg_device:chr_file w_file_perms;
userdebug_or_eng(`allow openbook_pc_setup kmsg_debug_device:chr_file { getattr ioctl w_file_perms };')

# dgpu-pm: read PCI devices; unbind snd_hda_intel from the dGPU's HDMI-audio function; write power/control and
# snd_hda_intel's power_save.
r_dir_file(openbook_pc_setup, sysfs)
allow openbook_pc_setup sysfs:file w_file_perms;
# It reads every PCI function's vendor ID, the iGPU's included (sysfs_gpu, file_contexts).
r_dir_file(openbook_pc_setup, sysfs_gpu)

# perms: hand cpufreq's energy_performance_preference to the power HAL.
r_dir_file(openbook_pc_setup, sysfs_devices_system_cpu)
allow openbook_pc_setup sysfs_devices_system_cpu:file setattr;
allow openbook_pc_setup self:capability { chown fowner };

# kvm (ANAL-218): read whether KVM registered its misc device (sysfs, above), and say so in vendor.openbook.kvm for
# init.openbook.rc.
set_prop(openbook_pc_setup, vendor_openbook_prop)
