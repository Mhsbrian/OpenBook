# Wi-Fi, Bluetooth and audio on an OpenBook PC (ANAL-179, docs/g14-audio-net.md). AOSP's wpa_supplicant runs in
# AOSP's hal_wifi_supplicant_default domain, and the Wi-Fi module's nl80211 code in system_server.

# Wi-Fi: cfg80211 checks regulatory.db's signature against a keyring it creates when it loads. modprobe loads it
# (vendor_dlkm, early-init), so the keyring carries vendor_modprobe's label, and the kernel worker that reads the
# database may not search it: "loaded regulatory.db is malformed or signature is missing/invalid" and the world
# domain only (ANAL-179 QEMU run b: kernel -> vendor_modprobe key { search } denied).
allow kernel vendor_modprobe:key search;

# Bluetooth: AOSP's AIDL HAL (android.hardware.bluetooth-service.default) finds the controller through the
# kernel's management channel, unblocks it with rfkill and opens it as an HCI user channel (btusb + btmtk own
# the hardware and its firmware).
allow hal_bluetooth_default openbook_rfkill_device:chr_file rw_file_perms;
allow hal_bluetooth_default self:bluetooth_socket { getattr getopt setopt };

# Audio: the example HAL's primary module reads which ALSA card is the built-in codec.
get_prop(hal_audio_default, vendor_openbook_audio_prop)
# Its streams' fast message queues are memfds the HAL creates and audioserver maps. On the android17-6.18 kernel a
# memfd carries its creator's tmpfs type, and without a type of its own the HAL may not even write its own queues:
# every stream open failed, so AudioPolicy had no output and every AudioTrack got NO_INIT (ANAL-179 QEMU run b; the
# "audio HAL writing a tmpfs memfd" denials ANAL-199 saw while nothing played yet).
type hal_audio_default_tmpfs, file_type;
tmpfs_domain(hal_audio_default)
allow audioserver hal_audio_default_tmpfs:file { getattr map read write };
# The HAL process also hosts the Bluetooth audio provider, which hands the Bluetooth stack the A2DP data queue, a memfd
# of the same type. Without this the transfer fails, StartSession gets FAILED_TRANSACTION and com.android.bluetooth
# aborts as soon as an audio device connects. On the G14 under enforcing (anal176s, 2026-10-17 13:43Z) it aborted twice;
# the permissive save-logs boot reached A2DP Connected with read, write and map granted (ANAL-176).
allow bluetooth hal_audio_default_tmpfs:file { getattr map read write };
# AudioFlinger's track control blocks are memfds too, and carry audioserver_tmpfs: AOSP 17 does not turn on the
# memfd_class capability that would make them memfd_file objects. Apps run with MLS categories (s0:cX,cY) and may only
# write s0 objects whose type is an mlstrustedobject, so apps targeting SDK 28+ could not write theirs, although
# AOSP's private/app.te allows appdomain to. createTrack then fails with "Could not get control block": the WebView
# browser had no sound on the G14 under enforcing (anal176s, 13:45Z, ANAL-176). AOSP marks system_server_tmpfs the same
# way, and graphics-amd does it for the allocator's memfds.
typeattribute audioserver_tmpfs mlstrustedobject;

# openbook-audio-setup (init, boot): reads /proc/asound and the HDA driver's bound devices, publishes the card,
# sets the codec's mixer.
type openbook_audio_setup, domain;
type openbook_audio_setup_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(openbook_audio_setup)
allow openbook_audio_setup kmsg_device:chr_file w_file_perms;
userdebug_or_eng(`allow openbook_audio_setup kmsg_debug_device:chr_file { getattr ioctl w_file_perms };')
r_dir_file(openbook_audio_setup, proc_asound)
allow openbook_audio_setup audio_device:dir r_dir_perms;
allow openbook_audio_setup audio_device:chr_file rw_file_perms;
allow openbook_audio_setup sysfs:dir r_dir_perms;
set_prop(openbook_audio_setup, vendor_openbook_audio_prop)
