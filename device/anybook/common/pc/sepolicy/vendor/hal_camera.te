# The G14's android17-6.18 kernel labels camera FMQ memfds as tmpfs files.
# Without a private type, ftruncate(MessageQueue) is denied and the external
# camera session fails before streaming (ANAL-228, camera23 hardware capture).
# Keep queue access between the camera HAL and its framework client; do not
# grant writes to generic tmpfs or expose queues directly to applications.
type hal_camera_default_tmpfs, file_type;
tmpfs_domain(hal_camera_default)
allow cameraserver hal_camera_default_tmpfs:file { getattr map read write };

# Camera2 has a second FMQ boundary: cameraserver sends its result queue to
# the permission-checked app client. Upstream grants cameraserver:memfd_file;
# the G14 kernel instead labels that same buffer cameraserver_tmpfs:file.
# App MLS categories differ from the service's s0, so trust only this shared
# object type (as for audioserver_tmpfs), never the app as a trusted subject.
# Isolated processes still have no queue access, and apps cannot map HAL queues.
allow { appdomain -isolated_app_all } cameraserver_tmpfs:file { getattr map read write };
typeattribute cameraserver_tmpfs mlstrustedobject;

# The external provider imports graphics buffers through libui/mapper. Without
# allocator discovery, the API1 preview reaches UVC STREAMON and then aborts at
# "gralloc-mapper is missing". Use the standard client attribute for discovery,
# Binder IPC and mapper loading, rather than a one-off service-manager grant.
hal_client_domain(hal_camera_default, hal_graphics_allocator)
