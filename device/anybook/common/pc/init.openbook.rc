#
# OpenBook on a PC (device/anybook/common/pc). init.rc imports this as /vendor/etc/init/hw/init.${ro.hardware}.rc,
# so its early-init actions run before those of /vendor/etc/init/*.rc (anybook_gpu_probe among them).

on early-init
    # Second-stage kernel modules from vendor_dlkm, in ANAL-198's order (ACPI and platform, input, ASUS, GPU, NPU,
    # card reader, HDA, ACP/SOF, Wi-Fi and Bluetooth), before any HAL starts. Their GKI dependencies load from
    # /system/lib/modules through vendor_dlkm's modules.dep. -b applies modules.blocklist, which keeps the
    # VM-only virtio modules out on real hardware.
    exec_start vendor.openbook.dlkm
    # A dGPU that no driver binds: let it reach D3cold (docs/nvidia.md). No-op without an NVIDIA function.
    exec_start vendor.openbook.dgpu-pm
    # Display density: the device's default, unless the loader passes androidboot.lcd_density.
    setprop vendor.openbook.lcd_density ${ro.vendor.openbook.lcd_density:-160}

on early-init && property:ro.boot.lcd_density=*
    setprop vendor.openbook.lcd_density ${ro.boot.lcd_density}

on early-init
    setprop ro.sf.lcd_density ${vendor.openbook.lcd_density}

on init
    # amd-pstate EPP and the backlight belong to the power and lights HALs.
    exec_start vendor.openbook.sysfs-perms

on fs
    # /metadata (formatted here on first boot) and the rest of fstab.openbook that needs no fsck.
    mount_all --early

on late-fs
    # /data: f2fs with metadata encryption, formatted on first boot.
    mount_all --late

# Virtual machines: anybook_gpu_probe found virtio-gpu (unbound: its module is blocklisted for laptops). Load it
# and render in software, SwiftShader Vulkan under ANGLE, with minigbm and drm_hwcomposer on the virtio-gpu KMS
# device. This is what lets the PC image boot in QEMU, which has no AMD GPU. Real AMD GPUs take the
# vendor-anybook-gpu-amdgpu event in init.anybook.graphics-amd.rc instead. Both events come from the probe at
# early-init, so this runs before any HAL or SurfaceFlinger starts.
on vendor-anybook-gpu-virtio
    exec_start vendor.openbook.virtio-modules
    setprop ro.hardware.vulkan ${ro.boot.hardware.vulkan:-pastel}
    setprop ro.hardware.egl ${ro.boot.hardware.egl:-angle}
    setprop ro.hardware.gralloc ${ro.boot.hardware.gralloc:-minigbm}
    setprop ro.hardware.hwcomposer ${ro.boot.hardware.hwcomposer:-drm}
    setprop ro.opengles.version ${ro.boot.opengles.version:-196609}

on post-fs-data
    mkdir /data/vendor/weaver 0700 system system

service vendor.openbook.dlkm /vendor/bin/modprobe -b -s -d /vendor/lib/modules --all=/vendor/lib/modules/modules.load
    user root
    group root system
    seclabel u:r:vendor_modprobe:s0
    oneshot
    disabled
    stdio_to_kmsg

# virtio_pci (the transport) is a GKI module in system_dlkm; laptops never load it.
service vendor.openbook.virtio-modules /vendor/bin/modprobe -s -d /system/lib/modules -d /vendor/lib/modules -a virtio_pci virtio-gpu virtio_input
    user root
    group root system
    seclabel u:r:vendor_modprobe:s0
    oneshot
    disabled
    stdio_to_kmsg

service vendor.openbook.dgpu-pm /vendor/bin/openbook-pc-setup dgpu-pm
    user root
    group root system
    oneshot
    disabled
    stdio_to_kmsg

service vendor.openbook.sysfs-perms /vendor/bin/openbook-pc-setup perms
    user root
    group root system
    oneshot
    disabled
    stdio_to_kmsg
