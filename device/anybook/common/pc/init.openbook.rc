#
# OpenBook on a PC (device/anybook/common/pc). init.rc imports this as /vendor/etc/init/hw/init.${ro.hardware}.rc,
# so its early-init actions run before those of /vendor/etc/init/*.rc (anybook_gpu_probe among them).

on early-init
    # Second-stage kernel modules from vendor_dlkm, in ANAL-198's order (ACPI and platform, input, ASUS, GPU, NPU,
    # card reader, HDA, ACP/SOF, Wi-Fi and Bluetooth), before any HAL starts. Their GKI dependencies load from
    # /system/lib/modules through vendor_dlkm's modules.dep. -b applies modules.blocklist, which keeps the
    # VM-only virtio modules out on real hardware.
    exec_start vendor.openbook.dlkm
    # A dGPU that no driver binds: let it reach D3cold (docs/nvidia.md). No-op without an NVIDIA function.
    exec_start vendor.openbook.dgpu-pm
    # Display density: the device's default, unless the loader passes androidboot.lcd_density.
    setprop vendor.openbook.lcd_density ${ro.vendor.openbook.lcd_density:-160}

on early-init && property:ro.boot.lcd_density=*
    setprop vendor.openbook.lcd_density ${ro.boot.lcd_density}

on early-init
    setprop ro.sf.lcd_density ${vendor.openbook.lcd_density}

on init
    # amd-pstate EPP and the backlight belong to the power and lights HALs.
    exec_start vendor.openbook.sysfs-perms

on fs
    # /metadata (formatted here on first boot) and the rest of fstab.openbook that needs no fsck.
    mount_all --early

on post-fs
    # The built-in sound card for the audio HAL (started later, with class hal): which ALSA card the codec is,
    # and its mixer's switches and volumes (audio/openbook-audio-setup.cpp).
    exec_start vendor.openbook.audio-setup

on late-fs
    # /data: f2fs with metadata encryption, formatted on first boot.
    mount_all --late

# Virtual machines: anybook_gpu_probe found virtio-gpu (unbound: its module is blocklisted for laptops). Load it
# and render in software, SwiftShader Vulkan under ANGLE, with minigbm and drm_hwcomposer on the virtio-gpu KMS
# device. This is what lets the PC image boot in QEMU, which has no AMD GPU. Real AMD GPUs take the
# vendor-anybook-gpu-amdgpu event in init.anybook.graphics-amd.rc instead. Both events come from the probe at
# early-init, so this runs before any HAL or SurfaceFlinger starts.
on vendor-anybook-gpu-virtio
    exec_start vendor.openbook.virtio-modules
    setprop ro.hardware.vulkan ${ro.boot.hardware.vulkan:-pastel}
    setprop ro.hardware.egl ${ro.boot.hardware.egl:-angle}
    setprop ro.hardware.gralloc ${ro.boot.hardware.gralloc:-minigbm}
    setprop ro.hardware.hwcomposer ${ro.boot.hardware.hwcomposer:-drm}
    setprop ro.opengles.version ${ro.boot.opengles.version:-196609}

on post-fs-data
    mkdir /data/vendor/weaver 0700 system system
    # wpa_supplicant's configuration and control sockets (wifi/wifi.mk).
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

# The dGPU's power state, logged as root to logcat (ANAL-238): a user build's adb shell cannot read PCI power state
# or the kernel log, and dgpu-pm's own early-init lines reach neither there. Read with
# `adb logcat -d -s openbook-pc-setup`. Again on demand: `adb shell setprop debug.openbook.dgpu_report <new value>`.
on property:sys.boot_completed=1
    start vendor.openbook.dgpu-report

on property:debug.openbook.dgpu_report=*
    start vendor.openbook.dgpu-report

# Volatile dGPU power hold for battery comparisons (ANAL-238): `setprop debug.openbook.dgpu_pm on` keeps the dGPU in
# D0, `auto` lets it reach D3cold again. A reboot returns to dgpu-pm's default.
on property:debug.openbook.dgpu_pm=*
    start vendor.openbook.dgpu-ctl

# The G14 lab helper (ANAL-257, docs/googlebook-s0i3.md): allow-listed experiments over adb. Any value of
# debug.openbook.lab runs `openbook-pc-setup lab VALUE` as root; it refuses everything but enable/disable until
# persist.vendor.openbook.lab=1, which only it can set. Module loads and unloads go through
# vendor.openbook.lab.mod, which only the helper can set, to the fixed commands below. One request at a time: a
# request made while the helper still runs is ignored. Results: `adb logcat -d -s openbook-pc-setup`.
on property:debug.openbook.lab=*
    start vendor.openbook.lab

on property:vendor.openbook.lab.mod=nouveau-load
    start vendor.openbook.lab-nouveau-load

on property:vendor.openbook.lab.mod=nouveau-unload
    start vendor.openbook.lab-nouveau-unload

on property:vendor.openbook.lab.mod=diag-snapshot
    start vendor.openbook.lab-diag-snapshot

on property:vendor.openbook.lab.mod=diag-ptm-off
    start vendor.openbook.lab-diag-ptm-off

on property:vendor.openbook.lab.mod=diag-unload
    start vendor.openbook.lab-diag-unload

service vendor.openbook.dlkm /vendor/bin/modprobe -b -s -d /vendor/lib/modules --all=/vendor/lib/modules/modules.load
    user root
    group root system
    seclabel u:r:vendor_modprobe:s0
    oneshot
    disabled
    stdio_to_kmsg

# virtio_pci (the transport) is a GKI module in system_dlkm; laptops never load it.
service vendor.openbook.virtio-modules /vendor/bin/modprobe -s -d /system/lib/modules -d /vendor/lib/modules -a virtio_pci virtio-gpu virtio_input
    user root
    group root system
    seclabel u:r:vendor_modprobe:s0
    oneshot
    disabled
    stdio_to_kmsg

service vendor.openbook.dgpu-pm /vendor/bin/openbook-pc-setup dgpu-pm
    user root
    group root system
    oneshot
    disabled
    stdio_to_kmsg

# These two run after logd is up and log there (openbook-pc-setup's log()), so they need no kmsg.
service vendor.openbook.dgpu-report /vendor/bin/openbook-pc-setup dgpu-report ${debug.openbook.dgpu_report:-boot}
    user root
    group root system
    oneshot
    disabled

service vendor.openbook.dgpu-ctl /vendor/bin/openbook-pc-setup dgpu-ctl ${debug.openbook.dgpu_pm}
    user root
    group root system
    oneshot
    disabled

service vendor.openbook.lab /vendor/bin/openbook-pc-setup lab ${debug.openbook.lab}
    user root
    group root system
    oneshot
    disabled

# The lab's module commands (ANAL-257), in the boot-time loader's domain. Without -b: nouveau, drm_gpuvm and
# openbook_sleep_diag are on vendor_dlkm's modules.blocklist, which keeps them out of the boot (vendor.openbook.dlkm
# uses -b) but not out of these. modules.options gives nouveau runpm=1 modeset=2. -r also removes the dependencies
# nothing else uses (drm_gpuvm).
service vendor.openbook.lab-nouveau-load /vendor/bin/modprobe -s -d /vendor/lib/modules nouveau
    user root
    group root system
    seclabel u:r:vendor_modprobe:s0
    oneshot
    disabled

service vendor.openbook.lab-nouveau-unload /vendor/bin/modprobe -r -s -d /vendor/lib/modules nouveau
    user root
    group root system
    seclabel u:r:vendor_modprobe:s0
    oneshot
    disabled

service vendor.openbook.lab-diag-snapshot /vendor/bin/modprobe -s -d /vendor/lib/modules openbook_sleep_diag snapshot=2 usb4=1 cycles=8
    user root
    group root system
    seclabel u:r:vendor_modprobe:s0
    oneshot
    disabled

service vendor.openbook.lab-diag-ptm-off /vendor/bin/modprobe -s -d /vendor/lib/modules openbook_sleep_diag ptm_off=1 snapshot=1 usb4=1 cycles=8
    user root
    group root system
    seclabel u:r:vendor_modprobe:s0
    oneshot
    disabled

service vendor.openbook.lab-diag-unload /vendor/bin/modprobe -r -s -d /vendor/lib/modules openbook_sleep_diag
    user root
    group root system
    seclabel u:r:vendor_modprobe:s0
    oneshot
    disabled

service vendor.openbook.audio-setup /vendor/bin/openbook-audio-setup boot
    user root
    group root system audio
    oneshot
    disabled
    stdio_to_kmsg

# ANAL-218: AVF's capability properties, set only when the firmware gives us KVM (openbook-pc-setup kvm). Cuttlefish
# sets them itself; on a PC nothing else does.
on post-fs
    exec_start vendor.openbook.kvm-check

on property:vendor.openbook.kvm=1
    setprop ro.boot.hypervisor.vm.supported 1
    setprop ro.boot.hypervisor.protected_vm.supported 0
    setprop ro.boot.hypervisor.version openbook-kvm

service vendor.openbook.kvm-check /vendor/bin/openbook-pc-setup kvm
    user root
    group root
    oneshot
    disabled
    stdio_to_kmsg

service vendor.openbook.sysfs-perms /vendor/bin/openbook-pc-setup perms
    user root
    group root system
    oneshot
    disabled
    stdio_to_kmsg
