#!/system/bin/sh
# SPDX-License-Identifier: Apache-2.0
# openbook-updater: the on-laptop OpenBook updater engine (ANAL-229): notice and download. The OpenBook
# Update app runs it as a child process; it also runs by hand over adb.
#
# The laptop watches Google's public release listing for its own device and fetches a newer
# Googlebook release by itself, with no host and no assistant involved:
#
#   check     fetch the listing, pick the newest STABLE build for this device, compare it with the
#             running build (ro.build.version.incremental). Exit 0 up to date, 10 update available.
#             The release's kind comes from the two Android build IDs (ro.build.id). A build ID such as
#             CL3B.260622.276.R4 starts with its release train: a year letter (C = 2026), a product
#             letter, the quarter (3) and a variant; then the branch date, the build and an optional
#             respin suffix. A new Android version arrives with a new train, so only the train tells
#             what the laptop may take by itself:
#               monthly    the same train (first three characters): Google's regular update of the
#                          running release
#               quarterly  a later train of the same product: a quarterly release, possibly a new
#                          Android version. Held: OpenBook checks the laptop's adaptations against it
#                          first and delivers it as an OpenBook update
#               unknown    anything else (unparseable, an earlier train or date, another product): held
#             A successful check also writes DIR/release: the newest listed release, kept until the next
#             successful check (the app reads it; DIR/state describes the last run only).
#   download  fetch that release's recovery.zip into DIR/<build>/ (with release.info, the release it is),
#             resuming a partial download, after a free-space check, then verify Google's MD5. Older
#             downloads in DIR are removed after a newer one is verified. Only
#             monthly releases are downloaded. TERM, INT or HUP stops it cleanly at any point: the
#             transfer or checksum ends, and the partial file is kept for the next run to resume.
#   adapt     build the newest verified download for this laptop (phase 3), with openbook-adapt and the
#             running system's OpenBook layer: Google's partitions are reconstructed from the zip and
#             checked against Google's signature, the layer is re-applied (it stops, "held", when Google
#             changed something OpenBook adapts) and the result is rebuilt and signed. Then the update
#             payload for it is written, unsigned: the OpenBook Update app signs it with this laptop's key
#             (`sign`). Keeps DIR/<build>/adapted/ (payload and records); the images live in the payload.
#             DIR/adapt-progress names the current step (reconstruct, check, build, sign, payload).
#   sign      insert the payload signatures the app made (DIR/<build>/adapted/payload/{metadata,payload}.sig).
#   status    print the last recorded state.
#   watch     check FIRST_DELAY seconds after start, then every INTERVAL seconds of wall-clock time. It
#             only notices: downloads are explicit (the OpenBook Update app starts them on unmetered
#             networks). Each check is its own locked run; a failed check is logged, never fatal.
#
# It never touches a partition, the boot loader or settings: it reads the network and the running
# system, and writes only under DIR. Installing is the app's, with the owner's approval
# (docs/googlebook-on-device-updater.md). Runs on the laptop's own tools: mksh, toybox, awk, curl.
# mksh arithmetic is 32-bit, so every byte count is computed and compared in awk.
#
# usage: openbook-updater [--dir DIR] [--listing URL|FILE] check|download|adapt|sign|status|watch
# env:   OPENBOOK_UPDATER_DIR (default /data/local/tmp/openbook-updater), OPENBOOK_UPDATER_LISTING,
#        OPENBOOK_UPDATER_RESERVE_KB (free space kept after a download; default 20 GiB),
#        OPENBOOK_UPDATER_FIRST_DELAY (default 60 s), OPENBOOK_UPDATER_INTERVAL (default 86400 s),
#        OPENBOOK_UPDATER_STEP (watch: sleep step, default 900 s), OPENBOOK_UPDATER_CYCLES (stop after N; tests),
#        OPENBOOK_UPDATER_TEST_BUILD_ID (tests on a device whose own build ID is not a release-train ID, such
#        as an emulator's: classify against this instead; the OpenBook Update app never sets it),
#        OPENBOOK_ADAPT, OPENBOOK_LAYER, OPENBOOK_AVB_KEY, OPENBOOK_OURS_ROOT (tests: the adapter, the layer,
#        the AVB key and the root of OpenBook's files; default the running system's)
# exit:  0 ok/up to date, 10 update available, 2 usage (or adapt/sign not possible here), 3 network,
#        4 checksum mismatch, 5 space, 6 busy, 7 no release listed for this device, 8 held (the release
#        needs OpenBook support), 9 listing refused (an unexpected download location or a malformed
#        checksum), 11 adaptation failed (not held: a fault, recorded), 130 stopped on request

set -u
LISTING=${OPENBOOK_UPDATER_LISTING:-https://dl.google.com/dl/edgedl/device/recovery/production_recovery.json}
DIR=${OPENBOOK_UPDATER_DIR:-/data/local/tmp/openbook-updater}
RESERVE_KB=${OPENBOOK_UPDATER_RESERVE_KB:-20971520}
US=$(printf '\037')   # row field separator: not IFS whitespace, so empty fields survive a read

usage() { awk 'NR > 2 && /^#/ { sub(/^# ?/, ""); print; next } NR > 2 { exit }' "$0"; exit 2; }
# Not named "log": that would hide toybox's `log` command used below (and recurse).
say() {
    # updater.log is kept under 1 MiB: one previous generation is enough for diagnosis.
    if [ -f "$DIR/updater.log" ] && [ "$(stat -c %s "$DIR/updater.log")" -gt 1048576 ]; then
        mv -f "$DIR/updater.log" "$DIR/updater.log.1"
    fi
    printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$DIR/updater.log"
    # On the laptop, also to logcat (readable over adb on a user build).
    if [ -n "${ANDROID_ROOT:-}" ] && command -v log > /dev/null 2>&1; then command log -t openbook-updater "$*"; fi
}
CHECKED=
FINAL=
FINAL_RC=0
fail() {
    code=$1; shift; say "error: $*"
    # Before this run's check, a fresh state; after it, keep its context. DIR/release keeps the last
    # successful check's release either way.
    if [ -n "$CHECKED" ]; then record result "error:$code" detail "$*"; else record_new result "error:$code" detail "$*"; fi
    exit "$code"
}

# Byte counts exceed mksh's 32-bit integers: compare and compute in awk (exact to 2^53).
num_ge() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a + 0 >= b + 0) }'; }
num_gt() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a + 0 > b + 0) }'; }

# key=value files, each replaced atomically so a reader never sees half a record.
# record_new starts a fresh state (a new check); record merges into it (later values win).
write_kv() {
    awk '{ i = index($0, "="); k = substr($0, 1, i - 1); if (!(k in v)) order[++n] = k; v[k] = $0 }
         END { for (j = 1; j <= n; j++) print v[order[j]] }' > "$1.tmp" && mv "$1.tmp" "$1"
}
pairs() { while [ $# -ge 2 ]; do printf '%s=%s\n' "$1" "$2"; shift 2; done; printf 'updated_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"; }
record_new() { pairs "$@" | write_kv "$DIR/state"; }
record() { { [ -f "$DIR/state" ] && cat "$DIR/state"; pairs "$@"; } | write_kv "$DIR/state"; }
write_release() { pairs "$@" | write_kv "$DIR/release"; }

# Allowed transfer protocols for a URL, redirects included: HTTPS from the network, file:// for local media.
proto_for() {
    case $1 in
        https://*) echo "--proto =https --proto-redir =https" ;;
        file://*) echo "--proto =file" ;;
        *) echo "--proto =" ;;  # nothing allowed
    esac
}

# Long work (curl, md5sum) runs in the background and the script waits for it: a trapped TERM interrupts
# `wait` at once (a foreground child would delay the trap until it finished). The child keeps the lock
# descriptor, so while it lives no second run can write the same files.
# usage: child OUTFILE COMMAND... (stdout to OUTFILE, errors to the log). Shell functions share variables:
# its own are prefixed c_ so callers' (out, rc) survive.
CHILD=
IN_CHILD=
child() {
    c_out=$1; shift
    IN_CHILD=1                      # stop() falls back to $! if TERM lands before CHILD is set
    "$@" > "$c_out" 2>> "$DIR/updater.log" &
    CHILD=$!
    wait "$CHILD"; c_rc=$?
    CHILD=; IN_CHILD=
    return $c_rc
}
transfer() { t_out=$1; shift; child "$t_out" curl "$@"; }
# Sets MD5 to FILE's MD5 (empty if it cannot be read).
md5_of() {
    MD5=
    child "$DIR/md5.out" md5sum "$1" && MD5=$(cut -d' ' -f1 "$DIR/md5.out")
    rm -f "$DIR/md5.out"
}
stop() {
    s_pid=$CHILD
    [ -z "$s_pid" ] && [ -n "$IN_CHILD" ] && s_pid=$!
    [ -n "$s_pid" ] && kill "$s_pid" 2>/dev/null && wait "$s_pid" 2>/dev/null
    rm -f "$DIR/md5.out" "$DIR/headers" "$DIR/http_code"
    [ -n "$FINAL" ] && exit "$FINAL_RC"          # the result was already recorded: keep it
    say "stopped on request${STOP_NOTE:+; $STOP_NOTE}"
    if [ -n "$CHECKED" ]; then record result stopped; else record_new result stopped; fi
    exit 130
}

fetch_listing() {
    case $LISTING in
        https://*)
            # shellcheck disable=SC2046  # proto_for returns separate curl options
            transfer /dev/null -fsSL $(proto_for "$LISTING") --retry 2 --max-time 60 -o "$DIR/listing.json" "$LISTING" \
                || fail 3 "cannot fetch the listing $LISTING" ;;
        http://*) fail 2 "refusing a plain-HTTP listing: $LISTING" ;;
        *)  local_listing=${LISTING#file://}
            [ -f "$local_listing" ] || fail 2 "no listing file $local_listing"
            cp "$local_listing" "$DIR/listing.json" || fail 2 "cannot read the listing file $local_listing" ;;
    esac
}

# Rows "number<US>buildidentifier<US>channel<US>date<US>url<US>md5" for one device, from Google's
# listing (a JSON array of flat objects). One record per object (RS="}"): linear in the listing's size.
# JSON may escape "/" as "\/" (some serializers do): that is undone. A value with any other escape or
# a control character is dropped, so a URL or checksum is never guessed and nothing forges a row.
# Portable awk (one-true-awk on the laptop): no gensub, no \s.
rows_for() {
    awk -v want="$1" -v us="$US" 'BEGIN { RS = "}" }
        function field(obj, key,    re, v) {
            re = "\"" key "\"[ \t\r\n]*:[ \t\r\n]*(\"[^\"]*\"|-?[0-9.]+)"
            if (!match(obj, re)) return ""
            v = substr(obj, RSTART, RLENGTH); sub(/^"[^"]*"[ \t\r\n]*:[ \t\r\n]*/, "", v); gsub(/"/, "", v)
            gsub(/\\\//, "/", v)
            return (index(v, "\\") || v ~ /[\001-\037\177]/) ? "" : v
        }
        {
            i = 0; while ((j = index(substr($0, i + 1), "{")) > 0) i += j   # last "{" of this record
            if (!i) next
            obj = substr($0, i + 1)
            if (field(obj, "device") != want) next
            id = field(obj, "buildidentifier"); n = id; sub(/_.*/, "", n)
            if (n !~ /^[0-9]+$/) next
            print n us id us field(obj, "channel") us field(obj, "dateupdated") us field(obj, "url") us field(obj, "md5")
        }' "$DIR/listing.json"
}

# release_kind RUNNING_ID LATEST_ID: see the header. The train is the year letter, the product letter
# and the quarter digit; the variant letter and the branch date follow.
release_kind() {
    awk -v a="$1" -v b="$2" '
        function ok(s) { return s ~ /^[A-Z][A-Z][0-9][A-Z0-9]\.[0-9][0-9][0-9][0-9][0-9][0-9]\.[0-9]+(\.[A-Z0-9]+)?$/ }
        BEGIN {
            if (!ok(a) || !ok(b)) { print "unknown"; exit }
            split(a, x, "."); split(b, y, ".")
            if (substr(x[1], 1, 3) == substr(y[1], 1, 3)) { print (y[2] + 0 >= x[2] + 0) ? "monthly" : "unknown"; exit }
            if (substr(x[1], 2, 1) != substr(y[1], 2, 1)) { print "unknown"; exit }   # another product
            ta = substr(x[1], 1, 1) substr(x[1], 3, 1); tb = substr(y[1], 1, 1) substr(y[1], 3, 1)
            print (tb > ta) ? "quarterly" : "unknown"
        }'
}

cmd_check() {
    device=$(getprop ro.product.device)
    running=$(getprop ro.build.version.incremental)
    running_id=${OPENBOOK_UPDATER_TEST_BUILD_ID:-$(getprop ro.build.id)}
    [ -n "$device" ] && [ -n "$running" ] || fail 2 "cannot read this laptop's device or build"
    case $running in *[!0-9]*) fail 2 "the running build number '$running' is not numeric" ;; esac
    fetch_listing
    best=$(rows_for "$device" | awk -F"$US" '$3 == "STABLE"' | sort -t "$US" -k1,1n | tail -1)
    [ -n "$best" ] || fail 7 "the listing has no STABLE release for $device"
    # Split without a here-document: mksh writes those to TMPDIR, outside the service's own directory.
    oldifs=$IFS; IFS=$US; set -f
    # shellcheck disable=SC2086  # deliberate split on IFS=$US; globbing is off (set -f)
    set -- $best
    set +f; IFS=$oldifs
    number=$1; id=${2:-}; channel=${3:-}; date=${4:-}; url=${5:-}; md5=${6:-}
    # Google's releases come from dl.google.com over HTTPS. file:// is accepted only from a local
    # listing (tests and offline media), never from a listing fetched over the network.
    case $url in
        https://dl.google.com/*) ;;
        file://*) case $LISTING in https://*) fail 9 "a network listing named a local file: $url" ;; esac ;;
        *) fail 9 "unexpected download location $url" ;;
    esac
    printf '%s' "$md5" | grep -qE '^[0-9a-f]{32}$' || fail 9 "the listing's MD5 for $id is malformed"
    latest_id=${id#*_}; [ "$latest_id" != "$id" ] || latest_id=
    kind=$(release_kind "$running_id" "$latest_id")
    prune_obsolete "$running"
    if num_gt "$number" "$running"; then
        write_release number "$number" latest "$id" latest_id "$latest_id" latest_date "$date" kind "$kind" \
            url "$url" md5 "$md5" device "$device" running "$running" running_id "$running_id"
        record_new result update-available device "$device" running "$running" running_id "$running_id" \
            latest "$id" latest_id "$latest_id" latest_date "$date" kind "$kind" url "$url" md5 "$md5"
        CHECKED=1
        [ "$CMD" = check ] && FINAL=1 FINAL_RC=10
        say "update available ($kind): $device runs $running ($running_id); Google lists $id ($date, $channel)"
        return 10
    fi
    write_release number "$number" latest "$id" latest_id "$latest_id" latest_date "$date" \
        device "$device" running "$running" running_id "$running_id"
    record_new result up-to-date device "$device" running "$running" running_id "$running_id" \
        latest "$id" latest_id "$latest_id" latest_date "$date"
    CHECKED=1
    [ "$CMD" = check ] && FINAL=1 FINAL_RC=0
    say "up to date: $device runs $running; newest listed is $id ($date)"
    return 0
}

# Downloads live in all-digit directories DIR/<build>/ holding only the updater's own files.
remove_download() {
    rm -rf "$1/adapted" "$1/adapt.tmp" "$1/adapt-held"
    rm -f "$1/recovery.zip" "$1/recovery.zip.part" "$1/recovery.zip.md5" "$1/release.info"
    rmdir "$1" 2>/dev/null && say "removed the download ${1##*/} ($2)"
}
# Builds at or below the running one are installed or superseded: drop them.
prune_obsolete() {
    for d in "$DIR"/[0-9]*; do
        [ -d "$d" ] || continue
        case ${d##*/} in *[!0-9]*) continue ;; esac
        num_gt "${d##*/}" "$1" || remove_download "$d" "not newer than the running build"
    done
}
# After a verified download, the other pending downloads are superseded.
prune_except() {
    for d in "$DIR"/[0-9]*; do
        [ -d "$d" ] && [ "$d" != "$1" ] || continue
        case ${d##*/} in *[!0-9]*) continue ;; esac
        remove_download "$d" "superseded by ${1##*/}"
    done
}

cmd_download() {
    cmd_check; rc=$?
    [ $rc = 10 ] || { FINAL=1 FINAL_RC=0; say "nothing to download"; return 0; }
    case $kind in
        monthly) ;;
        *)  FINAL=1 FINAL_RC=8                   # first: a stop from here on keeps the check's record
            record result held
            say "not downloading $id: a $kind release needs OpenBook support for this laptop first"
            return 8 ;;
    esac
    out="$DIR/$number"; mkdir -p "$out" || fail 2 "cannot create $out"
    # Which release this download is, for the app: Google's listing names one build per device and may
    # move on while a verified download waits.
    pairs number "$number" latest "$id" latest_id "$latest_id" latest_date "$date" kind "$kind" | write_kv "$out/release.info"
    # A finished download is re-hashed before it is reported verified again, marker or not: the marker
    # alone could be stale or planted, and a stop between the rename and the marker leaves none.
    if [ -f "$out/recovery.zip" ]; then
        STOP_NOTE="the downloaded file of $id is kept and verified on the next run"
        record result verifying
        md5_of "$out/recovery.zip"
        if [ "$MD5" = "$md5" ]; then
            printf '%s\n' "$md5" > "$out/recovery.zip.md5" || fail 2 "cannot record the verification of $id"
            prune_except "$out"
            record result downloaded verified "$id" path "$out/recovery.zip" md5 "$md5"
            FINAL=1 FINAL_RC=0
            say "already downloaded and verified: $out/recovery.zip"; return 0
        fi
        say "the earlier download of $id does not match Google's MD5; downloading it again"
        rm -f "$out/recovery.zip" "$out/recovery.zip.md5"
    fi
    proto=$(proto_for "$url")
    # shellcheck disable=SC2086  # $proto holds separate curl options
    transfer "$DIR/headers" -fsSIL $proto --max-time 60 "$url"
    size=$(tr -d '\r' < "$DIR/headers" \
           | awk '/^HTTP\// { n = 0 } tolower($1) == "content-length:" { n = $2 } END { printf "%.0f", n + 0 }')
    rm -f "$DIR/headers"
    part="$out/recovery.zip.part"
    have=0; [ -f "$part" ] && have=$(stat -c %s "$part")
    if num_gt "$size" 0 && num_gt "$have" "$size"; then
        say "discarding a partial download larger than the release ($have > $size bytes)"
        rm -f "$part"; have=0
    fi
    free_kb=$(df -k "$out" | awk 'NR == 2 { print $4 }')
    need_kb=$(awk -v s="$size" -v h="$have" -v r="$RESERVE_KB" 'BEGIN { printf "%.0f", (s - h) / 1024 + r }')
    num_ge "$free_kb" "$need_kb" || fail 5 "not enough space in $out: ${free_kb} KiB free, ${need_kb} KiB needed (download + reserve)"
    num_gt "$size" 0 || say "warning: the server did not report a size; only the reserve was checked"
    record result downloading build "$id" bytes "$size" path "$out/recovery.zip" part "$part"
    STOP_NOTE="the partial download of $id is kept"
    if num_gt "$size" 0 && [ "$have" = "$size" ]; then
        say "partial download of $id is already complete ($have bytes); verifying"
    else
        say "downloading $id ($size bytes, resuming at $have)"
        # shellcheck disable=SC2086
        transfer "$DIR/http_code" -fsSL $proto --retry 3 --retry-delay 5 -C - -w '%{http_code}' -o "$part" "$url"
        rc=$?
        http=$(cat "$DIR/http_code" 2>/dev/null); rm -f "$DIR/http_code"
        if [ $rc != 0 ]; then
            # Only a refused range (curl 33/36, HTTP 416) means the partial cannot continue: restart it once.
            # Any other failure (network, server) keeps the partial for the next run to resume.
            case "$rc:$http" in
                33:*|36:*|*:416) ;;
                *) fail 3 "download of $id stopped (curl $rc, HTTP ${http:-none}); rerun to resume" ;;
            esac
            say "the server refused to resume $id (curl $rc, HTTP ${http:-none}); restarting from the beginning"
            rm -f "$part"
            # shellcheck disable=SC2086
            transfer /dev/null -fsSL $proto --retry 3 --retry-delay 5 -o "$part" "$url" \
                || fail 3 "download of $id failed; rerun to resume"
        fi
    fi
    STOP_NOTE="the downloaded file of $id is kept and verified on the next run"
    record result verifying
    md5_of "$part"
    if [ "$MD5" != "$md5" ]; then
        rm -f "$part"
        fail 4 "$id failed Google's MD5 check (got ${MD5:-nothing}, listing $md5); the partial file was removed"
    fi
    rm -f "$out/recovery.zip.md5"
    mv "$part" "$out/recovery.zip" || fail 2 "cannot move the verified download into place"
    printf '%s\n' "$md5" > "$out/recovery.zip.md5" || fail 2 "cannot record the verification of $id"
    prune_except "$out"
    record result downloaded verified "$id" path "$out/recovery.zip" md5 "$md5"
    FINAL=1 FINAL_RC=0
    say "downloaded and verified $id: $out/recovery.zip"
    return 0
}

ADAPT=${OPENBOOK_ADAPT:-/system/bin/openbook-adapt}
LAYER=${OPENBOOK_LAYER:-/system/etc/openbook/layer}
AVB_KEY=${OPENBOOK_AVB_KEY:-/system/etc/openbook/avb/testkey_rsa4096.pem}
OURS_ROOT=${OPENBOOK_OURS_ROOT:-/}
# The newest download with Google's MD5 verified (sets D, its directory, and ID, its release).
newest_verified() {
    D=; ID=
    for d in "$DIR"/[0-9]*; do
        [ -f "$d/recovery.zip" ] && [ -f "$d/recovery.zip.md5" ] || continue
        case ${d##*/} in *[!0-9]*) continue ;; esac
        if [ -z "$D" ] || num_gt "${d##*/}" "${D##*/}"; then D=$d; fi
    done
    [ -n "$D" ] && ID=$(sed -n 's/^latest=//p' "$D/release.info" 2>/dev/null)
    [ -n "$ID" ] || ID=${D##*/}
}
# Runs openbook-adapt with its output (errors included) in FILE.
adapter() { a_out=$1; shift; child "$a_out" sh -c 'exec "$0" "$@" 2>&1' "$ADAPT" "$@"; }

cmd_adapt() {
    [ -x "$ADAPT" ] && [ -f "$LAYER/layer.json" ] && [ -f "$AVB_KEY" ] \
        || fail 2 "this system cannot build releases for the laptop (no openbook-adapt, layer or key)"
    newest_verified
    [ -n "$D" ] || fail 2 "no verified download to adapt"
    # A release this system's layer cannot carry stays held until a new system (a new layer) arrives.
    LAYER_SHA=$(sha256sum "$LAYER/layer.json" | cut -d' ' -f1)
    if [ -f "$D/adapt-held" ] && [ "$(sed -n 's/^layer=//p' "$D/adapt-held")" = "$LAYER_SHA" ]; then
        why=$(sed -n 's/^detail=//p' "$D/adapt-held")
        record_new result adapt-held build "$ID" detail "$why"
        FINAL=1 FINAL_RC=8
        say "still held: $ID ($why)"; exit 8
    fi
    rm -f "$D/adapt-held"
    if [ -f "$D/adapted/payload/payload.json" ]; then
        record_new result adapted build "$ID" payload "$D/adapted/payload/payload.bin"
        FINAL=1 FINAL_RC=0
        say "already adapted: $ID"; return 0
    fi
    # Google's partitions, the adapted ones and the payload, plus the work tree: 16 GiB beside the reserve.
    free_kb=$(df -k "$D" | awk 'NR == 2 { print $4 }')
    need_kb=$(awk -v r="$RESERVE_KB" 'BEGIN { printf "%.0f", 16 * 1048576 + r }')
    num_ge "$free_kb" "$need_kb" || fail 5 "not enough space to adapt $ID: ${free_kb} KiB free, ${need_kb} KiB needed"
    w="$D/adapt.tmp"
    rm -rf "$w" && mkdir -p "$w" || fail 2 "cannot create $w"
    STOP_NOTE="the adaptation of $ID starts again on the next run"
    rm -f "$DIR/adapt-progress"
    step() { printf '%s\n' "$1" > "$DIR/adapt-progress.tmp" && mv "$DIR/adapt-progress.tmp" "$DIR/adapt-progress"; }
    record_new result adapting build "$ID"
    say "adapting $ID: reconstructing Google's partitions"
    step reconstruct
    adapter "$w/reconstruct.out" reconstruct --release "$D/recovery.zip" --layer "$LAYER" --out "$w/google" \
        || adapt_failed "$?" "$w/reconstruct.out"
    say "adapting $ID: re-applying the OpenBook layer"
    adapter "$w/adapt.out" adapt --layer "$LAYER" --new "$w/google" --ours-root "$OURS_ROOT" --key "$AVB_KEY" \
        --work "$w/work" --out "$w/adapted" --progress "$DIR/adapt-progress" || adapt_failed "$?" "$w/adapt.out"
    say "adapting $ID: writing the update payload"
    step payload
    adapter "$w/payload.out" payload --adapted "$w/adapted" --layer "$LAYER" --out "$w/payload" \
        || adapt_failed "$?" "$w/payload.out"
    # Keep the payload and the records: the images live in the payload.
    mkdir -p "$w/keep" && mv "$w/payload" "$w/keep/payload" && cp "$w/adapted/adapt.json" "$w/google/reconstruct.json" "$w/keep/" \
        || fail 2 "cannot keep the adaptation of $ID"
    rm -rf "$D/adapted" && mv "$w/keep" "$D/adapted" && rm -rf "$w" || fail 2 "cannot move the adaptation of $ID into place"
    rm -f "$DIR/adapt-progress"
    record result adapted build "$ID" payload "$D/adapted/payload/payload.bin"
    FINAL=1 FINAL_RC=0
    say "adapted $ID for this laptop; the update payload waits for this laptop's signature"
    return 0
}
# adapt_failed RC OUTFILE: a held release (8) or a fault, recorded with the adapter's reason.
adapt_failed() {
    why=$(sed -n 's/^openbook-adapt: //p' "$2" 2>/dev/null | tail -1)
    rm -rf "$w"; rm -f "$DIR/adapt-progress"
    if [ "$1" = 8 ]; then
        FINAL=1 FINAL_RC=8
        pairs layer "$LAYER_SHA" detail "${why#held: }" | write_kv "$D/adapt-held"
        record result adapt-held build "$ID" detail "${why#held: }"
        say "not adapting $ID: ${why#held: }"
        exit 8
    fi
    FINAL=1 FINAL_RC=11
    record result error:11 build "$ID" detail "${why:-openbook-adapt exited $1}"
    say "error: adapting $ID failed: ${why:-openbook-adapt exited $1}"
    exit 11
}

cmd_sign() {
    newest_verified
    p="${D:+$D/adapted/payload}"
    [ -n "$D" ] && [ -f "$p/payload.json" ] || fail 2 "no adapted release to sign"
    [ -f "$p/metadata.sig" ] && [ -f "$p/payload.sig" ] || fail 2 "the app has not signed the payload of $ID"
    # The app leaves this laptop's certificate beside the signatures: both are checked with it before use.
    cert=; [ -f "$p/laptop.x509.pem" ] && cert="$p/laptop.x509.pem"
    adapter "$p/sign.out" payload-sign --dir "$p" --metadata-signature "$p/metadata.sig" --payload-signature "$p/payload.sig" \
        ${cert:+--cert} ${cert:+"$cert"} \
        || { why=$(sed -n 's/^openbook-adapt: //p' "$p/sign.out" | tail -1); fail 2 "cannot sign the payload of $ID: $why"; }
    rm -f "$p/sign.out"
    record_new result ready build "$ID" payload "$p/payload.bin"
    FINAL=1 FINAL_RC=0
    say "the update payload of $ID is signed and ready to install"
    return 0
}

cmd_watch() {
    interval=${OPENBOOK_UPDATER_INTERVAL:-86400}; step=${OPENBOOK_UPDATER_STEP:-900}
    cycles=${OPENBOOK_UPDATER_CYCLES:-0}; n=0
    due=$(awk -v n="$(date +%s)" -v d="${OPENBOOK_UPDATER_FIRST_DELAY:-60}" 'BEGIN { printf "%.0f", n + d }')
    say "watching for Google releases: first check in ${OPENBOOK_UPDATER_FIRST_DELAY:-60}s, then every ${interval}s"
    while :; do
        now=$(date +%s)
        # A clock set backwards (RTC fixed by network time) must not postpone checks past one interval.
        if num_gt "$due" "$(awk -v n="$now" -v i="$interval" 'BEGIN { printf "%.0f", n + i }')"; then due=$now; fi
        # The wall clock decides: sleep's clock stops while the laptop is suspended.
        if num_ge "$now" "$due"; then
            # A separate locked run per check: the watcher holds no lock while it sleeps.
            sh "$0" --dir "$DIR" --listing "$LISTING" check; rc=$?
            n=$((n + 1))
            say "check $n finished (exit $rc); next in ${interval}s"
            [ "$cycles" -gt 0 ] && [ "$n" -ge "$cycles" ] && return "$rc"
            due=$(awk -v n="$(date +%s)" -v i="$interval" 'BEGIN { printf "%.0f", n + i }')
            continue
        fi
        # Sleep until the next check is due, at most one step (so suspend cannot stretch it).
        sleep "$(awk -v d="$due" -v n="$now" -v s="$step" 'BEGIN { w = d - n; if (w > s) w = s; if (w < 1) w = 1; printf "%.0f", w }')"
    done
}

# Parsed in a function so the script's own "$@" survives for the locking re-exec below.
parse() {
    CMD=
    while [ $# -gt 0 ]; do
        case $1 in
            --dir) [ $# -ge 2 ] || usage; DIR=$2; shift 2 ;;
            --listing) [ $# -ge 2 ] || usage; LISTING=$2; shift 2 ;;
            check|download|adapt|sign|status|watch) CMD=$1; shift ;;
            *) usage ;;
        esac
    done
}
parse "$@"
[ -n "$CMD" ] || usage
mkdir -p "$DIR" || { echo "cannot create $DIR"; exit 2; }
export TMPDIR="$DIR"   # any temporary file a tool makes stays in the updater's own directory
if [ "$CMD" = status ]; then cat "$DIR/state" 2>/dev/null || echo "result=never-run"; exit 0; fi
if [ "$CMD" = watch ]; then cmd_watch; exit $?; fi
# One run at a time per DIR. toybox flock takes a descriptor number, and mksh marks descriptors
# opened by a bare `exec 9>` close-on-exec, so flock would never see one. Re-run with the lock file
# as a redirection of exec instead: that descriptor is inherited by flock, the lock lives on the
# open file, and the kernel drops it when this run ends (also on a crash).
if [ "${OPENBOOK_UPDATER_LOCKED:-}" != "$DIR" ]; then
    OPENBOOK_UPDATER_LOCKED=$DIR exec sh "$0" "$@" 9>> "$DIR/lock"
fi
flock -n 9 || { echo "another openbook-updater run holds $DIR/lock"; exit 6; }
trap stop TERM INT HUP
case $CMD in
    check) cmd_check ;;
    download) cmd_download ;;
    adapt) cmd_adapt ;;
    sign) cmd_sign ;;
esac
