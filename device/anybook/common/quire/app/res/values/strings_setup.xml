    <!-- Welcome -->
    <string name="setup_welcome_title">Bring your AI agents to OpenBook</string>
    <string name="setup_welcome_lead">Quire works with the agents you already use. Set them up once, then call Quire from anywhere on the laptop.</string>
    <string name="setup_point1_title">They run on this laptop</string>
    <string name="setup_point1">In a private Linux environment that Quire sets up for you. No Terminal needed.</string>
    <string name="setup_point2_title">Pick the ones you like</string>
    <string name="setup_point2">Claude Code, GitHub Copilot, Gemini CLI, opencode, Cursor and more.</string>
    <string name="setup_point3_title">You stay in charge</string>
    <string name="setup_point3">Quire asks before anything destructive, and every change it makes can be undone.</string>
    <string name="setup_welcome_hint">Downloads about 800 MB, once. Takes a few minutes.</string>
    <string name="setup_get_started">Get started</string>

    <!-- Linux -->
    <string name="setup_linux_title">Setting up the Linux environment</string>
    <string name="setup_linux_title_done">The Linux environment is ready</string>
    <string name="setup_linux_lead">Your agents run here, on this laptop. This happens once.</string>
    <string name="setup_linux_lead_done">Your agents will run here, on this laptop.</string>
    <string name="setup_linux_hint">You can close this window. Quire carries on and tells you when it’s ready.</string>
    <string name="setup_row_check">This laptop can run it</string>
    <string name="setup_row_check_sub">Hardware virtualization is on</string>
    <string name="setup_row_download">Downloading the Linux environment</string>
    <string name="setup_row_download_sub">%1$d of %2$d MB</string>
    <string name="setup_row_download_done">Checked</string>
    <string name="setup_row_unpack">Unpacking</string>
    <string name="setup_row_unpack_sub">Debian 13 with Quire’s helper</string>
    <string name="setup_row_start">Starting Linux</string>
    <string name="setup_row_connect">Connecting Quire</string>
    <string name="setup_row_connect_done">Quire’s helper answered</string>
    <string name="setup_percent">%1$d %%</string>
    <string name="setup_set_up">Set up</string>

    <string name="setup_nokvm_title">Turn on virtualization first</string>
    <string name="setup_nokvm_lead">The Linux environment needs your processor’s virtualization, and it is switched off in this laptop’s firmware.</string>
    <string name="setup_nokvm_heading">In the firmware settings</string>
    <string name="setup_nokvm_1">Restart the laptop and open its firmware settings. Many laptops use F2 or Delete while the logo shows.</string>
    <string name="setup_nokvm_2">Turn on SVM Mode (AMD) or Intel Virtualization Technology.</string>
    <string name="setup_nokvm_3">Save, restart, and open Quire again.</string>
    <string name="setup_nokvm_why">Nothing else on OpenBook changes. Until then, Quire can’t run agents on this laptop.</string>
    <string name="setup_noimage_title">This build has no Linux environment yet</string>
    <string name="setup_noimage_lead">This build of OpenBook doesn’t include a Linux environment image yet, so Quire can’t set one up. A later update brings it.</string>
    <string name="setup_noavf_title">This build has no Linux environment</string>
    <string name="setup_noavf_lead">This build of OpenBook was made without the Linux environment, so Quire can’t run agents on this laptop.</string>
    <string name="setup_error_title">The Linux environment didn’t start</string>
    <string name="setup_error_lead">Try again. If it keeps failing, open Terminal to see why.</string>
    <string name="setup_old_title">Quire’s helper needs updating</string>
    <string name="setup_old_lead">This Linux environment has an older Quire helper that can’t install agents. Update it and keep your files, or start the Linux environment over.</string>
    <!-- A Linux environment without Quire's helper (ANAL-394): Google's image, or a quired that doesn't answer. -->
    <string name="setup_nohelper_google_title">This Linux environment doesn’t have Quire’s helper</string>
    <string name="setup_nohelper_google_lead">It was set up from Google’s Linux image, before OpenBook had its own. Quire’s agents run through a small helper that this image doesn’t include.</string>
    <string name="setup_nohelper_title">Quire’s helper isn’t answering</string>
    <string name="setup_nohelper_lead">The Linux environment is running, but Quire’s helper in it doesn’t answer. It may have been removed, or it doesn’t start.</string>
    <string name="setup_keep_title">Keep your files</string>
    <string name="setup_keep_lead">Open Terminal, paste this command and press Enter. It adds Quire’s helper and changes nothing else.</string>
    <string name="setup_keep_command_desc">Command: %1$s</string>
    <string name="setup_keep_fine">Quire put %1$s in your Downloads, and the command checks it before installing it. If Terminal says the file isn’t there, start clean instead.</string>
    <string name="setup_keep_preparing">Putting Quire’s helper in your Downloads…</string>
    <string name="setup_helper_no_deb">This build of OpenBook doesn’t carry Quire’s helper, so starting clean is the way to go.</string>
    <string name="setup_helper_no_copy">Quire couldn’t put its helper in your Downloads (%1$s), so starting clean is the way to go.</string>
    <string name="setup_clean_title">Start clean</string>
    <string name="setup_clean_lead">In Terminal, open Settings › Recovery and reset the Linux environment. Quire then sets up OpenBook’s Linux environment, helper included.</string>
    <string name="setup_clean_warning">This deletes the files in the Linux environment.</string>
    <string name="setup_helper_hint">Quire carries on by itself once the helper answers.</string>

