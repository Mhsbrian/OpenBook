<!--
  Copyright (C) 2026 The OpenBook Authors
  SPDX-License-Identifier: Apache-2.0

  OpenBook NVK (ANAL-327, docs/nvk-openbook.md): the NVIDIA driver for apps, as Android's updatable graphics driver
  package. It has no code. Android loads its libraries into an app that is opted in to it (ro.gfx.driver.0,
  GraphicsEnvironment.chooseDriver), uncompressed from lib/x86_64 in the APK:
    vulkan.radv.so           NVK for Vulkan (libvulkan asks for vulkan.<ro.hardware.vulkan>.so)
    lib*_angle.so            ANGLE for OpenGL ES, on NVK (EGL asks for lib<API>_<ro.hardware.egl>.so)
    libnv_bionic_native.so   NVK's backend for NVIDIA's open kernel driver
    libdrm.so, libelf_mesa.so  their own copies of Mesa's libdrm and elfutils' libelf
  forceQueryable: every app's process looks the package up with its own PackageManager (GraphicsEnvironment), so the
  package must be visible to every app. A system package is only if it is platform-signed or forceQueryable
  (AppsFilterImpl), as AOSP's own ANGLE APK is. Without it, apps saw "package not installed" (QEMU, 2026-11-02).
  build_time is "L" and the Unix time of the clean-room commit these libraries are built from (ea217004,
  2026-11-02T21:15:00Z); scripts/nvk-stage.sh checks it against device/anybook/common/nvk/tested-bytes.txt.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.openbook.nvk">
    <application
        android:label="OpenBook NVIDIA driver"
        android:hasCode="false"
        android:extractNativeLibs="false"
        android:forceQueryable="true">
        <meta-data
            android:name="com.android.graphics.driver.build_time"
            android:value="L1793654100" />
    </application>
</manifest>
