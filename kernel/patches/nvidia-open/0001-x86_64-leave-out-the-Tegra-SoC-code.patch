From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "AnyBook (ANAL-297)" <noreply@anybook.invalid>
Date: Mon, 26 Oct 2026 00:00:00 +0000
Subject: [PATCH 1/7] x86_64: leave out the Tegra SoC code

Tegra platform devices (the iGPU, display, DSI panels) and the Tegra PCI
iGPU's devfreq, interconnect, clock and GenPD code serve Arm64 Tegra SoCs only.
On x86_64 that code was still compiled because its guards test kernel options
(CONFIG_OF, CONFIG_PM_DEVFREQ, CONFIG_INTERCONNECT, CONFIG_COMMON_CLK) that a
generic x86 kernel enables too, and it imported about 25 Device Tree, GPIO,
clock, interconnect, devfreq and OPP functions that no x86 code path reaches.

Compile it out on x86_64. Behaviour on PCI GPUs is unchanged: the platform
driver was never registered there, and the Tegra paths are reached only
through Tegra platform data or Device Tree nodes that x86 does not have.
nv_dsi_is_panel_connected() reports no panel.

AnyBook (ANAL-297) keeps the Ruby kernel's export list small: an Android GKI
kernel exports only what its partner lists name.
---
 kernel-open/common/inc/nv-platform.h          | 10 ++++++++++
 kernel-open/nvidia/nv-clk.c                   |  2 +-
 kernel-open/nvidia/nv-dsi-parse-panel-props.c |  4 ++++
 kernel-open/nvidia/nv-pci.c                   | 18 ++++++++---------
 kernel-open/nvidia/nv-platform.c              |  4 +++-
 kernel-open/nvidia/nv.c                       | 20 +++++++++++++------
 6 files changed, 41 insertions(+), 17 deletions(-)

diff --git a/kernel-open/common/inc/nv-platform.h b/kernel-open/common/inc/nv-platform.h
index 4bb286a..8ffc277 100644
--- a/kernel-open/common/inc/nv-platform.h
+++ b/kernel-open/common/inc/nv-platform.h
@@ -35,7 +35,17 @@ int       nv_platform_count_devices(void);
 int       nv_soc_register_irqs(nv_state_t *nv);
 void      nv_soc_free_irqs(nv_state_t *nv);
 
+/*
+ * NVIDIA platform devices (the Tegra iGPU and Tegra display) exist only on
+ * Arm64 Tegra SoCs; an x86_64 system has PCI GPUs only. Compile the platform
+ * device code out there: it would otherwise import Device Tree, GPIO, clock,
+ * interconnect and devfreq APIs that no x86 code path reaches.
+ */
+#if defined(NVCPU_X86_64)
+#define NV_SUPPORTS_PLATFORM_DEVICE 0
+#else
 #define NV_SUPPORTS_PLATFORM_DEVICE NV_IS_EXPORT_SYMBOL_PRESENT___platform_driver_register
+#endif
 
 #if defined(NV_LINUX_PLATFORM_TEGRA_DCE_DCE_CLIENT_IPC_H_PRESENT)
 #define NV_SUPPORTS_DCE_CLIENT_IPC 1
diff --git a/kernel-open/nvidia/nv-clk.c b/kernel-open/nvidia/nv-clk.c
index 1b60b69..2e45d4c 100644
--- a/kernel-open/nvidia/nv-clk.c
+++ b/kernel-open/nvidia/nv-clk.c
@@ -32,7 +32,7 @@
 
 // Use the CCF APIs if enabled in Kernel config and RM build
 // has Dual license define enabled.
-#if defined(CONFIG_COMMON_CLK)
+#if defined(CONFIG_COMMON_CLK) && !defined(NVCPU_X86_64)
 #define HAS_COMMON_CLOCK_FRAMEWORK 1
 #else
 #define HAS_COMMON_CLOCK_FRAMEWORK 0
diff --git a/kernel-open/nvidia/nv-dsi-parse-panel-props.c b/kernel-open/nvidia/nv-dsi-parse-panel-props.c
index ed5c108..5b7cfd7 100644
--- a/kernel-open/nvidia/nv-dsi-parse-panel-props.c
+++ b/kernel-open/nvidia/nv-dsi-parse-panel-props.c
@@ -795,6 +795,7 @@ nv_dsi_is_panel_connected
     nv_state_t      *nv
 )
 {
+#if NV_SUPPORTS_PLATFORM_DEVICE
     nv_linux_state_t *nvl            = NV_GET_NVL_FROM_NV_STATE(nv);
     struct device_node *np_dsi       = NULL;
     struct device_node *np_dsi_panel = NULL;
@@ -817,6 +818,9 @@ fail:
     of_node_put(np_dsi_panel);
     of_node_put(np_dsi);
     return ret;
+#else
+    return NV_FALSE;
+#endif
 }
 
 NV_STATUS
