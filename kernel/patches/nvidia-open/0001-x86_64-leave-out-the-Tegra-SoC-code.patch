     nv_linux_state_t *nvl = pci_get_drvdata(to_pci_dev(dev));
     const struct nv_pci_tegra_devfreq_data *tdata;
     struct clk *clk = NULL;
@@ -2482,7 +2482,7 @@ nv_pci_probe_body
 
     pm_vt_switch_required(nvl->dev, NV_TRUE);
 
-#if defined(CONFIG_PM_DEVFREQ)
