    srcs = ["//common:kernel_x86_64_sources"],
    outs = [],
    arch = "x86_64",
    base_kernel = "//common:kernel_x86_64",
    kmi_symbol_list = "//common:gki/x86_64/symbols/anybook_amd",
    make_goals = ["modules"],
    makefile = "//common:Makefile",
    module_outs = _ANYBOOK_AMD_MODULES,
    post_defconfig_fragments = ["anybook_amd.fragment"],
    strip_modules = True,
)

kernel_abi(
    name = "anybook_amd_x86_64_abi",
    kernel_build = ":anybook_amd_x86_64",
    kernel_modules = [],
    kmi_symbol_list_add_only = True,
)

