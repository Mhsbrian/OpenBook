# AnyBook AMD laptop vendor modules (ANAL-171): a Kleaf mixed build on top of the x86_64 GKI.
#
# Lives in the AnyBook repo as kernel/devices/anybook/; scripts/kernel-amd-apply.sh copies it into the
# kernel tree as //devices/anybook. The GKI itself only changes through kernel/patches/common/.
#
#   tools/bazel run --config=stamp //devices/anybook:anybook_amd_x86_64_dist -- --destdir=DIR
#   tools/bazel run //devices/anybook:anybook_amd_x86_64_abi_update_symbol_list   # -> common/gki/x86_64/symbols/anybook_amd

load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load(
    "//build/kernel/kleaf:kernel.bzl",
    "kernel_abi",
    "kernel_build",
    "kernel_modules_install",
)

# For scripts/kernel-amd-integrity.sh, which builds the GKI with the vendor fragment on top:
#   --defconfig_fragment=//devices/anybook:anybook_amd_gki_check_fragment
# Module signing stays on there, so the GKI build's own signed-module checks still pass.
genrule(
    name = "anybook_amd_gki_check_fragment",
    srcs = ["anybook_amd.fragment"],
    outs = ["anybook_amd_gki_check.fragment"],
    cmd = "grep -v '^# CONFIG_MODULE_SIG_ALL is not set' $< > $@",
)

# In-tree modules the AMD fragment adds, relative to common/. Keep sorted.
