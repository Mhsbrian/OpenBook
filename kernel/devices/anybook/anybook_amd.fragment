# AnyBook AMD laptop vendor modules (ANAL-171). Mixed build on top of //common:kernel_x86_64.
# Target: ASUS ROG Zephyrus G14 2025 (GA403WR, Ryzen AI 9 HX 370 "Strix Point"); generic for Zen 4/5 laptops.
#
# Rule: this fragment may only add modules (n -> m) and options that only module code reads.
# It must not change anything vmlinux or a GKI module is built from; built-in options go in
# gki_defconfig through kernel/patches/common/ instead. scripts/kernel-config-check.py enforces it.
# Each line is checked by Kleaf after olddefconfig, unless marked "nocheck".

# Vendor modules are not signed: under MODULE_SIG_PROTECT they may only use KMI-listed symbols,
# which is what the anybook_amd symbol list provides. Build-time only, no code.
# CONFIG_MODULE_SIG_ALL is not set

## GPU: Radeon 890M (RDNA 3.5, gfx1150, DCN 3.5) and other RDNA 2/3 APUs
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_AMD_DC=y
# CONFIG_DRM_AMDGPU_SI is not set
# CONFIG_DRM_AMDGPU_CIK is not set
# CONFIG_DRM_AMD_ACP is not set
# CONFIG_DRM_AMD_SECURE_DISPLAY is not set
# KFD (ROCm compute) is off: Android does not use it, and HSA_AMD_SVM would need ZONE_DEVICE in vmlinux.
# CONFIG_HSA_AMD is not set
CONFIG_HWMON=m
CONFIG_SENSORS_K10TEMP=m

## NPU: XDNA 2 (needs AMD_IOMMU=y in vmlinux)
CONFIG_DRM_ACCEL_AMDXDNA=m

## Virtual machines (QEMU/crosvm test target, ANAL-172)
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_VIRTIO_INPUT=m

## Power: s2idle (amd_pmc), sensor fusion hub, ACPI power and thermal devices
CONFIG_AMD_PMC=m
CONFIG_AMD_SFH_HID=m
# amd-pmf needs AMDTEE -> CRYPTO_DEV_SP_PSP, and ccp.ko then always links the SEV code, which calls
# kernel_read/kernel_write. build/kernel/abi/symbols.deny forbids both for GKI vendor modules.
# Left out until that is resolved (docs/kernel.md, "Blocked").
# CONFIG_AMD_PMF is not set
# CONFIG_CRYPTO_DEV_CCP_DD is not set
CONFIG_ACPI_PLATFORM_PROFILE=m
CONFIG_ACPI_AC=m
CONFIG_ACPI_BATTERY=m
CONFIG_ACPI_FAN=m
CONFIG_ACPI_THERMAL=m

## Input: I2C HID touchpad on the AMD DesignWare I2C controller (AMDI0010), ASUS N-KEY keyboard
CONFIG_I2C_DESIGNWARE_CORE=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
CONFIG_I2C_HID_ACPI=m
CONFIG_I2C_PIIX4=m
CONFIG_SPI_AMD=m
CONFIG_HID_ASUS=m

## Platform: ASUS WMI hotkeys, fan/profile, backlight
CONFIG_ACPI_WMI=m
CONFIG_ACPI_VIDEO=m
# MUX laptops: when the EC owns the panel brightness, acpi/video_detect.c (built in) picks nvidia_wmi_ec
# over the GPU's native backlight. Without this module there would be no backlight device at all.
CONFIG_NVIDIA_WMI_EC_BACKLIGHT=m
CONFIG_ASUS_WMI=m
CONFIG_ASUS_NB_WMI=m
CONFIG_INPUT_SPARSEKMAP=m
CONFIG_SERIAL_MULTI_INSTANTIATE=m

## Storage: Realtek RTS525A SD card reader (GA403WR inventory)
CONFIG_MISC_RTSX_PCI=m
CONFIG_MMC_REALTEK_PCI=m

## Ports and security: USB-C UCSI, firmware TPM (Pluton/fTPM via CRB)
CONFIG_UCSI_ACPI=m
CONFIG_TCG_TPM=m
CONFIG_TCG_CRB=m

## Audio: HDA controller with Realtek ALC285 + 2x Cirrus CS35L56 (I2C), HDMI/DP audio
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_ALC269=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_HDMI_ATI=m
CONFIG_SND_HDA_SCODEC_CS35L56_I2C=m
CONFIG_SND_HDA_PATCH_LOADER=y

## Audio: ACP 6.3/7.x DMIC. snd_pci_ps binds by default; acp-config DMI quirks pick SOF or the
## generic ACP driver instead, so all three are built.
CONFIG_SND_SOC_AMD_ACP_COMMON=m
CONFIG_SND_SOC_AMD_PS=m
CONFIG_SND_SOC_AMD_PS_MACH=m
CONFIG_SND_SOC_AMD_ACP_PCI=m
CONFIG_SND_AMD_ASOC_ACP70=m
CONFIG_SND_SOC_AMD_LEGACY_MACH=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_AMD_TOPLEVEL=m
CONFIG_SND_SOC_SOF_AMD_REMBRANDT=m
CONFIG_SND_SOC_SOF_AMD_ACP63=m
CONFIG_SND_SOC_SOF_AMD_ACP70=m
CONFIG_SND_SOC_AMD_SOF_MACH=m

## Wi-Fi and Bluetooth: MediaTek MT7921/MT7922/MT7925, Realtek RTW89
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=m
CONFIG_MT7925E=m
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW89=m
CONFIG_RTW89_8851BE=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_RTW89_8922AE=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_MTK=y
