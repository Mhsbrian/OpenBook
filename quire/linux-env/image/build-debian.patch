 ### --- Functions --- ###
 
-# Remove default kernel packages to make room for our custom kernel
-remove_default_kernels() {
-  echo "--- Removing default kernel packages ---"
-  apt purge -y linux-image-*
+# OpenBook: keep Debian's own cloud kernel. The guest boots it directly (build_internal.sh
+# copies /boot's kernel and initrd into the bundle) instead of a kernel downloaded from Google's CI.
+keep_debian_kernel() {
+  echo "--- Keeping Debian's kernel ---"
+  ls /boot/vmlinuz-* /boot/initrd.img-*
+}
+
+# OpenBook: install the local packages staged in /mnt/build/localdebs (quired), and the agents
+# named in /mnt/build/openbook-agents (test images only; a product image ships no agent).
+install_openbook() {
+  echo "--- Installing OpenBook packages ---"
+  if compgen -G "/mnt/build/localdebs/*.deb" > /dev/null; then
+    eatmydata apt install -y /mnt/build/localdebs/*.deb
+  fi
+  if [ -s /mnt/build/openbook-agents ]; then
+    while read -r agent url sha; do
+      [ -n "$agent" ] || continue
+      echo "test agent: $agent from $url"
+      curl -fsSL -o "/tmp/$agent.tgz" "$url"
+      echo "$sha  /tmp/$agent.tgz" | sha256sum -c -
+      tar -xzf "/tmp/$agent.tgz" -C /usr/local/bin
+      rm "/tmp/$agent.tgz"
+    done < /mnt/build/openbook-agents
+  fi
 }
 
 # Install required packages and optimize the process
