-remove_default_kernels
+# OpenBook: hand the newest kernel, its initrd and its config to build_internal.sh, through the
+# bind-mounted build folder.
+export_kernel() {
+  local v
+  v=$(ls -1 /boot/vmlinuz-* | sed 's|/boot/vmlinuz-||' | sort -V | tail -1)
+  mkdir -p /mnt/build/openbook-kernel
+  cp "/boot/vmlinuz-$v" /mnt/build/openbook-kernel/vmlinuz
+  cp "/boot/initrd.img-$v" /mnt/build/openbook-kernel/initrd.img
+  cp "/boot/config-$v" /mnt/build/openbook-kernel/kernel_config
+  echo "$v" > /mnt/build/openbook-kernel/kernel_version
+  echo "--- Kernel for the bundle: $v ---"
+}
+
+keep_debian_kernel
