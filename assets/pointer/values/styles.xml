<!-- AOSP's pointer colour styles, with the same colour under our own attribute too. -->
<resources>
    <style name="PointerIconVectorStyleFillBlack">
        <item name="*android:pointerIconVectorFill">@android:color/black</item>
        <item name="*android:pointerIconVectorFillInverse">@android:color/white</item>
        <item name="openbookPointerFill">@android:color/black</item>
    </style>
    <style name="PointerIconVectorStyleFillGreen">
        <item name="*android:pointerIconVectorFill">#1AA64A</item>
        <item name="*android:pointerIconVectorFillInverse">#1AA64A</item>
        <item name="openbookPointerFill">#1AA64A</item>
    </style>
    <style name="PointerIconVectorStyleFillRed">
        <item name="*android:pointerIconVectorFill">#F55E57</item>
        <item name="*android:pointerIconVectorFillInverse">#F55E57</item>
        <item name="openbookPointerFill">#F55E57</item>
    </style>
    <style name="PointerIconVectorStyleFillPink">
        <item name="*android:pointerIconVectorFill">#F94AAB</item>
        <item name="*android:pointerIconVectorFillInverse">#F94AAB</item>
        <item name="openbookPointerFill">#F94AAB</item>
    </style>
    <style name="PointerIconVectorStyleFillBlue">
        <item name="*android:pointerIconVectorFill">#009DC9</item>
        <item name="*android:pointerIconVectorFillInverse">#009DC9</item>
        <item name="openbookPointerFill">#009DC9</item>
    </style>
    <style name="PointerIconVectorStyleFillPurple">
        <item name="*android:pointerIconVectorFill">#AD72FF</item>
        <item name="*android:pointerIconVectorFillInverse">#AD72FF</item>
        <item name="openbookPointerFill">#AD72FF</item>
    </style>
    <style name="PointerIconVectorStyleStrokeWhite">
        <item name="*android:pointerIconVectorStroke">@android:color/white</item>
        <item name="*android:pointerIconVectorStrokeInverse">@android:color/black</item>
        <item name="openbookPointerStroke">@android:color/white</item>
    </style>
    <style name="PointerIconVectorStyleStrokeBlack">
        <item name="*android:pointerIconVectorStroke">@android:color/black</item>
        <item name="*android:pointerIconVectorStrokeInverse">@android:color/black</item>
        <item name="openbookPointerStroke">@android:color/black</item>
    </style>
    <style name="PointerIconVectorStyleStrokeNone">
        <item name="*android:pointerIconVectorStroke">@android:color/transparent</item>
        <item name="*android:pointerIconVectorStrokeInverse">@android:color/transparent</item>
        <item name="openbookPointerStroke">@android:color/transparent</item>
    </style>
</resources>
