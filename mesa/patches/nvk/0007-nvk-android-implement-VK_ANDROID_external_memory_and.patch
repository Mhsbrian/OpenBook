+#if ANDROID_API_LEVEL >= 26
+
+#include <vndk/hardware_buffer.h>
+
+static VkResult
+nvk_android_init_ahb_layout(struct nvk_device *dev, struct nvk_image *image,
+                            struct AHardwareBuffer *ahb)
+{
+   VkImageDrmFormatModifierExplicitCreateInfoEXT mod_info;
+   VkSubresourceLayout layouts[NVK_MAX_IMAGE_PLANES];
+   VkResult result;
+
+   if (!vk_image_is_android_hardware_buffer(&image->vk) ||
+       image->vk.android_deferred_create_info == NULL) {
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "AHardwareBuffer memory dedicated to an image created "
+                       "without that external memory handle type");
+   }
+
+   result = vk_android_get_ahb_layout(ahb, &mod_info, layouts,
+                                      NVK_MAX_IMAGE_PLANES);
+   if (result != VK_SUCCESS)
+      return vk_error(dev, result);
+
+   AHardwareBuffer_Desc desc;
+   AHardwareBuffer_describe(ahb, &desc);
+
+   return nvk_android_init_gralloc_layout(dev, image,
+                                          image->vk.android_deferred_create_info,
+                                          AHardwareBuffer_getNativeHandle(ahb),
+                                          desc.format, desc.stride,
+                                          &mod_info, layouts);
+}
+
+static uint32_t
+nvk_android_dma_buf_mem_types(struct nvk_device *dev, int fd)
+{
+   VkMemoryFdPropertiesKHR fd_props = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_FD_PROPERTIES_KHR,
+   };
+   VkResult result = nvk_GetMemoryFdPropertiesKHR(
+      nvk_device_to_handle(dev), VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+      fd, &fd_props);
+
+   return result == VK_SUCCESS ? fd_props.memoryTypeBits : 0;
+}
+
+/* Imports the dma-buf of an AHardwareBuffer as NVK memory, after laying the
+ * dedicated image, if there is one, out from the buffer.
+ */
+static VkResult
+nvk_android_import_ahb_memory(struct nvk_device *dev,
+                              const VkMemoryAllocateInfo *pAllocateInfo,
+                              struct AHardwareBuffer *ahb,
+                              const VkAllocationCallbacks *pAllocator,
+                              VkDeviceMemory *pMem)
+{
+   const struct nvk_physical_device *pdev = nvk_device_physical(dev);
+   VkDevice device = nvk_device_to_handle(dev);
+   VkResult result;
+
+   const native_handle_t *handle = AHardwareBuffer_getNativeHandle(ahb);
+   if (handle == NULL || handle->numFds < 1) {
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "AHardwareBuffer without a file descriptor");
+   }
+   const int dma_buf_fd = handle->data[0];
+
+   const VkMemoryDedicatedAllocateInfo *dedicated_info =
+      vk_find_struct_const(pAllocateInfo->pNext,
+                           MEMORY_DEDICATED_ALLOCATE_INFO);
+
+   VkImage image_h = VK_NULL_HANDLE;
+   VkBuffer buffer_h = VK_NULL_HANDLE;
+   VkMemoryRequirements mem_reqs;
+   if (dedicated_info != NULL && dedicated_info->image != VK_NULL_HANDLE) {
+      VK_FROM_HANDLE(nvk_image, image, dedicated_info->image);
+      result = nvk_android_init_ahb_layout(dev, image, ahb);
+      if (result != VK_SUCCESS)
+         return result;
+
+      image_h = dedicated_info->image;
+      dev->vk.dispatch_table.GetImageMemoryRequirements(device, image_h,
+                                                        &mem_reqs);
+   } else if (dedicated_info != NULL &&
+              dedicated_info->buffer != VK_NULL_HANDLE) {
+      buffer_h = dedicated_info->buffer;
+      dev->vk.dispatch_table.GetBufferMemoryRequirements(device, buffer_h,
+                                                         &mem_reqs);
+
+      /* The allocationSize of a buffer import comes from
+       * vkGetAndroidHardwareBufferPropertiesANDROID() and can be larger than
+       * the buffer.  Keep it, so that the whole AHB can be mapped, and drop
+       * the dedicated buffer, which the spec then requires.
+       */
+      if (pAllocateInfo->allocationSize > mem_reqs.size) {
+         mem_reqs.size = pAllocateInfo->allocationSize;
+         buffer_h = VK_NULL_HANDLE;
+      }
+   } else {
+      mem_reqs.size = pAllocateInfo->allocationSize;
+      mem_reqs.memoryTypeBits = BITFIELD_MASK(pdev->mem_type_count);
+   }
+
+   /* NVK imports the whole dma-buf, so the resource must fit in it */
+   const off_t size_B = lseek(dma_buf_fd, 0, SEEK_END);
+   if (size_B < 0 || mem_reqs.size > (uint64_t)size_B) {
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "%" PRIu64 " B do not fit in the AHardwareBuffer's "
+                       "%jd B", mem_reqs.size, (intmax_t)size_B);
+   }
+
+   const uint32_t mem_types =
+      mem_reqs.memoryTypeBits & nvk_android_dma_buf_mem_types(dev, dma_buf_fd);
+   if (mem_types == 0) {
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "no memory type fits both the AHardwareBuffer and "
+                       "its dedicated resource");
+   }
+
+   /* An export cannot know the memory types of its image, whose memory
+    * requirements cannot be queried before the image is laid out here.
+    */
+   uint32_t mem_type_index = pAllocateInfo->memoryTypeIndex;
+   if (!(BITFIELD_BIT(mem_type_index) & mem_types))
+      mem_type_index = ffs(mem_types) - 1;
+
+   int dup_fd = os_dupfd_cloexec(dma_buf_fd);
+   if (dup_fd < 0) {
+      return vk_error(dev, errno == EMFILE ? VK_ERROR_TOO_MANY_OBJECTS
+                                           : VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+
+   const VkMemoryDedicatedAllocateInfo local_dedicated_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+      .image = image_h,
+      .buffer = buffer_h,
+   };
+   const VkImportMemoryFdInfoKHR fd_info = {
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+      .pNext = &local_dedicated_info,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+      .fd = dup_fd,
+   };
+   const VkMemoryAllocateInfo alloc_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .pNext = &fd_info,
+      .allocationSize = mem_reqs.size,
+      .memoryTypeIndex = mem_type_index,
+   };
+   result = nvk_AllocateMemory(device, &alloc_info, pAllocator, pMem);
+   if (result != VK_SUCCESS)
+      close(dup_fd);
+
+   return result;
+}
+
+bool
+nvk_android_is_ahb_memory(const VkMemoryAllocateInfo *pAllocateInfo)
+{
+   vk_foreach_struct_const(ext, pAllocateInfo->pNext) {
+      switch (ext->sType) {
+      case VK_STRUCTURE_TYPE_IMPORT_ANDROID_HARDWARE_BUFFER_INFO_ANDROID:
+         return true;
+      case VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO: {
+         const VkExportMemoryAllocateInfo *export_info = (const void *)ext;
+         if (export_info->handleTypes &
+             VK_EXTERNAL_MEMORY_HANDLE_TYPE_ANDROID_HARDWARE_BUFFER_BIT_ANDROID)
+            return true;
+         break;
+      }
+      default:
+         break;
+      }
+   }
+   return false;
+}
+
+VkResult
+nvk_android_allocate_ahb_memory(struct nvk_device *dev,
+                                const VkMemoryAllocateInfo *pAllocateInfo,
+                                const VkAllocationCallbacks *pAllocator,
+                                VkDeviceMemory *pMem)
+{
+   struct AHardwareBuffer *ahb;
+   VkResult result;
+
+   const VkImportAndroidHardwareBufferInfoANDROID *import_info =
+      vk_find_struct_const(pAllocateInfo->pNext,
+                           IMPORT_ANDROID_HARDWARE_BUFFER_INFO_ANDROID);
+   if (import_info != NULL) {
+      ahb = import_info->buffer;
+      AHardwareBuffer_acquire(ahb);
+   } else {
+      /* Sized from the dedicated image, or allocationSize for a BLOB */
+      ahb = vk_alloc_ahardware_buffer(pAllocateInfo);
+      if (ahb == NULL)
+         return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+
+   result = nvk_android_import_ahb_memory(dev, pAllocateInfo, ahb,
+                                          pAllocator, pMem);
+   if (result != VK_SUCCESS) {
+      AHardwareBuffer_release(ahb);
+      return result;
+   }
+
+   /* vk_device_memory_destroy() releases it, and
+    * vkGetMemoryAndroidHardwareBufferANDROID() returns it.
+    */
+   VK_FROM_HANDLE(vk_device_memory, mem, *pMem);
+   assert(mem->ahardware_buffer == NULL);
+   mem->ahardware_buffer = ahb;
+
+   return VK_SUCCESS;
+}
+
+#endif /* ANDROID_API_LEVEL >= 26 */
+
 VKAPI_ATTR VkResult VKAPI_CALL
 nvk_QueueSignalReleaseImageANDROID(VkQueue _queue,
                                    uint32_t waitSemaphoreCount,
