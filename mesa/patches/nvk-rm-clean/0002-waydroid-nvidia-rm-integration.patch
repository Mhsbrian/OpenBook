diff --git a/src/nouveau/vulkan/nvk_device.c b/src/nouveau/vulkan/nvk_device.c
index 40decf9..537535d 100644
--- a/src/nouveau/vulkan/nvk_device.c
+++ b/src/nouveau/vulkan/nvk_device.c
@@ -231,6 +231,7 @@ nvk_CreateDevice(VkPhysicalDevice physicalDevice,
                  VkDevice *pDevice)
 {
    VK_FROM_HANDLE(nvk_physical_device, pdev, physicalDevice);
+   *pDevice = VK_NULL_HANDLE;
    VkResult result = VK_ERROR_OUT_OF_HOST_MEMORY;
    struct nvk_device *dev;
 
@@ -245,6 +246,20 @@ nvk_CreateDevice(VkPhysicalDevice physicalDevice,
 
    init_dispatch_tables(dev);
 
+   /* Native RM timelines can be GPU-waited before their signal exists, but
+    * a GPU ring is finite: a submit that finds it full CPU-waits for the
+    * queue's oldest batch on the submitting thread. If that batch waits for
+    * a point whose signal is not submitted yet and only this thread can
+    * submit it, that wait never ends. THREADED_ON_DEMAND guarantees the
+    * driver never receives such a wait: vk_queue routes a submit with a
+    * not-yet-pending wait (VK_SYNC_WAIT_PENDING, zero timeout) through the
+    * queue's submit thread, which waits until the signal is submitted.
+    * Submits whose waits are all pending stay on the caller. Older
+    * transports keep the assisted dependency submit thread. */
+   if (dev->vk.timeline_mode == VK_DEVICE_TIMELINE_MODE_NATIVE)
+      dev->vk.submit_mode = VK_QUEUE_SUBMIT_MODE_THREADED_ON_DEMAND;
+   else
+      dev->vk.submit_mode = VK_QUEUE_SUBMIT_MODE_THREADED;
    dev->vk.shader_ops = &nvk_device_shader_ops;
    dev->vk.check_status = &nvk_device_check_status;
 
