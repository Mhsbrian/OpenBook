       bool tiling_has_explicit_layout;
       switch (pImageFormatInfo->tiling) {
       case VK_IMAGE_TILING_LINEAR:
@@ -881,6 +888,19 @@ nvk_image_can_compress(const struct nvk_physical_device *pdev,
    return true;
 }
 
+/* Rust RM compression (see rm_compress in nvk_image_init): the image uses
+ * nil's compressible PTE kind. Compressed mappings must cover whole big
+ * (64 KiB) pages: RM rejects a compressible kind at a VA not aligned to the
+ * big page size. */
+static void
+nvk_image_rm_use_compressed_kind(struct nil_image *nil)
+{
+   assert(nil->compressed_pte_kind != 0);
+   nil->pte_kind = nil->compressed_pte_kind;
+   nil->align_B = MAX2(nil->align_B, 1u << 16);
+   nil->size_B = align64(nil->size_B, nil->align_B);
+}
+
 void
 nvk_image_init_common(struct nvk_device *dev,
                       struct nvk_image *image,
@@ -943,7 +963,15 @@ nvk_image_init_layout(struct nvk_device *dev,
     * we prefer a dedicated allocation for it.
     */
    image->can_compress = nvk_image_can_compress(pdev, image);
-   if (!image->can_compress)
+
+   /* Rust RM backend (kmd_info.has_compression == false, so can_compress is
+    * false). CLEAN-ROOM STUB S5 (SPEC.md): which images use RM-granted
+    * compression. Until it is implemented, no image does. The image VA
+    * carries the compressible kind; whether the memory actually carries
+    * compression is decided at bind by the KMD. */
+   const bool rm_compress = false;
+
+   if (!image->can_compress && !rm_compress)
       usage |= NIL_IMAGE_USAGE_UNCOMPRESSED_BIT;
 
    uint32_t explicit_row_stride_B[NVK_MAX_IMAGE_PLANES] = { 0 };
@@ -1149,6 +1177,19 @@ nvk_image_init_layout(struct nvk_device *dev,
          image->stencil_copy_temp.nil.align_B;
    }
 
+   if (rm_compress) {
+      /* Every nil image initialised with this usage takes its compressible
+       * kind (nil computed compressed_pte_kind since UNCOMPRESSED_BIT is not
+       * set) and the SET_*_COMPRESSION state follows is_compressed. */
+      nvk_image_rm_use_compressed_kind(&image->planes[0].nil);
+      if (image->stencil_copy_temp.nil.size_B > 0) {
+         nvk_image_rm_use_compressed_kind(&image->stencil_copy_temp.nil);
+         image->stencil_copy_temp.plane_align_B =
+            image->stencil_copy_temp.nil.align_B;
+      }
+      image->is_compressed = true;
+   }
+
    uint64_t plane_offset_B = 0;
    image->image_size_B = 0;
    image->image_align_B = 0;
