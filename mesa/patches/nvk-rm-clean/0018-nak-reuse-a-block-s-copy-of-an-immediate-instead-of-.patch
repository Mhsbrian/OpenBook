 }
 
+/// Copies of 32-bit immediates into registers made by the legalizer in the
+/// current block, with the index of the instruction that made each one.
+///
+/// A copy is only reused by an instruction at most `IMM_COPY_REUSE_WINDOW`
+/// instructions later, so that reuse never keeps a register live across a
+/// long stretch of the block just to save a mov; past the window the
+/// immediate is materialized again, as before.
+struct ImmCopies {
+    ip: usize,
+    copies: FxHashMap<(RegFile, u32), (SSAValue, usize)>,
+}
+
+const IMM_COPY_REUSE_WINDOW: usize = 64;
+
+impl ImmCopies {
+    fn new() -> Self {
+        ImmCopies {
+            ip: 0,
+            copies: Default::default(),
+        }
+    }
+}
+
 pub struct LegalizeBuilder<'a> {
     b: SSAInstrBuilder<'a>,
     const_tracker: &'a mut ConstTracker,
+    imm_copies: &'a mut ImmCopies,
 }
 
 impl<'a> LegalizeBuilder<'a> {
@@ -394,10 +451,12 @@ impl<'a> LegalizeBuilder<'a> {
         sm: &'a ShaderModelInfo,
         alloc: &'a mut SSAValueAllocator,
         const_tracker: &'a mut ConstTracker,
+        imm_copies: &'a mut ImmCopies,
     ) -> Self {
         LegalizeBuilder {
             b: SSAInstrBuilder::new(sm, alloc),
             const_tracker,
+            imm_copies,
         }
     }
 
@@ -442,7 +501,26 @@ impl<'a> SSABuilder for LegalizeBuilder<'a> {
     }
 }
 
-impl LegalizeBuildHelpers for LegalizeBuilder<'_> {}
+impl LegalizeBuildHelpers for LegalizeBuilder<'_> {
+    fn reusable_imm_copy(
+        &mut self,
+        reg_file: RegFile,
+        imm: u32,
+    ) -> Option<SSAValue> {
+        let ip = self.imm_copies.ip;
+        match self.imm_copies.copies.get(&(reg_file, imm)) {
+            Some(&(ssa, copy_ip)) if ip - copy_ip <= IMM_COPY_REUSE_WINDOW => {
+                Some(ssa)
+            }
+            _ => None,
+        }
+    }
+
+    fn add_imm_copy(&mut self, reg_file: RegFile, imm: u32, ssa: SSAValue) {
+        let ip = self.imm_copies.ip;
+        self.imm_copies.copies.insert((reg_file, imm), (ssa, ip));
+    }
+}
 
 fn legalize_instr(
     sm: &ShaderModelInfo,
