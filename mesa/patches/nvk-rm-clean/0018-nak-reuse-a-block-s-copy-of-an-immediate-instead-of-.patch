                     match &instr.op {
                         Op::Pin(pin) => {
                             if let Dst::SSA(ssa) = &pin.dst {
@@ -608,6 +688,7 @@ impl Shader<'_> {
                         sm,
                         &mut f.ssa_alloc,
                         &mut const_tracker,
+                        &mut imm_copies,
                     );
                     legalize_instr(sm, &mut b, bl, bu, &pinned, ip, &mut instr);
                     b.push_instr(instr);
