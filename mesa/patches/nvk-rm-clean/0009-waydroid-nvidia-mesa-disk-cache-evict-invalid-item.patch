From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Shiro836 <17294277+Shiro836@users.noreply.github.com>
Date: Mon, 26 Oct 2026 10:01:08 -0400
Subject: [PATCH 09/23] waydroid-nvidia: mesa-disk-cache-evict-invalid-item

nvidia-prolapse/driver-source/native/mesa/mesa-disk-cache-evict-invalid-item.patch at waydroid-nvidia 788728d3d51c (v0.2.0-rc12), sha256 f19dc2cb945f60e0bcfbfca482608359770e6ad5e42a2a3cfa19ddb9b500ee9b
---
 src/util/disk_cache_os.c | 40 +++++++++++++++++++++++++++++++++-------
 1 file changed, 33 insertions(+), 7 deletions(-)

diff --git a/src/util/disk_cache_os.c b/src/util/disk_cache_os.c
index 7914d30..3daffbd 100644
--- a/src/util/disk_cache_os.c
+++ b/src/util/disk_cache_os.c
@@ -624,12 +624,19 @@ disk_cache_evict_item(struct disk_cache *cache, char *filename)
       p_atomic_add(&cache->size->value, - (uint64_t)sb.st_blocks * 512);
 }
 
+/* Returns the item's uncompressed payload, or NULL. *invalid is set when the
+ * item itself is unusable (truncated, keys mismatch, CRC or inflate failure),
+ * as opposed to running out of memory.
+ */
 static void *
 parse_and_validate_cache_item(struct disk_cache *cache, void *cache_item,
-                              size_t cache_item_size, size_t *size)
+                              size_t cache_item_size, size_t *size,
+                              bool *invalid)
 {
    uint8_t *uncompressed_data = NULL;
 
+   *invalid = true;
+
    struct blob_reader ci_blob_reader;
    blob_reader_init(&ci_blob_reader, cache_item, cache_item_size);
 
@@ -681,8 +688,10 @@ parse_and_validate_cache_item(struct disk_cache *cache, void *cache_item,
 
    /* Uncompress the cache data */
    uncompressed_data = malloc(cf_data->uncompressed_size);
-   if (!uncompressed_data)
+   if (!uncompressed_data) {
+      *invalid = false;
       goto fail;
+   }
 
    if (cache->compression_disabled) {
       if (cf_data->uncompressed_size != cache_data_size)
@@ -728,10 +737,23 @@ disk_cache_load_item(struct disk_cache *cache, char *filename, size_t *size)
    if (ret == -1)
       goto fail;
 
-    uint8_t *uncompressed_data =
-       parse_and_validate_cache_item(cache, data, sb.st_size, size);
-   if (!uncompressed_data)
+   bool invalid;
+   uint8_t *uncompressed_data =
+       parse_and_validate_cache_item(cache, data, sb.st_size, size, &invalid);
+   if (!uncompressed_data) {
+      /* Items are written to a temporary file and renamed into place, so a
+       * reader never sees a partial write: an item that fails validation is
+       * damaged (or from an incompatible writer) and stays so. Remove it,
+       * otherwise it blocks every later write of the same key
+       * (disk_cache_write_item_to_disk skips keys whose file exists) and the
+       * key misses for as long as the file lives.
+       */
+      if (invalid) {
+         disk_cache_evict_item(cache, filename);
+         filename = NULL;
+      }
       goto fail;
+   }
 
    free(data);
    free(filename);
@@ -1175,8 +1197,10 @@ disk_cache_load_item_foz(struct disk_cache *cache, const cache_key key,
    if (!cache_item)
       return NULL;
 
+   bool invalid;
    uint8_t *uncompressed_data =
-       parse_and_validate_cache_item(cache, cache_item, cache_tem_size, size);
+       parse_and_validate_cache_item(cache, cache_item, cache_tem_size, size,
+                                     &invalid);
    free(cache_item);
 
    return uncompressed_data;
@@ -1330,8 +1354,10 @@ disk_cache_db_load_item(struct disk_cache *cache, const cache_key key,
    if (!cache_item)
       return NULL;
 
+   bool invalid;
    uint8_t *uncompressed_data =
-       parse_and_validate_cache_item(cache, cache_item, cache_tem_size, size);
+       parse_and_validate_cache_item(cache, cache_item, cache_tem_size, size,
+                                     &invalid);
    free(cache_item);
 
    return uncompressed_data;
