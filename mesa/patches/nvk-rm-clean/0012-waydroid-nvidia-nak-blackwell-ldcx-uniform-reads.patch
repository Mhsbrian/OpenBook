From: Shiro836 <17294277+Shiro836@users.noreply.github.com>
Date: Mon, 26 Oct 2026 10:01:28 -0400
Subject: [PATCH 12/23] waydroid-nvidia: nak-blackwell-ldcx-uniform-reads

nvidia-prolapse/driver-source/native/mesa/nak-blackwell-ldcx-uniform-reads.patch at waydroid-nvidia 788728d3d51c (v0.2.0-rc12), sha256 50d0f58c8abd6b8cf7fc14e4a90b7a433f95ef3fd0baf9f6c1cf315b232831e6
---
 src/nouveau/compiler/nak_nir_lower_non_uniform_ldcx.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/nouveau/compiler/nak_nir_lower_non_uniform_ldcx.c b/src/nouveau/compiler/nak_nir_lower_non_uniform_ldcx.c
index cbba65c..c73340c 100644
--- a/src/nouveau/compiler/nak_nir_lower_non_uniform_ldcx.c
+++ b/src/nouveau/compiler/nak_nir_lower_non_uniform_ldcx.c
@@ -380,10 +380,15 @@ lower_ldcx_block(nir_builder *b, nir_block *block,
       switch (instr->type) {
       case nir_instr_type_alu: {
          nir_alu_instr *alu = nir_instr_as_alu(instr);
-         if (nus != NULL) {
+         if (nus != NULL && nak->sm < 100) {
             /* In non-uniform control-flow, NAK can't copy-prop cbuf values
              * across blocks.  Re-materialize cbufs that are used by ALU
              * instructions in the same block.
+             *
+             * Blackwell+ has no cbuf ALU sources (see opt_copy_prop), so a
+             * re-materialized load would only become an extra LDC into a
+             * GPR in that block; the uniform value loaded before the
+             * section is read directly instead.
              */
             for (uint8_t i = 0; i < nir_op_infos[alu->op].num_inputs; i++)
                progress |= try_remat_ldcx_alu_use(b, alu, i, nus);
