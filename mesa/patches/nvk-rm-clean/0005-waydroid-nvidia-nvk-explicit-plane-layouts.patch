From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Shiro836 <17294277+Shiro836@users.noreply.github.com>
Date: Mon, 26 Oct 2026 10:01:03 -0400
Subject: [PATCH 05/23] waydroid-nvidia: nvk-explicit-plane-layouts

nvidia-prolapse/driver-source/native/mesa/nvk-explicit-plane-layouts.patch at waydroid-nvidia 788728d3d51c (v0.2.0-rc12), sha256 6514f3d05558b9609b87e4edb099f98032554d0ead58c5e2dcd54ac72139723e
---
 src/nouveau/vulkan/nvk_image.c | 29 ++++++++++++++++++++++++-----
 1 file changed, 24 insertions(+), 5 deletions(-)

diff --git a/src/nouveau/vulkan/nvk_image.c b/src/nouveau/vulkan/nvk_image.c
index d36154e..d08fbaf 100644
--- a/src/nouveau/vulkan/nvk_image.c
+++ b/src/nouveau/vulkan/nvk_image.c
@@ -995,6 +995,11 @@ nvk_image_init_layout(struct nvk_device *dev,
          vk_find_struct_const(pCreateInfo->pNext,
                               IMAGE_DRM_FORMAT_MODIFIER_EXPLICIT_CREATE_INFO_EXT);
       if (mod_explicit_info) {
+         if (mod_explicit_info->drmFormatModifierPlaneCount != image->plane_count)
+            return vk_errorf(dev, VK_ERROR_INVALID_DRM_FORMAT_MODIFIER_PLANE_LAYOUT_EXT,
+                             "%u explicit plane layouts for a %u-plane image",
+                             mod_explicit_info->drmFormatModifierPlaneCount,
+                             image->plane_count);
          image->vk.drm_format_mod = mod_explicit_info->drmFormatModifier;
          /* Normally with explicit modifiers, the client specifies all strides,
           * however in our case, we can only really make use of this in the linear
@@ -1216,7 +1221,15 @@ nvk_image_init_layout(struct nvk_device *dev,
       image->image_align_B = MAX2(plane_align_B, image->image_align_B);
 
       if (explicit_offsets_B[plane] >= 0) {
-         assert(explicit_offsets_B[plane] % plane_align_B == 0);
+         /* Client-provided layout (explicit modifier info or ANB): a
+          * misaligned plane offset cannot be bound; refuse it loudly instead
+          * of asserting (release builds would bind a misaligned plane). */
+         if (explicit_offsets_B[plane] % plane_align_B != 0)
+            return vk_errorf(dev, VK_ERROR_INVALID_DRM_FORMAT_MODIFIER_PLANE_LAYOUT_EXT,
+                             "plane %u offset %" PRId64 " is not a multiple of "
+                             "its %u B alignment (pte kind %u)", plane,
+                             explicit_offsets_B[plane], plane_align_B,
+                             image->planes[plane].nil.pte_kind);
          image->planes[plane].plane_offset_B = explicit_offsets_B[plane];
          image->image_size_B =
             MAX2((explicit_offsets_B[plane] + image->planes[plane].nil.size_B),
@@ -1478,7 +1491,10 @@ nvk_get_image_memory_requirements(struct nvk_device *dev,
       assert(image->zcull.nil.size_B == 0);
       assert(image->stencil_copy_temp.nil.size_B == 0);
 
-      size_B = align64(image->planes[plane].nil.size_B,
+      /* A disjoint plane with an explicit offset is bound at that offset
+       * (nvk_image_plane_bind): the binding must cover it. */
+      size_B = align64(image->planes[plane].plane_offset_B +
+                       image->planes[plane].nil.size_B,
                        image->planes[plane].plane_align_B);
       align_B = image->planes[plane].plane_align_B;
    } else {
@@ -1682,9 +1698,12 @@ nvk_get_image_subresource_layout(struct nvk_device *dev,
    const uint8_t p = nvk_image_memory_aspects_to_plane(image, isr->aspectMask);
    const struct nvk_image_plane *plane = &image->planes[p];
 
-   uint64_t offset_B = 0;
-   if (!image->disjoint)
-      offset_B = plane->plane_offset_B;
+   /* plane_offset_B is the packed offset of a non-disjoint plane, and for a
+    * disjoint plane 0 or the client's explicit plane offset
+    * (VkImageDrmFormatModifierExplicitCreateInfoEXT / ANB), which
+    * nvk_image_plane_bind adds to the plane's binding: report it in both
+    * cases so layout and binding agree. */
+   uint64_t offset_B = plane->plane_offset_B;
    offset_B += nil_image_level_layer_offset_B(&plane->nil, isr->mipLevel,
                                               isr->arrayLayer);
 
