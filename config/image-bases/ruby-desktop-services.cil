; Ruby 16452207 framework services whose labels were in the replaced vendor.
; Reviewed subset of the original vendor contract, checked against that input
; by compat-audit.py. No default_android_service grants. storage_metrics_service
; is absent on OpenBook, so its snapshot find grant is deliberately omitted.
(type desktop_data_migration_service)
(roletype object_r desktop_data_migration_service)
(type drm_network_service)
(roletype object_r drm_network_service)
(type desktop_net_service)
(roletype object_r desktop_net_service)
(type desktop_setting_health_service)
(roletype object_r desktop_setting_health_service)
(type desktop_snapshot_service)
(roletype object_r desktop_snapshot_service)
(type desktop_video_chat_manager)
(roletype object_r desktop_video_chat_manager)
(type desktop_serviceability_service)
(roletype object_r desktop_serviceability_service)
(typeattributeset service_manager_type (desktop_data_migration_service drm_network_service desktop_net_service desktop_setting_health_service desktop_snapshot_service desktop_video_chat_manager desktop_serviceability_service))
(typeattributeset system_server_service (desktop_net_service desktop_serviceability_service))
(allow system_server_202604 desktop_data_migration_service (service_manager (add)))
(allow system_server_202604 drm_network_service (service_manager (add)))
(allow system_server_202604 desktop_setting_health_service (service_manager (add)))
(allow system_server_202604 desktop_snapshot_service (service_manager (add)))
(allow system_server_202604 desktop_video_chat_manager (service_manager (add)))
(allow system_server_202604 desktop_serviceability_service (service_manager (add)))
(allow toscana_ta_runner_202604 drm_network_service (service_manager (find)))
(allow priv_app_all desktop_setting_health_service (service_manager (find)))
(allow snapshot_collector_202604 desktop_snapshot_service (service_manager (find)))
(allow hal_audio_default desktop_video_chat_manager (service_manager (find)))
(allow hal_camera_default desktop_video_chat_manager (service_manager (find)))
(allow platform_app_202604 desktop_video_chat_manager (service_manager (find)))
(allow priv_app_202604 desktop_serviceability_service (service_manager (find)))
(allow untrusted_app_202604 desktop_serviceability_service (service_manager (find)))
