# Toolchain for Mesa's out-of-tree Android build (https://docs.mesa3d.org/android.html):
# Android NDK (current LTS) + Meson + Mesa's host-side generators. No host sudo needed.
# Used by scripts/mesa-android-build.sh. Every version is pinned here; bump them deliberately.
FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55

# NDK r30 is the 2026 LTS (developer.android.com/ndk/downloads, checked 2026-10-15).
ARG NDK_VERSION=r30
ARG NDK_SHA1=5107f898313790e449e87eee2183d9a20602dee9
ARG MESON_VERSION=1.12.1
ARG MAKO_VERSION=1.4.3
ARG PYYAML_VERSION=6.0.3
ARG PACKAGING_VERSION=26.3

ENV DEBIAN_FRONTEND=noninteractive
# glslang-tools: RADV compiles its BVH build shaders with glslangValidator on the build host.
RUN apt-get update && apt-get install -y --no-install-recommends \
      bison binutils build-essential ca-certificates ccache curl file flex git glslang-tools \
      ninja-build patchelf pkg-config python3 python3-venv unzip xz-utils zstd \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir \
      meson==${MESON_VERSION} mako==${MAKO_VERSION} pyyaml==${PYYAML_VERSION} packaging==${PACKAGING_VERSION}
ENV PATH=/opt/venv/bin:$PATH

RUN curl -fsSLo /tmp/ndk.zip https://dl.google.com/android/repository/android-ndk-${NDK_VERSION}-linux.zip \
    && echo "${NDK_SHA1}  /tmp/ndk.zip" | sha1sum -c - \
    && unzip -q /tmp/ndk.zip -d /opt && rm /tmp/ndk.zip \
    && mv /opt/android-ndk-${NDK_VERSION} /opt/android-ndk
ENV ANDROID_NDK_HOME=/opt/android-ndk NDK_VERSION=${NDK_VERSION}

WORKDIR /w
